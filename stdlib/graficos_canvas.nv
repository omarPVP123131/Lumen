/// Dibuja texto en (x, y) con el color (r, g, b, a)
/// Cada caracter mide 5x7 píxeles más 1 de separación horizontal
funcion void texto(entero x, entero y, texto s,
        entero r, entero g, entero b, entero a) {
    si __ren == 0 { retornar; }
    si !__cargar() { retornar; }
    si s.largo() == 0 { retornar; }

    lista<entero> font = __font_data();
    __set_color(r, g, b, a);

    entero i = 0;
    mientras i < s.largo() {
        entero ch = __str_ord(s[i]);
        si ch < 32 { ch = 32; }
        si ch > 126 { ch = 126; }
        entero idx = (ch - 32) * 7;
        entero row = 0;
        mientras row < 7 {
            entero bits = font[idx + row];
            entero col = 0;
            mientras col < 5 {
                si ((bits >> (4 - col)) && 1) == 1 {
                    __raw_pixel(x + i * 6 + col, y + row);
                }
                col = col + 1;
            }
            row = row + 1;
        }
        i = i + 1;
    }
}
/// Draw text at (x, y) with color (r, g, b, a)
/// Each character is 5x7 pixels plus 1 spacing
funcion void text(entero x, entero y, texto s,
        entero r, entero g, entero b, entero a) {
    texto(x, y, s, r, g, b, a);
}

/// Ancho en píxeles de un texto (6 por caracter: 5 + 1 separación)
funcion entero ancho_texto(texto s) {
    retornar s.largo() * 6;
}
/// Pixel width of text (6 per character: 5 + 1 spacing)
funcion entero text_width(texto s) { retornar ancho_texto(s); }
