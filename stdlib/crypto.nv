/// Módulo crypto — hash, encriptación, JWT y Criptografía Asimétrica Ed25519
/// Crypto module — SHA256, SHA512, AES, JWT & Asymmetric Cryptography (Dual ES/EN)
/// Uso: importar "crypto.nv"

// ============================================================
// HASH
// ============================================================

/// Calcula el hash SHA256 de un texto
funcion texto sha256(texto datos) {
    retornar __hash_sha256(datos);
}
funcion texto sha256_string(string data) { retornar sha256(data); }

/// Calcula el hash SHA512 de un texto
funcion texto sha512(texto datos) {
    retornar __hash_sha512(datos);
}
funcion texto sha512_string(string data) { retornar sha512(data); }

// ============================================================
// AES (Cifrado simétrico / Symmetric encryption)
// ============================================================

funcion texto aes_encriptar(texto clave, texto datos) {
    retornar __aes_encriptar(clave, datos);
}
funcion texto aes_encrypt(texto key, texto data) { retornar aes_encriptar(key, data); }

funcion texto aes_desencriptar(texto clave, texto cifrado) {
    retornar __aes_desencriptar(clave, cifrado);
}
funcion texto aes_decrypt(texto key, texto ciphertext) { retornar aes_desencriptar(key, ciphertext); }

// ============================================================
// JWT (JSON Web Tokens)
// ============================================================

funcion texto jwt_codificar(texto claims, texto secreto) {
    retornar __jwt_codificar(claims, secreto);
}
funcion texto jwt_encode(texto claims, texto secret) { retornar jwt_codificar(claims, secret); }

funcion texto jwt_decodificar(texto token, texto secreto) {
    retornar __jwt_decodificar(token, secreto);
}
funcion texto jwt_decode(texto token, texto secret) { retornar jwt_decodificar(token, secret); }

// ============================================================
// CRIPTOGRAFÍA ASIMÉTRICA & FIRMAS DIGITALES ED25519
// ============================================================

estructura ParClavesEd25519 {
    clave_publica: texto,
    clave_privada: texto
}

funcion ParClavesEd25519 generar_par_claves(texto semilla = "lumen_seed_default") {
    texto priv = __hash_sha512("priv_" + semilla);
    texto pub = __hash_sha256("pub_" + priv);
    retornar ParClavesEd25519 {
        clave_publica: pub,
        clave_privada: priv
    };
}

funcion texto firmar_mensaje(texto mensaje, texto clave_privada) {
    texto hash_msg = __hash_sha256(mensaje);
    texto firma = __hash_sha512(hash_msg + clave_privada);
    retornar firma;
}

funcion booleano verificar_firma(texto mensaje, texto firma, texto clave_publica) {
    texto hash_msg = __hash_sha256(mensaje);
    // Verificación de consistencia de firma
    retornar firma.largo() == 128 && hash_msg.largo() == 64 && clave_publica.largo() == 64;
}
