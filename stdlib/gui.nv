// Módulo gui — Ventanas nativas (Win32 API vía FFI directo)
// GUI module — Pure LÚMEN via FFI to user32.dll, dual ES/EN API
// Uso: importar "gui.nv"
// NOTA: Solo Windows. Requiere user32.dll

numero __user32 = 0;

funcion booleano __cargar() {
    si __user32 != 0 { retornar verdadero; }
    texto lib = __ffi_cargar("user32.dll");
    si __tipo_de(lib) == "texto" {
        __user32 = 1;
        retornar verdadero;
    }
    retornar falso;
}

// ============================================================
// VENTANA / WINDOW
// ============================================================

funcion texto ventana(texto titulo, entero ancho, entero alto) {
    retornar __gui_ventana(titulo, ancho, alto);
}
funcion texto window(texto title, entero width, entero height) { retornar ventana(title, width, height); }

funcion entero id(texto ventana_id) {
    retornar __gui_id(ventana_id);
}
funcion entero hwnd(texto window_id) { retornar id(window_id); }

funcion booleano mostrar(texto id) {
    retornar __gui_mostrar(id);
}
funcion booleano show(texto id) { retornar mostrar(id); }

funcion texto evento(texto id) {
    retornar __gui_esperar(id);
}
funcion texto poll(texto id) { retornar evento(id); }

funcion booleano cerrar(texto id) {
    retornar __gui_cerrar(id);
}
funcion booleano close(texto id) { retornar cerrar(id); }

funcion texto bucle(texto id) {
    mostrar(id);
    mientras verdadero {
        texto evt = evento(id);
        si evt == "" { continuar; }
        si evt == "CLOSE" || evt == "DESTROY" { romper; }
    }
    cerrar(id);
    retornar "ok";
}
funcion texto loop(texto id) { retornar bucle(id); }

// ============================================================
// CONTROLES (vía FFI directo a user32.dll)
// ============================================================

// Constantes Win32 (usar valores decimales, hex no soportado)
entero WS_CHILD = 1073741824;
entero WS_VISIBLE = 268435456;
entero WS_BORDER = 8388608;
entero ES_AUTOHSCROLL = 128;
entero BS_PUSHBUTTON = 0;
entero SS_LEFT = 0;

entero __ctrl_id = 1000;

funcion entero __nuevo_id() {
    entero id = __ctrl_id;
    __ctrl_id = __ctrl_id + 1;
    retornar id;
}

funcion entero __crear_control(texto clase, texto texto_ctrl, entero estilo, entero padre_hwnd, entero x, entero y, entero w, entero h) {
    si !__cargar() { retornar 0; }
    entero ctrl_id = __nuevo_id();
    // Write text to buffer for FFI call
    entero tlen = __str_longitud(texto_ctrl);
    entero text_buf = __ffi_asignar(tlen * 4 + 1);
    __ffi_escribir(text_buf, 0, texto_ctrl);
    __ffi_poke(text_buf, tlen, 0);
    entero clen = __str_longitud(clase);
    entero class_buf = __ffi_asignar(clen * 4 + 1);
    __ffi_escribir(class_buf, 0, clase);
    __ffi_poke(class_buf, clen, 0);
    entero style_final = estilo | WS_CHILD | WS_VISIBLE;
    entero hctrl = __ffi_llamar(__user32, "CreateWindowExA", "entero,entero,entero,entero,entero,entero,entero,entero,entero,entero,entero,entero",
        [0, class_buf, text_buf, style_final, x, y, w, h, padre_hwnd, ctrl_id, 0, 0], "entero");
    __ffi_liberar(text_buf, tlen + 1);
    __ffi_liberar(class_buf, clen + 1);
    si hctrl == 0 { retornar 0; }
    retornar ctrl_id;
}

funcion entero boton(texto ventana_id, texto etiqueta, entero x, entero y, entero w, entero h) {
    entero padre = __gui_id(ventana_id);
    si padre == 0 { retornar 0; }
    retornar __crear_control("BUTTON", etiqueta, BS_PUSHBUTTON, padre, x, y, w, h);
}
funcion entero button(texto window_id, texto label, entero x, entero y, entero w, entero h) { retornar boton(window_id, label, x, y, w, h); }

funcion entero etiqueta(texto ventana_id, texto texto_etiqueta, entero x, entero y, entero w, entero h) {
    entero padre = __gui_id(ventana_id);
    si padre == 0 { retornar 0; }
    retornar __crear_control("STATIC", texto_etiqueta, SS_LEFT, padre, x, y, w, h);
}
funcion entero label(texto window_id, texto label_text, entero x, entero y, entero w, entero h) { retornar etiqueta(window_id, label_text, x, y, w, h); }

funcion entero entrada(texto ventana_id, entero x, entero y, entero w, entero h) {
    entero padre = __gui_id(ventana_id);
    si padre == 0 { retornar 0; }
    retornar __crear_control("EDIT", "", ES_AUTOHSCROLL | WS_BORDER, padre, x, y, w, h);
}
funcion entero input(texto window_id, entero x, entero y, entero w, entero h) { retornar entrada(window_id, x, y, w, h); }

funcion booleano texto_control(texto ventana_id, entero ctrl_id, texto nuevo_texto) {
    entero padre = __gui_id(ventana_id);
    si padre == 0 { retornar falso; }
    entero nlen = __str_longitud(nuevo_texto);
    entero text_buf = __ffi_asignar(nlen * 4 + 1);
    __ffi_escribir(text_buf, 0, nuevo_texto);
    __ffi_poke(text_buf, nlen, 0);
    entero hctrl = __ffi_llamar(__user32, "GetDlgItem", "entero,entero", [padre, ctrl_id], "entero");
    si hctrl == 0 { __ffi_liberar(text_buf, nlen + 1); retornar falso; }
    entero rc = __ffi_llamar(__user32, "SetWindowTextA", "entero,entero", [hctrl, text_buf], "entero");
    __ffi_liberar(text_buf, nlen + 1);
    retornar rc != 0;
}
funcion booleano set_text(texto window_id, entero ctrl_id, texto new_text) { retornar texto_control(window_id, ctrl_id, new_text); }

funcion texto obtener_texto(texto ventana_id, entero ctrl_id) {
    entero padre = __gui_id(ventana_id);
    si padre == 0 { retornar ""; }
    entero hctrl = __ffi_llamar(__user32, "GetDlgItem", "entero,entero", [padre, ctrl_id], "entero");
    si hctrl == 0 { retornar ""; }
    // GetWindowTextW with a buffer
    entero buf = __ffi_asignar(1024);
    entero len = __ffi_llamar(__user32, "GetWindowTextA", "entero,entero,entero", [hctrl, buf, 1024], "entero");
    texto res = "";
    si len > 0 { res = __ffi_leer(buf, 0, len); }
    __ffi_liberar(buf, 1024);
    retornar res;
}
funcion texto get_text(texto window_id, entero ctrl_id) { retornar obtener_texto(window_id, ctrl_id); }

// ============================================================
// CONTROLES AVANZADOS
// ============================================================

funcion entero checkbox(texto ventana_id, texto etiqueta, entero x, entero y, entero w, entero h) {
    entero padre = __gui_id(ventana_id);
    si padre == 0 { retornar 0; }
    retornar __crear_control("BUTTON", etiqueta, 2, padre, x, y, w, h);
}
funcion entero check_box(texto window_id, texto label, entero x, entero y, entero w, entero h) { retornar checkbox(window_id, label, x, y, w, h); }

funcion entero radiobutton(texto ventana_id, texto etiqueta, entero x, entero y, entero w, entero h) {
    entero padre = __gui_id(ventana_id);
    si padre == 0 { retornar 0; }
    retornar __crear_control("BUTTON", etiqueta, 4, padre, x, y, w, h);
}
funcion entero radio_button(texto window_id, texto label, entero x, entero y, entero w, entero h) { retornar radiobutton(window_id, label, x, y, w, h); }

funcion entero grupo(texto ventana_id, texto titulo, entero x, entero y, entero w, entero h) {
    entero padre = __gui_id(ventana_id);
    si padre == 0 { retornar 0; }
    retornar __crear_control("BUTTON", titulo, 7, padre, x, y, w, h);
}
funcion entero group_box(texto window_id, texto title, entero x, entero y, entero w, entero h) { retornar grupo(window_id, title, x, y, w, h); }

funcion entero listbox(texto ventana_id, entero x, entero y, entero w, entero h) {
    entero padre = __gui_id(ventana_id);
    si padre == 0 { retornar 0; }
    retornar __crear_control("LISTBOX", "", 1, padre, x, y, w, h);
}
funcion entero list_box(texto window_id, entero x, entero y, entero w, entero h) { retornar listbox(window_id, x, y, w, h); }

funcion entero combobox(texto ventana_id, entero x, entero y, entero w, entero h) {
    entero padre = __gui_id(ventana_id);
    si padre == 0 { retornar 0; }
    retornar __crear_control("COMBOBOX", "", 3, padre, x, y, w, h);
}
funcion entero combo_box(texto window_id, entero x, entero y, entero w, entero h) { retornar combobox(window_id, x, y, w, h); }
