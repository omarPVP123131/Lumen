// Módulo tilemap — sistema de mapas de baldosas (tiles) vía SDL2 FFI
// Tilemap module — tile-based map system via SDL2 FFI
// Uso: importar "graficos_tilemap.nv"
// Requiere: graficos_iniciar() y renderizador creado
//           Luego llamar graficos_tilemap_iniciar(renderer)
//
// Funciones principales (ES/EN):
//   tilemap_crear / tilemap_create     — crear tilemap
//   tilemap_poner / tilemap_set        — asignar tile en posición
//   tilemap_obtener / tilemap_get      — obtener tile en posición
//   tilemap_dibujar / tilemap_draw     — dibujar tilemap con cámara
//   tilemap_colision / tilemap_collision — detectar colisión con tiles
//   tilemap_liberar / tilemap_free     — liberar recursos
//   tilemap_color / tilemap_set_color  — definir color para tile_id

// ============================================================
// ESTRUCTURAS / STRUCTURES
// ============================================================

estructura Tilemap {
    id: entero,
    datos: lista<entero>,
    ancho: entero,
    alto: entero,
    tile_w: entero,
    tile_h: entero,
    textura: entero,         // SDL_Texture* (0 = sin textura)
    columnas_textura: entero, // columnas en la hoja de tiles
    paquete: entero,          // empaquetado RGB de color (cuando no hay textura)
}

// ============================================================
// ESTADO INTERNO / INTERNAL STATE
// ============================================================

cualquiera __sdl = ninguno;
entero __ren = 0;
lista<Tilemap> __tilemaps = [];
entero __contador_id = 1;

// ============================================================
// CARGA DE SDL2 / SDL2 LOADING
// ============================================================

funcion booleano __cargar() {
    si __tipo_de(__sdl) == "texto" { retornar verdadero; }
    __sdl = __ffi_cargar("SDL2.dll");
    si __tipo_de(__sdl) != "texto" {
        __sdl = __ffi_cargar("libSDL2.so");
    }
    si __tipo_de(__sdl) != "texto" {
        __sdl = __ffi_cargar("libSDL2.dylib");
    }
    retornar __tipo_de(__sdl) == "texto";
}

// ============================================================
// INICIALIZACIÓN / INIT
// ============================================================

/// Establece el renderer para el módulo tilemap
funcion void iniciar(entero renderer) {
    __ren = renderer;
    __cargar();
    __tilemaps = [];
    __contador_id = 1;
}
/// Set the renderer for the tilemap module
funcion void init(entero renderer) { iniciar(renderer); }

// ============================================================
// AUXILIARES / HELPERS
// ============================================================

funcion entero __i32_le(entero val, entero buf, entero off) {
    __ffi_poke(buf, off, val && 255);
    __ffi_poke(buf, off + 1, (val >> 8) && 255);
    __ffi_poke(buf, off + 2, (val >> 16) && 255);
    __ffi_poke(buf, off + 3, (val >> 24) && 255);
    retornar 0;
}

funcion entero __read_u32(entero buf, entero off) {
    entero b0 = __ffi_peek(buf, off);
    entero b1 = __ffi_peek(buf, off + 1);
    entero b2 = __ffi_peek(buf, off + 2);
    entero b3 = __ffi_peek(buf, off + 3);
    retornar b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
}

funcion entero __rect_alloc(entero x, entero y, entero w, entero h) {
    entero buf = __ffi_asignar(16);
    __i32_le(x, buf, 0);
    __i32_le(y, buf, 4);
    __i32_le(w, buf, 8);
    __i32_le(h, buf, 12);
    retornar buf;
}

/// Busca tilemap por ID, retorna su índice en la lista (-1 si no existe)
funcion entero __buscar_idx(entero id) {
    entero i = 0;
    mientras i < largo(__tilemaps) {
        si __tilemaps[i].id == id { retornar i; }
        i = i + 1;
    }
    retornar -1;
}

/// Carga textura desde archivo usando SDL2 (reutiliza lógica de graficos.nv)
/// Retorna puntero a SDL_Texture* o 0 si falla
funcion entero __cargar_textura(texto archivo) {
    // SDL_RWFromFile(filename, "rb")
    entero rwops = __ffi_llamar(__sdl, "SDL_RWFromFile", "texto,texto",
        [archivo, "rb"], "entero");
    si rwops == 0 { retornar 0; }

    // SDL_LoadBMP_RW(rwops, freesrc=1)
    entero surf = __ffi_llamar(__sdl, "SDL_LoadBMP_RW", "entero,entero",
        [rwops, 1], "entero");
    si surf == 0 { retornar 0; }

    // SDL_CreateTextureFromSurface(renderer, surface)
    entero tex = __ffi_llamar(__sdl, "SDL_CreateTextureFromSurface",
        "entero,entero", [__ren, surf], "entero");

    // SDL_FreeSurface(surface)
    __ffi_llamar(__sdl, "SDL_FreeSurface", "entero", [surf], "void");

    retornar tex;
}

/// Calcula el ancho de textura (en tiles) dividiendo ancho píxel / tile_w
funcion entero __tex_columnas(entero tex, entero tile_w) {
    si tex == 0 { retornar 0; }
    entero w_buf = __ffi_asignar(4);
    entero h_buf = __ffi_asignar(4);
    // SDL_QueryTexture(texture, format=NULL, access=NULL, &w, &h)
    __ffi_llamar(__sdl, "SDL_QueryTexture", "entero,entero,entero,entero,entero",
        [tex, 0, 0, w_buf, h_buf], "entero");
    entero tw = __read_u32(w_buf, 0);
    __ffi_liberar(w_buf, 4);
    __ffi_liberar(h_buf, 4);
    retornar tw / tile_w;
}

// ============================================================
// PALETA DE COLORES POR DEFECTO / DEFAULT COLOR PALETTE
// ============================================================

/// Paleta de colores para tile_id cuando NO se usa textura.
/// tile_id 0 = vacío/transparente (no se dibuja)
/// tile_id 1..N = colores predefinidos
funcion entero __color_por_tile(entero tile_id) {
    // Colores predefinidos para tiles comunes
    si tile_id == 1 { retornar 0x8B4513; }  // marrón (tierra)
    si tile_id == 2 { retornar 0x228B22; }  // verde (césped)
    si tile_id == 3 { retornar 0x808080; }  // gris (piedra)
    si tile_id == 4 { retornar 0x4169E1; }  // azul (agua)
    si tile_id == 5 { retornar 0x654321; }  // marrón oscuro (madera)
    si tile_id == 6 { retornar 0xDAA520; }  // amarillo (arena)
    si tile_id == 7 { retornar 0xFFFFFF; }  // blanco (nieve)
    si tile_id == 8 { retornar 0xFF4500; }  // naranja (lava)
    si tile_id == 9 { retornar 0x8B008B; }  // púrpura
    si tile_id == 10 { retornar 0x00CED1; } // turquesa

    // Para IDs > 10, generar color por ciclo
    entero idx = tile_id - 1;
    entero base = idx * 60;
    entero rr = (base * 7) % 200 + 55;
    entero gg = (base * 13) % 200 + 55;
    entero bb = (base * 23) % 200 + 55;
    retornar (rr << 16) | (gg << 8) | bb;
}

/// Desempaqueta color RGB de un entero empaquetado (0xRRGGBB)
/// Retorna el valor del componente (0-255)
funcion entero __r(entero rgb) { retornar (rgb >> 16) && 255; }
funcion entero __g(entero rgb) { retornar (rgb >> 8) && 255; }
funcion entero __b(entero rgb) { retornar rgb && 255; }

// ============================================================
// CREAR TILEMAP / CREATE TILEMAP
// ============================================================

/// Crea un nuevo tilemap de ancho×alto tiles, cada uno de tile_w×tile_h píxeles
/// archivo_tileset: ruta a un BMP (puede ser "" para usar colores sólidos)
/// Retorna el ID del tilemap, o 0 si hay error
funcion entero tilemap_crear(entero ancho, entero alto,
        entero tile_w, entero tile_h, texto archivo_tileset) {
    si __ren == 0 { retornar 0; }
    si !__cargar() { retornar 0; }
    si ancho <= 0 || alto <= 0 { retornar 0; }
    si tile_w <= 0 || tile_h <= 0 { retornar 0; }

    // Inicializar datos vacíos (tile_id = 0)
    lista<entero> datos = [];
    entero i = 0;
    mientras i < ancho * alto {
        datos = datos ++ [0];
        i = i + 1;
    }

    // Cargar textura si se especificó archivo
    entero tex = 0;
    entero cols = 0;
    si archivo_tileset != "" {
        tex = __cargar_textura(archivo_tileset);
        si tex != 0 {
            cols = __tex_columnas(tex, tile_w);
        }
    }

    entero id = __contador_id;
    __contador_id = __contador_id + 1;

    Tilemap tm = Tilemap {
        id: id,
        datos: datos,
        ancho: ancho,
        alto: alto,
        tile_w: tile_w,
        tile_h: tile_h,
        textura: tex,
        columnas_textura: cols,
        paquete: 0,
    };
    __tilemaps = __tilemaps ++ [tm];

    retornar id;
}
/// Create a new tilemap of width×height tiles, each tile_w×tile_h pixels
/// tileset_file: path to a BMP (can be "" to use solid colors)
/// Returns the tilemap ID, or 0 on error
funcion entero tilemap_create(entero width, entero height,
        entero tile_w, entero tile_h, texto tileset_file) {
    retornar tilemap_crear(width, height, tile_w, tile_h, tileset_file);
}

// ============================================================
// PONER TILE / SET TILE
// ============================================================

/// Coloca un tile en la posición (x, y) del tilemap con ID dado
/// tile_id: 0 = vacío, >0 = tile específico
funcion void tilemap_poner(entero id, entero x, entero y, entero tile_id) {
    entero idx = __buscar_idx(id);
    si idx < 0 { retornar; }
    si x < 0 || x >= __tilemaps[idx].ancho { retornar; }
    si y < 0 || y >= __tilemaps[idx].alto { retornar; }

    entero pos = y * __tilemaps[idx].ancho + x;
    __tilemaps[idx].datos[pos] = tile_id;
}
/// Set a tile at position (x, y) in the tilemap with given ID
/// tile_id: 0 = empty, >0 = specific tile
funcion void tilemap_set(entero id, entero x, entero y, entero tile_id) {
    tilemap_poner(id, x, y, tile_id);
}

// ============================================================
// OBTENER TILE / GET TILE
// ============================================================

/// Obtiene el tile_id en la posición (x, y) del tilemap
/// Retorna tile_id o -1 si la posición es inválida
funcion entero tilemap_obtener(entero id, entero x, entero y) {
    entero idx = __buscar_idx(id);
    si idx < 0 { retornar -1; }
    si x < 0 || x >= __tilemaps[idx].ancho { retornar -1; }
    si y < 0 || y >= __tilemaps[idx].alto { retornar -1; }
    entero pos = y * __tilemaps[idx].ancho + x;
    retornar __tilemaps[idx].datos[pos];
}
/// Get the tile_id at position (x, y) in the tilemap
/// Returns tile_id or -1 if position is invalid
funcion entero tilemap_get(entero id, entero x, entero y) {
    retornar tilemap_obtener(id, x, y);
}

/// Dibuja borde de 1px alrededor de un tile (usado en modo color)
funcion void __raw_line_borde(entero x, entero y, entero w, entero h) {
    // Solo dibujar bordes inferior y derecho para evitar solapamiento
    __ffi_llamar(__sdl, "SDL_RenderDrawLine", "entero,entero,entero,entero,entero",
        [__ren, x, y + h - 1, x + w - 1, y + h - 1], "entero");
    __ffi_llamar(__sdl, "SDL_RenderDrawLine", "entero,entero,entero,entero,entero",
        [__ren, x + w - 1, y, x + w - 1, y + h - 1], "entero");
}

// ============================================================
// DIBUJAR TILEMAP / DRAW TILEMAP
// ============================================================

/// Dibuja el tilemap con desplazamiento de cámara (cam_x, cam_y)
/// Solo dibuja los tiles visibles en pantalla (view culling)
/// Obtiene el tamaño de pantalla automáticamente vía SDL_GetRendererOutputSize
funcion void tilemap_dibujar(entero id, entero cam_x, entero cam_y) {
    entero idx = __buscar_idx(id);
    si idx < 0 { retornar; }
    si __ren == 0 { retornar; }
    si !__cargar() { retornar; }

    Tilemap tm = __tilemaps[idx];

    // Obtener tamaño de salida del renderer (resolución de la ventana)
    entero w_buf = __ffi_asignar(4);
    entero h_buf = __ffi_asignar(4);
    __ffi_llamar(__sdl, "SDL_GetRendererOutputSize", "entero,entero,entero",
        [__ren, w_buf, h_buf], "entero");
    entero scr_w = __read_u32(w_buf, 0);
    entero scr_h = __read_u32(h_buf, 0);
    __ffi_liberar(w_buf, 4);
    __ffi_liberar(h_buf, 4);

    // Calcular rango de tiles visibles
    entero tile_x_inicio = cam_x / tm.tile_w;
    si tile_x_inicio < 0 { tile_x_inicio = 0; }
    entero tile_y_inicio = cam_y / tm.tile_h;
    si tile_y_inicio < 0 { tile_y_inicio = 0; }

    entero tile_x_fin = (cam_x + scr_w + tm.tile_w - 1) / tm.tile_w;
    si tile_x_fin > tm.ancho { tile_x_fin = tm.ancho; }
    entero tile_y_fin = (cam_y + scr_h + tm.tile_h - 1) / tm.tile_h;
    si tile_y_fin > tm.alto { tile_y_fin = tm.alto; }

    // Dibujar tiles visibles
    entero ty = tile_y_inicio;
    mientras ty < tile_y_fin {
        entero tx = tile_x_inicio;
        mientras tx < tile_x_fin {
            entero pos = ty * tm.ancho + tx;
            entero tile_id = tm.datos[pos];

            si tile_id > 0 {
                entero screen_x = tx * tm.tile_w - cam_x;
                entero screen_y = ty * tm.tile_h - cam_y;

                si tm.textura != 0 {
                    // Renderizar con textura (tileset)
                    entero cols = tm.columnas_textura;
                    si cols <= 0 { cols = 1; }
                    entero src_x = (tile_id % cols) * tm.tile_w;
                    entero src_y = (tile_id / cols) * tm.tile_h;

                    entero src = __rect_alloc(src_x, src_y, tm.tile_w, tm.tile_h);
                    entero dst = __rect_alloc(screen_x, screen_y, tm.tile_w, tm.tile_h);

                    __ffi_llamar(__sdl, "SDL_RenderCopy", "entero,entero,entero,entero",
                        [__ren, tm.textura, src, dst], "entero");

                    __ffi_liberar(src, 16);
                    __ffi_liberar(dst, 16);
                } sino {
                    // Renderizar con color sólido
                    entero rgb = tm.paquete;
                    si rgb == 0 { rgb = __color_por_tile(tile_id); }
                    __ffi_llamar(__sdl, "SDL_SetRenderDrawColor",
                        "entero,entero,entero,entero,entero",
                        [__ren, __r(rgb), __g(rgb), __b(rgb), 255], "entero");

                    entero dst = __rect_alloc(screen_x, screen_y, tm.tile_w, tm.tile_h);
                    __ffi_llamar(__sdl, "SDL_RenderFillRect", "entero,entero",
                        [__ren, dst], "entero");
                    __ffi_liberar(dst, 16);

                    // Borde sutil entre tiles (1px más oscuro)
                    entero br = (__r(rgb) * 3 / 4) como entero;
                    entero bg = (__g(rgb) * 3 / 4) como entero;
                    entero bb = (__b(rgb) * 3 / 4) como entero;
                    __ffi_llamar(__sdl, "SDL_SetRenderDrawColor",
                        "entero,entero,entero,entero,entero",
                        [__ren, br, bg, bb, 255], "entero");
                    __raw_line_borde(screen_x, screen_y, tm.tile_w, tm.tile_h);
                }
            }

            tx = tx + 1;
        }
        ty = ty + 1;
    }
}
/// Draw the tilemap with camera offset (cam_x, cam_y)
/// Only draws visible tiles on screen (view culling)
funcion void tilemap_draw(entero id, entero cam_x, entero cam_y) {
    tilemap_dibujar(id, cam_x, cam_y);
}

// ============================================================
// COLISIÓN / COLLISION
// ============================================================

/// Verifica si una posición del mundo (wx, wy) colisiona con un tile sólido
/// Retorna el tile_id del tile en esa posición, o -1 si está fuera del mapa
/// Los tiles con tile_id > 0 se consideran sólidos
funcion entero tilemap_colision(entero id, decimal wx, decimal wy) {
    entero idx = __buscar_idx(id);
    si idx < 0 { retornar -1; }

    entero tx = (wx / (__tilemaps[idx].tile_w como decimal)) como entero;
    entero ty = (wy / (__tilemaps[idx].tile_h como decimal)) como entero;

    si tx < 0 || tx >= __tilemaps[idx].ancho { retornar -1; }
    si ty < 0 || ty >= __tilemaps[idx].alto { retornar -1; }

    entero pos = ty * __tilemaps[idx].ancho + tx;
    entero tile_id = __tilemaps[idx].datos[pos];
    retornar tile_id;
}
/// Check if a world position (wx, wy) collides with a solid tile
/// Returns the tile_id at that position, or -1 if out of bounds
/// Tiles with tile_id > 0 are considered solid
funcion entero tilemap_collision(entero id, decimal wx, decimal wy) {
    retornar tilemap_colision(id, wx, wy);
}

// ============================================================
// COLOR PERSONALIZADO / CUSTOM COLOR
// ============================================================

/// Define un color RGB para un tile_id específico (modo sin textura)
/// tile_id: el ID del tile a colorear (1-255)
/// r, g, b: componentes de color (0-255)
funcion void tilemap_color(entero id, entero tile_id, entero r, entero g, entero b) {
    entero idx = __buscar_idx(id);
    si idx < 0 { retornar; }
    // No podemos almacenar colores por tile_id individual sin expandir la estructura;
    // usamos el paquete como override global. Para control fino, usar textura.
    __tilemaps[idx].paquete = (r << 16) | (g << 8) | b;
}
/// Set an RGB color for a specific tile_id (color-only mode)
funcion void tilemap_set_color(entero id, entero tile_id, entero r, entero g, entero b) {
    tilemap_color(id, tile_id, r, g, b);
}

// ============================================================
// LIBERAR / FREE
// ============================================================

/// Libera los recursos de un tilemap (textura y datos)
funcion void tilemap_liberar(entero id) {
    entero idx = __buscar_idx(id);
    si idx < 0 { retornar; }
    si !__cargar() { retornar; }

    // Liberar textura SDL si existe
    si __tilemaps[idx].textura != 0 {
        __ffi_llamar(__sdl, "SDL_DestroyTexture", "entero",
            [__tilemaps[idx].textura], "void");
    }

    // Eliminar tilemap de la lista
    lista<Tilemap> nuevas = [];
    entero i = 0;
    mientras i < largo(__tilemaps) {
        si i != idx {
            nuevas = nuevas ++ [__tilemaps[i]];
        }
        i = i + 1;
    }
    __tilemaps = nuevas;
}
/// Free tilemap resources (texture and data)
funcion void tilemap_free(entero id) {
    tilemap_liberar(id);
}

/// Libera todos los tilemaps
funcion void limpiar_todo() {
    entero i = 0;
    mientras i < largo(__tilemaps) {
        si __tilemaps[i].textura != 0 {
            __ffi_llamar(__sdl, "SDL_DestroyTexture", "entero",
                [__tilemaps[i].textura], "void");
        }
        i = i + 1;
    }
    __tilemaps = [];
    __contador_id = 1;
}
/// Free all tilemaps
funcion void clear_all() {
    limpiar_todo();
}
