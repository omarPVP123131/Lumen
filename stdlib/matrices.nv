// Modulo matrices - operaciones sobre listas anidadas (matrices 2D y Álgebra Lineal)
// Matrices module - 2D matrix operations & Linear Algebra (Dual ES/EN API)
// Uso: importar "matrices.nv"

importar "matematicas.nv";

// Crear una matriz de tamano filas x columnas con valor inicial
funcion lista<lista<entero>> crear(entero filas, entero columnas, entero inicial) {
    lista<lista<entero>> m = [];
    entero i = 0;
    mientras i < filas {
        lista<entero> fila = [];
        entero j = 0;
        mientras j < columnas {
            fila.agregar(inicial);
            j = j + 1;
        }
        m.agregar(fila);
        i = i + 1;
    }
    retornar m;
}

// Crear matriz identidad / Create identity matrix
funcion lista<lista<entero>> identidad(entero n) {
    lista<lista<entero>> m = crear(n, n, 0);
    entero i = 0;
    mientras i < n {
        m[i][i] = 1;
        i = i + 1;
    }
    retornar m;
}

// Transponer una matriz (filas <-> columnas) / Transpose matrix
funcion lista<lista<entero>> transponer(lista<lista<entero>> m) {
    entero filas = largo(m);
    entero columnas = 0;
    si filas > 0 { columnas = largo(m[0]); }
    lista<lista<entero>> t = crear(columnas, filas, 0);
    entero i = 0;
    mientras i < filas {
        entero j = 0;
        mientras j < columnas {
            t[j][i] = m[i][j];
            j = j + 1;
        }
        i = i + 1;
    }
    retornar t;
}

// Sumar dos matrices del mismo tamano / Add two matrices
funcion lista<lista<entero>> sumar(lista<lista<entero>> a, lista<lista<entero>> b) {
    entero filas = largo(a);
    entero columnas = largo(a[0]);
    lista<lista<entero>> r = crear(filas, columnas, 0);
    entero i = 0;
    mientras i < filas {
        entero j = 0;
        mientras j < columnas {
            r[i][j] = a[i][j] + b[i][j];
            j = j + 1;
        }
        i = i + 1;
    }
    retornar r;
}

// Restar dos matrices / Subtract two matrices
funcion lista<lista<entero>> restar(lista<lista<entero>> a, lista<lista<entero>> b) {
    entero filas = largo(a);
    entero columnas = largo(a[0]);
    lista<lista<entero>> r = crear(filas, columnas, 0);
    entero i = 0;
    mientras i < filas {
        entero j = 0;
        mientras j < columnas {
            r[i][j] = a[i][j] - b[i][j];
            j = j + 1;
        }
        i = i + 1;
    }
    retornar r;
}

// Multiplicar dos matrices / Multiply two matrices
funcion lista<lista<entero>> multiplicar(lista<lista<entero>> a, lista<lista<entero>> b) {
    entero fa = largo(a);
    entero ca = largo(a[0]);
    entero cb = largo(b[0]);
    lista<lista<entero>> r = crear(fa, cb, 0);
    entero i = 0;
    mientras i < fa {
        entero j = 0;
        mientras j < cb {
            entero k = 0;
            mientras k < ca {
                r[i][j] = r[i][j] + a[i][k] * b[k][j];
                k = k + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    retornar r;
}

// Determinante de matriz 2x2: |A| = a*d - b*c
funcion decimal determinante_2x2(lista<lista<decimal>> m) {
    retornar m[0][0] * m[1][1] - m[0][1] * m[1][0];
}

// Determinante de matriz 3x3 por regla de Sarrus / Cofactores
funcion decimal determinante_3x3(lista<lista<decimal>> m) {
    decimal a = m[0][0] * (m[1][1] * m[2][2] - m[1][2] * m[2][1]);
    decimal b = m[0][1] * (m[1][0] * m[2][2] - m[1][2] * m[2][0]);
    decimal c = m[0][2] * (m[1][0] * m[2][1] - m[1][1] * m[2][0]);
    retornar a - b + c;
}

// Inversa de matriz 2x2: A^-1 = (1 / det) * [[d, -b], [-c, a]]
funcion lista<lista<decimal>> inversa_2x2(lista<lista<decimal>> m) {
    decimal det = determinante_2x2(m);
    si det == 0.0 { retornar []; }
    decimal inv_det = 1.0 / det;
    retornar [
        [m[1][1] * inv_det, -m[0][1] * inv_det],
        [-m[1][0] * inv_det, m[0][0] * inv_det]
    ];
}

// Producto Cruz 3D (Vector Cross Product): A x B
funcion lista<decimal> vector_producto_cruz_3d(lista<decimal> a, lista<decimal> b) {
    retornar [
        a[1] * b[2] - a[2] * b[1],
        a[2] * b[0] - a[0] * b[2],
        a[0] * b[1] - a[1] * b[0]
    ];
}

// Magnitud / Norma de un Vector Euclidiano
funcion decimal vector_magnitud(lista<decimal> v) {
    decimal suma = 0.0;
    para x en v {
        suma = suma + x * x;
    }
    retornar matematicas_raiz(suma);
}

// Normalización de Vector (Vector Unitario)
funcion lista<decimal> vector_normalizar(lista<decimal> v) {
    decimal mag = vector_magnitud(v);
    si mag == 0.0 { retornar v; }
    retornar [x / mag para x en v];
}

// Obtener dimensiones / Get dimensions
funcion entero filas(lista<lista<entero>> m) {
    retornar largo(m);
}

funcion entero columnas(lista<lista<entero>> m) {
    si largo(m) > 0 { retornar largo(m[0]); }
    retornar 0;
}

// Imprimir matriz / Print matrix
funcion void imprimir_matriz(lista<lista<entero>> m) {
    entero i = 0;
    mientras i < largo(m) {
        texto linea = "";
        entero j = 0;
        mientras j < largo(m[i]) {
            linea = linea + m[i][j];
            si j < largo(m[i]) - 1 { linea = linea + " "; }
            j = j + 1;
        }
        imprimir(linea);
        i = i + 1;
    }
}
