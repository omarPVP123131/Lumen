// Módulo sql — SQLite vía FFI multiplataforma (Linux / Windows / macOS)
// SQL module — pure LÚMEN via FFI, dual ES/EN API
// Uso: importar "sql.nv"

funcion cualquiera _sql_obtener_lib() {
    cualquiera lib = __ffi_cargar("libsqlite3.so.0");
    si __tipo_de(lib) == "texto" && lib != "" { retornar lib; }
    lib = __ffi_cargar("libsqlite3.so");
    si __tipo_de(lib) == "texto" && lib != "" { retornar lib; }
    lib = __ffi_cargar("sqlite3.dll");
    si __tipo_de(lib) == "texto" && lib != "" { retornar lib; }
    lib = __ffi_cargar("libsqlite3.dylib");
    si __tipo_de(lib) == "texto" && lib != "" { retornar lib; }
    retornar "";
}

funcion entero abrir(texto ruta) {
    cualquiera lib = _sql_obtener_lib();
    si __tipo_de(lib) != "texto" || lib == "" { retornar 0; }
    entero len = ruta.largo();
    entero path_buf = __ffi_asignar(len + 1);
    __ffi_escribir(path_buf, 0, ruta);
    __ffi_poke_byte(path_buf, len, 0);
    entero db_buf = __ffi_asignar(8);
    entero rc = __ffi_llamar(lib, "sqlite3_open", "entero,entero", [path_buf, db_buf], "entero");
    entero db = 0;
    si rc == 0 {
        db = __ffi_peek64(db_buf, 0);
    }
    __ffi_liberar(db_buf, 8);
    __ffi_liberar(path_buf, len + 1);
    retornar db;
}
funcion entero open(texto path) { retornar abrir(path); }

funcion entero ejecutar(entero db, texto sql) {
    si db == 0 { retornar -1; }
    cualquiera lib = _sql_obtener_lib();
    si __tipo_de(lib) != "texto" || lib == "" { retornar -1; }
    entero slen = sql.largo();
    entero sql_buf = __ffi_asignar(slen + 1);
    __ffi_escribir(sql_buf, 0, sql);
    __ffi_poke_byte(sql_buf, slen, 0);
    entero rc = __ffi_llamar(lib, "sqlite3_exec", "entero,entero,entero,entero,entero", [db, sql_buf, 0, 0, 0], "entero");
    __ffi_liberar(sql_buf, slen + 1);
    si rc != 0 { retornar -1; }
    retornar __ffi_llamar(lib, "sqlite3_changes", "entero", [db], "entero");
}
funcion entero exec(entero db, texto sql) { retornar ejecutar(db, sql); }

funcion cualquiera ejecutar_consulta(entero db, texto sql) {
    si db == 0 { retornar ninguno; }
    cualquiera lib = _sql_obtener_lib();
    si __tipo_de(lib) != "texto" || lib == "" { retornar ninguno; }
    entero slen = sql.largo();
    entero sql_buf = __ffi_asignar(slen + 1);
    __ffi_escribir(sql_buf, 0, sql);
    __ffi_poke_byte(sql_buf, slen, 0);
    entero stmt_buf = __ffi_asignar(8);
    entero rc = __ffi_llamar(lib, "sqlite3_prepare_v2", "entero,entero,entero,entero,entero", [db, sql_buf, -1, stmt_buf, 0], "entero");
    entero stmt = 0;
    si rc == 0 {
        stmt = __ffi_peek64(stmt_buf, 0);
    }
    __ffi_liberar(stmt_buf, 8);
    __ffi_liberar(sql_buf, slen + 1);
    si rc != 0 { retornar ninguno; }
    si stmt == 0 { retornar []; }

    entero cc = __ffi_llamar(lib, "sqlite3_column_count", "entero", [stmt], "entero");
    cualquiera filas = __map_nuevo();
    entero nfila = 0;

    mientras verdadero {
        entero sr = __ffi_llamar(lib, "sqlite3_step", "entero", [stmt], "entero");
        si sr == 101 { romper; }
        si sr != 100 {
            __ffi_llamar(lib, "sqlite3_finalize", "entero", [stmt], "entero");
            retornar ninguno;
        }
        cualquiera fila = __map_nuevo();
        entero i = 0;
        mientras i < cc {
            entero ct = __ffi_llamar(lib, "sqlite3_column_type", "entero,entero", [stmt, i], "entero");
            cualquiera val = ninguno;
            si ct == 1 { val = __ffi_llamar(lib, "sqlite3_column_int64", "entero,entero", [stmt, i], "entero"); }
            si ct == 2 { val = __ffi_llamar(lib, "sqlite3_column_double", "entero,entero", [stmt, i], "decimal"); }
            si ct == 3 { val = __ffi_llamar(lib, "sqlite3_column_text", "entero,entero", [stmt, i], "texto"); }
            fila = __map_poner(fila, i, val);
            i = i + 1;
        }
        filas = __map_poner(filas, nfila, fila);
        nfila = nfila + 1;
    }

    __ffi_llamar(lib, "sqlite3_finalize", "entero", [stmt], "entero");
    retornar filas;
}
funcion cualquiera sql_consultar(entero db, texto sql) { retornar ejecutar_consulta(db, sql); }
funcion cualquiera query_exec(entero db, texto sql) { retornar ejecutar_consulta(db, sql); }

funcion booleano cerrar(entero db) {
    si db == 0 { retornar falso; }
    cualquiera lib = _sql_obtener_lib();
    si __tipo_de(lib) != "texto" || lib == "" { retornar falso; }
    retornar __ffi_llamar(lib, "sqlite3_close", "entero", [db], "entero") == 0;
}
funcion booleano close(entero db) { retornar cerrar(db); }

// Aliases con prefijo sql_ para compatibilidad (test_sqlite_avanzado.nv y orm.nv)
funcion entero sql_abrir(texto ruta) { retornar abrir(ruta); }
funcion entero sql_open(texto ruta) { retornar abrir(ruta); }
funcion entero sql_ejecutar(entero db, texto sql) { retornar ejecutar(db, sql); }
funcion entero sql_exec(entero db, texto sql) { retornar ejecutar(db, sql); }
funcion booleano sql_cerrar(entero db) { retornar cerrar(db); }
