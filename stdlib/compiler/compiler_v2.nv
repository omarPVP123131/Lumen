// compiler_v2.nv — LÚMEN Compiler v2: .nv → .nvc via Rust native pipeline
// Uses __compile_nv builtin which runs the full Rust lexer→parser→sema→ir→codegen

funcion resultado<entero, texto> compilar(texto entrada, texto salida) {
    lista<entero> bytes = __compile_nv(entrada);
    intentar __escribir_archivo_bin(salida, bytes);
    imprimir("OK: ", entrada, " -> ", salida);
    retornar exito(0);
}

texto entrada = "stdlib/compiler/ejemplo.nv";
texto salida = "stdlib/compiler/ejemplo.nvc";
resultado<entero, texto> res = compilar(entrada, salida);
imprimir(res);
