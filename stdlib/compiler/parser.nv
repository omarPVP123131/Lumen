// stdlib/compiler/parser.nv — Recursive Descent Parser for LÚMEN
// ═══════════════════════════════════════════════════════════════
// Takes a token map from the lexer (format: {t, v}) and produces AST.
// Token types: 1=Ident, 2=Numero, 3=String, 4=Oper, 5=Punt, 6=Kw, 99=EOF
//
// Architecture: Map-based state (passed as parameter, updated via _res pattern).
// Each parse function returns {st: updated_state, node: ast_node}.

// Funciones anónimas (IIFE) hoisteadas durante el parseo — se fusionan al Programa
lista<numero> lambdas_hoistadas = [];
entero lambda_cnt = 0;
// Traits/impl: tipo -> {metodo -> mangled}; variables -> tipo (para resolver n.metodo())
numero mapa_impls = __map_nuevo();
numero mapa_tipos_var = __map_nuevo();

// ── State Helpers ──────────────────────────────────────────────
funcion numero _st_tk(numero st) {
    numero pos = __map_obtener(st, "pos");
    numero cnt = __map_obtener(st, "cnt");
    si (pos >= cnt) {
        numero t = __map_nuevo();
        t = __map_poner(t, "t", 99);
        t = __map_poner(t, "v", "");
        retornar t;
    }
    retornar __map_obtener(__map_obtener(st, "tokens"), a_texto(pos));
}

funcion numero _st_tt(numero st) {
    numero t = _st_tk(st);
    retornar __map_obtener(t, "t");
}

funcion numero _st_tv(numero st) {
    numero t = _st_tk(st);
    retornar __map_obtener(t, "v");
}

funcion booleano _st_eof(numero st) {
    retornar __map_obtener(st, "pos") >= __map_obtener(st, "cnt");
}

funcion numero _st_adv(numero st) {
    numero p = __map_obtener(st, "pos");
    st = __map_poner(st, "pos", p + 1);
    retornar st;
}

funcion booleano _st_ch(numero st, numero tt, texto vv) {
    si (_st_eof(st)) { retornar falso; }
    numero tk = _st_tk(st);
    numero a = __map_obtener(tk, "t");
    numero b = __map_obtener(tk, "v");
    retornar a == tt && a_texto(b) == vv;
}

funcion booleano _st_kw(numero st, texto w) {
    retornar _st_tt(st) == 6 && a_texto(_st_tv(st)) == w;
}

funcion booleano _st_tp(numero st) {
    texto v = a_texto(_st_tv(st));
    retornar _st_tt(st) == 6 && (v == "entero" || v == "texto" ||
           v == "decimal" || v == "booleano" || v == "numero" || v == "void" ||
           v == "lista" || v == "diccionario" ||
           v == "opcion" || v == "resultado");
}

// Avanza tras el tipo en una declaración, saltando genéricos "lista<entero>",
// "opcion<entero>", "resultado<entero, texto>"
funcion numero _st_tp_skip(numero st) {
    st = _st_adv(st);
    si _st_ch(st, 4, "<") {
        st = _st_adv(st);
        mientras (!_st_eof(st)) {
            si _st_ch(st, 4, ">") { st = _st_adv(st); romper; }
            st = _st_adv(st);
        }
    }
    retornar st;
}

// Check if current token is a real binary operator (not punct like ; { } etc.)
funcion booleano _st_is_op(numero st) {
    si (_st_tt(st) != 4) { retornar falso; }
    texto v = a_texto(_st_tv(st));
    retornar v == "+" || v == "-" || v == "*" || v == "/" || v == "%" ||
           v == "==" || v == "!=" || v == "<" || v == ">" || v == "<=" || v == ">=" ||
           v == "&&" || v == "||" || v == "=";
}

funcion numero _res(numero st, numero nodo) {
    numero r = __map_nuevo();
    r = __map_poner(r, "st", st);
    r = __map_poner(r, "node", nodo);
    retornar r;
}

// ── Forward ────────────────────────────────────────────────────
funcion numero _parse_expr(numero st);
funcion numero _parse_stmt(numero st);
funcion numero _parse_blk(numero st);

// ═══════════════════════════════════════════════════════════════
// ── Expression ─────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════

funcion numero _parse_pr(numero st) {
    numero tt = _st_tt(st);
    texto tvs = a_texto(_st_tv(st));

    si (tt == 3) {
        st = _st_adv(st);
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "Texto");
        n = __map_poner(n, "v", tvs);
        retornar _res(st, n);
    }
    si (tt == 2) {
        st = _st_adv(st);
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "Literal");
        n = __map_poner(n, "v", tvs);
        retornar _res(st, n);
    }
    si (tt == 6 && (tvs == "intentar" || tvs == "try")) {
        st = _st_adv(st);
        numero re = _parse_pr(st);
        numero _en = __map_obtener(re, "node");
        st = __map_obtener(re, "st");
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "Intenta");
        n = __map_poner(n, "expr", _en);
        retornar _res(st, n);
    }

    // Función anónima (IIFE): funcion(params) { body } (args)
    si (tt == 6 && (tvs == "funcion" || tvs == "function")) {
        numero st_chk = _st_adv(st);
        si (_st_ch(st_chk, 5, "(")) {
            st = _st_adv(st_chk);
            numero lams = __map_nuevo();
            numero lc = 0;
            mientras (!_st_eof(st)) {
                si (_st_ch(st, 5, ")")) { romper; }
                si (lc > 0) {
                    si (_st_ch(st, 5, ",")) { st = _st_adv(st); }
                }
                texto pt2 = a_texto(_st_tv(st));
                si (_st_tp(st)) {
                    st = _st_tp_skip(st);
                } sino {
                    st = _st_adv(st);
                }
                texto pn2 = a_texto(_st_tv(st));
                st = _st_adv(st);
                numero pm2 = __map_nuevo();
                pm2 = __map_poner(pm2, "nombre", pn2);
                pm2 = __map_poner(pm2, "tipo", pt2);
                lams = __map_poner(lams, a_texto(lc), pm2);
                lc = lc + 1;
            }
            st = _st_adv(st);
            lams = __map_poner(lams, "cnt", lc);
            numero rf = _parse_blk(st);
            numero fbody = __map_obtener(rf, "node");
            st = __map_obtener(rf, "st");
            texto lname = "__lambda_" + a_texto(lambda_cnt);
            numero lf = __map_nuevo();
            lf = __map_poner(lf, "tipo", "Func");
            lf = __map_poner(lf, "nombre", lname);
            lf = __map_poner(lf, "params", lams);
            lf = __map_poner(lf, "cuerpo", fbody);
            lambdas_hoistadas.agregar(lf);
            lambda_cnt = lambda_cnt + 1;
            // IIFE: si sigue (args), construye Call(callee=lname)
            si (_st_ch(st, 5, "(")) {
                st = _st_adv(st);
                numero largs = __map_nuevo();
                numero lac = 0;
                mientras (!_st_eof(st)) {
                    si (_st_ch(st, 5, ")")) { romper; }
                    si (lac > 0) {
                        si (_st_ch(st, 5, ",")) { st = _st_adv(st); }
                    }
                    numero rea = _parse_expr(st);
                    largs = __map_poner(largs, a_texto(lac), __map_obtener(rea, "node"));
                    st = __map_obtener(rea, "st");
                    lac = lac + 1;
                }
                st = _st_adv(st);
                largs = __map_poner(largs, "cnt", lac);
                numero cn = __map_nuevo();
                cn = __map_poner(cn, "tipo", "Call");
                cn = __map_poner(cn, "callee", lname);
                cn = __map_poner(cn, "args", largs);
                retornar _res(st, cn);
            }
            numero lid = __map_nuevo();
            lid = __map_poner(lid, "tipo", "Ident");
            lid = __map_poner(lid, "nombre", lname);
            retornar _res(st, lid);
        }
    }

    si (tt == 6 && (tvs == "verdadero" || tvs == "true" ||
                     tvs == "falso" || tvs == "false")) {
        st = _st_adv(st);
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "Bool");
        n = __map_poner(n, "v", tvs);
        retornar _res(st, n);
    }

    si (tt == 6 && (tvs == "ninguno" || tvs == "none")) {
        st = _st_adv(st);
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "Ninguno");
        retornar _res(st, n);
    }

    // Identifier or function call
    si (tt == 1 || (tt == 6 && !_st_tp(st) &&
         tvs != "verdadero" && tvs != "true" &&
         tvs != "falso" && tvs != "false")) {
        texto nm = tvs;
        st = _st_adv(st);
        numero base = __map_nuevo();
        // genéricos en llamada: foo<T>(...)
        numero st_pre = st;
        si (_st_ch(st, 4, "<")) {
            numero st_scan = st;
            mientras (!_st_eof(st_scan) && !_st_ch(st_scan, 4, ">")) {
                si (_st_ch(st_scan, 5, "(") || _st_ch(st_scan, 5, ")") ||
                    _st_ch(st_scan, 5, "{") || _st_ch(st_scan, 5, "}") ||
                    _st_ch(st_scan, 5, ";")) { romper; }
                st_scan = _st_adv(st_scan);
            }
            numero st_despues_gt = _st_adv(st_scan);
            si (_st_ch(st_scan, 4, ">") &&
                (_st_ch(st_despues_gt, 5, "(") || _st_ch(st_despues_gt, 5, "{"))) {
                st = st_despues_gt;
            } sino {
                st = st_pre;
            }
        }
        si (_st_ch(st, 5, "(")) {
            st = _st_adv(st);
            numero args = __map_nuevo();
            numero ac = 0;
            mientras (!_st_eof(st)) {
                si (_st_ch(st, 5, ")")) { romper; }
                si (ac > 0) {
                    si (_st_ch(st, 5, ",")) { st = _st_adv(st); }
                }
                numero re = _parse_expr(st);
                numero _en = __map_obtener(re, "node");
                st = __map_obtener(re, "st");
                args = __map_poner(args, a_texto(ac), _en);
                ac = ac + 1;
            }
            st = _st_adv(st);
            args = __map_poner(args, "cnt", ac);
            numero n = __map_nuevo();
            n = __map_poner(n, "tipo", "Call");
            n = __map_poner(n, "callee", nm);
            n = __map_poner(n, "args", args);
            base = n;
        } sino {
            numero n = __map_nuevo();
            n = __map_poner(n, "tipo", "Ident");
            n = __map_poner(n, "nombre", nm);
            base = n;
        }
        // Enum member: Nombre::Miembro → EnumInit (con/sin datos)
        si (_st_ch(st, 5, ":")) {
            numero st_dos = _st_adv(st);
            si (_st_ch(st_dos, 5, ":")) {
                st = _st_adv(st_dos);
                texto mnm = a_texto(_st_tv(st));
                st = _st_adv(st);
                numero eargs = __map_nuevo();
                numero ec = 0;
                si (_st_ch(st, 5, "(")) {
                    st = _st_adv(st);
                    mientras (!_st_eof(st)) {
                        si (_st_ch(st, 5, ")")) { romper; }
                        si (ec > 0) {
                            si (_st_ch(st, 5, ",")) { st = _st_adv(st); }
                        }
                        numero re = _parse_expr(st);
                        numero _en = __map_obtener(re, "node");
                        st = __map_obtener(re, "st");
                        eargs = __map_poner(eargs, a_texto(ec), _en);
                        ec = ec + 1;
                    }
                    st = _st_adv(st);
                }
                eargs = __map_poner(eargs, "cnt", ec);
                numero mn = __map_nuevo();
                mn = __map_poner(mn, "tipo", "EnumInit");
                mn = __map_poner(mn, "nombre", nm);
                mn = __map_poner(mn, "variante", mnm);
                mn = __map_poner(mn, "args", eargs);
                base = mn;
            }
        }
        // StructInit: Ident { f1: v1, ... }
        si (_st_ch(st, 5, "{")) {
            numero st_ck = _st_adv(st);
            booleano es_si = falso;
            si (_st_ch(st_ck, 5, "}")) { es_si = verdadero; }
            sino si (_st_tt(st_ck) == 1) {
                numero st_ck2 = _st_adv(st_ck);
                si (_st_ch(st_ck2, 5, ":")) { es_si = verdadero; }
            }
            si (es_si) {
                st = _st_adv(st);
                numero flds = __map_nuevo();
                numero fc = 0;
                mientras (!_st_eof(st)) {
                    si (_st_ch(st, 5, "}")) { romper; }
                    si (fc > 0 && _st_ch(st, 5, ",")) { st = _st_adv(st); }
                    si (_st_ch(st, 5, "}")) { romper; }
                    texto fnm = a_texto(_st_tv(st));
                    st = _st_adv(st);
                    si (_st_ch(st, 5, ":")) { st = _st_adv(st); }
                    numero re = _parse_expr(st);
                    numero fval = __map_obtener(re, "node");
                    st = __map_obtener(re, "st");
                    numero fitem = __map_nuevo();
                    fitem = __map_poner(fitem, "nombre", fnm);
                    fitem = __map_poner(fitem, "valor", fval);
                    flds = __map_poner(flds, a_texto(fc), fitem);
                    fc = fc + 1;
                }
                si (_st_ch(st, 5, "}")) { st = _st_adv(st); }
                flds = __map_poner(flds, "cnt", fc);
                numero n = __map_nuevo();
                n = __map_poner(n, "tipo", "StructInit");
                n = __map_poner(n, "nombre", nm);
                n = __map_poner(n, "campos", flds);
                base = n;
            }
        }
        // Postfix indexing: obj[expr] (possibly chained)
        mientras (_st_ch(st, 5, "[")) {
            st = _st_adv(st);
            numero re = _parse_expr(st);
            numero iexpr = __map_obtener(re, "node");
            st = __map_obtener(re, "st");
            st = _st_adv(st);
            numero n2 = __map_nuevo();
            n2 = __map_poner(n2, "tipo", "Index");
            n2 = __map_poner(n2, "obj", base);
            n2 = __map_poner(n2, "idx", iexpr);
            base = n2;
        }
        // Postfix methods: obj.nombre(...) or field: obj.campo
        mientras (_st_ch(st, 5, ".")) {
            st = _st_adv(st);
            texto mn = a_texto(_st_tv(st));
            st = _st_adv(st);
            numero mn_dig = 1;
            numero mni = 0;
            mientras mni < largo(mn) {
                texto ch = __str_subcadena(mn, mni, mni + 1);
                si !(ch >= "0" && ch <= "9") { mn_dig = 0; }
                mni = mni + 1;
            }
            numero idx_int = 0;
            si (mn_dig == 1) { idx_int = __str_a_entero(mn); }
            si (_st_ch(st, 5, "(")) {
                st = _st_adv(st);
                numero margs = __map_nuevo();
                numero mc = 0;
                margs = __map_poner(margs, a_texto(mc), base);
                mc = mc + 1;
                mientras (!_st_eof(st)) {
                    si (_st_ch(st, 5, ")")) { romper; }
                    si (mc > 1) {
                        si (_st_ch(st, 5, ",")) { st = _st_adv(st); }
                    }
                    numero re2 = _parse_expr(st);
                    numero an = __map_obtener(re2, "node");
                    st = __map_obtener(re2, "st");
                    margs = __map_poner(margs, a_texto(mc), an);
                    mc = mc + 1;
                }
                st = _st_adv(st);
                margs = __map_poner(margs, "cnt", mc);
                // Resolver método de trait: n.metodo() → Tipo_Trait_metodo(n, ...)
                texto callee_final = mn;
                si a_texto(__map_obtener(base, "tipo")) == "Ident" {
                    texto bn = a_texto(__map_obtener(base, "nombre"));
                    numero bt_v = __map_obtener(mapa_tipos_var, bn);
                    si a_texto(__tipo_de(bt_v)) == "texto" {
                        texto bt = a_texto(bt_v);
                        numero impl_t = __map_obtener(mapa_impls, bt);
                        si a_texto(__tipo_de(impl_t)) == "diccionario" || a_texto(__tipo_de(impl_t)) == "mapa" {
                            numero m_v = __map_obtener(impl_t, mn);
                            si a_texto(__tipo_de(m_v)) == "texto" && a_texto(m_v) != "" {
                                callee_final = a_texto(m_v);
                            }
                        }
                    }
                }
                numero nm2 = __map_nuevo();
                nm2 = __map_poner(nm2, "tipo", "Call");
                nm2 = __map_poner(nm2, "callee", callee_final);
                nm2 = __map_poner(nm2, "args", margs);
                si ((mn == "agregar" || mn == "push") &&
                    a_texto(__map_obtener(base, "tipo")) == "Ident") {
                    // desugar: nombre = agregar(nombre, ...) — el builtin devuelve la lista nueva
                    numero asn = __map_nuevo();
                    asn = __map_poner(asn, "tipo", "Assign");
                    asn = __map_poner(asn, "nombre", a_texto(__map_obtener(base, "nombre")));
                    asn = __map_poner(asn, "valor", nm2);
                    base = asn;
                } sino {
                    base = nm2;
                }
            } sino {
                numero fld = __map_nuevo();
                si (mn_dig == 1) {
                    fld = __map_poner(fld, "tipo", "Literal");
                    fld = __map_poner(fld, "v", idx_int);
                } sino {
                    fld = __map_poner(fld, "tipo", "Texto");
                    fld = __map_poner(fld, "v", mn);
                }
                numero n2 = __map_nuevo();
                n2 = __map_poner(n2, "tipo", "Index");
                n2 = __map_poner(n2, "obj", base);
                n2 = __map_poner(n2, "idx", fld);
                base = n2;
            }
        }
        retornar _res(st, base);
    }

    si (_st_ch(st, 5, "(")) {
        st = _st_adv(st);
        numero telems = __map_nuevo();
        numero tec = 0;
        numero es_tupla = 0;
        mientras (!_st_eof(st)) {
            si (_st_ch(st, 5, ")")) { romper; }
            si (tec > 0) {
                si (_st_ch(st, 5, ",")) { es_tupla = 1; st = _st_adv(st); }
            }
            numero re = _parse_expr(st);
            numero el = __map_obtener(re, "node");
            st = __map_obtener(re, "st");
            telems = __map_poner(telems, a_texto(tec), el);
            tec = tec + 1;
            si (!_st_ch(st, 5, ",") && !_st_ch(st, 5, ")")) { romper; }
        }
        st = _st_adv(st);
        si (es_tupla == 1) {
            telems = __map_poner(telems, "cnt", tec);
            numero nt = __map_nuevo();
            nt = __map_poner(nt, "tipo", "Tupla");
            nt = __map_poner(nt, "elementos", telems);
            // Postfix inline: .0 / .1 / [i] sobre tuplas
            mientras (!_st_eof(st)) {
                si (_st_ch(st, 5, ".")) {
                    st = _st_adv(st);
                    texto mn2 = a_texto(_st_tv(st));
                    st = _st_adv(st);
                    numero mn2_dig = 1;
                    numero mn2i = 0;
                    mientras mn2i < largo(mn2) {
                        texto ch2 = __str_subcadena(mn2, mn2i, mn2i + 1);
                        si !(ch2 >= "0" && ch2 <= "9") { mn2_dig = 0; }
                        mn2i = mn2i + 1;
                    }
                    numero fld2 = __map_nuevo();
                    si (mn2_dig == 1) {
                        fld2 = __map_poner(fld2, "tipo", "Literal");
                        fld2 = __map_poner(fld2, "v", __str_a_entero(mn2));
                    } sino {
                        fld2 = __map_poner(fld2, "tipo", "Texto");
                        fld2 = __map_poner(fld2, "v", mn2);
                    }
                    numero n3 = __map_nuevo();
                    n3 = __map_poner(n3, "tipo", "Index");
                    n3 = __map_poner(n3, "obj", nt);
                    n3 = __map_poner(n3, "idx", fld2);
                    nt = n3;
                } sino si (_st_ch(st, 5, "[")) {
                    st = _st_adv(st);
                    numero re4 = _parse_expr(st);
                    numero ie2 = __map_obtener(re4, "node");
                    st = __map_obtener(re4, "st");
                    st = _st_adv(st);
                    numero n4 = __map_nuevo();
                    n4 = __map_poner(n4, "tipo", "Index");
                    n4 = __map_poner(n4, "obj", nt);
                    n4 = __map_poner(n4, "idx", ie2);
                    nt = n4;
                } sino { romper; }
            }
            retornar _res(st, nt);
        }
        retornar _res(st, __map_obtener(telems, "0"));
    }

    // Array literal: [e1, e2, ...]
    si (tt == 5 && tvs == "[") {
        st = _st_adv(st);
        numero elems = __map_nuevo();
        numero ec = 0;
        mientras (!_st_eof(st)) {
            si (_st_ch(st, 5, "]")) { romper; }
            si (ec > 0) {
                si (_st_ch(st, 5, ",")) { st = _st_adv(st); }
            }
            numero re = _parse_expr(st);
            numero elen = __map_obtener(re, "node");
            st = __map_obtener(re, "st");
            elems = __map_poner(elems, a_texto(ec), elen);
            ec = ec + 1;
        }
        st = _st_adv(st);
        elems = __map_poner(elems, "cnt", ec);
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "Lista");
        n = __map_poner(n, "elementos", elems);
        retornar _res(st, n);
    }

    si (tt == 4 && (tvs == "-" || tvs == "!")) {
        st = _st_adv(st);
        numero re = _parse_pr(st);
        numero _en = __map_obtener(re, "node");
        st = __map_obtener(re, "st");
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "Unary");
        n = __map_poner(n, "op", tvs);
        n = __map_poner(n, "expr", _en);
        retornar _res(st, n);
    }

    st = _st_adv(st);
    numero n = __map_nuevo();
    n = __map_poner(n, "tipo", "Literal");
    n = __map_poner(n, "v", "0");
    retornar _res(st, n);
}

funcion entero _prec(texto op) {
    si (op == "||") { retornar 1; }
    si (op == "&&") { retornar 2; }
    si (op == "==" || op == "!=" || op == "<" || op == ">"
        || op == "<=" || op == ">=" || op == "&") { retornar 3; }
    si (op == "+" || op == "-" || op == "|" || op == "++") { retornar 4; }
    si (op == "<<" || op == ">>") { retornar 5; }
    si (op == "*" || op == "/" || op == "%") { retornar 6; }
    retornar 0;
}

funcion numero _parse_bin(numero st, entero mp) {
    numero re = _parse_pr(st);
    numero izq = __map_obtener(re, "node");
    st = __map_obtener(re, "st");

    mientras (_st_is_op(st)) {
        texto op = a_texto(_st_tv(st));
        entero p = _prec(op);
        si (p < mp || p == 0) { romper; }
        st = _st_adv(st);
        numero rr = _parse_bin(st, p + 1);
        numero der = __map_obtener(rr, "node");
        st = __map_obtener(rr, "st");
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "Binary");
        n = __map_poner(n, "op", op);
        n = __map_poner(n, "izq", izq);
        n = __map_poner(n, "der", der);
        izq = n;
    }
    // Ternario: cond ? si : no — solo al nivel superior (mp == 0),
    // para que `a >= b ? x : y` sea (a>=b) ? x : y, no a >= (b ? x : y)
    si (mp == 0 && _st_ch(st, 4, "?")) {
        st = _st_adv(st);
        numero rb = _parse_expr(st);
        numero sv = __map_obtener(rb, "node");
        st = __map_obtener(rb, "st");
        numero no = __map_nuevo();
        no = __map_poner(no, "tipo", "Literal");
        no = __map_poner(no, "v", "0");
        si (_st_ch(st, 5, ":")) {
            st = _st_adv(st);
            numero rc = _parse_expr(st);
            no = __map_obtener(rc, "node");
            st = __map_obtener(rc, "st");
        }
        numero tn = __map_nuevo();
        tn = __map_poner(tn, "tipo", "Ternario");
        tn = __map_poner(tn, "cond", izq);
        tn = __map_poner(tn, "si", sv);
        tn = __map_poner(tn, "no", no);
        izq = tn;
    }
    retornar _res(st, izq);
}

funcion numero _parse_expr(numero st) {
    retornar _parse_bin(st, 0);
}

// ═══════════════════════════════════════════════════════════════
// ── Block ──────────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════

funcion numero _parse_blk(numero st) {
    st = _st_adv(st);
    numero stmts = __map_nuevo();
    numero sc = 0;
    mientras (!_st_eof(st)) {
        si (_st_ch(st, 5, "}")) { romper; }
        si ((_st_tt(st) == 1 || _st_tt(st) == 6) &&
            (a_texto(_st_tv(st)) == "caso" || a_texto(_st_tv(st)) == "case" ||
             a_texto(_st_tv(st)) == "default")) { romper; }
        numero rs = _parse_stmt(st);
        numero sn = __map_obtener(rs, "node");
        st = __map_obtener(rs, "st");
        stmts = __map_poner(stmts, a_texto(sc), sn);
        sc = sc + 1;
    }
    st = _st_adv(st);
    stmts = __map_poner(stmts, "cnt", sc);
    numero n = __map_nuevo();
    n = __map_poner(n, "tipo", "Block");
    n = __map_poner(n, "cuerpo", stmts);
    retornar _res(st, n);
}

// ═══════════════════════════════════════════════════════════════
// ── Statement ──────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════

funcion numero _parse_stmt(numero st) {
    si (_st_eof(st)) {
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "Vacio");
        retornar _res(st, n);
    }
    numero tt = _st_tt(st);
    texto tvs = a_texto(_st_tv(st));

    si (tt == 6 && (tvs == "sea" || tvs == "let")) {
        st = _st_adv(st);
        texto svar = "let";
        si (_st_tp(st)) {
            svar = a_texto(_st_tv(st));
            st = _st_tp_skip(st);
        }
        texto nm = a_texto(_st_tv(st));
        st = _st_adv(st);
        numero vl = __map_nuevo();
        vl = __map_poner(vl, "tipo", "Vacio");
        si (_st_ch(st, 4, "=")) {
            st = _st_adv(st);
            numero re = _parse_expr(st);
            vl = __map_obtener(re, "node");
            st = __map_obtener(re, "st");
        }
        si (_st_ch(st, 5, ";")) { st = _st_adv(st); }
        // Inferir tipo desde StructInit: sea c = Caja { ... } → c:Caja
        si a_texto(__map_obtener(vl, "tipo")) == "StructInit" {
            svar = a_texto(__map_obtener(vl, "nombre"));
        }
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "VarDecl");
        n = __map_poner(n, "nombre", nm);
        n = __map_poner(n, "tipo_var", svar);
        n = __map_poner(n, "valor", vl);
        mapa_tipos_var = __map_poner(mapa_tipos_var, nm, svar);
        retornar _res(st, n);
    }

    // Decl con tipo tupla: (entero, (texto, entero)) t = ...
    si (_st_ch(st, 5, "(")) {
        numero st_par = _st_adv(st);
        numero nivel = 1;
        mientras (!_st_eof(st_par) && nivel > 0) {
            si (_st_ch(st_par, 5, "(")) { nivel = nivel + 1; }
            sino si (_st_ch(st_par, 5, ")")) { nivel = nivel - 1; }
            st_par = _st_adv(st_par);
        }
        si ((_st_tt(st_par) == 1 || (_st_tt(st_par) == 6 && !_st_tp(st_par))) &&
            !_st_eof(st_par)) {
            st = st_par;
            texto nmp = a_texto(_st_tv(st));
            st = _st_adv(st);
            numero vlp = __map_nuevo();
            vlp = __map_poner(vlp, "tipo", "Vacio");
            si (_st_ch(st, 4, "=")) {
                st = _st_adv(st);
                numero rep = _parse_expr(st);
                vlp = __map_obtener(rep, "node");
                st = __map_obtener(rep, "st");
            }
            si (_st_ch(st, 5, ";")) { st = _st_adv(st); }
            numero np = __map_nuevo();
            np = __map_poner(np, "tipo", "VarDecl");
            np = __map_poner(np, "nombre", nmp);
            np = __map_poner(np, "tipo_var", "tupla");
            np = __map_poner(np, "valor", vlp);
            mapa_tipos_var = __map_poner(mapa_tipos_var, nmp, "tupla");
            retornar _res(st, np);
        }
    }

    // Decl con tipo genérico: Par<entero, texto> p = ...
    si (tt == 1 || (tt == 6 && !_st_tp(st))) {
        numero st_ckg = _st_adv(st);
        si (_st_ch(st_ckg, 4, "<")) {
            numero st_sc = st_ckg;
            mientras (!_st_eof(st_sc) && !_st_ch(st_sc, 4, ">")) {
                si (_st_ch(st_sc, 5, "(") || _st_ch(st_sc, 5, ")") ||
                    _st_ch(st_sc, 5, "{") || _st_ch(st_sc, 5, "}") ||
                    _st_ch(st_sc, 5, ";")) { romper; }
                st_sc = _st_adv(st_sc);
            }
            numero st_adg = _st_adv(st_sc);
            si (_st_ch(st_sc, 4, ">") && (_st_tt(st_adg) == 1 ||
                (_st_tt(st_adg) == 6 && !_st_tp(st_adg)))) {
                st = st_adg;
                texto nmg = a_texto(_st_tv(st));
                st = _st_adv(st);
                numero vlg = __map_nuevo();
                vlg = __map_poner(vlg, "tipo", "Vacio");
                si (_st_ch(st, 4, "=")) {
                    st = _st_adv(st);
                    numero reg = _parse_expr(st);
                    vlg = __map_obtener(reg, "node");
                    st = __map_obtener(reg, "st");
                }
                si (_st_ch(st, 5, ";")) { st = _st_adv(st); }
                numero ng = __map_nuevo();
                ng = __map_poner(ng, "tipo", "VarDecl");
                ng = __map_poner(ng, "nombre", nmg);
                ng = __map_poner(ng, "tipo_var", tvs);
                ng = __map_poner(ng, "valor", vlg);
                mapa_tipos_var = __map_poner(mapa_tipos_var, nmg, tvs);
                retornar _res(st, ng);
            }
        }
    }

    si (tt == 6 && _st_tp(st)) {
        texto tvar = tvs;
        st = _st_tp_skip(st);
        texto nm = a_texto(_st_tv(st));
        st = _st_adv(st);
        // Destructuring: entero x, texto y = (1, "hola")
        si (_st_ch(st, 5, ",")) {
            numero objetivos = __map_nuevo();
            numero otc = 0;
            numero ot0 = __map_nuevo();
            ot0 = __map_poner(ot0, "nombre", nm);
            ot0 = __map_poner(ot0, "tipo", tvar);
            objetivos = __map_poner(objetivos, "0", ot0);
            otc = 1;
            mientras (!_st_eof(st)) {
                si (_st_ch(st, 5, ",")) { st = _st_adv(st); }
                numero o_nm = "";
                texto o_tp = "let";
                si (_st_tt(st) == 1 && a_texto(_st_tv(st)) == "_") {
                    o_nm = "_";
                    st = _st_adv(st);
                } sino {
                    si (_st_tp(st)) {
                        o_tp = a_texto(_st_tv(st));
                        st = _st_tp_skip(st);
                    }
                    o_nm = a_texto(_st_tv(st));
                    st = _st_adv(st);
                }
                numero ot = __map_nuevo();
                ot = __map_poner(ot, "nombre", o_nm);
                ot = __map_poner(ot, "tipo", o_tp);
                objetivos = __map_poner(objetivos, a_texto(otc), ot);
                otc = otc + 1;
                si (!_st_ch(st, 5, ",")) { romper; }
            }
            si (_st_ch(st, 4, "=")) { st = _st_adv(st); }
            numero rde = _parse_expr(st);
            numero de = __map_obtener(rde, "node");
            st = __map_obtener(rde, "st");
            si (_st_ch(st, 5, ";")) { st = _st_adv(st); }
            objetivos = __map_poner(objetivos, "cnt", otc);
            numero nd = __map_nuevo();
            nd = __map_poner(nd, "tipo", "Descomp");
            nd = __map_poner(nd, "objetivos", objetivos);
            nd = __map_poner(nd, "expr", de);
            numero oi2 = 0;
            mientras oi2 < otc {
                texto onm2 = a_texto(__map_obtener(__map_obtener(objetivos, a_texto(oi2)), "nombre"));
                si onm2 != "_" {
                    texto otp2 = a_texto(__map_obtener(__map_obtener(objetivos, a_texto(oi2)), "tipo"));
                    mapa_tipos_var = __map_poner(mapa_tipos_var, onm2, otp2);
                }
                oi2 = oi2 + 1;
            }
            retornar _res(st, nd);
        }
        numero vl = __map_nuevo();
        vl = __map_poner(vl, "tipo", "Vacio");
        si (_st_ch(st, 4, "=")) {
            st = _st_adv(st);
            numero re = _parse_expr(st);
            vl = __map_obtener(re, "node");
            st = __map_obtener(re, "st");
        }
        si (_st_ch(st, 5, ";")) { st = _st_adv(st); }
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "VarDecl");
        n = __map_poner(n, "nombre", nm);
        n = __map_poner(n, "tipo_var", tvar);
        n = __map_poner(n, "valor", vl);
        mapa_tipos_var = __map_poner(mapa_tipos_var, nm, tvar);
        retornar _res(st, n);
    }

    si (tt == 6 && tvs == "const") {
        st = _st_adv(st);
        texto nm = a_texto(_st_tv(st));
        st = _st_adv(st);
        numero vl = __map_nuevo();
        vl = __map_poner(vl, "tipo", "Vacio");
        si (_st_ch(st, 4, "=")) {
            st = _st_adv(st);
            numero re = _parse_expr(st);
            vl = __map_obtener(re, "node");
            st = __map_obtener(re, "st");
        }
        si (_st_ch(st, 5, ";")) { st = _st_adv(st); }
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "VarDecl");
        n = __map_poner(n, "nombre", nm);
        n = __map_poner(n, "tipo_var", "const");
        n = __map_poner(n, "valor", vl);
        retornar _res(st, n);
    }

    si (tt == 6 && (tvs == "rasgo" || tvs == "trait")) {
        st = _st_adv(st);
        st = _st_adv(st); // nombre del rasgo
        si (_st_ch(st, 5, "{")) { st = _st_adv(st); }
        mientras (!_st_eof(st)) {
            si (_st_ch(st, 5, "}")) { romper; }
            st = _st_adv(st);
        }
        si (_st_ch(st, 5, "}")) { st = _st_adv(st); }
        numero nrv = __map_nuevo();
        nrv = __map_poner(nrv, "tipo", "Vacio");
        retornar _res(st, nrv);
    }

    si (tt == 6 && tvs == "impl") {
        st = _st_adv(st);
        texto trait_nm = a_texto(_st_tv(st));
        st = _st_adv(st);
        si (_st_kw(st, "para") || _st_kw(st, "for")) { st = _st_adv(st); }
        texto type_nm = a_texto(_st_tv(st));
        si (_st_tp(st)) { st = _st_tp_skip(st); } sino { st = _st_adv(st); }
        si (_st_ch(st, 5, "{")) { st = _st_adv(st); }
        mientras (!_st_eof(st)) {
            si (_st_ch(st, 5, "}")) { romper; }
            numero mtt = _st_tt(st);
            texto mvv = a_texto(_st_tv(st));
            si ((mtt == 6 || mtt == 1) && (mvv == "funcion" || mvv == "function")) {
                numero pfx = _st_adv(st);
                numero st_rt = pfx;
                si (_st_tp(st_rt)) { st_rt = _st_tp_skip(st_rt); }
                texto mnm = a_texto(_st_tv(st_rt));
                st = _st_adv(st_rt);
                si (_st_ch(st, 5, "(")) { st = _st_adv(st); }
                numero mpar = __map_nuevo();
                numero mpc = 0;
                mientras (!_st_eof(st)) {
                    si (_st_ch(st, 5, ")")) { romper; }
                    si (mpc > 0) {
                        si (_st_ch(st, 5, ",")) { st = _st_adv(st); }
                    }
                    texto ptt = a_texto(_st_tv(st));
                    texto ppn = "";
                    si (_st_tp(st)) {
                        st = _st_tp_skip(st);
                        ppn = a_texto(_st_tv(st));
                        st = _st_adv(st);
                    } sino {
                        ppn = ptt;
                        st = _st_adv(st);
                    }
                    numero pmm = __map_nuevo();
                    pmm = __map_poner(pmm, "nombre", ppn);
                    pmm = __map_poner(pmm, "tipo", ptt);
                    mpar = __map_poner(mpar, a_texto(mpc), pmm);
                    mpc = mpc + 1;
                }
                st = _st_adv(st);
                mpar = __map_poner(mpar, "cnt", mpc);
                numero rmb = _parse_blk(st);
                numero mbod = __map_obtener(rmb, "node");
                st = __map_obtener(rmb, "st");
                texto mangled = type_nm + "_" + trait_nm + "_" + mnm;
                numero mf = __map_nuevo();
                mf = __map_poner(mf, "tipo", "Func");
                mf = __map_poner(mf, "nombre", mangled);
                mf = __map_poner(mf, "params", mpar);
                mf = __map_poner(mf, "cuerpo", mbod);
                lambdas_hoistadas.agregar(mf);
                numero mtabla = __map_obtener(mapa_impls, type_nm);
                si a_texto(__tipo_de(mtabla)) != "diccionario" && a_texto(__tipo_de(mtabla)) != "mapa" {
                    mtabla = __map_nuevo();
                }
                mtabla = __map_poner(mtabla, mnm, mangled);
                mapa_impls = __map_poner(mapa_impls, type_nm, mtabla);
            } sino {
                st = _st_adv(st);
            }
        }
        si (_st_ch(st, 5, "}")) { st = _st_adv(st); }
        numero nv = __map_nuevo();
        nv = __map_poner(nv, "tipo", "Vacio");
        retornar _res(st, nv);
    }

    si (tt == 6 && (tvs == "para" || tvs == "for")) {
        st = _st_adv(st);
        si (_st_ch(st, 5, "(")) {
            // for clásico: para (init; cond; paso) { }
            st = _st_adv(st);
            numero rinit = _parse_stmt(st);
            numero init = __map_obtener(rinit, "node");
            st = __map_obtener(rinit, "st");
            numero rcond = _parse_expr(st);
            numero cond = __map_obtener(rcond, "node");
            st = __map_obtener(rcond, "st");
            si (_st_ch(st, 5, ";")) { st = _st_adv(st); }
            numero rpaso = _parse_stmt(st);
            numero paso = __map_obtener(rpaso, "node");
            st = __map_obtener(rpaso, "st");
            si (_st_ch(st, 5, ")")) { st = _st_adv(st); }
            numero rb = _parse_blk(st);
            numero cuerpo = __map_obtener(rb, "node");
            st = __map_obtener(rb, "st");
            // desugar: init; mientras (cond) { cuerpo; paso; }
            numero stmts2 = __map_obtener(cuerpo, "cuerpo");
            numero s2c = __map_obtener(stmts2, "cnt");
            stmts2 = __map_poner(stmts2, a_texto(s2c), paso);
            stmts2 = __map_poner(stmts2, "cnt", s2c + 1);
            numero cuerpo2 = __map_nuevo();
            cuerpo2 = __map_poner(cuerpo2, "tipo", "Block");
            cuerpo2 = __map_poner(cuerpo2, "cuerpo", stmts2);
            numero wl = __map_nuevo();
            wl = __map_poner(wl, "tipo", "While");
            wl = __map_poner(wl, "cond", cond);
            wl = __map_poner(wl, "cuerpo", cuerpo2);
            numero stmts3 = __map_nuevo();
            stmts3 = __map_poner(stmts3, "0", init);
            stmts3 = __map_poner(stmts3, "1", wl);
            stmts3 = __map_poner(stmts3, "cnt", 2);
            numero n = __map_nuevo();
            n = __map_poner(n, "tipo", "Block");
            n = __map_poner(n, "cuerpo", stmts3);
            retornar _res(st, n);
        }
        // for-each: para [tipo] X en EXPR { }  →  i=0; mientras (i < largo(EXPR)) { X = EXPR[i]; cuerpo; i=i+1; }
        si (_st_tp(st)) { st = _st_tp_skip(st); }
        texto nm = a_texto(_st_tv(st));
        st = _st_adv(st);
        si (_st_kw(st, "en") || _st_kw(st, "in")) { st = _st_adv(st); }
        numero re = _parse_expr(st);
        numero col = __map_obtener(re, "node");
        st = __map_obtener(re, "st");
        numero rb = _parse_blk(st);
        numero cuerpo = __map_obtener(rb, "node");
        st = __map_obtener(rb, "st");
        texto iv = "__para_" + nm;
        numero lit0 = __map_nuevo();
        lit0 = __map_poner(lit0, "tipo", "Literal");
        lit0 = __map_poner(lit0, "v", "0");
        numero as0 = __map_nuevo();
        as0 = __map_poner(as0, "tipo", "Assign");
        as0 = __map_poner(as0, "nombre", iv);
        as0 = __map_poner(as0, "valor", lit0);
        numero argsL = __map_nuevo();
        argsL = __map_poner(argsL, "0", col);
        argsL = __map_poner(argsL, "cnt", 1);
        numero callL = __map_nuevo();
        callL = __map_poner(callL, "tipo", "Call");
        callL = __map_poner(callL, "callee", "largo");
        callL = __map_poner(callL, "args", argsL);
        numero idI = __map_nuevo();
        idI = __map_poner(idI, "tipo", "Ident");
        idI = __map_poner(idI, "nombre", iv);
        numero condB = __map_nuevo();
        condB = __map_poner(condB, "tipo", "Binary");
        condB = __map_poner(condB, "op", "<");
        condB = __map_poner(condB, "izq", idI);
        condB = __map_poner(condB, "der", callL);
        numero idxN = __map_nuevo();
        idxN = __map_poner(idxN, "tipo", "Index");
        idxN = __map_poner(idxN, "obj", col);
        idxN = __map_poner(idxN, "idx", idI);
        numero asn = __map_nuevo();
        asn = __map_poner(asn, "tipo", "Assign");
        asn = __map_poner(asn, "nombre", nm);
        asn = __map_poner(asn, "valor", idxN);
        numero lit1 = __map_nuevo();
        lit1 = __map_poner(lit1, "tipo", "Literal");
        lit1 = __map_poner(lit1, "v", "1");
        numero idI2 = __map_nuevo();
        idI2 = __map_poner(idI2, "tipo", "Ident");
        idI2 = __map_poner(idI2, "nombre", iv);
        numero incB = __map_nuevo();
        incB = __map_poner(incB, "tipo", "Binary");
        incB = __map_poner(incB, "op", "+");
        incB = __map_poner(incB, "izq", idI2);
        incB = __map_poner(incB, "der", lit1);
        numero inc = __map_nuevo();
        inc = __map_poner(inc, "tipo", "Assign");
        inc = __map_poner(inc, "nombre", iv);
        inc = __map_poner(inc, "valor", incB);
        numero stmtsW = __map_nuevo();
        stmtsW = __map_poner(stmtsW, "0", asn);
        numero scW = __map_obtener(cuerpo, "cuerpo");
        numero scWc = __map_obtener(scW, "cnt");
        numero wk = 0;
        mientras (wk < scWc) {
            stmtsW = __map_poner(stmtsW, a_texto(wk + 1), __map_obtener(scW, a_texto(wk)));
            wk = wk + 1;
        }
        stmtsW = __map_poner(stmtsW, a_texto(scWc + 1), inc);
        stmtsW = __map_poner(stmtsW, "cnt", scWc + 2);
        numero cuerpoW = __map_nuevo();
        cuerpoW = __map_poner(cuerpoW, "tipo", "Block");
        cuerpoW = __map_poner(cuerpoW, "cuerpo", stmtsW);
        numero wl = __map_nuevo();
        wl = __map_poner(wl, "tipo", "While");
        wl = __map_poner(wl, "cond", condB);
        wl = __map_poner(wl, "cuerpo", cuerpoW);
        numero stmts3 = __map_nuevo();
        stmts3 = __map_poner(stmts3, "0", as0);
        stmts3 = __map_poner(stmts3, "1", wl);
        stmts3 = __map_poner(stmts3, "cnt", 2);
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "Block");
        n = __map_poner(n, "cuerpo", stmts3);
        retornar _res(st, n);
    }

    si (tt == 6 && (tvs == "si" || tvs == "if")) {
        st = _st_adv(st);
        numero rc = _parse_expr(st);
        numero cond = __map_obtener(rc, "node");
        st = __map_obtener(rc, "st");
        numero rb = _parse_blk(st);
        numero cuerpo = __map_obtener(rb, "node");
        st = __map_obtener(rb, "st");
        numero _else = __map_nuevo();
        _else = __map_poner(_else, "tipo", "Vacio");
        si (_st_kw(st, "sino") || _st_kw(st, "else")) {
            st = _st_adv(st);
            si (_st_kw(st, "si") || _st_kw(st, "if")) {
                numero rs = _parse_stmt(st);
                _else = __map_obtener(rs, "node");
                st = __map_obtener(rs, "st");
            } sino {
                numero rb2 = _parse_blk(st);
                _else = __map_obtener(rb2, "node");
                st = __map_obtener(rb2, "st");
            }
        }
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "If");
        n = __map_poner(n, "cond", cond);
        n = __map_poner(n, "cuerpo", cuerpo);
        n = __map_poner(n, "sino", _else);
        retornar _res(st, n);
    }

    si (tt == 6 && (tvs == "elegir" || tvs == "switch")) {
        st = _st_adv(st);
        si (_st_ch(st, 5, "(")) { st = _st_adv(st); }
        numero re_sw = _parse_expr(st);
        numero sel = __map_obtener(re_sw, "node");
        st = __map_obtener(re_sw, "st");
        si (_st_ch(st, 5, ")")) { st = _st_adv(st); }
        si (_st_ch(st, 5, "{")) { st = _st_adv(st); }
        numero ifns = __map_nuevo();
        numero ic = 0;
        numero dblock = 0;
        mientras (!_st_eof(st)) {
            si (_st_ch(st, 5, "}")) { romper; }
            numero ctt = _st_tt(st);
            texto cv = a_texto(_st_tv(st));
            si ((ctt == 1 || ctt == 6) && (cv == "caso" || cv == "case")) {
                st = _st_adv(st);
                numero rc_v = _parse_expr(st);
                numero cval = __map_obtener(rc_v, "node");
                st = __map_obtener(rc_v, "st");
                si (_st_ch(st, 5, ":")) { st = _st_adv(st); }
                // body del caso: statements hasta `}` o `caso` (sin consumir el `}` — es el cierre del elegir)
                 numero stmts_c = __map_nuevo();
                 numero sc2 = 0;
                 mientras (!_st_eof(st) && !_st_ch(st, 5, "}")) {
                     numero cbt = _st_tt(st);
                     texto cbv = a_texto(_st_tv(st));
                     si ((cbt == 1 || cbt == 6) &&
                         (cbv == "caso" || cbv == "case" || cbv == "defecto" ||
                          cbv == "default")) { romper; }
                     numero rs2 = _parse_stmt(st);
                     numero sn2 = __map_obtener(rs2, "node");
                     st = __map_obtener(rs2, "st");
                     stmts_c = __map_poner(stmts_c, a_texto(sc2), sn2);
                     sc2 = sc2 + 1;
                 }
                 stmts_c = __map_poner(stmts_c, "cnt", sc2);
                 numero b_c = __map_nuevo();
                 b_c = __map_poner(b_c, "tipo", "Block");
                 b_c = __map_poner(b_c, "cuerpo", stmts_c);
                 numero cmp = __map_nuevo();
                 cmp = __map_poner(cmp, "tipo", "Binary");
                 cmp = __map_poner(cmp, "op", "==");
                 cmp = __map_poner(cmp, "izq", sel);
                 cmp = __map_poner(cmp, "der", cval);
                 numero ifn = __map_nuevo();
                 ifn = __map_poner(ifn, "tipo", "If");
                 ifn = __map_poner(ifn, "cond", cmp);
                 ifn = __map_poner(ifn, "cuerpo", b_c);
                 numero _sv = __map_nuevo();
                 _sv = __map_poner(_sv, "tipo", "Vacio");
                 ifn = __map_poner(ifn, "sino", _sv);
                 ifns = __map_poner(ifns, a_texto(ic), ifn);
                 ic = ic + 1;
                 // caso defecto/default: rama else del último If (tras construir el ifn actual)
                 si ((_st_tt(st) == 1 || _st_tt(st) == 6) &&
                     (a_texto(_st_tv(st)) == "defecto" ||
                      a_texto(_st_tv(st)) == "default")) {
                     st = _st_adv(st);
                     si (_st_ch(st, 5, ":")) { st = _st_adv(st); }
                     numero stmts_d = __map_nuevo();
                     numero sd = 0;
                     mientras (!_st_eof(st) && !_st_ch(st, 5, "}")) {
                         numero rsd = _parse_stmt(st);
                         numero snd = __map_obtener(rsd, "node");
                         st = __map_obtener(rsd, "st");
                         stmts_d = __map_poner(stmts_d, a_texto(sd), snd);
                         sd = sd + 1;
                     }
                     stmts_d = __map_poner(stmts_d, "cnt", sd);
                     numero b_d = __map_nuevo();
                     b_d = __map_poner(b_d, "tipo", "Block");
                     b_d = __map_poner(b_d, "cuerpo", stmts_d);
                     dblock = b_d;
                     romper;
                 }
             } sino {
                 st = _st_adv(st);
             }
         }
        si (_st_ch(st, 5, "}")) { st = _st_adv(st); }
        // Construir la cadena desde el final: __map_poner NO muta el mapa original
        si (ic > 0) {
            numero chain = __map_obtener(ifns, a_texto(ic - 1));
            si (dblock != 0) {
                chain = __map_poner(chain, "sino", dblock);
            }
            numero i2 = ic - 1;
            mientras (i2 > 0) {
                i2 = i2 - 1;
                chain = __map_poner(__map_obtener(ifns, a_texto(i2)), "sino", chain);
            }
            retornar _res(st, chain);
        }
        si (dblock != 0) {
            retornar _res(st, dblock);
        }
        numero n_sw = __map_nuevo();
        n_sw = __map_poner(n_sw, "tipo", "Vacio");
        retornar _res(st, n_sw);
    }

    si (tt == 6 && (tvs == "mientras" || tvs == "while")) {
        st = _st_adv(st);
        numero rc = _parse_expr(st);
        numero cond = __map_obtener(rc, "node");
        st = __map_obtener(rc, "st");
        numero rb = _parse_blk(st);
        numero cuerpo = __map_obtener(rb, "node");
        st = __map_obtener(rb, "st");
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "While");
        n = __map_poner(n, "cond", cond);
        n = __map_poner(n, "cuerpo", cuerpo);
        retornar _res(st, n);
    }

    si ((tt == 6 || tt == 1) && (tvs == "retornar" || tvs == "etornar" || tvs == "return")) {
        st = _st_adv(st);
        numero vl = __map_nuevo();
        vl = __map_poner(vl, "tipo", "Vacio");
        si (!_st_ch(st, 5, ";") && !_st_ch(st, 5, "}") && !_st_eof(st)) {
            numero re = _parse_expr(st);
            vl = __map_obtener(re, "node");
            st = __map_obtener(re, "st");
        }
        si (_st_ch(st, 5, ";")) { st = _st_adv(st); }
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "Return");
        n = __map_poner(n, "valor", vl);
        retornar _res(st, n);
    }

    si (tt == 6 && (tvs == "romper" || tvs == "break")) {
        st = _st_adv(st);
        si (_st_ch(st, 5, ";")) { st = _st_adv(st); }
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "Break");
        retornar _res(st, n);
    }
    si (tt == 6 && tvs == "continuar") {
        st = _st_adv(st);
        si (_st_ch(st, 5, ";")) { st = _st_adv(st); }
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "Continue");
        retornar _res(st, n);
    }

    si (tt == 6 && (tvs == "importar" || tvs == "import")) {
        st = _st_adv(st);
        texto rt = a_texto(_st_tv(st));
        st = _st_adv(st);
        si (_st_ch(st, 5, ";")) { st = _st_adv(st); }
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "Import");
        n = __map_poner(n, "ruta", rt);
        retornar _res(st, n);
    }

    si (tt == 1 || tt == 6) {
        // Typed var decl con tipo custom (struct): Punto p = Punto { x: 1, y: 2 }
        numero st_ck = _st_adv(st);
        si ((_st_tt(st_ck) == 1) || (_st_tt(st_ck) == 6 && !_st_tp(st_ck))) {
            numero st_nm = st_ck;
            si (_st_ch(st_nm, 4, "<")) {
                mientras (!_st_eof(st_nm) && !_st_ch(st_nm, 4, ">")) { st_nm = _st_adv(st_nm); }
                st_nm = _st_adv(st_nm);
            }
            si (_st_tt(st_nm) == 1 || (_st_tt(st_nm) == 6 && !_st_tp(st_nm))) {
                texto vnombre = a_texto(_st_tv(st_nm));
                st_nm = _st_adv(st_nm);
                si (_st_ch(st_nm, 4, "=")) {
                    st_nm = _st_adv(st_nm);
                    numero re3 = _parse_expr(st_nm);
                    numero vvl = __map_obtener(re3, "node");
                    st_nm = __map_obtener(re3, "st");
                    si (_st_ch(st_nm, 5, ";")) { st_nm = _st_adv(st_nm); }
                    numero n3 = __map_nuevo();
                    n3 = __map_poner(n3, "tipo", "VarDecl");
                    n3 = __map_poner(n3, "nombre", vnombre);
                    n3 = __map_poner(n3, "valor", vvl);
                    retornar _res(st_nm, n3);
                }
            }
        }
        numero re = _parse_expr(st);
        numero ex = __map_obtener(re, "node");
        st = __map_obtener(re, "st");
        // Destructuring en asignación: p, q = (42, "mundo")
        si (a_texto(__map_obtener(ex, "tipo")) == "Ident" && _st_ch(st, 5, ",")) {
            numero objetivos2 = __map_nuevo();
            numero otc2 = 0;
            numero at0 = __map_nuevo();
            at0 = __map_poner(at0, "nombre", a_texto(__map_obtener(ex, "nombre")));
            at0 = __map_poner(at0, "tipo", "let");
            objetivos2 = __map_poner(objetivos2, "0", at0);
            otc2 = 1;
            mientras (!_st_eof(st)) {
                si (_st_ch(st, 5, ",")) { st = _st_adv(st); }
                numero atn = "";
                si (_st_tt(st) == 1 && a_texto(_st_tv(st)) == "_") {
                    atn = "_";
                    st = _st_adv(st);
                } sino {
                    atn = a_texto(_st_tv(st));
                    st = _st_adv(st);
                }
                numero at = __map_nuevo();
                at = __map_poner(at, "nombre", atn);
                at = __map_poner(at, "tipo", "let");
                objetivos2 = __map_poner(objetivos2, a_texto(otc2), at);
                otc2 = otc2 + 1;
                si (!_st_ch(st, 5, ",")) { romper; }
            }
            si (_st_ch(st, 4, "=")) { st = _st_adv(st); }
            numero rde2 = _parse_expr(st);
            numero de2 = __map_obtener(rde2, "node");
            st = __map_obtener(rde2, "st");
            si (_st_ch(st, 5, ";")) { st = _st_adv(st); }
            objetivos2 = __map_poner(objetivos2, "cnt", otc2);
            numero nd2 = __map_nuevo();
            nd2 = __map_poner(nd2, "tipo", "Descomp");
            nd2 = __map_poner(nd2, "objetivos", objetivos2);
            nd2 = __map_poner(nd2, "expr", de2);
            retornar _res(st, nd2);
        }
        si (_st_ch(st, 4, "=")) {
            st = _st_adv(st);
            numero re2 = _parse_expr(st);
            numero vl = __map_obtener(re2, "node");
            st = __map_obtener(re2, "st");
            si (_st_ch(st, 5, ";")) { st = _st_adv(st); }
            numero n = __map_nuevo();
            n = __map_poner(n, "tipo", "Assign");
            texto tp_ex = a_texto(__map_obtener(ex, "tipo"));
            si tp_ex == "Index" {
                n = __map_poner(n, "target", ex);
                numero objn = __map_obtener(ex, "obj");
                mientras a_texto(__map_obtener(objn, "tipo")) == "Index" {
                    objn = __map_obtener(objn, "obj");
                }
                n = __map_poner(n, "nombre", a_texto(__map_obtener(objn, "nombre")));
            } sino {
                n = __map_poner(n, "nombre", a_texto(__map_obtener(ex, "nombre")));
            }
            n = __map_poner(n, "valor", vl);
            retornar _res(st, n);
        }
        si (_st_ch(st, 5, ";")) { st = _st_adv(st); }
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "ExprStmt");
        n = __map_poner(n, "expr", ex);
        retornar _res(st, n);
    }

    si (_st_ch(st, 5, "{")) {
        numero rb3 = _parse_blk(st);
        numero b3 = __map_obtener(rb3, "node");
        retornar _res(__map_obtener(rb3, "st"), b3);
    }

    si (!_st_eof(st)) {
        numero re = _parse_expr(st);
        numero ex = __map_obtener(re, "node");
        st = __map_obtener(re, "st");
        si (_st_ch(st, 5, ";")) { st = _st_adv(st); }
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "ExprStmt");
        n = __map_poner(n, "expr", ex);
        retornar _res(st, n);
    }
    numero n = __map_nuevo();
    n = __map_poner(n, "tipo", "Vacio");
    retornar _res(st, n);
}

// ═══════════════════════════════════════════════════════════════
// ── Declaration ────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════

funcion numero _parse_decl(numero st) {
    si (_st_eof(st)) {
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "Vacio");
        retornar _res(st, n);
    }
    numero tt = _st_tt(st);
    texto tvs = a_texto(_st_tv(st));

    si (tt == 6 && (tvs == "funcion" || tvs == "function")) {
        st = _st_adv(st);
        texto tr = "void";
        si (_st_tp(st)) {
            tr = a_texto(_st_tv(st));
            st = _st_tp_skip(st);
        } sino {
            // Tipo de retorno genérico: `funcion T foo<T>(...)` — el siguiente token es Ident (nombre)
            si (!_st_eof(st) && _st_tt(st) == 1) {
                texto tv = a_texto(_st_tv(st));
                numero st_adelante = _st_adv(st);
                si (!_st_eof(st_adelante) && _st_tt(st_adelante) == 1) {
                    tr = tv;
                    st = st_adelante;
                }
            }
        }
        texto nm = a_texto(_st_tv(st));
        st = _st_adv(st);
        // genéricos en la firma: funcion X<T>(...)  (scan con límites)
        si (_st_ch(st, 4, "<")) {
            numero st_scan = st;
            mientras (!_st_eof(st_scan) && !_st_ch(st_scan, 4, ">")) {
                si (_st_ch(st_scan, 5, "(") || _st_ch(st_scan, 5, ")") ||
                    _st_ch(st_scan, 5, "{") || _st_ch(st_scan, 5, "}") ||
                    _st_ch(st_scan, 5, ";")) { romper; }
                st_scan = _st_adv(st_scan);
            }
            si (_st_ch(st_scan, 4, ">")) {
                st = _st_adv(st_scan);
            } sino {
                st = _st_adv(st);
            }
        }
        st = _st_adv(st); // (
        numero prms = __map_nuevo();
        numero pc = 0;
        mientras (!_st_eof(st)) {
            si (_st_ch(st, 5, ")")) { romper; }
            si (pc > 0) {
                si (_st_ch(st, 5, ",")) { st = _st_adv(st); }
            }
            texto pt = a_texto(_st_tv(st));
            // Avanzar correctamente tras el tipo (soporta genéricos como lista<entero>)
            si (_st_tp(st)) {
                st = _st_tp_skip(st);
            } sino {
                st = _st_adv(st);
            }
            texto pn = a_texto(_st_tv(st));
            st = _st_adv(st);
            numero pm = __map_nuevo();
            pm = __map_poner(pm, "nombre", pn);
            pm = __map_poner(pm, "tipo", pt);
            pm = __map_poner(pm, "defecto", 0);
            si (_st_ch(st, 4, "=")) {
                st = _st_adv(st);
                numero rdf = _parse_expr(st);
                pm = __map_poner(pm, "defecto", __map_obtener(rdf, "node"));
                st = __map_obtener(rdf, "st");
            }
            prms = __map_poner(prms, a_texto(pc), pm);
            pc = pc + 1;
        }
        st = _st_adv(st); // )
        prms = __map_poner(prms, "cnt", pc);
        // Forward declaration sin cuerpo (solo firma + ;) — ignorar
        si (_st_ch(st, 5, ";")) {
            st = _st_adv(st);
            numero v = __map_nuevo();
            v = __map_poner(v, "tipo", "Vacio");
            retornar _res(st, v);
        }
        numero rb = _parse_blk(st);
        numero bd = __map_obtener(rb, "node");
        st = __map_obtener(rb, "st");
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "Func");
        n = __map_poner(n, "nombre", nm);
        n = __map_poner(n, "tipo_ret", tr);
        n = __map_poner(n, "params", prms);
        n = __map_poner(n, "cuerpo", bd);
        retornar _res(st, n);
    }

    si (tt == 6 && (tvs == "estructura" || tvs == "struct")) {
        st = _st_adv(st);
        st = _st_adv(st); // nombre
        si (_st_ch(st, 4, "<")) {
            mientras (!_st_eof(st) && !_st_ch(st, 4, ">")) { st = _st_adv(st); }
            st = _st_adv(st);
        }
        si (_st_ch(st, 5, "{")) {
            st = _st_adv(st);
            mientras (!_st_eof(st) && !_st_ch(st, 5, "}")) { st = _st_adv(st); }
            si (_st_ch(st, 5, "}")) { st = _st_adv(st); }
        }
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "Vacio");
        retornar _res(st, n);
    }

    si (tt == 6 && tvs == "enum") {
        st = _st_adv(st);
        st = _st_adv(st); // nombre
        si (_st_ch(st, 5, "{")) {
            st = _st_adv(st);
            mientras (!_st_eof(st) && !_st_ch(st, 5, "}")) { st = _st_adv(st); }
            si (_st_ch(st, 5, "}")) { st = _st_adv(st); }
        }
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "Vacio");
        retornar _res(st, n);
    }

    retornar _parse_stmt(st);
}

// ═══════════════════════════════════════════════════════════════
// ── Program ────────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════

funcion numero _parse_prog(numero st) {
    numero prog = __map_nuevo();
    prog = __map_poner(prog, "tipo", "Programa");
    numero stmts = __map_nuevo();
    numero sc = 0;
    lambdas_hoistadas = [];
    mientras (!_st_eof(st)) {
        si (_st_ch(st, 5, ";") || _st_ch(st, 5, "}")) {
            st = _st_adv(st);
            continuar;
        }
        numero tt = _st_tt(st);
        texto tvs = a_texto(_st_tv(st));
        numero r;
        si ((tt == 6 || tt == 1) && (tvs == "funcion" || tvs == "function" ||
                         tvs == "estructura" || tvs == "importar" ||
                         tvs == "import" || tvs == "enum")) {
            r = _parse_decl(st);
        } sino {
            r = _parse_stmt(st);
        }
        st = __map_obtener(r, "st");
        stmts = __map_poner(stmts, a_texto(sc), __map_obtener(r, "node"));
        sc = sc + 1;
    }
    stmts = __map_poner(stmts, "cnt", sc);
    // Fusionar funciones anónimas hoisteadas (IIFE) al Programa
    entero li = 0;
    mientras li < largo(lambdas_hoistadas) {
        stmts = __map_poner(stmts, a_texto(sc), lambdas_hoistadas[li]);
        sc = sc + 1;
        li = li + 1;
    }
    stmts = __map_poner(stmts, "cnt", sc);
    prog = __map_poner(prog, "cuerpo", stmts);
    retornar _res(st, prog);
}

// ── Public API ─────────────────────────────────────────────────

// ═══════════════════════════════════════════════════════════════
// ── Import Resolution (Sprint 6.1) ──────────────────────────────
// ═══════════════════════════════════════════════════════════════

funcion numero _imp_parse(numero tokens) {
    numero st = __map_nuevo();
    st = __map_poner(st, "tokens", tokens);
    st = __map_poner(st, "pos", 0);
    st = __map_poner(st, "cnt", __map_obtener(tokens, "cnt"));
    numero r = _parse_prog(st);
    retornar __map_obtener(r, "node");
}

// Prefijo de módulo a partir de la ruta: "matematicas.nv" → "matematicas_"
funcion texto _imp_prefijo(texto ruta) {
    texto nm = ruta;
    // basename: quitar directorios (barra normal e invertida)
    numero i = 0;
    numero ln = largo(ruta);
    numero last = 0;
    mientras (i < ln) {
        texto c = __str_subcadena(ruta, i, i + 1);
        si (c == "/" || c == "\\") { last = i + 1; }
        i = i + 1;
    }
    nm = __str_subcadena(ruta, last, ln);
    // quitar extensión .nv
    si (__str_subcadena(nm, largo(nm) - 3, largo(nm)) == ".nv") {
        nm = __str_subcadena(nm, 0, largo(nm) - 3);
    }
    retornar nm + "_";
}

// ¿nombre en el mapa de funciones?
funcion booleano _imp_es_func(numero fns, texto nm) {
    retornar __map_contiene(fns, nm);
}

// Recolecta nombres de funciones propias (sin marca imp) y de importadas (con marca)
funcion numero _imp_funcs(numero cuerpo, texto marcar) {
    numero fns = __map_nuevo();
    numero sc = __map_obtener(cuerpo, "cnt");
    numero j = 0;
    mientras (j < sc) {
        numero nd = __map_obtener(cuerpo, a_texto(j));
        si (a_texto(__map_obtener(nd, "tipo")) == "Func") {
            texto esimp = a_texto(__map_obtener(nd, "imp"));
            si (marcar == "propias" && esimp != "1") {
                fns = __map_poner(fns, a_texto(__map_obtener(nd, "nombre")), 1);
            }
            si (marcar == "importadas" && esimp == "1") {
                fns = __map_poner(fns, a_texto(__map_obtener(nd, "nombre")), 1);
            }
        }
        j = j + 1;
    }
    retornar fns;
}

// Prefija recursivamente las funciones propias de un módulo y sus calls internos
funcion numero _imp_prefijar(numero nodo, texto prefijo, numero propias, numero importadas) {
    texto tp = a_texto(__map_obtener(nodo, "tipo"));
    si (tp == "Func") {
        // funciones importadas ya resueltas — no tocar
        si (a_texto(__map_obtener(nodo, "imp")) == "1") { retornar nodo; }
        texto nm = a_texto(__map_obtener(nodo, "nombre"));
        si (!__str_starts_with(nm, prefijo)) {
            nodo = __map_poner(nodo, "nombre", prefijo + nm);
        }
        nodo = __map_poner(nodo, "cuerpo",
            _imp_prefijar(__map_obtener(nodo, "cuerpo"), prefijo, propias, importadas));
        retornar nodo;
    }
    si (tp == "Block" || tp == "Programa") {
        numero stmts = __map_obtener(nodo, "cuerpo");
        numero sc = __map_obtener(stmts, "cnt");
        numero j = 0;
        mientras (j < sc) {
            numero nd = __map_obtener(stmts, a_texto(j));
            stmts = __map_poner(stmts, a_texto(j),
                _imp_prefijar(nd, prefijo, propias, importadas));
            j = j + 1;
        }
        nodo = __map_poner(nodo, "cuerpo", stmts);
        retornar nodo;
    }
    si (tp == "Call") {
        texto cl = a_texto(__map_obtener(nodo, "callee"));
        si (_imp_es_func(propias, cl)) {
            si (!__str_starts_with(cl, prefijo)) {
                nodo = __map_poner(nodo, "callee", prefijo + cl);
            }
        }
        numero args = __map_obtener(nodo, "args");
        numero ac = __map_obtener(args, "cnt");
        numero j = 0;
        mientras (j < ac) {
            numero an = __map_obtener(args, a_texto(j));
            args = __map_poner(args, a_texto(j),
                _imp_prefijar(an, prefijo, propias, importadas));
            j = j + 1;
        }
        nodo = __map_poner(nodo, "args", args);
        retornar nodo;
    }
    si (tp == "Binary") {
        nodo = __map_poner(nodo, "izq",
            _imp_prefijar(__map_obtener(nodo, "izq"), prefijo, propias, importadas));
        nodo = __map_poner(nodo, "der",
            _imp_prefijar(__map_obtener(nodo, "der"), prefijo, propias, importadas));
        retornar nodo;
    }
    si (tp == "Unary" || tp == "Intenta") {
        nodo = __map_poner(nodo, "expr",
            _imp_prefijar(__map_obtener(nodo, "expr"), prefijo, propias, importadas));
        retornar nodo;
    }
    si (tp == "Index") {
        nodo = __map_poner(nodo, "obj",
            _imp_prefijar(__map_obtener(nodo, "obj"), prefijo, propias, importadas));
        nodo = __map_poner(nodo, "idx",
            _imp_prefijar(__map_obtener(nodo, "idx"), prefijo, propias, importadas));
        retornar nodo;
    }
    si (tp == "If") {
        nodo = __map_poner(nodo, "cond",
            _imp_prefijar(__map_obtener(nodo, "cond"), prefijo, propias, importadas));
        nodo = __map_poner(nodo, "cuerpo",
            _imp_prefijar(__map_obtener(nodo, "cuerpo"), prefijo, propias, importadas));
        nodo = __map_poner(nodo, "sino",
            _imp_prefijar(__map_obtener(nodo, "sino"), prefijo, propias, importadas));
        retornar nodo;
    }
    si (tp == "While") {
        nodo = __map_poner(nodo, "cond",
            _imp_prefijar(__map_obtener(nodo, "cond"), prefijo, propias, importadas));
        nodo = __map_poner(nodo, "cuerpo",
            _imp_prefijar(__map_obtener(nodo, "cuerpo"), prefijo, propias, importadas));
        retornar nodo;
    }
    si (tp == "Return") {
        numero vl = __map_obtener(nodo, "valor");
        si (a_texto(__map_obtener(vl, "tipo")) != "Vacio") {
            nodo = __map_poner(nodo, "valor",
                _imp_prefijar(vl, prefijo, propias, importadas));
        }
        retornar nodo;
    }
    si (tp == "VarDecl" || tp == "Assign") {
        numero vl = __map_obtener(nodo, "valor");
        si (a_texto(__map_obtener(vl, "tipo")) != "Vacio") {
            nodo = __map_poner(nodo, "valor",
                _imp_prefijar(vl, prefijo, propias, importadas));
        }
        si (__map_contiene(nodo, "target")) {
            nodo = __map_poner(nodo, "target",
                _imp_prefijar(__map_obtener(nodo, "target"), prefijo, propias, importadas));
        }
        retornar nodo;
    }
    si (tp == "ExprStmt") {
        nodo = __map_poner(nodo, "expr",
            _imp_prefijar(__map_obtener(nodo, "expr"), prefijo, propias, importadas));
        retornar nodo;
    }
    retornar nodo;
}

// Lee un archivo de módulo probando rutas: base/, directa, stdlib/, stdlib/compiler/
funcion texto _imp_leer(texto ruta, texto base) {
    si (__file_exists(base + ruta)) { retornar intentar __leer_archivo(base + ruta); }
    si (__file_exists(ruta)) { retornar intentar __leer_archivo(ruta); }
    texto r2 = "stdlib/" + ruta;
    si (__file_exists(r2)) { retornar intentar __leer_archivo(r2); }
    texto r3 = "stdlib/compiler/" + ruta;
    si (__file_exists(r3)) { retornar intentar __leer_archivo(r3); }
    retornar "Error: no se encontró módulo " + ruta;
}

// ¿ruta en el stack de imports (para evitar ciclos)?
funcion booleano _imp_en_stack(numero stack, texto ruta) {
    numero sc = __map_obtener(stack, "cnt");
    numero j = 0;
    mientras (j < sc) {
        si (__map_contiene(stack, a_texto(j)) &&
            a_texto(__map_obtener(stack, a_texto(j))) == ruta) {
            retornar verdadero;
        }
        j = j + 1;
    }
    retornar falso;
}

// Resuelve los imports de un Programa: carga módulos, fusiona funciones prefijadas
funcion numero _imp_resolver_rec(numero prog, numero stack, texto base) {
    numero stmts = __map_obtener(prog, "cuerpo");
    numero sc = __map_obtener(stmts, "cnt");
    numero nuevos = __map_nuevo();
    numero nc = 0;
    numero j = 0;
    mientras (j < sc) {
        numero nd = __map_obtener(stmts, a_texto(j));
        si (a_texto(__map_obtener(nd, "tipo")) == "Import") {
            texto ruta = a_texto(__map_obtener(nd, "ruta"));
            si (!_imp_en_stack(stack, ruta)) {
                texto contenido = _imp_leer(ruta, base);
                si (!__str_starts_with(contenido, "Error:")) {
                    numero stack2 = __map_poner(stack, a_texto(__map_obtener(stack, "cnt")), ruta);
                    stack2 = __map_poner(stack2, "cnt", __map_obtener(stack, "cnt") + 1);
                    numero mod_ast = _imp_resolver_rec(_imp_parse(lexer_tokenizar(contenido)), stack2, base);
                    numero mod_cuerpo = __map_obtener(mod_ast, "cuerpo");
                    texto prefijo = _imp_prefijo(ruta);
                    numero propias = _imp_funcs(mod_cuerpo, "propias");
                    numero importadas = _imp_funcs(mod_cuerpo, "importadas");
                    numero msc = __map_obtener(mod_cuerpo, "cnt");
                    numero mk = 0;
                    mientras (mk < msc) {
                        numero mnd = __map_obtener(mod_cuerpo, a_texto(mk));
                        si (a_texto(__map_obtener(mnd, "tipo")) != "Vacio") {
                            numero pf = _imp_prefijar(mnd, prefijo, propias, importadas);
                            pf = __map_poner(pf, "imp", "1");
                            nuevos = __map_poner(nuevos, a_texto(nc), pf);
                            nc = nc + 1;
                        }
                        mk = mk + 1;
                    }
                }
            }
        } sino {
            nuevos = __map_poner(nuevos, a_texto(nc), nd);
            nc = nc + 1;
        }
        j = j + 1;
    }
    nuevos = __map_poner(nuevos, "cnt", nc);
    numero nprog = __map_nuevo();
    nprog = __map_poner(nprog, "tipo", "Programa");
    nprog = __map_poner(nprog, "cuerpo", nuevos);
    retornar nprog;
}

funcion numero parser_parse_con_base(numero tokens, texto base) {
    numero st = __map_nuevo();
    st = __map_poner(st, "tokens", tokens);
    st = __map_poner(st, "pos", 0);
    st = __map_poner(st, "cnt", __map_obtener(tokens, "cnt"));
    numero r = _parse_prog(st);
    numero prog = __map_obtener(r, "node");
    numero stack = __map_nuevo();
    stack = __map_poner(stack, "cnt", 0);
    retornar _imp_resolver_rec(prog, stack, base);
}

funcion numero parser_parse(numero tokens) {
    retornar parser_parse_con_base(tokens, "");
}

funcion numero parser_parsear(numero tokens) {
    retornar parser_parse(tokens);
}

// API con directorio base para resolver imports relativos al archivo principal
funcion numero parser_parsear_con_base(numero tokens, texto base) {
    retornar parser_parse_con_base(tokens, base);
}

// ═══════════════════════════════════════════════════════════════
// ── AST Printer ─────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════

funcion texto ast_a_texto(numero nodo, entero prof) {
    texto tp = a_texto(__map_obtener(nodo, "tipo"));
    texto pad = "";
    entero i = 0;
    mientras (i < prof) { pad = pad + "  "; i = i + 1; }

    si (tp == "Programa") {
        texto r = pad + "Programa\n";
        numero stmts = __map_obtener(nodo, "cuerpo");
        numero sc = __map_obtener(stmts, "cnt");
        numero j = 0;
        mientras (j < sc) {
            r = r + ast_a_texto(__map_obtener(stmts, a_texto(j)), prof + 1);
            j = j + 1;
        }
        retornar r;
    }
    si (tp == "VarDecl") {
        texto r = pad + "VarDecl(";
        r = r + a_texto(__map_obtener(nodo, "tipo_var"));
        r = r + " " + a_texto(__map_obtener(nodo, "nombre"));
        numero vl = __map_obtener(nodo, "valor");
        si (a_texto(__map_obtener(vl, "tipo")) != "Vacio") {
            r = r + " = " + ast_a_texto(vl, 0);
        }
        retornar r + ")\n";
    }
    si (tp == "Assign") {
        texto r = pad + "Assign(";
        r = r + a_texto(__map_obtener(nodo, "nombre"));
        r = r + " = " + ast_a_texto(__map_obtener(nodo, "valor"), 0);
        retornar r + ")\n";
    }
    si (tp == "If") {
        texto r = pad + "If\n";
        r = r + pad + "  cond: ";
        r = r + ast_a_texto(__map_obtener(nodo, "cond"), 0);
        r = r + pad + "  cuerpo:\n";
        r = r + ast_a_texto(__map_obtener(nodo, "cuerpo"), prof + 2);
        numero _else = __map_obtener(nodo, "sino");
        si (a_texto(__map_obtener(_else, "tipo")) != "Vacio") {
            r = r + pad + "  sino:\n";
            r = r + ast_a_texto(_else, prof + 2);
        }
        retornar r;
    }
    si (tp == "While") {
        texto r = pad + "While\n";
        r = r + pad + "  cond: ";
        r = r + ast_a_texto(__map_obtener(nodo, "cond"), 0);
        r = r + pad + "  cuerpo:\n";
        r = r + ast_a_texto(__map_obtener(nodo, "cuerpo"), prof + 2);
        retornar r;
    }
    si (tp == "Return") {
        numero vl = __map_obtener(nodo, "valor");
        si (a_texto(__map_obtener(vl, "tipo")) == "Vacio") {
            retornar pad + "Return\n";
        }
        retornar pad + "Return(" + ast_a_texto(vl, 0) + ")\n";
    }
    si (tp == "Func") {
        texto r = pad + "Func(";
        r = r + a_texto(__map_obtener(nodo, "nombre"));
        r = r + " -> " + a_texto(__map_obtener(nodo, "tipo_ret"));
        r = r + ")\n";
        numero prms = __map_obtener(nodo, "params");
        numero pc = __map_obtener(prms, "cnt");
        numero j = 0;
        mientras (j < pc) {
            numero p = __map_obtener(prms, a_texto(j));
            r = r + pad + "  param: ";
            r = r + a_texto(__map_obtener(p, "tipo"));
            r = r + " " + a_texto(__map_obtener(p, "nombre"));
            r = r + "\n";
            j = j + 1;
        }
        r = r + ast_a_texto(__map_obtener(nodo, "cuerpo"), prof + 1);
        retornar r;
    }
    si (tp == "Block") {
        texto r = pad + "Block\n";
        numero stmts = __map_obtener(nodo, "cuerpo");
        numero sc = __map_obtener(stmts, "cnt");
        numero j = 0;
        mientras (j < sc) {
            r = r + ast_a_texto(__map_obtener(stmts, a_texto(j)), prof + 1);
            j = j + 1;
        }
        retornar r;
    }
    si (tp == "Call") {
        texto cl = a_texto(__map_obtener(nodo, "callee"));
        numero args = __map_obtener(nodo, "args");
        numero ac = __map_obtener(args, "cnt");
        texto r = pad + "Call(" + cl;
        numero j = 0;
        mientras (j < ac) {
            r = r + " " + ast_a_texto(__map_obtener(args, a_texto(j)), 0);
            j = j + 1;
        }
        retornar r + ")\n";
    }
    si (tp == "Binary") {
        texto r = pad + "Binary(";
        r = r + ast_a_texto(__map_obtener(nodo, "izq"), 0);
        r = r + " " + a_texto(__map_obtener(nodo, "op")) + " ";
        r = r + ast_a_texto(__map_obtener(nodo, "der"), 0);
        retornar r + ")\n";
    }
    si (tp == "Unary") {
        texto r = pad + "Unary(";
        r = r + a_texto(__map_obtener(nodo, "op"));
        r = r + ast_a_texto(__map_obtener(nodo, "expr"), 0);
        retornar r + ")\n";
    }
    si (tp == "Ident") { retornar a_texto(__map_obtener(nodo, "nombre")); }
    si (tp == "Literal") { retornar a_texto(__map_obtener(nodo, "v")); }
    si (tp == "Texto") {
        retornar "\"" + a_texto(__map_obtener(nodo, "v")) + "\"";
    }
    si (tp == "Bool") { retornar a_texto(__map_obtener(nodo, "v")); }
    si (tp == "ExprStmt") {
        retornar pad + ast_a_texto(__map_obtener(nodo, "expr"), prof);
    }
    si (tp == "Import") {
        retornar pad + "Import(" + a_texto(__map_obtener(nodo, "ruta")) + ")\n";
    }
    si (tp == "Break") { retornar pad + "Break\n"; }
    si (tp == "Continue") { retornar pad + "Continue\n"; }
    si (tp == "Vacio") { retornar ""; }
    retornar pad + tp + "(?)\n";
}

funcion texto ast_to_text(numero nodo, entero prof) {
    retornar ast_a_texto(nodo, prof);
}
