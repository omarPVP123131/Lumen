            numero sv = estado_pila(st, sp);
            sp = sp - 1;
            numero fm = stcs[a_entero(sv - 3000000000)];
            si __map_contiene(fm, fname) {
                st = estado_pila_poner(st, sp + 1, __map_obtener(fm, fname));
            } sino {
                st = estado_pila_poner(st, sp + 1, 0.0);
            }
            sp = sp + 1;
        }
        si op == 37 {
            numero val2 = estado_pila(st, sp);
            sp = sp - 1;
            numero fname2 = estado_pila(st, sp);
            sp = sp - 1;
            numero sv2 = estado_pila(st, sp);
            sp = sp - 1;
            numero fm2 = __map_poner(stcs[a_entero(sv2 - 3000000000)], fname2, val2);
            stcs.agregar(fm2);
            st = estado_pila_poner(st, sp + 1, 3000000000.0 + largo(stcs) - 1);
            sp = sp + 1;
        }
        si op == 38 {
            numero v = estado_pila(st, sp);
            sp = sp - 1;
            numero r = __map_nuevo();
            r = __map_poner(r, "ok", 1.0);
            r = __map_poner(r, "v", v);
            resl.agregar(r);
            st = estado_pila_poner(st, sp + 1, 4000000000.0 + largo(resl) - 1);
            sp = sp + 1;
        }
        si op == 39 {
            numero v = estado_pila(st, sp);
            sp = sp - 1;
            numero r = __map_nuevo();
            r = __map_poner(r, "ok", 0.0);
            r = __map_poner(r, "v", v);
            resl.agregar(r);
            st = estado_pila_poner(st, sp + 1, 4000000000.0 + largo(resl) - 1);
            sp = sp + 1;
        }
        si op == 40 {
            numero rv2 = estado_pila(st, sp);
            sp = sp - 1;
            numero r40 = resl[a_entero(rv2 - 4000000000)];
            si __map_obtener(r40, "ok") == 1 {
                st = estado_pila_poner(st, sp + 1, __map_obtener(r40, "v"));
                sp = sp + 1;
            } sino {
                entero rn = a_entero(__map_obtener(st, "rn")) - 1;
                numero rets = __map_obtener(st, "rets");
                pc = a_entero(__map_obtener(rets, a_texto(rn)));
                rets = __map_poner(rets, a_texto(rn), 0.0);
                entero ns2 = a_entero(__map_obtener(st, "ns")) - 1;
                st = __map_poner(st, "rets", rets);
                st = __map_poner(st, "rn", rn + 0.0);
                st = __map_poner(st, "ns", ns2 + 0.0);
                st = estado_pila_poner(st, sp + 1, rv2);
                sp = sp + 1;
                saltar = 1;
            }
        }
        si op == 41 {
            numero v = estado_pila(st, sp);
            sp = sp - 1;
            numero r = __map_nuevo();
            r = __map_poner(r, "some", 1.0);
            r = __map_poner(r, "v", v);
            opts.agregar(r);
            st = estado_pila_poner(st, sp + 1, 5000000000.0 + largo(opts) - 1);
            sp = sp + 1;
        }
        si op == 42 {
            numero r = __map_nuevo();
            r = __map_poner(r, "some", 0.0);
            r = __map_poner(r, "v", 0.0);
            opts.agregar(r);
            st = estado_pila_poner(st, sp + 1, 5000000000.0 + largo(opts) - 1);
            sp = sp + 1;
        }
        si op == 43 {
            entero cnt3 = a_entero(nums[insn[3*(pc+2) + 3]]);
            lista<numero> eargs = [];
            entero k = 1;
            while k <= cnt3 {
                eargs.agregar(estado_pila(st, sp - cnt3 + k));
                k = k + 1;
            }
            sp = sp - cnt3;
            arrs.agregar(eargs);
            numero enm = __map_nuevo();
            enm = __map_poner(enm, "nm", 1000000000.0 + a);
            enm = __map_poner(enm, "vr", 1000000000.0 + insn[3*(pc+1) + 3]);
            enm = __map_poner(enm, "args", 0.0 - 1000000000.0 - largo(arrs));
            enms.agregar(enm);
            st = estado_pila_poner(st, sp + 1, 7000000000.0 + largo(enms) - 1);
            sp = sp + 1;
        }
        si op == 44 {
            entero n4 = a_entero(nums[a]);
            lista<numero> titems = [];
            entero k = 1;
            while k <= n4 {
                titems.agregar(estado_pila(st, sp - n4 + k));
                k = k + 1;
            }
            sp = sp - n4;
            arrs.agregar(titems);
            st = estado_pila_poner(st, sp + 1, 6000000000.0 + largo(arrs) - 1);
            sp = sp + 1;
        }
        si op == 45 {
            numero ix5 = nums[a];
            numero tv = estado_pila(st, sp);
            sp = sp - 1;
            lista<numero> tl = arrs[a_entero(tv - 6000000000)];
            st = estado_pila_poner(st, sp + 1, tl[a_entero(ix5)]);
            sp = sp + 1;
        }
        si op == 46 {
            numero y = estado_pila(st, sp);
            sp = sp - 1;
            numero x = estado_pila(st, sp);
            entero q = a_entero(x / y);
            st = estado_pila_poner(st, sp, x - q * y);
        }
        si saltar == 0 { pc = pc + 1; }
        }
    }
    retornar 0;
}
