// vm.nv - VM de Lumen en Lumen (Sprint 7)
// Decodifica .nvc y ejecuta opcode a opcode.
// Tipos boxed: v<0 array | 1e9..2e9 string | 2e9..3e9 mapa | 3e9..4e9 struct
//             4e9..5e9 resultado | 5e9..6e9 opcion | 6e9..7e9 tupla
//             7e9..8e9 enum | 8e9..9e9 funcion

lista<texto> stl = [];
lista<texto> stl_din = [];
lista<lista<numero>> arrs = [];
lista<numero> mapas = [];
lista<numero> stcs = [];
lista<numero> resl = [];
lista<numero> opts = [];
lista<numero> enms = [];
lista<texto> fncs = [];
entero coro_n = 0;
entero tarea_n = 0;
numero tareas_mapa = __map_nuevo();
entero coro_actual = -1;
numero coro_st_guard = 0.0;
entero coro_sp_guard = 0;
entero coro_pc_guard = 0;
numero coros_idx_mapa = __map_nuevo();
numero coro_nombres_m = __map_nuevo();
numero coro_fidx_m = __map_nuevo();
numero coro_pcs_m = __map_nuevo();
numero coro_stats_m = __map_nuevo();
numero coro_sps_m = __map_nuevo();
numero coro_done_m = __map_nuevo();
numero coro_inic_m = __map_nuevo();

funcion entero leer_u32(lista<entero> b, entero pos) {
    entero r = 0;
    entero i = 0;
    while i < 4 {
        r = r * 256 + b[pos + 3 - i];
        i = i + 1;
    }
    retornar r;
}

funcion entero leer_u64(lista<entero> b, entero pos) {
    entero r = 0;
    entero i = 0;
    while i < 8 {
        r = r * 256 + b[pos + 7 - i];
        i = i + 1;
    }
    retornar r;
}

funcion texto deco_texto(lista<entero> b, entero pos, entero n) {
    lista<entero> bytes = [];
    entero i = 0;
    while i < n {
        bytes.agregar(b[pos + i]);
        i = i + 1;
    }
    retornar __desde_utf8(bytes);
}

funcion numero leer_float(lista<entero> b, entero pos) {
    lista<entero> parte = [];
    entero i = 0;
    while i < 8 {
        parte.agregar(b[pos + i]);
        i = i + 1;
    }
    retornar __bytes_a_f64(parte);
}

funcion entero a_entero(numero f) {
    retornar __str_a_entero(a_texto(f));
}

funcion numero estado_pila(numero st, entero i) {
    retornar __map_obtener(__map_obtener(st, "pila"), a_texto(i));
}

funcion numero estado_pila_poner(numero st, entero i, numero v) {
    retornar __map_poner(st, "pila", __map_poner(__map_obtener(st, "pila"), a_texto(i), v));
}

funcion numero estado_mem(numero st, texto k) {
    numero scopes = __map_obtener(st, "scopes");
    entero ns = a_entero(__map_obtener(st, "ns"));
    entero ci = ns;
    while ci > 0 {
        numero m = __map_obtener(scopes, a_texto(ci));
        si __map_contiene(m, k) { retornar __map_obtener(m, k); }
        ci = ci - 1;
    }
    retornar __map_obtener(__map_obtener(st, "mem"), k);
}

funcion numero estado_mem_poner(numero st, texto k, numero v) {
    entero ns = a_entero(__map_obtener(st, "ns"));
    si ns == 0 {
        retornar __map_poner(st, "mem", __map_poner(__map_obtener(st, "mem"), k, v));
    } sino {
        numero scopes = __map_obtener(st, "scopes");
        numero top = __map_obtener(scopes, a_texto(ns));
        numero nuevo = __map_poner(top, k, v);
        numero sc2 = __map_poner(scopes, a_texto(ns), nuevo);
        retornar __map_poner(st, "scopes", sc2);
    }
}

funcion texto str_at(lista<texto> stl, lista<texto> stl_din, entero idx) {
    si idx < largo(stl) { retornar stl[idx]; }
    retornar stl_din[idx - largo(stl)];
}

funcion numero es_verdad(numero v) {
    si v == 0 { retornar 0.0; }
    si v >= 9000000000 { retornar v - 9000000000; }
    si v < -999999999 {
        si largo(arrs[a_entero(0.0 - v - 1000000000.0) - 1]) > 0 { retornar 1.0; }
    }
    si v >= 1000000000 {
        si v < 2000000000 {
            si a_entero(v - 1000000000) < largo(stl) + largo(stl_din) {
                si largo(str_at(stl, stl_din, a_entero(v - 1000000000))) > 0 { retornar 1.0; }
                retornar 0.0;
            }
            retornar 1.0;
        }
        si v < 3000000000 {
            si __map_longitud(mapas[a_entero(v - 2000000000)]) > 0 { retornar 1.0; }
            retornar 0.0;
        }
        si v < 6000000000 {
            si v < 5000000000 { retornar 1.0; }
            si __map_obtener(opts[a_entero(v - 5000000000)], "some") == 1 { retornar 1.0; }
            retornar 0.0;
        }
        retornar 1.0;
    }
    retornar 1.0;
}

funcion texto a_texto_v(numero v) {
    si v >= 9000000000 {
        si v == 9000000001 { retornar "true"; }
        retornar "false";
    }
    si v < -999999999 {
        si 0.0 - v - 1000000000.0 - 1 >= largo(arrs) { retornar a_texto(a_entero(v)); }
        lista<numero> arr = arrs[a_entero(0.0 - v - 1000000000.0) - 1];
        texto s2 = "[";
        entero k = 0;
        while k < largo(arr) {
            si k > 0 { s2 = s2 + ", "; }
            s2 = s2 + a_texto_v(arr[k]);
            k = k + 1;
        }
        retornar s2 + "]";
    }
    si v >= 1000000000 {
        si v < 2000000000 {
        si a_entero(v - 1000000000) >= largo(stl) + largo(stl_din) { retornar a_texto(a_entero(v)); }
        retornar str_at(stl, stl_din, a_entero(v - 1000000000));
    }
        si v < 3000000000 {
            si a_entero(v - 2000000000) >= largo(mapas) { retornar a_texto(a_entero(v)); }
            numero m = mapas[a_entero(v - 2000000000)];
            lista<numero> claves = __map_claves(m);
            texto s3 = "{";
            entero k2 = 0;
            while k2 < largo(claves) {
                si k2 > 0 { s3 = s3 + ", "; }
                s3 = s3 + a_texto_v(claves[k2]) + ": " + a_texto_v(__map_obtener(m, claves[k2]));
                k2 = k2 + 1;
            }
            retornar s3 + " }";
        }
        si v < 4000000000 {
            numero s4 = stcs[a_entero(v - 3000000000)];
            lista<numero> claves4 = __map_claves(s4);
            texto s5 = "{ ";
            entero k3 = 0;
            while k3 < largo(claves4) {
                si k3 > 0 { s5 = s5 + ", "; }
                s5 = s5 + a_texto_v(claves4[k3]) + ": " + a_texto_v(__map_obtener(s4, claves4[k3]));
                k3 = k3 + 1;
            }
            retornar s5 + " }";
        }
        si v < 5000000000 {
            numero r5 = resl[a_entero(v - 4000000000)];
            si __map_obtener(r5, "ok") == 1 {
                retornar "exito(" + a_texto_v(__map_obtener(r5, "v")) + ")";
            }
            retornar "error(" + a_texto_v(__map_obtener(r5, "v")) + ")";
        }
        si v < 6000000000 {
            numero r6 = opts[a_entero(v - 5000000000)];
            si __map_obtener(r6, "some") == 1 {
                retornar "algun(" + a_texto_v(__map_obtener(r6, "v")) + ")";
            }
            retornar "ninguno";
        }
        si v < 7000000000 {
            lista<numero> tp = arrs[a_entero(v - 6000000000)];
            texto s7 = "(";
            entero k4 = 0;
            while k4 < largo(tp) {
                si k4 > 0 { s7 = s7 + ", "; }
                s7 = s7 + a_texto_v(tp[k4]);
                k4 = k4 + 1;
            }
            retornar s7 + ")";
        }
        si v < 8000000000 {
            numero enm = enms[a_entero(v - 7000000000)];
            texto s8 = a_texto_v(__map_obtener(enm, "nm")) + "::" + a_texto_v(__map_obtener(enm, "vr"));
            lista<numero> args8 = arrs[a_entero(0.0 - __map_obtener(enm, "args") - 1000000000.0) - 1];
            si largo(args8) > 0 {
                s8 = s8 + "(";
                entero k5 = 0;
                while k5 < largo(args8) {
                    si k5 > 0 { s8 = s8 + ", "; }
                    s8 = s8 + a_texto_v(args8[k5]);
                    k5 = k5 + 1;
                }
                s8 = s8 + ")";
            }
            retornar s8;
        }
        retornar "<funcion " + fncs[a_entero(v - 8000000000)] + ">";
    }
    retornar a_texto(v);
}

funcion numero ig_listas(lista<numero> lx, lista<numero> ly) {
    si largo(lx) != largo(ly) { retornar 0.0; }
    entero k = 0;
    while k < largo(lx) {
        si ig_v(lx[k], ly[k]) == 0 { retornar 0.0; }
        k = k + 1;
    }
    retornar 1.0;
}

funcion numero ig_maps(numero mx, numero my) {
    lista<numero> claves = __map_claves(mx);
    si largo(claves) != largo(__map_claves(my)) { retornar 0.0; }
    entero kk = 0;
    while kk < largo(claves) {
        si !__map_contiene(my, claves[kk]) { retornar 0.0; }
        si ig_v(__map_obtener(mx, claves[kk]), __map_obtener(my, claves[kk])) == 0 { retornar 0.0; }
        kk = kk + 1;
    }
    retornar 1.0;
}

funcion numero box_str(texto s) {
    stl_din.agregar(s);
    retornar 1000000000.0 + largo(stl) + largo(stl_din) - 1;
}

funcion numero ig_v(numero x, numero y) {
    si x == y { retornar 1.0; }
    si x < -999999999 && y < -999999999 {
        retornar ig_listas(arrs[a_entero(0.0 - x - 1000000000.0) - 1], arrs[a_entero(0.0 - y - 1000000000.0) - 1]);
    }
    si x >= 1000000000 && y >= 1000000000 {
        si x < 2000000000 && y < 2000000000
            && a_entero(x - 1000000000) < largo(stl) + largo(stl_din)
            && a_entero(y - 1000000000) < largo(stl) + largo(stl_din) {
            si str_at(stl, stl_din, a_entero(x - 1000000000)) == str_at(stl, stl_din, a_entero(y - 1000000000)) {
                retornar 1.0;
            }
            retornar 0.0;
        }
        si x >= 2000000000 && x < 3000000000 && y >= 2000000000 && y < 3000000000 {
            retornar ig_maps(mapas[a_entero(x - 2000000000)], mapas[a_entero(y - 2000000000)]);
        }
        si x >= 3000000000 && x < 4000000000 && y >= 3000000000 && y < 4000000000 {
            retornar ig_maps(stcs[a_entero(x - 3000000000)], stcs[a_entero(y - 3000000000)]);
        }
        si x >= 4000000000 && x < 5000000000 && y >= 4000000000 && y < 5000000000 {
            numero rx = resl[a_entero(x - 4000000000)];
            numero ry = resl[a_entero(y - 4000000000)];
            si __map_obtener(rx, "ok") == __map_obtener(ry, "ok") {
                retornar ig_v(__map_obtener(rx, "v"), __map_obtener(ry, "v"));
            }
            retornar 0.0;
        }
        si x >= 5000000000 && x < 6000000000 && y >= 5000000000 && y < 6000000000 {
            numero ox = opts[a_entero(x - 5000000000)];
            numero oy = opts[a_entero(y - 5000000000)];
            si __map_obtener(ox, "some") == __map_obtener(oy, "some") {
                retornar ig_v(__map_obtener(ox, "v"), __map_obtener(oy, "v"));
            }
            retornar 0.0;
        }
        si x >= 6000000000 && x < 7000000000 && y >= 6000000000 && y < 7000000000 {
            retornar ig_listas(arrs[a_entero(x - 6000000000)], arrs[a_entero(y - 6000000000)]);
        }
        si x >= 7000000000 && x < 8000000000 && y >= 7000000000 && y < 8000000000 {
            numero ex = enms[a_entero(x - 7000000000)];
            numero ey = enms[a_entero(y - 7000000000)];
            si a_texto_v(__map_obtener(ex, "nm")) == a_texto_v(__map_obtener(ey, "nm")) {
                si a_texto_v(__map_obtener(ex, "vr")) == a_texto_v(__map_obtener(ey, "vr")) {
                    retornar ig_v(__map_obtener(ex, "args"), __map_obtener(ey, "args"));
                }
            }
            retornar 0.0;
        }
    }
    retornar 0.0;
}

funcion numero val_num(numero x) {
    si x >= 1000000000 { retornar 1000000000000000000.0; }
    retornar x;
}

funcion numero bin(numero st, entero sp, entero argc, texto nm) {
    si nm == "largo" {
        numero v = estado_pila(st, sp);
        si v < -999999999 {
            retornar largo(arrs[a_entero(0.0 - v - 1000000000.0) - 1]) + 0.0;
        }
        retornar largo(__str_a_caracteres(str_at(stl, stl_din, a_entero(v - 1000000000)))) + 0.0;
    }
    si nm == "a_texto" || nm == "to_texto" || nm == "__str_from" {
        numero v = estado_pila(st, sp);
        stl_din.agregar(a_texto_v(v));
        retornar 1000000000.0 + largo(stl) + largo(stl_din) - 1;
    }
    si nm == "leer" || nm == "read" {
        stl_din.agregar("");
        retornar 1000000000.0 + largo(stl) + largo(stl_din) - 1;
    }
    si nm == "__str_len" || nm == "__str_longitud" {
        numero v = estado_pila(st, sp);
        retornar largo(__str_a_caracteres(str_at(stl, stl_din, a_entero(v - 1000000000)))) + 0.0;
    }
    si nm == "__str_upper" || nm == "__str_mayusculas" {
        numero v = estado_pila(st, sp);
        texto s = str_at(stl, stl_din, a_entero(v - 1000000000));
        lista<texto> cs = __str_a_caracteres(s);
        lista<texto> cs2 = [];
        entero k = 0;
        while k < largo(cs) {
            lista<entero> cc = __str_codigo(cs[k]);
            entero code = cc[0];
            si code >= 97 && code <= 122 { code = code - 32; }
            cs2.agregar(__str_caracter(code));
            k = k + 1;
        }
        stl_din.agregar(__str_concat_list(cs2));
        retornar 1000000000.0 + largo(stl) + largo(stl_din) - 1;
    }
    si nm == "__str_lower" || nm == "__str_minusculas" {
        numero v = estado_pila(st, sp);
        texto s = str_at(stl, stl_din, a_entero(v - 1000000000));
        lista<texto> cs = __str_a_caracteres(s);
        lista<texto> cs2 = [];
        entero k = 0;
        while k < largo(cs) {
            lista<entero> cc = __str_codigo(cs[k]);
            entero code = cc[0];
            si code >= 65 && code <= 90 { code = code + 32; }
            cs2.agregar(__str_caracter(code));
            k = k + 1;
        }
        stl_din.agregar(__str_concat_list(cs2));
        retornar 1000000000.0 + largo(stl) + largo(stl_din) - 1;
    }
    si nm == "__str_trim" || nm == "__str_recortar" {
        numero v = estado_pila(st, sp);
        texto s = str_at(stl, stl_din, a_entero(v - 1000000000));
        lista<texto> cs = __str_a_caracteres(s);
        entero st_i = 0;
        entero en_i = largo(cs) - 1;
        entero trimando = 1;
        while trimando == 1 && st_i <= en_i {
            lista<entero> cc = __str_codigo(cs[st_i]);
            si cc[0] == 32 || cc[0] == 9 || cc[0] == 13 || cc[0] == 10 { st_i = st_i + 1; } sino { trimando = 0; }
        }
        trimando = 1;
        while trimando == 1 && en_i >= st_i {
            lista<entero> cc2 = __str_codigo(cs[en_i]);
            si cc2[0] == 32 || cc2[0] == 9 || cc2[0] == 13 || cc2[0] == 10 { en_i = en_i - 1; } sino { trimando = 0; }
        }
        texto out = "";
        entero k = st_i;
        while k <= en_i {
            out = out + cs[k];
            k = k + 1;
        }
        stl_din.agregar(out);
        retornar 1000000000.0 + largo(stl) + largo(stl_din) - 1;
    }
    si nm == "__str_contains" || nm == "__str_contiene" {
        texto s = str_at(stl, stl_din, a_entero(estado_pila(st, sp - 1) - 1000000000));
        texto sub = str_at(stl, stl_din, a_entero(estado_pila(st, sp) - 1000000000));
        lista<texto> cs = __str_a_caracteres(s);
        lista<texto> csub = __str_a_caracteres(sub);
        si largo(csub) > largo(cs) { retornar 9000000000.0; }
        si largo(csub) == 0 { retornar 9000000001.0; }
        entero k = 0;
        while k <= largo(cs) - largo(csub) {
            entero coincide = 1;
            entero j = 0;
            while j < largo(csub) {
                si cs[k + j] != csub[j] { coincide = 0; }
                j = j + 1;
            }
            si coincide == 1 { retornar 9000000001.0; }
            k = k + 1;
        }
        retornar 9000000000.0;
    }
    si nm == "__str_starts_with" || nm == "__str_empieza_con" {
        texto s = str_at(stl, stl_din, a_entero(estado_pila(st, sp - 1) - 1000000000));
        texto sub = str_at(stl, stl_din, a_entero(estado_pila(st, sp) - 1000000000));
        lista<texto> cs = __str_a_caracteres(s);
        lista<texto> csub = __str_a_caracteres(sub);
        si largo(csub) > largo(cs) { retornar 9000000000.0; }
        entero k = 0;
        while k < largo(csub) {
            si cs[k] != csub[k] { retornar 9000000000.0; }
            k = k + 1;
        }
        retornar 9000000001.0;
    }
    si nm == "__str_split" || nm == "__str_dividir" {
        texto s = str_at(stl, stl_din, a_entero(estado_pila(st, sp - 1) - 1000000000));
        texto d = str_at(stl, stl_din, a_entero(estado_pila(st, sp) - 1000000000));
        lista<texto> cd = __str_a_caracteres(d);
        si largo(cd) == 0 {
            lista<numero> cs0 = [];
            texto s0 = str_at(stl, stl_din, a_entero(estado_pila(st, sp - 1) - 1000000000));
            lista<texto> chs0 = __str_a_caracteres(s0);
            entero k0 = 0;
            while k0 < largo(chs0) {
                stl_din.agregar(chs0[k0]);
                cs0.agregar(1000000000.0 + largo(stl) + largo(stl_din) - 1);
                k0 = k0 + 1;
            }
            arrs.agregar(cs0);
            retornar 0.0 - 1000000000.0 - largo(arrs);
        }
        lista<texto> cs = __str_a_caracteres(s);
        lista<numero> partes = [];
        texto cur = "";
        entero k = 0;
        while k < largo(cs) {
            entero coincide = 1;
            entero j = 0;
            while j < largo(cd) {
                si k + j >= largo(cs) { coincide = 0; }
                sino { si cs[k + j] != cd[j] { coincide = 0; } }
                j = j + 1;
            }
            si coincide == 1 {
                stl_din.agregar(cur);
                partes.agregar(1000000000.0 + largo(stl) + largo(stl_din) - 1);
                cur = "";
                k = k + largo(cd);
            } sino {
                cur = cur + cs[k];
                k = k + 1;
            }
        }
        stl_din.agregar(cur);
        partes.agregar(1000000000.0 + largo(stl) + largo(stl_din) - 1);
        arrs.agregar(partes);
        retornar 0.0 - 1000000000.0 - largo(arrs);
    }
    si nm == "__str_ord" || nm == "__str_codigo" {
        numero v = estado_pila(st, sp);
        lista<entero> codes = __str_codigo(str_at(stl, stl_din, a_entero(v - 1000000000)));
        lista<numero> codes2 = [];
        entero k = 0;
        while k < largo(codes) {
            codes2.agregar(codes[k] + 0.0);
            k = k + 1;
        }
        arrs.agregar(codes2);
        retornar 0.0 - 1000000000.0 - largo(arrs);
    }
    si nm == "__str_chr" || nm == "__str_caracter" {
        numero v = estado_pila(st, sp);
        stl_din.agregar(__str_caracter(a_entero(v)));
        retornar 1000000000.0 + largo(stl) + largo(stl_din) - 1;
    }
    si nm == "__str_slice" || nm == "__str_subcadena" {
        texto s = str_at(stl, stl_din, a_entero(estado_pila(st, sp - 2) - 1000000000));
        lista<texto> cs = __str_a_caracteres(s);
        entero ns = largo(cs);
        entero st3 = a_entero(estado_pila(st, sp - 1));
        si st3 < 0 { st3 = ns; }
        si st3 > ns { st3 = ns; }
        entero en3 = a_entero(estado_pila(st, sp));
        si en3 < 0 { en3 = ns; }
        si en3 > ns { en3 = ns; }
        si en3 < st3 { en3 = st3; }
        texto out = "";
        entero k = st3;
        while k < en3 {
            out = out + cs[k];
            k = k + 1;
        }
        stl_din.agregar(out);
        retornar 1000000000.0 + largo(stl) + largo(stl_din) - 1;
    }
    si nm == "__str_subcadena_chars" || nm == "__str_slice_chars" {
        lista<texto> cs = __str_a_caracteres(str_at(stl, stl_din, a_entero(estado_pila(st, sp - 2) - 1000000000)));
        entero ns = largo(cs);
        entero st3 = a_entero(estado_pila(st, sp - 1));
        si st3 < 0 { st3 = 0; }
        si st3 > ns { st3 = ns; }
