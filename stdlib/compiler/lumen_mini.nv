// lumen_mini.nv — Compilador LUMEN funcional 
// Basado en test_simple_lexer.nv que funciona

// ═══ LEXER (funcionando) ═══════════════════════════════════
funcion numero lx(texto s) {
    lista<entero> codes = __str_ord(s);
    entero n = largo(codes);
    entero idx = 0;
    numero tk = __map_nuevo();
    entero cnt = 0;
    
    mientras idx < n {
        entero cp = codes[idx];
        si cp == 32 || cp == 9 { idx = idx + 1; continuar; }
        si cp == 10 { idx = idx + 1; continuar; }
        si cp == 13 { idx = idx + 1; continuar; }
        si cp == 47 && idx + 1 < n {
            si codes[idx + 1] == 47 {
                mientras idx < n && codes[idx] != 10 { idx = idx + 1; }
                continuar;
            }
            si codes[idx + 1] == 42 {
                idx = idx + 2;
                mientras idx + 1 < n {
                    si codes[idx] == 42 && codes[idx + 1] == 47 { idx = idx + 2; romper; }
                    idx = idx + 1;
                }
                continuar;
            }
        }
        si cp == 34 {
            texto st = ""; idx = idx + 1;
            mientras idx < n && codes[idx] != 34 { st = st + a_texto(codes[idx]); idx = idx + 1; }
            si idx < n { idx = idx + 1; }
            numero t = __map_nuevo();
            t = __map_poner(t, "t", 3); t = __map_poner(t, "v", st);
            tk = __map_poner(tk, a_texto(cnt), t); cnt = cnt + 1;
            continuar;
        }
        si cp >= 48 && cp <= 57 {
            texto num = "";
            mientras idx < n && codes[idx] >= 48 && codes[idx] <= 57 { num = num + a_texto(codes[idx]); idx = idx + 1; }
            numero t = __map_nuevo();
            t = __map_poner(t, "t", 2); t = __map_poner(t, "v", num);
            tk = __map_poner(tk, a_texto(cnt), t); cnt = cnt + 1;
            continuar;
        }
        si (cp >= 65 && cp <= 90) || (cp >= 97 && cp <= 122) || cp == 95 {
            texto id = "";
            mientras idx < n {
                entero c2 = codes[idx];
                si (c2 >= 65 && c2 <= 90) || (c2 >= 97 && c2 <= 122) || c2 == 95 || (c2 >= 48 && c2 <= 57) {
                    id = id + a_texto(c2); idx = idx + 1;
                } sino {
                    romper;
                }
            }
            numero t = __map_nuevo();
            t = __map_poner(t, "t", 1); t = __map_poner(t, "v", id);
            tk = __map_poner(tk, a_texto(cnt), t); cnt = cnt + 1;
            continuar;
        }
        texto op = a_texto(cp);
        numero t = __map_nuevo();
        t = __map_poner(t, "t", 4); t = __map_poner(t, "v", op);
        tk = __map_poner(tk, a_texto(cnt), t); cnt = cnt + 1; idx = idx + 1;
    }
    numero t = __map_nuevo();
    t = __map_poner(t, "t", 99); t = __map_poner(t, "v", "");
    tk = __map_poner(tk, a_texto(cnt), t);
    tk = __map_poner(tk, "cnt", cnt + 1);
    retornar tk;
}

// ═══ CODEGEN DIRECTO ══════════════════════════════════════
funcion numero cg(numero tk) {
    numero bc = __map_nuevo();
    bc = __map_poner(bc, "st", __map_nuevo());
    bc = __map_poner(bc, "sc", 0);
    bc = __map_poner(bc, "op", __map_nuevo());
    bc = __map_poner(bc, "pc", 0);
    
    entero pos = 0;
    entero total = __map_obtener(tk, "cnt");
    
    mientras pos < total {
        numero t1 = __map_obtener(tk, a_texto(pos));
        texto v1 = __map_obtener(t1, "v");
        entero tp1 = __map_obtener(t1, "t");
        
        // VarDecl: tipo nombre = valor;
        si tp1 == 1 {
            si v1 == "entero" || v1 == "texto" || v1 == "decimal" || v1 == "booleano" || v1 == "numero" {
                si pos + 5 < total {
                    numero t2 = __map_obtener(tk, a_texto(pos + 1));
                    texto v2 = __map_obtener(t2, "v");
                    numero t3 = __map_obtener(tk, a_texto(pos + 2));
                    texto v3 = __map_obtener(t3, "v");
                    numero t5 = __map_obtener(tk, a_texto(pos + 4));
                    texto v5 = __map_obtener(t5, "v");
                    si v3 == "=" {
                        // Store value string in strings table
                        numero st = __map_obtener(bc, "st");
                        entero sc = __map_obtener(bc, "sc");
                        st = __map_poner(st, a_texto(sc), v5);
                        entero vi = sc;
                        sc = sc + 1;
                        st = __map_poner(st, a_texto(sc), v2);
                        entero ni = sc;
                        sc = sc + 1;
                        bc = __map_poner(bc, "st", st);
                        bc = __map_poner(bc, "sc", sc);
                        
                        // Emit: PUSH(vi), STORE(ni)
                        numero op = __map_obtener(bc, "op");
                        entero pc = __map_obtener(bc, "pc");
                        op = __map_poner(op, a_texto(pc), vi);
                        pc = pc + 1;
                        op = __map_poner(op, a_texto(pc), ni + 100);
                        pc = pc + 1;
                        bc = __map_poner(bc, "op", op);
                        bc = __map_poner(bc, "pc", pc);
                        pos = pos + 6; continuar;
                    }
                }
            }
        }
        
        // Call: imprimir(arg)
        si v1 == "imprimir" || v1 == "print" {
            si pos + 4 < total {
                numero t3 = __map_obtener(tk, a_texto(pos + 2));
                texto v3 = __map_obtener(t3, "v");
                // Store arg name in strings table
                numero st = __map_obtener(bc, "st");
                entero sc = __map_obtener(bc, "sc");
                st = __map_poner(st, a_texto(sc), v3);
                bc = __map_poner(bc, "st", st);
                bc = __map_poner(bc, "sc", sc + 1);
                
                // Emit: LOAD(sc), PRINT
                numero op = __map_obtener(bc, "op");
                entero pc = __map_obtener(bc, "pc");
                op = __map_poner(op, a_texto(pc), sc);
                pc = pc + 1;
                op = __map_poner(op, a_texto(pc), 999);
                pc = pc + 1;
                bc = __map_poner(bc, "op", op);
                bc = __map_poner(bc, "pc", pc);
            }
            pos = pos + 5; continuar;
        }
        
        pos = pos + 1;
    }
    
    // HALT
    numero op = __map_obtener(bc, "op");
    entero pc = __map_obtener(bc, "pc");
    op = __map_poner(op, a_texto(pc), 888);
    bc = __map_poner(bc, "op", op);
    bc = __map_poner(bc, "pc", pc + 1);
    retornar bc;
}

funcion texto _op(entero v) {
    si v == 888 { retornar "HALT"; }
    si v == 999 { retornar "PRINT"; }
    si v >= 100 { retornar "STORE(" + a_texto(v - 100) + ")"; }
    retornar "PUSH(" + a_texto(v) + ")";
}

// ═══ MAIN ═══════════════════════════════════════════════════
imprimir("=== LUMEN Self-Compiler ===");
imprimir("Source: entero x = 42; imprimir(x);");

numero tk = lx("entero x = 42; imprimir(x);");
imprimir("Lexer: ", __map_obtener(tk, "cnt"), " tokens");

numero bc = cg(tk);
entero pc = __map_obtener(bc, "pc");
imprimir("Bytecode: ", pc, " instructions");
numero op = __map_obtener(bc, "op");
entero i = 0;
mientras i < pc {
    entero v = __map_obtener(op, a_texto(i));
    imprimir("  ", i, ": ", _op(v));
    i = i + 1;
}

imprimir("=== DONE ===");
