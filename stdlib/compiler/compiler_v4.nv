// compiler_v4.nv - Compilador autocontenido (self-hosting)
// Generado: concatenación de lexer.nv + parser.nv + codegen.nv + main
// Sin imports - el parser LÚMEN puede compilarlo completo
// stdlib/compiler/lexer.nv — Lexer LUMEN
// Tokeniza texto fuente → tokens como mapa {t, v, linea, col}
// Token types: 1=Ident, 2=Numero, 3=String, 4=Oper, 5=Punt, 6=Kw, 99=EOF

funcion booleano _lx_es_ident(texto c) { retornar (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || c == "_"; }
funcion booleano _lx_es_digit(texto c) { retornar c >= "0" && c <= "9"; }
funcion booleano _lx_es_punct(texto c) { retornar c == ";" || c == "(" || c == ")" || c == "{" || c == "}" || c == "," || c == "." || c == "[" || c == "]" || c == ":"; }

funcion numero lexer_tokenizar(texto s) {
    numero kw = __map_nuevo();
    kw = __map_poner(kw, "si", 1); kw = __map_poner(kw, "if", 1);
    kw = __map_poner(kw, "sino", 1); kw = __map_poner(kw, "else", 1);
    kw = __map_poner(kw, "mientras", 1); kw = __map_poner(kw, "while", 1);
    kw = __map_poner(kw, "para", 1); kw = __map_poner(kw, "for", 1);
    kw = __map_poner(kw, "funcion", 1); kw = __map_poner(kw, "function", 1);
    kw = __map_poner(kw, "retornar", 1); kw = __map_poner(kw, "return", 1);
    kw = __map_poner(kw, "entero", 1); kw = __map_poner(kw, "texto", 1);
    kw = __map_poner(kw, "numero", 1); kw = __map_poner(kw, "booleano", 1);
    kw = __map_poner(kw, "decimal", 1); kw = __map_poner(kw, "lista", 1);
    kw = __map_poner(kw, "diccionario", 1); kw = __map_poner(kw, "void", 1);
    kw = __map_poner(kw, "importar", 1); kw = __map_poner(kw, "romper", 1);
    kw = __map_poner(kw, "continuar", 1); kw = __map_poner(kw, "verdadero", 1);
    kw = __map_poner(kw, "falso", 1); kw = __map_poner(kw, "imprimir", 1);
    kw = __map_poner(kw, "intentar", 1); kw = __map_poner(kw, "try", 1);
    kw = __map_poner(kw, "exito", 1); kw = __map_poner(kw, "error", 1);
    kw = __map_poner(kw, "const", 1); kw = __map_poner(kw, "true", 1); kw = __map_poner(kw, "false", 1);
    kw = __map_poner(kw, "estructura", 1); kw = __map_poner(kw, "struct", 1);
    kw = __map_poner(kw, "enum", 1); kw = __map_poner(kw, "elegir", 1);
    kw = __map_poner(kw, "opcion", 1); kw = __map_poner(kw, "resultado", 1);
    kw = __map_poner(kw, "sea", 1); kw = __map_poner(kw, "let", 1);
    kw = __map_poner(kw, "en", 1); kw = __map_poner(kw, "in", 1);
    kw = __map_poner(kw, "algun", 1); kw = __map_poner(kw, "some", 1);
    kw = __map_poner(kw, "ninguno", 1); kw = __map_poner(kw, "none", 1);
    
    // Normalize CRLF to LF and remove stray CR to avoid off-by-one tokenization
    texto s2 = __str_reemplazar(s, "\r\n", "\n");
    s2 = __str_reemplazar(s2, "\r", "");
    lista<texto> chars = __str_a_caracteres(s2);
    numero tk = __map_nuevo();
    entero cnt = 0;
    entero i = 0; entero n = largo(chars); entero ln = 1; entero cl = 1;
    
    mientras i < n {
        texto c = chars[i];
        si c == " " || c == "\t" { i = i + 1; cl = cl + 1; continuar; }
        si c == "\n" { i = i + 1; ln = ln + 1; cl = 1; continuar; }
        si c == "\r" { i = i + 1; continuar; }
        
        si _lx_es_ident(c) {
            entero st = i;
            mientras i < n && _lx_es_ident_o_digito(chars[i]) { i = i + 1; }
            texto id = sub_from_chars(chars, st, i);
            entero adv = i - st;
            numero tp = 1;
            numero kk = __map_obtener(kw, id);
            si __tipo_de(kk) == "entero" { tp = 6; }
            numero t = __map_nuevo();
            t = __map_poner(t, "t", tp); t = __map_poner(t, "v", id);
            t = __map_poner(t, "linea", ln); t = __map_poner(t, "col", cl);
            tk = __map_poner(tk, a_texto(cnt), t); cnt = cnt + 1;
            cl = cl + adv; continuar;
        }
        
        si _lx_es_digit(c) {
            entero st = i;
            mientras i < n && (_lx_es_digit(chars[i]) || chars[i] == ".") { i = i + 1; }
            texto num = sub_from_chars(chars, st, i);
            entero adv = i - st;
            numero t = __map_nuevo();
            t = __map_poner(t, "t", 2); t = __map_poner(t, "v", num);
            t = __map_poner(t, "linea", ln); t = __map_poner(t, "col", cl);
            tk = __map_poner(tk, a_texto(cnt), t); cnt = cnt + 1;
            cl = cl + adv; continuar;
        }
        
        si _lx_es_punct(c) {
            numero t = __map_nuevo();
            t = __map_poner(t, "t", 5); t = __map_poner(t, "v", c);
            t = __map_poner(t, "linea", ln); t = __map_poner(t, "col", cl);
            tk = __map_poner(tk, a_texto(cnt), t); cnt = cnt + 1;
            i = i + 1; cl = cl + 1; continuar;
        }
        
        // Line comment: skip until end of line
        si c == "/" && i + 1 < n && chars[i + 1] == "/" {
            mientras i < n && chars[i] != "\n" { i = i + 1; }
            continuar;
        }
        // Block comment: skip */
        si c == "/" && i + 1 < n && chars[i + 1] == "*" {
            i = i + 2;
            mientras i + 1 < n && !(chars[i] == "*" && chars[i + 1] == "/") { i = i + 1; }
            si i + 1 < n { i = i + 2; }
            continuar;
        }
        
        si c == "\"" {
            i = i + 1; cl = cl + 1;
            texto sb = "";
            mientras i < n && chars[i] != "\"" {
                si chars[i] == "\\" && i + 1 < n {
                    texto nxt = chars[i + 1];
                    si nxt == "n" { sb = sb + "\n"; }
                    sino si nxt == "t" { sb = sb + "\t"; }
                    sino si nxt == "r" { sb = sb + "\r"; }
                    sino si nxt == "\"" { sb = sb + "\""; }
                    sino si nxt == "\\" { sb = sb + "\\"; }
                    sino { sb = sb + nxt; }
                    i = i + 2; cl = cl + 2;
                } sino {
                    sb = sb + chars[i];
                    i = i + 1; cl = cl + 1;
                }
            }
            si i < n { i = i + 1; cl = cl + 1; }
            numero t = __map_nuevo();
            t = __map_poner(t, "t", 3); t = __map_poner(t, "v", sb);
            t = __map_poner(t, "linea", ln); t = __map_poner(t, "col", cl);
            tk = __map_poner(tk, a_texto(cnt), t); cnt = cnt + 1;
            continuar;
        }
        
        // Multi-character operators (|| && == != <= >=)
        si i + 1 < n {
            texto op2 = c + chars[i + 1];
            si op2 == "||" || op2 == "&&" || op2 == "==" || op2 == "!=" || op2 == "<=" || op2 == ">=" {
                numero t = __map_nuevo();
                t = __map_poner(t, "t", 4); t = __map_poner(t, "v", op2);
                t = __map_poner(t, "linea", ln); t = __map_poner(t, "col", cl);
                tk = __map_poner(tk, a_texto(cnt), t); cnt = cnt + 1;
                i = i + 2; cl = cl + 2; continuar;
            }
        }
        
        // Single-char operator/punctuation
        numero t = __map_nuevo();
        t = __map_poner(t, "t", 4); t = __map_poner(t, "v", c);
        t = __map_poner(t, "linea", ln); t = __map_poner(t, "col", cl);
        tk = __map_poner(tk, a_texto(cnt), t); cnt = cnt + 1;
        i = i + 1; cl = cl + 1;
    }
    
    // Post-process tokens: merge single-letter oper + ident into keywords (workaround for stray-char splits)
    numero ntk = __map_nuevo();
    entero ni = 0;
    entero ii = 0;
    mientras (ii < cnt) {
        numero tkv = __map_obtener(tk, a_texto(ii));
        numero ttp = __map_obtener(tkv, "t");
        texto tvv = a_texto(__map_obtener(tkv, "v"));
        si (ttp == 4 && largo(tvv) == 1 && ii + 1 < cnt) {
            numero nxt = __map_obtener(tk, a_texto(ii + 1));
            si (__map_obtener(nxt, "t") == 1) {
                texto comb = tvv + a_texto(__map_obtener(nxt, "v"));
                numero kk = __map_obtener(kw, comb);
                si (__tipo_de(kk) == "entero") {
                    // create keyword token
                    numero nt = __map_nuevo();
                    nt = __map_poner(nt, "t", 6); nt = __map_poner(nt, "v", comb);
                    nt = __map_poner(nt, "linea", __map_obtener(tkv, "linea")); nt = __map_poner(nt, "col", __map_obtener(tkv, "col"));
                    ntk = __map_poner(ntk, a_texto(ni), nt); ni = ni + 1;
                    ii = ii + 2; continuar;
                }
            }
        }
        // default: copy token
        ntk = __map_poner(ntk, a_texto(ni), tkv); ni = ni + 1; ii = ii + 1;
    }
    // EOF token (not counted in cnt so parser knows when to stop)
    numero t = __map_nuevo();
    t = __map_poner(t, "t", 99); t = __map_poner(t, "v", "");
    t = __map_poner(t, "linea", ln); t = __map_poner(t, "col", cl);
    ntk = __map_poner(ntk, a_texto(ni), t);
    ntk = __map_poner(ntk, "cnt", ni);
    retornar ntk;
}

funcion numero lexer_tokenize(texto s) { retornar lexer_tokenizar(s); }

funcion texto token_a_texto(numero t) {
    numero tk = __map_obtener(t, "t");
    texto ts = "?";
    si tk == 1 { ts = "Ident"; }
    si tk == 2 { ts = "Numero"; }
    si tk == 3 { ts = "Texto"; }
    si tk == 4 { ts = "Oper"; }
    si tk == 5 { ts = "Punt"; }
    si tk == 6 { ts = "Kw"; }
    si tk == 99 { ts = "EOF"; }
    texto val = __map_obtener(t, "v");
    retornar ts + "(" + val + ")";
}
funcion texto token_to_text(numero t) { retornar token_a_texto(t); }

funcion booleano _lx_es_ident_o_digito(texto c) {
    retornar _lx_es_ident(c) || _lx_es_digit(c);
}

// Helper: build substring from a character list between indices [st, fin)
funcion texto sub_from_chars(lista<texto> cs, entero st, entero fin) {
    retornar __str_subcadena_chars(cs, st, fin);
}

// stdlib/compiler/parser.nv — Recursive Descent Parser for LÚMEN
// ═══════════════════════════════════════════════════════════════
// Takes a token map from the lexer (format: {t, v}) and produces AST.
// Token types: 1=Ident, 2=Numero, 3=String, 4=Oper, 5=Punt, 6=Kw, 99=EOF
//
// Architecture: Map-based state (passed as parameter, updated via _res pattern).
// Each parse function returns {st: updated_state, node: ast_node}.

// ── State Helpers ──────────────────────────────────────────────
funcion numero _st_tk(numero st) {
    numero pos = __map_obtener(st, "pos");
    numero cnt = __map_obtener(st, "cnt");
    si (pos >= cnt) {
        numero t = __map_nuevo();
        t = __map_poner(t, "t", 99);
        t = __map_poner(t, "v", "");
        retornar t;
    }
    retornar __map_obtener(__map_obtener(st, "tokens"), a_texto(pos));
}

funcion numero _st_tt(numero st) {
    numero t = _st_tk(st);
    retornar __map_obtener(t, "t");
}

funcion numero _st_tv(numero st) {
    numero t = _st_tk(st);
    retornar __map_obtener(t, "v");
}

funcion booleano _st_eof(numero st) {
    retornar __map_obtener(st, "pos") >= __map_obtener(st, "cnt");
}

funcion numero _st_adv(numero st) {
    numero p = __map_obtener(st, "pos");
    st = __map_poner(st, "pos", p + 1);
    retornar st;
}

funcion booleano _st_ch(numero st, numero tt, texto vv) {
    si (_st_eof(st)) { retornar falso; }
    numero tk = _st_tk(st);
    numero a = __map_obtener(tk, "t");
    numero b = __map_obtener(tk, "v");
    retornar a == tt && a_texto(b) == vv;
}

funcion booleano _st_kw(numero st, texto w) {
    retornar _st_tt(st) == 6 && a_texto(_st_tv(st)) == w;
}

funcion booleano _st_tp(numero st) {
    texto v = a_texto(_st_tv(st));
    retornar _st_tt(st) == 6 && (v == "entero" || v == "texto" ||
           v == "decimal" || v == "booleano" || v == "numero" || v == "void" ||
           v == "lista" || v == "diccionario" ||
           v == "opcion" || v == "resultado");
}

// Avanza tras el tipo en una declaración, saltando genéricos "lista<entero>",
// "opcion<entero>", "resultado<entero, texto>"
funcion numero _st_tp_skip(numero st) {
    st = _st_adv(st);
    si _st_ch(st, 4, "<") {
        st = _st_adv(st);
        mientras (!_st_eof(st)) {
            si _st_ch(st, 4, ">") { st = _st_adv(st); romper; }
            st = _st_adv(st);
        }
    }
    retornar st;
}

// Check if current token is a real binary operator (not punct like ; { } etc.)
funcion booleano _st_is_op(numero st) {
    si (_st_tt(st) != 4) { retornar falso; }
    texto v = a_texto(_st_tv(st));
    retornar v == "+" || v == "-" || v == "*" || v == "/" || v == "%" ||
           v == "==" || v == "!=" || v == "<" || v == ">" || v == "<=" || v == ">=" ||
           v == "&&" || v == "||" || v == "=";
}

funcion numero _res(numero st, numero nodo) {
    numero r = __map_nuevo();
    r = __map_poner(r, "st", st);
    r = __map_poner(r, "node", nodo);
    retornar r;
}

// ── Forward ────────────────────────────────────────────────────
funcion numero _parse_expr(numero st);
funcion numero _parse_stmt(numero st);
funcion numero _parse_blk(numero st);

// ═══════════════════════════════════════════════════════════════
// ── Expression ─────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════

funcion numero _parse_pr(numero st) {
    numero tt = _st_tt(st);
    texto tvs = a_texto(_st_tv(st));

    si (tt == 3) {
        st = _st_adv(st);
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "Texto");
        n = __map_poner(n, "v", tvs);
        retornar _res(st, n);
    }
    si (tt == 2) {
        st = _st_adv(st);
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "Literal");
        n = __map_poner(n, "v", tvs);
        retornar _res(st, n);
    }
    si (tt == 6 && (tvs == "intentar" || tvs == "try")) {
        st = _st_adv(st);
        numero re = _parse_pr(st);
        numero _en = __map_obtener(re, "node");
        st = __map_obtener(re, "st");
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "Intenta");
        n = __map_poner(n, "expr", _en);
        retornar _res(st, n);
    }

    si (tt == 6 && (tvs == "verdadero" || tvs == "true" ||
                     tvs == "falso" || tvs == "false")) {
        st = _st_adv(st);
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "Bool");
        n = __map_poner(n, "v", tvs);
        retornar _res(st, n);
    }

    si (tt == 6 && (tvs == "ninguno" || tvs == "none")) {
        st = _st_adv(st);
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "Ninguno");
        retornar _res(st, n);
    }

    // Identifier or function call
    si (tt == 1 || (tt == 6 && !_st_tp(st) &&
         tvs != "verdadero" && tvs != "true" &&
         tvs != "falso" && tvs != "false")) {
        texto nm = tvs;
        st = _st_adv(st);
        numero base = __map_nuevo();
        // genéricos en llamada: foo<T>(...)
        numero st_pre = st;
        si (_st_ch(st, 4, "<")) {
            numero st_scan = st;
            mientras (!_st_eof(st_scan) && !_st_ch(st_scan, 4, ">")) {
                si (_st_ch(st_scan, 5, "(") || _st_ch(st_scan, 5, ")") ||
                    _st_ch(st_scan, 5, "{") || _st_ch(st_scan, 5, "}") ||
                    _st_ch(st_scan, 5, ";")) { romper; }
                st_scan = _st_adv(st_scan);
            }
            numero st_despues_gt = _st_adv(st_scan);
            si (_st_ch(st_scan, 4, ">") && _st_ch(st_despues_gt, 5, "(")) {
                st = st_despues_gt;
            } sino {
                st = st_pre;
            }
        }
        si (_st_ch(st, 5, "(")) {
            st = _st_adv(st);
            numero args = __map_nuevo();
            numero ac = 0;
            mientras (!_st_eof(st)) {
                si (_st_ch(st, 5, ")")) { romper; }
                si (ac > 0) {
                    si (_st_ch(st, 5, ",")) { st = _st_adv(st); }
                }
                numero re = _parse_expr(st);
                numero _en = __map_obtener(re, "node");
                st = __map_obtener(re, "st");
                args = __map_poner(args, a_texto(ac), _en);
                ac = ac + 1;
            }
            st = _st_adv(st);
            args = __map_poner(args, "cnt", ac);
            numero n = __map_nuevo();
            n = __map_poner(n, "tipo", "Call");
            n = __map_poner(n, "callee", nm);
            n = __map_poner(n, "args", args);
            base = n;
        } sino {
            numero n = __map_nuevo();
            n = __map_poner(n, "tipo", "Ident");
            n = __map_poner(n, "nombre", nm);
            base = n;
        }
        // Enum member: Nombre::Miembro → EnumInit (con/sin datos)
        si (_st_ch(st, 5, ":")) {
            numero st_dos = _st_adv(st);
            si (_st_ch(st_dos, 5, ":")) {
                st = _st_adv(st_dos);
                texto mnm = a_texto(_st_tv(st));
                st = _st_adv(st);
                numero eargs = __map_nuevo();
                numero ec = 0;
                si (_st_ch(st, 5, "(")) {
                    st = _st_adv(st);
                    mientras (!_st_eof(st)) {
                        si (_st_ch(st, 5, ")")) { romper; }
                        si (ec > 0) {
                            si (_st_ch(st, 5, ",")) { st = _st_adv(st); }
                        }
                        numero re = _parse_expr(st);
                        numero _en = __map_obtener(re, "node");
                        st = __map_obtener(re, "st");
                        eargs = __map_poner(eargs, a_texto(ec), _en);
                        ec = ec + 1;
                    }
                    st = _st_adv(st);
                }
                eargs = __map_poner(eargs, "cnt", ec);
                numero mn = __map_nuevo();
                mn = __map_poner(mn, "tipo", "EnumInit");
                mn = __map_poner(mn, "nombre", nm);
                mn = __map_poner(mn, "variante", mnm);
                mn = __map_poner(mn, "args", eargs);
                base = mn;
            }
        }
        // StructInit: Ident { f1: v1, ... }
        si (_st_ch(st, 5, "{")) {
            numero st_ck = _st_adv(st);
            booleano es_si = falso;
            si (_st_ch(st_ck, 5, "}")) { es_si = verdadero; }
            sino si (_st_tt(st_ck) == 1) {
                numero st_ck2 = _st_adv(st_ck);
                si (_st_ch(st_ck2, 5, ":")) { es_si = verdadero; }
            }
            si (es_si) {
                st = _st_adv(st);
                numero flds = __map_nuevo();
                numero fc = 0;
                mientras (!_st_eof(st)) {
                    si (_st_ch(st, 5, "}")) { romper; }
                    si (fc > 0 && _st_ch(st, 5, ",")) { st = _st_adv(st); }
                    si (_st_ch(st, 5, "}")) { romper; }
                    texto fnm = a_texto(_st_tv(st));
                    st = _st_adv(st);
                    si (_st_ch(st, 5, ":")) { st = _st_adv(st); }
                    numero re = _parse_expr(st);
                    numero fval = __map_obtener(re, "node");
                    st = __map_obtener(re, "st");
                    numero fitem = __map_nuevo();
                    fitem = __map_poner(fitem, "nombre", fnm);
                    fitem = __map_poner(fitem, "valor", fval);
                    flds = __map_poner(flds, a_texto(fc), fitem);
                    fc = fc + 1;
                }
                si (_st_ch(st, 5, "}")) { st = _st_adv(st); }
                flds = __map_poner(flds, "cnt", fc);
                numero n = __map_nuevo();
                n = __map_poner(n, "tipo", "StructInit");
                n = __map_poner(n, "nombre", nm);
                n = __map_poner(n, "campos", flds);
                base = n;
            }
        }
        // Postfix indexing: obj[expr] (possibly chained)
        mientras (_st_ch(st, 5, "[")) {
            st = _st_adv(st);
            numero re = _parse_expr(st);
            numero iexpr = __map_obtener(re, "node");
            st = __map_obtener(re, "st");
            st = _st_adv(st);
            numero n2 = __map_nuevo();
            n2 = __map_poner(n2, "tipo", "Index");
            n2 = __map_poner(n2, "obj", base);
            n2 = __map_poner(n2, "idx", iexpr);
            base = n2;
        }
        // Postfix methods: obj.nombre(...) or field: obj.campo
        mientras (_st_ch(st, 5, ".")) {
            st = _st_adv(st);
            texto mn = a_texto(_st_tv(st));
            st = _st_adv(st);
            si (_st_ch(st, 5, "(")) {
                st = _st_adv(st);
                numero margs = __map_nuevo();
                numero mc = 0;
                margs = __map_poner(margs, a_texto(mc), base);
                mc = mc + 1;
                mientras (!_st_eof(st)) {
                    si (_st_ch(st, 5, ")")) { romper; }
                    si (mc > 1) {
                        si (_st_ch(st, 5, ",")) { st = _st_adv(st); }
                    }
                    numero re2 = _parse_expr(st);
                    numero an = __map_obtener(re2, "node");
                    st = __map_obtener(re2, "st");
                    margs = __map_poner(margs, a_texto(mc), an);
                    mc = mc + 1;
                }
                st = _st_adv(st);
                margs = __map_poner(margs, "cnt", mc);
                numero nm2 = __map_nuevo();
                nm2 = __map_poner(nm2, "tipo", "Call");
                nm2 = __map_poner(nm2, "callee", mn);
                nm2 = __map_poner(nm2, "args", margs);
                si ((mn == "agregar" || mn == "push") &&
                    a_texto(__map_obtener(base, "tipo")) == "Ident") {
                    // desugar: nombre = agregar(nombre, ...) — el builtin devuelve la lista nueva
                    numero asn = __map_nuevo();
                    asn = __map_poner(asn, "tipo", "Assign");
                    asn = __map_poner(asn, "nombre", a_texto(__map_obtener(base, "nombre")));
                    asn = __map_poner(asn, "valor", nm2);
                    base = asn;
                } sino {
                    base = nm2;
                }
            } sino {
                numero fld = __map_nuevo();
                fld = __map_poner(fld, "tipo", "Texto");
                fld = __map_poner(fld, "v", mn);
                numero n2 = __map_nuevo();
                n2 = __map_poner(n2, "tipo", "Index");
                n2 = __map_poner(n2, "obj", base);
                n2 = __map_poner(n2, "idx", fld);
                base = n2;
            }
        }
        retornar _res(st, base);
    }

    si (_st_ch(st, 5, "(")) {
        st = _st_adv(st);
        numero re = _parse_expr(st);
        numero _en = __map_obtener(re, "node");
        st = __map_obtener(re, "st");
        st = _st_adv(st);
        retornar _res(st, _en);
    }

    // Array literal: [e1, e2, ...]
    si (tt == 5 && tvs == "[") {
        st = _st_adv(st);
        numero elems = __map_nuevo();
        numero ec = 0;
        mientras (!_st_eof(st)) {
            si (_st_ch(st, 5, "]")) { romper; }
            si (ec > 0) {
                si (_st_ch(st, 5, ",")) { st = _st_adv(st); }
            }
            numero re = _parse_expr(st);
            numero elen = __map_obtener(re, "node");
            st = __map_obtener(re, "st");
            elems = __map_poner(elems, a_texto(ec), elen);
            ec = ec + 1;
        }
        st = _st_adv(st);
        elems = __map_poner(elems, "cnt", ec);
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "Lista");
        n = __map_poner(n, "elementos", elems);
        retornar _res(st, n);
    }

    si (tt == 4 && (tvs == "-" || tvs == "!")) {
        st = _st_adv(st);
        numero re = _parse_pr(st);
        numero _en = __map_obtener(re, "node");
        st = __map_obtener(re, "st");
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "Unary");
        n = __map_poner(n, "op", tvs);
        n = __map_poner(n, "expr", _en);
        retornar _res(st, n);
    }

    st = _st_adv(st);
    numero n = __map_nuevo();
    n = __map_poner(n, "tipo", "Literal");
    n = __map_poner(n, "v", "0");
    retornar _res(st, n);
}

funcion entero _prec(texto op) {
    si (op == "||") { retornar 1; }
    si (op == "&&") { retornar 2; }
    si (op == "==" || op == "!=" || op == "<" || op == ">"
        || op == "<=" || op == ">=") { retornar 3; }
    si (op == "+" || op == "-") { retornar 4; }
    si (op == "*" || op == "/" || op == "%") { retornar 5; }
    retornar 0;
}

funcion numero _parse_bin(numero st, entero mp) {
    numero re = _parse_pr(st);
    numero izq = __map_obtener(re, "node");
    st = __map_obtener(re, "st");

    mientras (_st_is_op(st)) {
        texto op = a_texto(_st_tv(st));
        entero p = _prec(op);
        si (p < mp || p == 0) { romper; }
        st = _st_adv(st);
        numero rr = _parse_bin(st, p + 1);
        numero der = __map_obtener(rr, "node");
        st = __map_obtener(rr, "st");
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "Binary");
        n = __map_poner(n, "op", op);
        n = __map_poner(n, "izq", izq);
        n = __map_poner(n, "der", der);
        izq = n;
    }
    // Ternario: cond ? si : no — solo al nivel superior (mp == 0),
    // para que `a >= b ? x : y` sea (a>=b) ? x : y, no a >= (b ? x : y)
    si (mp == 0 && _st_ch(st, 4, "?")) {
        st = _st_adv(st);
        numero rb = _parse_expr(st);
        numero sv = __map_obtener(rb, "node");
        st = __map_obtener(rb, "st");
        numero no = __map_nuevo();
        no = __map_poner(no, "tipo", "Literal");
        no = __map_poner(no, "v", "0");
        si (_st_ch(st, 5, ":")) {
            st = _st_adv(st);
            numero rc = _parse_expr(st);
            no = __map_obtener(rc, "node");
            st = __map_obtener(rc, "st");
        }
        numero tn = __map_nuevo();
        tn = __map_poner(tn, "tipo", "Ternario");
        tn = __map_poner(tn, "cond", izq);
        tn = __map_poner(tn, "si", sv);
        tn = __map_poner(tn, "no", no);
        izq = tn;
    }
    retornar _res(st, izq);
}

funcion numero _parse_expr(numero st) {
    retornar _parse_bin(st, 0);
}

// ═══════════════════════════════════════════════════════════════
// ── Block ──────────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════

funcion numero _parse_blk(numero st) {
    st = _st_adv(st);
    numero stmts = __map_nuevo();
    numero sc = 0;
    mientras (!_st_eof(st)) {
        si (_st_ch(st, 5, "}")) { romper; }
        si ((_st_tt(st) == 1 || _st_tt(st) == 6) &&
            (a_texto(_st_tv(st)) == "caso" || a_texto(_st_tv(st)) == "case" ||
             a_texto(_st_tv(st)) == "default")) { romper; }
        numero rs = _parse_stmt(st);
        numero sn = __map_obtener(rs, "node");
        st = __map_obtener(rs, "st");
        stmts = __map_poner(stmts, a_texto(sc), sn);
        sc = sc + 1;
    }
    st = _st_adv(st);
    stmts = __map_poner(stmts, "cnt", sc);
    numero n = __map_nuevo();
    n = __map_poner(n, "tipo", "Block");
    n = __map_poner(n, "cuerpo", stmts);
    retornar _res(st, n);
}

// ═══════════════════════════════════════════════════════════════
// ── Statement ──────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════

funcion numero _parse_stmt(numero st) {
    si (_st_eof(st)) {
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "Vacio");
        retornar _res(st, n);
    }
    numero tt = _st_tt(st);
    texto tvs = a_texto(_st_tv(st));

    si (tt == 6 && (tvs == "sea" || tvs == "let")) {
        st = _st_adv(st);
        texto svar = "let";
        si (_st_tp(st)) {
            svar = a_texto(_st_tv(st));
            st = _st_tp_skip(st);
        }
        texto nm = a_texto(_st_tv(st));
        st = _st_adv(st);
        numero vl = __map_nuevo();
        vl = __map_poner(vl, "tipo", "Vacio");
        si (_st_ch(st, 4, "=")) {
            st = _st_adv(st);
            numero re = _parse_expr(st);
            vl = __map_obtener(re, "node");
            st = __map_obtener(re, "st");
        }
        si (_st_ch(st, 5, ";")) { st = _st_adv(st); }
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "VarDecl");
        n = __map_poner(n, "nombre", nm);
        n = __map_poner(n, "tipo_var", svar);
        n = __map_poner(n, "valor", vl);
        retornar _res(st, n);
    }

    si (tt == 6 && _st_tp(st)) {
        texto tvar = tvs;
        st = _st_tp_skip(st);
        texto nm = a_texto(_st_tv(st));
        st = _st_adv(st);
        numero vl = __map_nuevo();
        vl = __map_poner(vl, "tipo", "Vacio");
        si (_st_ch(st, 4, "=")) {
            st = _st_adv(st);
            numero re = _parse_expr(st);
            vl = __map_obtener(re, "node");
            st = __map_obtener(re, "st");
        }
        si (_st_ch(st, 5, ";")) { st = _st_adv(st); }
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "VarDecl");
        n = __map_poner(n, "nombre", nm);
        n = __map_poner(n, "tipo_var", tvar);
        n = __map_poner(n, "valor", vl);
        retornar _res(st, n);
    }

    si (tt == 6 && tvs == "const") {
        st = _st_adv(st);
        texto nm = a_texto(_st_tv(st));
        st = _st_adv(st);
        numero vl = __map_nuevo();
        vl = __map_poner(vl, "tipo", "Vacio");
        si (_st_ch(st, 4, "=")) {
            st = _st_adv(st);
            numero re = _parse_expr(st);
            vl = __map_obtener(re, "node");
            st = __map_obtener(re, "st");
        }
        si (_st_ch(st, 5, ";")) { st = _st_adv(st); }
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "VarDecl");
        n = __map_poner(n, "nombre", nm);
        n = __map_poner(n, "tipo_var", "const");
        n = __map_poner(n, "valor", vl);
        retornar _res(st, n);
    }

    si (tt == 6 && (tvs == "para" || tvs == "for")) {
        st = _st_adv(st);
        si (_st_ch(st, 5, "(")) {
            // for clásico: para (init; cond; paso) { }
            st = _st_adv(st);
            numero rinit = _parse_stmt(st);
            numero init = __map_obtener(rinit, "node");
            st = __map_obtener(rinit, "st");
            numero rcond = _parse_expr(st);
            numero cond = __map_obtener(rcond, "node");
            st = __map_obtener(rcond, "st");
            si (_st_ch(st, 5, ";")) { st = _st_adv(st); }
            numero rpaso = _parse_stmt(st);
            numero paso = __map_obtener(rpaso, "node");
            st = __map_obtener(rpaso, "st");
            si (_st_ch(st, 5, ")")) { st = _st_adv(st); }
            numero rb = _parse_blk(st);
            numero cuerpo = __map_obtener(rb, "node");
            st = __map_obtener(rb, "st");
            // desugar: init; mientras (cond) { cuerpo; paso; }
            numero stmts2 = __map_obtener(cuerpo, "cuerpo");
            numero s2c = __map_obtener(stmts2, "cnt");
            stmts2 = __map_poner(stmts2, a_texto(s2c), paso);
            stmts2 = __map_poner(stmts2, "cnt", s2c + 1);
            numero cuerpo2 = __map_nuevo();
            cuerpo2 = __map_poner(cuerpo2, "tipo", "Block");
            cuerpo2 = __map_poner(cuerpo2, "cuerpo", stmts2);
            numero wl = __map_nuevo();
            wl = __map_poner(wl, "tipo", "While");
            wl = __map_poner(wl, "cond", cond);
            wl = __map_poner(wl, "cuerpo", cuerpo2);
            numero stmts3 = __map_nuevo();
            stmts3 = __map_poner(stmts3, "0", init);
            stmts3 = __map_poner(stmts3, "1", wl);
            stmts3 = __map_poner(stmts3, "cnt", 2);
            numero n = __map_nuevo();
            n = __map_poner(n, "tipo", "Block");
            n = __map_poner(n, "cuerpo", stmts3);
            retornar _res(st, n);
        }
        // for-each: para [tipo] X en EXPR { }  →  i=0; mientras (i < largo(EXPR)) { X = EXPR[i]; cuerpo; i=i+1; }
        si (_st_tp(st)) { st = _st_tp_skip(st); }
        texto nm = a_texto(_st_tv(st));
        st = _st_adv(st);
        si (_st_kw(st, "en") || _st_kw(st, "in")) { st = _st_adv(st); }
        numero re = _parse_expr(st);
        numero col = __map_obtener(re, "node");
        st = __map_obtener(re, "st");
        numero rb = _parse_blk(st);
        numero cuerpo = __map_obtener(rb, "node");
        st = __map_obtener(rb, "st");
        texto iv = "__para_" + nm;
        numero lit0 = __map_nuevo();
        lit0 = __map_poner(lit0, "tipo", "Literal");
        lit0 = __map_poner(lit0, "v", "0");
        numero as0 = __map_nuevo();
        as0 = __map_poner(as0, "tipo", "Assign");
        as0 = __map_poner(as0, "nombre", iv);
        as0 = __map_poner(as0, "valor", lit0);
        numero argsL = __map_nuevo();
        argsL = __map_poner(argsL, "0", col);
        argsL = __map_poner(argsL, "cnt", 1);
        numero callL = __map_nuevo();
        callL = __map_poner(callL, "tipo", "Call");
        callL = __map_poner(callL, "callee", "largo");
        callL = __map_poner(callL, "args", argsL);
        numero idI = __map_nuevo();
        idI = __map_poner(idI, "tipo", "Ident");
        idI = __map_poner(idI, "nombre", iv);
        numero condB = __map_nuevo();
        condB = __map_poner(condB, "tipo", "Binary");
        condB = __map_poner(condB, "op", "<");
        condB = __map_poner(condB, "izq", idI);
        condB = __map_poner(condB, "der", callL);
        numero idxN = __map_nuevo();
        idxN = __map_poner(idxN, "tipo", "Index");
        idxN = __map_poner(idxN, "obj", col);
        idxN = __map_poner(idxN, "idx", idI);
        numero asn = __map_nuevo();
        asn = __map_poner(asn, "tipo", "Assign");
        asn = __map_poner(asn, "nombre", nm);
        asn = __map_poner(asn, "valor", idxN);
        numero lit1 = __map_nuevo();
        lit1 = __map_poner(lit1, "tipo", "Literal");
        lit1 = __map_poner(lit1, "v", "1");
        numero idI2 = __map_nuevo();
        idI2 = __map_poner(idI2, "tipo", "Ident");
        idI2 = __map_poner(idI2, "nombre", iv);
        numero incB = __map_nuevo();
        incB = __map_poner(incB, "tipo", "Binary");
        incB = __map_poner(incB, "op", "+");
        incB = __map_poner(incB, "izq", idI2);
        incB = __map_poner(incB, "der", lit1);
        numero inc = __map_nuevo();
        inc = __map_poner(inc, "tipo", "Assign");
        inc = __map_poner(inc, "nombre", iv);
        inc = __map_poner(inc, "valor", incB);
        numero stmtsW = __map_nuevo();
        stmtsW = __map_poner(stmtsW, "0", asn);
        numero scW = __map_obtener(cuerpo, "cuerpo");
        numero scWc = __map_obtener(scW, "cnt");
        numero wk = 0;
        mientras (wk < scWc) {
            stmtsW = __map_poner(stmtsW, a_texto(wk + 1), __map_obtener(scW, a_texto(wk)));
            wk = wk + 1;
        }
        stmtsW = __map_poner(stmtsW, a_texto(scWc + 1), inc);
        stmtsW = __map_poner(stmtsW, "cnt", scWc + 2);
        numero cuerpoW = __map_nuevo();
        cuerpoW = __map_poner(cuerpoW, "tipo", "Block");
        cuerpoW = __map_poner(cuerpoW, "cuerpo", stmtsW);
        numero wl = __map_nuevo();
        wl = __map_poner(wl, "tipo", "While");
        wl = __map_poner(wl, "cond", condB);
        wl = __map_poner(wl, "cuerpo", cuerpoW);
        numero stmts3 = __map_nuevo();
        stmts3 = __map_poner(stmts3, "0", as0);
        stmts3 = __map_poner(stmts3, "1", wl);
        stmts3 = __map_poner(stmts3, "cnt", 2);
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "Block");
        n = __map_poner(n, "cuerpo", stmts3);
        retornar _res(st, n);
    }

    si (tt == 6 && (tvs == "si" || tvs == "if")) {
        st = _st_adv(st);
        numero rc = _parse_expr(st);
        numero cond = __map_obtener(rc, "node");
        st = __map_obtener(rc, "st");
        numero rb = _parse_blk(st);
        numero cuerpo = __map_obtener(rb, "node");
        st = __map_obtener(rb, "st");
        numero _else = __map_nuevo();
        _else = __map_poner(_else, "tipo", "Vacio");
        si (_st_kw(st, "sino") || _st_kw(st, "else")) {
            st = _st_adv(st);
            si (_st_kw(st, "si") || _st_kw(st, "if")) {
                numero rs = _parse_stmt(st);
                _else = __map_obtener(rs, "node");
                st = __map_obtener(rs, "st");
            } sino {
                numero rb2 = _parse_blk(st);
                _else = __map_obtener(rb2, "node");
                st = __map_obtener(rb2, "st");
            }
        }
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "If");
        n = __map_poner(n, "cond", cond);
        n = __map_poner(n, "cuerpo", cuerpo);
        n = __map_poner(n, "sino", _else);
        retornar _res(st, n);
    }

    si (tt == 6 && (tvs == "elegir" || tvs == "switch")) {
        st = _st_adv(st);
        si (_st_ch(st, 5, "(")) { st = _st_adv(st); }
        numero re_sw = _parse_expr(st);
        numero sel = __map_obtener(re_sw, "node");
        st = __map_obtener(re_sw, "st");
        si (_st_ch(st, 5, ")")) { st = _st_adv(st); }
        si (_st_ch(st, 5, "{")) { st = _st_adv(st); }
        numero ifns = __map_nuevo();
        numero ic = 0;
        numero dblock = 0;
        mientras (!_st_eof(st)) {
            si (_st_ch(st, 5, "}")) { romper; }
            numero ctt = _st_tt(st);
            texto cv = a_texto(_st_tv(st));
            si ((ctt == 1 || ctt == 6) && (cv == "caso" || cv == "case")) {
                st = _st_adv(st);
                numero rc_v = _parse_expr(st);
                numero cval = __map_obtener(rc_v, "node");
                st = __map_obtener(rc_v, "st");
                si (_st_ch(st, 5, ":")) { st = _st_adv(st); }
                // body del caso: statements hasta `}` o `caso` (sin consumir el `}` — es el cierre del elegir)
                 numero stmts_c = __map_nuevo();
                 numero sc2 = 0;
                 mientras (!_st_eof(st) && !_st_ch(st, 5, "}")) {
                     numero cbt = _st_tt(st);
                     texto cbv = a_texto(_st_tv(st));
                     si ((cbt == 1 || cbt == 6) &&
                         (cbv == "caso" || cbv == "case" || cbv == "defecto" ||
                          cbv == "default")) { romper; }
                     numero rs2 = _parse_stmt(st);
                     numero sn2 = __map_obtener(rs2, "node");
                     st = __map_obtener(rs2, "st");
                     stmts_c = __map_poner(stmts_c, a_texto(sc2), sn2);
                     sc2 = sc2 + 1;
                 }
                 stmts_c = __map_poner(stmts_c, "cnt", sc2);
                 numero b_c = __map_nuevo();
                 b_c = __map_poner(b_c, "tipo", "Block");
                 b_c = __map_poner(b_c, "cuerpo", stmts_c);
                 numero cmp = __map_nuevo();
                 cmp = __map_poner(cmp, "tipo", "Binary");
                 cmp = __map_poner(cmp, "op", "==");
                 cmp = __map_poner(cmp, "izq", sel);
                 cmp = __map_poner(cmp, "der", cval);
                 numero ifn = __map_nuevo();
                 ifn = __map_poner(ifn, "tipo", "If");
                 ifn = __map_poner(ifn, "cond", cmp);
                 ifn = __map_poner(ifn, "cuerpo", b_c);
                 numero _sv = __map_nuevo();
                 _sv = __map_poner(_sv, "tipo", "Vacio");
                 ifn = __map_poner(ifn, "sino", _sv);
                 ifns = __map_poner(ifns, a_texto(ic), ifn);
                 ic = ic + 1;
                 // caso defecto/default: rama else del último If (tras construir el ifn actual)
                 si ((_st_tt(st) == 1 || _st_tt(st) == 6) &&
                     (a_texto(_st_tv(st)) == "defecto" ||
                      a_texto(_st_tv(st)) == "default")) {
                     st = _st_adv(st);
                     si (_st_ch(st, 5, ":")) { st = _st_adv(st); }
                     numero stmts_d = __map_nuevo();
                     numero sd = 0;
                     mientras (!_st_eof(st) && !_st_ch(st, 5, "}")) {
                         numero rsd = _parse_stmt(st);
                         numero snd = __map_obtener(rsd, "node");
                         st = __map_obtener(rsd, "st");
                         stmts_d = __map_poner(stmts_d, a_texto(sd), snd);
                         sd = sd + 1;
                     }
                     stmts_d = __map_poner(stmts_d, "cnt", sd);
                     numero b_d = __map_nuevo();
                     b_d = __map_poner(b_d, "tipo", "Block");
                     b_d = __map_poner(b_d, "cuerpo", stmts_d);
                     dblock = b_d;
                     romper;
                 }
             } sino {
                 st = _st_adv(st);
             }
         }
        si (_st_ch(st, 5, "}")) { st = _st_adv(st); }
        // Construir la cadena desde el final: __map_poner NO muta el mapa original
        si (ic > 0) {
            numero chain = __map_obtener(ifns, a_texto(ic - 1));
            si (dblock != 0) {
                chain = __map_poner(chain, "sino", dblock);
            }
            numero i2 = ic - 1;
            mientras (i2 > 0) {
                i2 = i2 - 1;
                chain = __map_poner(__map_obtener(ifns, a_texto(i2)), "sino", chain);
            }
            retornar _res(st, chain);
        }
        si (dblock != 0) {
            retornar _res(st, dblock);
        }
        numero n_sw = __map_nuevo();
        n_sw = __map_poner(n_sw, "tipo", "Vacio");
        retornar _res(st, n_sw);
    }

    si (tt == 6 && (tvs == "mientras" || tvs == "while")) {
        st = _st_adv(st);
        numero rc = _parse_expr(st);
        numero cond = __map_obtener(rc, "node");
        st = __map_obtener(rc, "st");
        numero rb = _parse_blk(st);
        numero cuerpo = __map_obtener(rb, "node");
        st = __map_obtener(rb, "st");
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "While");
        n = __map_poner(n, "cond", cond);
        n = __map_poner(n, "cuerpo", cuerpo);
        retornar _res(st, n);
    }

    si ((tt == 6 || tt == 1) && (tvs == "retornar" || tvs == "etornar" || tvs == "return")) {
        st = _st_adv(st);
        numero vl = __map_nuevo();
        vl = __map_poner(vl, "tipo", "Vacio");
        si (!_st_ch(st, 5, ";") && !_st_ch(st, 5, "}") && !_st_eof(st)) {
            numero re = _parse_expr(st);
            vl = __map_obtener(re, "node");
            st = __map_obtener(re, "st");
        }
        si (_st_ch(st, 5, ";")) { st = _st_adv(st); }
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "Return");
        n = __map_poner(n, "valor", vl);
        retornar _res(st, n);
    }

    si (tt == 6 && (tvs == "romper" || tvs == "break")) {
        st = _st_adv(st);
        si (_st_ch(st, 5, ";")) { st = _st_adv(st); }
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "Break");
        retornar _res(st, n);
    }
    si (tt == 6 && tvs == "continuar") {
        st = _st_adv(st);
        si (_st_ch(st, 5, ";")) { st = _st_adv(st); }
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "Continue");
        retornar _res(st, n);
    }

    si (tt == 6 && (tvs == "importar" || tvs == "import")) {
        st = _st_adv(st);
        texto rt = a_texto(_st_tv(st));
        st = _st_adv(st);
        si (_st_ch(st, 5, ";")) { st = _st_adv(st); }
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "Import");
        n = __map_poner(n, "ruta", rt);
        retornar _res(st, n);
    }

    si (tt == 1 || tt == 6) {
        // Typed var decl con tipo custom (struct): Punto p = Punto { x: 1, y: 2 }
        numero st_ck = _st_adv(st);
        si ((_st_tt(st_ck) == 1) || (_st_tt(st_ck) == 6 && !_st_tp(st_ck))) {
            numero st_nm = st_ck;
            si (_st_ch(st_nm, 4, "<")) {
                mientras (!_st_eof(st_nm) && !_st_ch(st_nm, 4, ">")) { st_nm = _st_adv(st_nm); }
                st_nm = _st_adv(st_nm);
            }
            si (_st_tt(st_nm) == 1 || (_st_tt(st_nm) == 6 && !_st_tp(st_nm))) {
                texto vnombre = a_texto(_st_tv(st_nm));
                st_nm = _st_adv(st_nm);
                si (_st_ch(st_nm, 4, "=")) {
                    st_nm = _st_adv(st_nm);
                    numero re3 = _parse_expr(st_nm);
                    numero vvl = __map_obtener(re3, "node");
                    st_nm = __map_obtener(re3, "st");
                    si (_st_ch(st_nm, 5, ";")) { st_nm = _st_adv(st_nm); }
                    numero n3 = __map_nuevo();
                    n3 = __map_poner(n3, "tipo", "VarDecl");
                    n3 = __map_poner(n3, "nombre", vnombre);
                    n3 = __map_poner(n3, "valor", vvl);
                    retornar _res(st_nm, n3);
                }
            }
        }
        numero re = _parse_expr(st);
        numero ex = __map_obtener(re, "node");
        st = __map_obtener(re, "st");
        si (_st_ch(st, 4, "=")) {
            st = _st_adv(st);
            numero re2 = _parse_expr(st);
            numero vl = __map_obtener(re2, "node");
            st = __map_obtener(re2, "st");
            si (_st_ch(st, 5, ";")) { st = _st_adv(st); }
            numero n = __map_nuevo();
            n = __map_poner(n, "tipo", "Assign");
            texto tp_ex = a_texto(__map_obtener(ex, "tipo"));
            si tp_ex == "Index" {
                n = __map_poner(n, "target", ex);
                numero objn = __map_obtener(ex, "obj");
                mientras a_texto(__map_obtener(objn, "tipo")) == "Index" {
                    objn = __map_obtener(objn, "obj");
                }
                n = __map_poner(n, "nombre", a_texto(__map_obtener(objn, "nombre")));
            } sino {
                n = __map_poner(n, "nombre", a_texto(__map_obtener(ex, "nombre")));
            }
            n = __map_poner(n, "valor", vl);
            retornar _res(st, n);
        }
        si (_st_ch(st, 5, ";")) { st = _st_adv(st); }
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "ExprStmt");
        n = __map_poner(n, "expr", ex);
        retornar _res(st, n);
    }

    si (_st_ch(st, 5, "{")) {
        numero rb3 = _parse_blk(st);
        numero b3 = __map_obtener(rb3, "node");
        retornar _res(__map_obtener(rb3, "st"), b3);
    }

    si (!_st_eof(st)) {
        numero re = _parse_expr(st);
        numero ex = __map_obtener(re, "node");
        st = __map_obtener(re, "st");
        si (_st_ch(st, 5, ";")) { st = _st_adv(st); }
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "ExprStmt");
        n = __map_poner(n, "expr", ex);
        retornar _res(st, n);
    }
    numero n = __map_nuevo();
    n = __map_poner(n, "tipo", "Vacio");
    retornar _res(st, n);
}

// ═══════════════════════════════════════════════════════════════
// ── Declaration ────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════

funcion numero _parse_decl(numero st) {
    si (_st_eof(st)) {
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "Vacio");
        retornar _res(st, n);
    }
    numero tt = _st_tt(st);
    texto tvs = a_texto(_st_tv(st));

    si (tt == 6 && (tvs == "funcion" || tvs == "function")) {
        st = _st_adv(st);
        texto tr = "void";
        si (_st_tp(st)) {
            tr = a_texto(_st_tv(st));
            st = _st_tp_skip(st);
        } sino {
            // Tipo de retorno genérico: `funcion T foo<T>(...)` — el siguiente token es Ident (nombre)
            si (!_st_eof(st) && _st_tt(st) == 1) {
                texto tv = a_texto(_st_tv(st));
                numero st_adelante = _st_adv(st);
                si (!_st_eof(st_adelante) && _st_tt(st_adelante) == 1) {
                    tr = tv;
                    st = st_adelante;
                }
            }
        }
        texto nm = a_texto(_st_tv(st));
        st = _st_adv(st);
        // genéricos en la firma: funcion X<T>(...)  (scan con límites)
        si (_st_ch(st, 4, "<")) {
            numero st_scan = st;
            mientras (!_st_eof(st_scan) && !_st_ch(st_scan, 4, ">")) {
                si (_st_ch(st_scan, 5, "(") || _st_ch(st_scan, 5, ")") ||
                    _st_ch(st_scan, 5, "{") || _st_ch(st_scan, 5, "}") ||
                    _st_ch(st_scan, 5, ";")) { romper; }
                st_scan = _st_adv(st_scan);
            }
            si (_st_ch(st_scan, 4, ">")) {
                st = _st_adv(st_scan);
            } sino {
                st = _st_adv(st);
            }
        }
        st = _st_adv(st); // (
        numero prms = __map_nuevo();
        numero pc = 0;
        mientras (!_st_eof(st)) {
            si (_st_ch(st, 5, ")")) { romper; }
            si (pc > 0) {
                si (_st_ch(st, 5, ",")) { st = _st_adv(st); }
            }
            texto pt = a_texto(_st_tv(st));
            // Avanzar correctamente tras el tipo (soporta genéricos como lista<entero>)
            si (_st_tp(st)) {
                st = _st_tp_skip(st);
            } sino {
                st = _st_adv(st);
            }
            texto pn = a_texto(_st_tv(st));
            st = _st_adv(st);
            numero pm = __map_nuevo();
            pm = __map_poner(pm, "nombre", pn);
            pm = __map_poner(pm, "tipo", pt);
            pm = __map_poner(pm, "defecto", 0);
            si (_st_ch(st, 4, "=")) {
                st = _st_adv(st);
                numero rdf = _parse_expr(st);
                pm = __map_poner(pm, "defecto", __map_obtener(rdf, "node"));
                st = __map_obtener(rdf, "st");
            }
            prms = __map_poner(prms, a_texto(pc), pm);
            pc = pc + 1;
        }
        st = _st_adv(st); // )
        prms = __map_poner(prms, "cnt", pc);
        // Forward declaration sin cuerpo (solo firma + ;) — ignorar
        si (_st_ch(st, 5, ";")) {
            st = _st_adv(st);
            numero v = __map_nuevo();
            v = __map_poner(v, "tipo", "Vacio");
            retornar _res(st, v);
        }
        numero rb = _parse_blk(st);
        numero bd = __map_obtener(rb, "node");
        st = __map_obtener(rb, "st");
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "Func");
        n = __map_poner(n, "nombre", nm);
        n = __map_poner(n, "tipo_ret", tr);
        n = __map_poner(n, "params", prms);
        n = __map_poner(n, "cuerpo", bd);
        retornar _res(st, n);
    }

    si (tt == 6 && (tvs == "estructura" || tvs == "struct")) {
        st = _st_adv(st);
        st = _st_adv(st); // nombre
        si (_st_ch(st, 4, "<")) {
            mientras (!_st_eof(st) && !_st_ch(st, 4, ">")) { st = _st_adv(st); }
            st = _st_adv(st);
        }
        si (_st_ch(st, 5, "{")) {
            st = _st_adv(st);
            mientras (!_st_eof(st) && !_st_ch(st, 5, "}")) { st = _st_adv(st); }
            si (_st_ch(st, 5, "}")) { st = _st_adv(st); }
        }
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "Vacio");
        retornar _res(st, n);
    }

    si (tt == 6 && tvs == "enum") {
        st = _st_adv(st);
        st = _st_adv(st); // nombre
        si (_st_ch(st, 5, "{")) {
            st = _st_adv(st);
            mientras (!_st_eof(st) && !_st_ch(st, 5, "}")) { st = _st_adv(st); }
            si (_st_ch(st, 5, "}")) { st = _st_adv(st); }
        }
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "Vacio");
        retornar _res(st, n);
    }

    retornar _parse_stmt(st);
}

// ═══════════════════════════════════════════════════════════════
// ── Program ────────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════

funcion numero _parse_prog(numero st) {
    numero prog = __map_nuevo();
    prog = __map_poner(prog, "tipo", "Programa");
    numero stmts = __map_nuevo();
    numero sc = 0;
    mientras (!_st_eof(st)) {
        si (_st_ch(st, 5, ";") || _st_ch(st, 5, "}")) {
            st = _st_adv(st);
            continuar;
        }
        numero tt = _st_tt(st);
        texto tvs = a_texto(_st_tv(st));
        numero r;
        si ((tt == 6 || tt == 1) && (tvs == "funcion" || tvs == "function" ||
                         tvs == "estructura" || tvs == "importar" ||
                         tvs == "import" || tvs == "enum")) {
            r = _parse_decl(st);
        } sino {
            r = _parse_stmt(st);
        }
        st = __map_obtener(r, "st");
        stmts = __map_poner(stmts, a_texto(sc), __map_obtener(r, "node"));
        sc = sc + 1;
    }
    stmts = __map_poner(stmts, "cnt", sc);
    prog = __map_poner(prog, "cuerpo", stmts);
    retornar _res(st, prog);
}

// ── Public API ─────────────────────────────────────────────────

// ═══════════════════════════════════════════════════════════════
// ── Import Resolution (Sprint 6.1) ──────────────────────────────
// ═══════════════════════════════════════════════════════════════

funcion numero _imp_parse(numero tokens) {
    numero st = __map_nuevo();
    st = __map_poner(st, "tokens", tokens);
    st = __map_poner(st, "pos", 0);
    st = __map_poner(st, "cnt", __map_obtener(tokens, "cnt"));
    numero r = _parse_prog(st);
    retornar __map_obtener(r, "node");
}

// Prefijo de módulo a partir de la ruta: "matematicas.nv" → "matematicas_"
funcion texto _imp_prefijo(texto ruta) {
    texto nm = ruta;
    // basename: quitar directorios (barra normal e invertida)
    numero i = 0;
    numero ln = largo(ruta);
    numero last = 0;
    mientras (i < ln) {
        texto c = __str_subcadena(ruta, i, i + 1);
        si (c == "/" || c == "\\") { last = i + 1; }
        i = i + 1;
    }
    nm = __str_subcadena(ruta, last, ln);
    // quitar extensión .nv
    si (__str_subcadena(nm, largo(nm) - 3, largo(nm)) == ".nv") {
        nm = __str_subcadena(nm, 0, largo(nm) - 3);
    }
    retornar nm + "_";
}

// ¿nombre en el mapa de funciones?
funcion booleano _imp_es_func(numero fns, texto nm) {
    retornar __map_contiene(fns, nm);
}

// Recolecta nombres de funciones propias (sin marca imp) y de importadas (con marca)
funcion numero _imp_funcs(numero cuerpo, texto marcar) {
    numero fns = __map_nuevo();
    numero sc = __map_obtener(cuerpo, "cnt");
    numero j = 0;
    mientras (j < sc) {
        numero nd = __map_obtener(cuerpo, a_texto(j));
        si (a_texto(__map_obtener(nd, "tipo")) == "Func") {
            texto esimp = a_texto(__map_obtener(nd, "imp"));
            si (marcar == "propias" && esimp != "1") {
                fns = __map_poner(fns, a_texto(__map_obtener(nd, "nombre")), 1);
            }
            si (marcar == "importadas" && esimp == "1") {
                fns = __map_poner(fns, a_texto(__map_obtener(nd, "nombre")), 1);
            }
        }
        j = j + 1;
    }
    retornar fns;
}

// Prefija recursivamente las funciones propias de un módulo y sus calls internos
funcion numero _imp_prefijar(numero nodo, texto prefijo, numero propias, numero importadas) {
    texto tp = a_texto(__map_obtener(nodo, "tipo"));
    si (tp == "Func") {
        // funciones importadas ya resueltas — no tocar
        si (a_texto(__map_obtener(nodo, "imp")) == "1") { retornar nodo; }
        texto nm = a_texto(__map_obtener(nodo, "nombre"));
        si (!__str_starts_with(nm, prefijo)) {
            nodo = __map_poner(nodo, "nombre", prefijo + nm);
        }
        nodo = __map_poner(nodo, "cuerpo",
            _imp_prefijar(__map_obtener(nodo, "cuerpo"), prefijo, propias, importadas));
        retornar nodo;
    }
    si (tp == "Block" || tp == "Programa") {
        numero stmts = __map_obtener(nodo, "cuerpo");
        numero sc = __map_obtener(stmts, "cnt");
        numero j = 0;
        mientras (j < sc) {
            numero nd = __map_obtener(stmts, a_texto(j));
            stmts = __map_poner(stmts, a_texto(j),
                _imp_prefijar(nd, prefijo, propias, importadas));
            j = j + 1;
        }
        nodo = __map_poner(nodo, "cuerpo", stmts);
        retornar nodo;
    }
    si (tp == "Call") {
        texto cl = a_texto(__map_obtener(nodo, "callee"));
        si (_imp_es_func(propias, cl)) {
            si (!__str_starts_with(cl, prefijo)) {
                nodo = __map_poner(nodo, "callee", prefijo + cl);
            }
        }
        numero args = __map_obtener(nodo, "args");
        numero ac = __map_obtener(args, "cnt");
        numero j = 0;
        mientras (j < ac) {
            numero an = __map_obtener(args, a_texto(j));
            args = __map_poner(args, a_texto(j),
                _imp_prefijar(an, prefijo, propias, importadas));
            j = j + 1;
        }
        nodo = __map_poner(nodo, "args", args);
        retornar nodo;
    }
    si (tp == "Binary") {
        nodo = __map_poner(nodo, "izq",
            _imp_prefijar(__map_obtener(nodo, "izq"), prefijo, propias, importadas));
        nodo = __map_poner(nodo, "der",
            _imp_prefijar(__map_obtener(nodo, "der"), prefijo, propias, importadas));
        retornar nodo;
    }
    si (tp == "Unary" || tp == "Intenta") {
        nodo = __map_poner(nodo, "expr",
            _imp_prefijar(__map_obtener(nodo, "expr"), prefijo, propias, importadas));
        retornar nodo;
    }
    si (tp == "Index") {
        nodo = __map_poner(nodo, "obj",
            _imp_prefijar(__map_obtener(nodo, "obj"), prefijo, propias, importadas));
        nodo = __map_poner(nodo, "idx",
            _imp_prefijar(__map_obtener(nodo, "idx"), prefijo, propias, importadas));
        retornar nodo;
    }
    si (tp == "If") {
        nodo = __map_poner(nodo, "cond",
            _imp_prefijar(__map_obtener(nodo, "cond"), prefijo, propias, importadas));
        nodo = __map_poner(nodo, "cuerpo",
            _imp_prefijar(__map_obtener(nodo, "cuerpo"), prefijo, propias, importadas));
        nodo = __map_poner(nodo, "sino",
            _imp_prefijar(__map_obtener(nodo, "sino"), prefijo, propias, importadas));
        retornar nodo;
    }
    si (tp == "While") {
        nodo = __map_poner(nodo, "cond",
            _imp_prefijar(__map_obtener(nodo, "cond"), prefijo, propias, importadas));
        nodo = __map_poner(nodo, "cuerpo",
            _imp_prefijar(__map_obtener(nodo, "cuerpo"), prefijo, propias, importadas));
        retornar nodo;
    }
    si (tp == "Return") {
        numero vl = __map_obtener(nodo, "valor");
        si (a_texto(__map_obtener(vl, "tipo")) != "Vacio") {
            nodo = __map_poner(nodo, "valor",
                _imp_prefijar(vl, prefijo, propias, importadas));
        }
        retornar nodo;
    }
    si (tp == "VarDecl" || tp == "Assign") {
        numero vl = __map_obtener(nodo, "valor");
        si (a_texto(__map_obtener(vl, "tipo")) != "Vacio") {
            nodo = __map_poner(nodo, "valor",
                _imp_prefijar(vl, prefijo, propias, importadas));
        }
        si (__map_contiene(nodo, "target")) {
            nodo = __map_poner(nodo, "target",
                _imp_prefijar(__map_obtener(nodo, "target"), prefijo, propias, importadas));
        }
        retornar nodo;
    }
    si (tp == "ExprStmt") {
        nodo = __map_poner(nodo, "expr",
            _imp_prefijar(__map_obtener(nodo, "expr"), prefijo, propias, importadas));
        retornar nodo;
    }
    retornar nodo;
}

// Lee un archivo de módulo probando rutas: base/, directa, stdlib/, stdlib/compiler/
funcion texto _imp_leer(texto ruta, texto base) {
    si (__file_exists(base + ruta)) { retornar intentar __leer_archivo(base + ruta); }
    si (__file_exists(ruta)) { retornar intentar __leer_archivo(ruta); }
    texto r2 = "stdlib/" + ruta;
    si (__file_exists(r2)) { retornar intentar __leer_archivo(r2); }
    texto r3 = "stdlib/compiler/" + ruta;
    si (__file_exists(r3)) { retornar intentar __leer_archivo(r3); }
    retornar "Error: no se encontró módulo " + ruta;
}

// ¿ruta en el stack de imports (para evitar ciclos)?
funcion booleano _imp_en_stack(numero stack, texto ruta) {
    numero sc = __map_obtener(stack, "cnt");
    numero j = 0;
    mientras (j < sc) {
        si (__map_contiene(stack, a_texto(j)) &&
            a_texto(__map_obtener(stack, a_texto(j))) == ruta) {
            retornar verdadero;
        }
        j = j + 1;
    }
    retornar falso;
}

// Resuelve los imports de un Programa: carga módulos, fusiona funciones prefijadas
funcion numero _imp_resolver_rec(numero prog, numero stack, texto base) {
    numero stmts = __map_obtener(prog, "cuerpo");
    numero sc = __map_obtener(stmts, "cnt");
    numero nuevos = __map_nuevo();
    numero nc = 0;
    numero j = 0;
    mientras (j < sc) {
        numero nd = __map_obtener(stmts, a_texto(j));
        si (a_texto(__map_obtener(nd, "tipo")) == "Import") {
            texto ruta = a_texto(__map_obtener(nd, "ruta"));
            si (!_imp_en_stack(stack, ruta)) {
                texto contenido = _imp_leer(ruta, base);
                si (!__str_starts_with(contenido, "Error:")) {
                    numero stack2 = __map_poner(stack, a_texto(__map_obtener(stack, "cnt")), ruta);
                    stack2 = __map_poner(stack2, "cnt", __map_obtener(stack, "cnt") + 1);
                    numero mod_ast = _imp_resolver_rec(_imp_parse(lexer_tokenizar(contenido)), stack2, base);
                    numero mod_cuerpo = __map_obtener(mod_ast, "cuerpo");
                    texto prefijo = _imp_prefijo(ruta);
                    numero propias = _imp_funcs(mod_cuerpo, "propias");
                    numero importadas = _imp_funcs(mod_cuerpo, "importadas");
                    numero msc = __map_obtener(mod_cuerpo, "cnt");
                    numero mk = 0;
                    mientras (mk < msc) {
                        numero mnd = __map_obtener(mod_cuerpo, a_texto(mk));
                        si (a_texto(__map_obtener(mnd, "tipo")) != "Vacio") {
                            numero pf = _imp_prefijar(mnd, prefijo, propias, importadas);
                            pf = __map_poner(pf, "imp", "1");
                            nuevos = __map_poner(nuevos, a_texto(nc), pf);
                            nc = nc + 1;
                        }
                        mk = mk + 1;
                    }
                }
            }
        } sino {
            nuevos = __map_poner(nuevos, a_texto(nc), nd);
            nc = nc + 1;
        }
        j = j + 1;
    }
    nuevos = __map_poner(nuevos, "cnt", nc);
    numero nprog = __map_nuevo();
    nprog = __map_poner(nprog, "tipo", "Programa");
    nprog = __map_poner(nprog, "cuerpo", nuevos);
    retornar nprog;
}

funcion numero parser_parse_con_base(numero tokens, texto base) {
    numero st = __map_nuevo();
    st = __map_poner(st, "tokens", tokens);
    st = __map_poner(st, "pos", 0);
    st = __map_poner(st, "cnt", __map_obtener(tokens, "cnt"));
    numero r = _parse_prog(st);
    numero prog = __map_obtener(r, "node");
    numero stack = __map_nuevo();
    stack = __map_poner(stack, "cnt", 0);
    retornar _imp_resolver_rec(prog, stack, base);
}

funcion numero parser_parse(numero tokens) {
    retornar parser_parse_con_base(tokens, "");
}

funcion numero parser_parsear(numero tokens) {
    retornar parser_parse(tokens);
}

// API con directorio base para resolver imports relativos al archivo principal
funcion numero parser_parsear_con_base(numero tokens, texto base) {
    retornar parser_parse_con_base(tokens, base);
}

// ═══════════════════════════════════════════════════════════════
// ── AST Printer ─────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════

funcion texto ast_a_texto(numero nodo, entero prof) {
    texto tp = a_texto(__map_obtener(nodo, "tipo"));
    texto pad = "";
    entero i = 0;
    mientras (i < prof) { pad = pad + "  "; i = i + 1; }

    si (tp == "Programa") {
        texto r = pad + "Programa\n";
        numero stmts = __map_obtener(nodo, "cuerpo");
        numero sc = __map_obtener(stmts, "cnt");
        numero j = 0;
        mientras (j < sc) {
            r = r + ast_a_texto(__map_obtener(stmts, a_texto(j)), prof + 1);
            j = j + 1;
        }
        retornar r;
    }
    si (tp == "VarDecl") {
        texto r = pad + "VarDecl(";
        r = r + a_texto(__map_obtener(nodo, "tipo_var"));
        r = r + " " + a_texto(__map_obtener(nodo, "nombre"));
        numero vl = __map_obtener(nodo, "valor");
        si (a_texto(__map_obtener(vl, "tipo")) != "Vacio") {
            r = r + " = " + ast_a_texto(vl, 0);
        }
        retornar r + ")\n";
    }
    si (tp == "Assign") {
        texto r = pad + "Assign(";
        r = r + a_texto(__map_obtener(nodo, "nombre"));
        r = r + " = " + ast_a_texto(__map_obtener(nodo, "valor"), 0);
        retornar r + ")\n";
    }
    si (tp == "If") {
        texto r = pad + "If\n";
        r = r + pad + "  cond: ";
        r = r + ast_a_texto(__map_obtener(nodo, "cond"), 0);
        r = r + pad + "  cuerpo:\n";
        r = r + ast_a_texto(__map_obtener(nodo, "cuerpo"), prof + 2);
        numero _else = __map_obtener(nodo, "sino");
        si (a_texto(__map_obtener(_else, "tipo")) != "Vacio") {
            r = r + pad + "  sino:\n";
            r = r + ast_a_texto(_else, prof + 2);
        }
        retornar r;
    }
    si (tp == "While") {
        texto r = pad + "While\n";
        r = r + pad + "  cond: ";
        r = r + ast_a_texto(__map_obtener(nodo, "cond"), 0);
        r = r + pad + "  cuerpo:\n";
        r = r + ast_a_texto(__map_obtener(nodo, "cuerpo"), prof + 2);
        retornar r;
    }
    si (tp == "Return") {
        numero vl = __map_obtener(nodo, "valor");
        si (a_texto(__map_obtener(vl, "tipo")) == "Vacio") {
            retornar pad + "Return\n";
        }
        retornar pad + "Return(" + ast_a_texto(vl, 0) + ")\n";
    }
    si (tp == "Func") {
        texto r = pad + "Func(";
        r = r + a_texto(__map_obtener(nodo, "nombre"));
        r = r + " -> " + a_texto(__map_obtener(nodo, "tipo_ret"));
        r = r + ")\n";
        numero prms = __map_obtener(nodo, "params");
        numero pc = __map_obtener(prms, "cnt");
        numero j = 0;
        mientras (j < pc) {
            numero p = __map_obtener(prms, a_texto(j));
            r = r + pad + "  param: ";
            r = r + a_texto(__map_obtener(p, "tipo"));
            r = r + " " + a_texto(__map_obtener(p, "nombre"));
            r = r + "\n";
            j = j + 1;
        }
        r = r + ast_a_texto(__map_obtener(nodo, "cuerpo"), prof + 1);
        retornar r;
    }
    si (tp == "Block") {
        texto r = pad + "Block\n";
        numero stmts = __map_obtener(nodo, "cuerpo");
        numero sc = __map_obtener(stmts, "cnt");
        numero j = 0;
        mientras (j < sc) {
            r = r + ast_a_texto(__map_obtener(stmts, a_texto(j)), prof + 1);
            j = j + 1;
        }
        retornar r;
    }
    si (tp == "Call") {
        texto cl = a_texto(__map_obtener(nodo, "callee"));
        numero args = __map_obtener(nodo, "args");
        numero ac = __map_obtener(args, "cnt");
        texto r = pad + "Call(" + cl;
        numero j = 0;
        mientras (j < ac) {
            r = r + " " + ast_a_texto(__map_obtener(args, a_texto(j)), 0);
            j = j + 1;
        }
        retornar r + ")\n";
    }
    si (tp == "Binary") {
        texto r = pad + "Binary(";
        r = r + ast_a_texto(__map_obtener(nodo, "izq"), 0);
        r = r + " " + a_texto(__map_obtener(nodo, "op")) + " ";
        r = r + ast_a_texto(__map_obtener(nodo, "der"), 0);
        retornar r + ")\n";
    }
    si (tp == "Unary") {
        texto r = pad + "Unary(";
        r = r + a_texto(__map_obtener(nodo, "op"));
        r = r + ast_a_texto(__map_obtener(nodo, "expr"), 0);
        retornar r + ")\n";
    }
    si (tp == "Ident") { retornar a_texto(__map_obtener(nodo, "nombre")); }
    si (tp == "Literal") { retornar a_texto(__map_obtener(nodo, "v")); }
    si (tp == "Texto") {
        retornar "\"" + a_texto(__map_obtener(nodo, "v")) + "\"";
    }
    si (tp == "Bool") { retornar a_texto(__map_obtener(nodo, "v")); }
    si (tp == "ExprStmt") {
        retornar pad + ast_a_texto(__map_obtener(nodo, "expr"), prof);
    }
    si (tp == "Import") {
        retornar pad + "Import(" + a_texto(__map_obtener(nodo, "ruta")) + ")\n";
    }
    si (tp == "Break") { retornar pad + "Break\n"; }
    si (tp == "Continue") { retornar pad + "Continue\n"; }
    si (tp == "Vacio") { retornar ""; }
    retornar pad + tp + "(?)\n";
}

funcion texto ast_to_text(numero nodo, entero prof) {
    retornar ast_a_texto(nodo, prof);
}

// stdlib/compiler/codegen.nv — Codegen LUMEN
// AST → bytecode (instrucciones) — AST → bytecode (instructions)
// Dual ES/EN API

// ── Opcodes ───────────────────────────────────────────────────
numero OP_PUSH_NUM = 1;
numero OP_PUSH_STR = 2;
numero OP_PUSH_INT = 3;
numero OP_PUSH_BOOL = 4;
numero OP_ADD = 5;
numero OP_SUB = 6;
numero OP_MUL = 7;
numero OP_DIV = 8;
numero OP_MOD = 9;
numero OP_EQ = 10;
numero OP_NEQ = 11;
numero OP_LT = 12;
numero OP_LE = 13;
numero OP_GT = 14;
numero OP_GE = 15;
numero OP_AND = 16;
numero OP_OR = 17;
numero OP_NOT = 18;
numero OP_NEG = 19;
numero OP_STORE = 20;
numero OP_LOAD = 21;
numero OP_JMP = 22;
numero OP_JMP_IF = 23;
numero OP_CALL = 24;
numero OP_RET = 25;
numero OP_PRINT = 26;
numero OP_HALT = 27;
numero OP_ARRAY_NEW = 28;
numero OP_ARRAY_GET = 29;
numero OP_ARRAY_SET = 30;
numero OP_ENUM_CTOR = 43;
numero OP_ENUM_VAR = 44;
numero OP_ENUM_ARGC = 45;

// ── Estructura de bytecode ──────────────────────────────────
// Una instrucción es un mapa: {op: opcode, arg: valor}

funcion numero _instr(numero op, numero arg) {
    numero i = __map_nuevo();
    i = __map_poner(i, "op", op);
    i = __map_poner(i, "arg", arg);
    retornar i;
}

funcion numero _codegen_nuevo() {
    numero cg = __map_nuevo();
    cg = __map_poner(cg, "instrs", __map_nuevo());
    cg = __map_poner(cg, "pos", 0);
    cg = __map_poner(cg, "strings", __map_nuevo());
    cg = __map_poner(cg, "str_cnt", 0);
    cg = __map_poner(cg, "ints", __map_nuevo());
    cg = __map_poner(cg, "int_cnt", 0);
    cg = __map_poner(cg, "funcs", __map_nuevo());
    cg = __map_poner(cg, "func_cnt", 0);
    cg = __map_poner(cg, "loop_stack", __map_nuevo());
    cg = __map_poner(cg, "loop_cnt", 0);
    retornar cg;
}

funcion numero _cg_emit(numero cg, numero instr) {
    numero p = __map_obtener(cg, "pos");
    cg = __map_poner(cg, "instrs", __map_poner(__map_obtener(cg, "instrs"), a_texto(p), instr));
    cg = __map_poner(cg, "pos", p + 1);
    retornar cg;
}

funcion numero _cg_add_str(numero cg, numero s) {
    numero strs = __map_obtener(cg, "strings");
    numero sc = __map_obtener(cg, "str_cnt");
    // Check if string already exists
    numero i = 0;
    mientras i < sc {
        si __map_obtener(strs, a_texto(i)) == s { cg = __map_poner(cg, "str_tmp", i); retornar cg; }
        i = i + 1;
    }
    cg = __map_poner(cg, "strings", __map_poner(strs, a_texto(sc), s));
    cg = __map_poner(cg, "str_cnt", sc + 1);
    cg = __map_poner(cg, "str_tmp", sc);
    retornar cg;
}

funcion numero _cg_add_int(numero cg, numero n) {
    numero ints = __map_obtener(cg, "ints");
    numero ic = __map_obtener(cg, "int_cnt");
    numero i = 0;
    mientras i < ic {
        si __map_obtener(ints, a_texto(i)) == n { cg = __map_poner(cg, "int_tmp", i); retornar cg; }
        i = i + 1;
    }
    cg = __map_poner(cg, "ints", __map_poner(ints, a_texto(ic), n));
    cg = __map_poner(cg, "int_cnt", ic + 1);
    cg = __map_poner(cg, "int_tmp", ic);
    retornar cg;
}

funcion numero _cg_emit_jmp(numero cg, numero target) {
    cg = _cg_add_int(cg, target);
    numero idx = __map_obtener(cg, "int_tmp");
    cg = _cg_emit(cg, _instr(OP_JMP, idx));
    retornar cg;
}

// Patch the arg of a previously emitted jump/jmp_if instruction
funcion numero _cg_patch(numero cg, numero instr_p, numero target) {
    numero instrs = __map_obtener(cg, "instrs");
    numero instr = __map_obtener(instrs, a_texto(instr_p));
    cg = _cg_add_int(cg, target);
    instr = __map_poner(instr, "arg", __map_obtener(cg, "int_tmp"));
    cg = __map_poner(cg, "instrs", __map_poner(instrs, a_texto(instr_p), instr));
    retornar cg;
}

funcion numero _cg_emit_jmp_if(numero cg, numero target) {
    cg = _cg_add_int(cg, target);
    numero idx = __map_obtener(cg, "int_tmp");
    cg = _cg_emit(cg, _instr(OP_JMP_IF, idx));
    retornar cg;
}

//   JmpIf salta cuando el valor es FALSY. Eval con short-circuit para && y ||:
//   &&: izq falsy -> false; der falsy -> false; ambos -> true
//   ||: izq truthy -> true; si no, der decide
funcion numero _cg_and_or(numero cg, numero izq, numero der, numero es_and) {
    si es_and == 1 {
        cg = _gen_expr(cg, izq);
        numero j1 = __map_obtener(cg, "pos");
        cg = _cg_emit_jmp_if(cg, 0);
        cg = _gen_expr(cg, der);
        numero j2 = __map_obtener(cg, "pos");
        cg = _cg_emit_jmp_if(cg, 0);
        cg = _cg_add_int(cg, 1);
        cg = _cg_emit(cg, _instr(OP_PUSH_BOOL, __map_obtener(cg, "int_tmp")));
        numero jm = __map_obtener(cg, "pos");
        cg = _cg_emit_jmp(cg, 0);
        numero lf = __map_obtener(cg, "pos");
        cg = _cg_add_int(cg, 0);
        cg = _cg_emit(cg, _instr(OP_PUSH_BOOL, __map_obtener(cg, "int_tmp")));
        numero le = __map_obtener(cg, "pos");
        cg = _cg_patch(cg, j1, lf);
        cg = _cg_patch(cg, j2, lf);
        cg = _cg_patch(cg, jm, le);
        retornar cg;
    }
    // OR
    cg = _gen_expr(cg, izq);
    numero k1 = __map_obtener(cg, "pos");
    cg = _cg_emit_jmp_if(cg, 0);
    cg = _cg_add_int(cg, 1);
    cg = _cg_emit(cg, _instr(OP_PUSH_BOOL, __map_obtener(cg, "int_tmp")));
    numero km = __map_obtener(cg, "pos");
    cg = _cg_emit_jmp(cg, 0);
    numero lb = __map_obtener(cg, "pos");
    cg = _gen_expr(cg, der);
    numero k2 = __map_obtener(cg, "pos");
    cg = _cg_emit_jmp_if(cg, 0);
    cg = _cg_add_int(cg, 1);
    cg = _cg_emit(cg, _instr(OP_PUSH_BOOL, __map_obtener(cg, "int_tmp")));
    numero jm2 = __map_obtener(cg, "pos");
    cg = _cg_emit_jmp(cg, 0);
    numero lf2 = __map_obtener(cg, "pos");
    cg = _cg_add_int(cg, 0);
    cg = _cg_emit(cg, _instr(OP_PUSH_BOOL, __map_obtener(cg, "int_tmp")));
    numero le2 = __map_obtener(cg, "pos");
    cg = _cg_patch(cg, k1, lb);
    cg = _cg_patch(cg, km, le2);
    cg = _cg_patch(cg, k2, lf2);
    cg = _cg_patch(cg, jm2, le2);
    retornar cg;
}

funcion numero _cg_emit_call(numero cg, numero name, numero argc) {
    // Default params: inline missing defaults antes del Call (como el IR de Rust)
    numero funcs = __map_obtener(cg, "funcs");
    numero fcnt = __map_obtener(cg, "func_cnt");
    numero fi = 0;
    mientras fi < fcnt {
        numero f = __map_obtener(funcs, a_texto(fi));
        si a_texto(__map_obtener(f, "nombre")) == a_texto(name) {
            numero params = __map_obtener(f, "params");
            numero pcnt = __map_obtener(params, "cnt");
            numero pd = __map_obtener(f, "defectos");
            numero ai2 = argc;
            mientras ai2 < pcnt {
                numero d = __map_obtener(pd, a_texto(ai2));
                si d != 0 {
                    cg = _gen_expr(cg, d);
                    argc = argc + 1;
                }
                ai2 = ai2 + 1;
            }
            romper;
        }
        fi = fi + 1;
    }
    cg = _cg_add_str(cg, name);
    numero str_idx = __map_obtener(cg, "str_tmp");
    cg = _cg_add_int(cg, argc);
    numero ai = __map_obtener(cg, "int_tmp");
    cg = _cg_emit(cg, _instr(OP_CALL, str_idx));
    cg = _cg_emit(cg, _instr(OP_CALL, ai));
    retornar cg;
}

// ── Gen: Expression ─────────────────────────────────────────
funcion numero _gen_expr(numero cg, numero node) {
    numero tp = __map_obtener(node, "tipo");
    
    si a_texto(tp) == "Literal" {
        numero v = __map_obtener(node, "v");
        texto vs = a_texto(v);
        cg = _cg_add_int(cg, v);
        si (__str_reemplazar(vs, ".", "") != vs) {
            cg = _cg_emit(cg, _instr(OP_PUSH_NUM, __map_obtener(cg, "int_tmp")));
        } sino {
            cg = _cg_emit(cg, _instr(OP_PUSH_INT, __map_obtener(cg, "int_tmp")));
        }
        retornar cg;
    }
    
    si a_texto(tp) == "Ident" {
        numero nombre = __map_obtener(node, "nombre");
        cg = _cg_add_str(cg, nombre);
        cg = _cg_emit(cg, _instr(OP_LOAD, __map_obtener(cg, "str_tmp")));
        retornar cg;
    }
    
    si a_texto(tp) == "Texto" {
        numero v = __map_obtener(node, "v");
        cg = _cg_add_str(cg, v);
        cg = _cg_emit(cg, _instr(OP_PUSH_STR, __map_obtener(cg, "str_tmp")));
        retornar cg;
    }
    
    si a_texto(tp) == "Bool" {
        numero v = __map_obtener(node, "v");
        numero bv = 1;
        si a_texto(v) == "falso" || a_texto(v) == "false" { bv = 0; }
        cg = _cg_add_int(cg, bv);
        cg = _cg_emit(cg, _instr(OP_PUSH_BOOL, __map_obtener(cg, "int_tmp")));
        retornar cg;
    }
    
    si a_texto(tp) == "Call" {
        numero callee = __map_obtener(node, "callee");
        numero args = __map_obtener(node, "args");
        numero argc = __map_obtener(args, "cnt");
        // Builtins: print — one Print per argument, in order
        si a_texto(callee) == "imprimir" || a_texto(callee) == "print" {
            numero pi = 0;
            mientras pi < argc {
                cg = _gen_expr(cg, __map_obtener(args, a_texto(pi)));
                cg = _cg_emit(cg, _instr(OP_PRINT, 0));
                pi = pi + 1;
            }
            retornar cg;
        }
        si a_texto(callee) == "exito" && argc == 1 {
            cg = _gen_expr(cg, __map_obtener(args, "0"));
            cg = _cg_emit(cg, _instr(38, 0)); // ResultOk
            retornar cg;
        }
        si a_texto(callee) == "error" && argc == 1 {
            cg = _gen_expr(cg, __map_obtener(args, "0"));
            cg = _cg_emit(cg, _instr(39, 0)); // ResultErr
            retornar cg;
        }
        si a_texto(callee) == "algun" && argc == 1 {
            cg = _gen_expr(cg, __map_obtener(args, "0"));
            cg = _cg_emit(cg, _instr(41, 0)); // OptionSome
            retornar cg;
        }
        // Generate code for arguments
        numero ai = 0;
        mientras ai < argc {
            cg = _gen_expr(cg, __map_obtener(args, a_texto(ai)));
            ai = ai + 1;
        }
        cg = _cg_emit_call(cg, callee, argc);
        retornar cg;
    }

    si a_texto(tp) == "Assign" {
        numero nombre = __map_obtener(node, "nombre");
        numero valor = __map_obtener(node, "valor");
        si __map_contiene(node, "target") {
            numero target = __map_obtener(node, "target");
            numero obj = __map_obtener(target, "obj");
            numero idx = __map_obtener(target, "idx");
            cg = _gen_expr(cg, obj);
            cg = _gen_expr(cg, idx);
            cg = _gen_expr(cg, valor);
            cg = _cg_emit(cg, _instr(OP_ARRAY_SET, 0));
            cg = _cg_add_str(cg, nombre);
            cg = _cg_emit(cg, _instr(OP_STORE, __map_obtener(cg, "str_tmp")));
        } sino {
            cg = _gen_expr(cg, valor);
            cg = _cg_add_str(cg, nombre);
            cg = _cg_emit(cg, _instr(OP_STORE, __map_obtener(cg, "str_tmp")));
        }
        retornar cg;
    }

    si a_texto(tp) == "StructInit" {
        // Desugar to map creation: __map_nuevo() then __map_poner(...)
        numero aux = __map_nuevo();
        aux = __map_poner(aux, "f", "__map_nuevo");
        numero b_nuevo = __map_obtener(aux, "f");
        cg = _cg_emit_call(cg, b_nuevo, 0);
        numero flds = __map_obtener(node, "campos");
        numero fc = __map_obtener(flds, "cnt");
        numero fi = 0;
        mientras fi < fc {
            numero fitem = __map_obtener(flds, a_texto(fi));
            numero fnm = __map_obtener(fitem, "nombre");
            numero fval = __map_obtener(fitem, "valor");
            cg = _cg_add_str(cg, fnm);
            cg = _cg_emit(cg, _instr(OP_PUSH_STR, __map_obtener(cg, "str_tmp")));
            cg = _gen_expr(cg, fval);
            numero aux2 = __map_nuevo();
            aux2 = __map_poner(aux2, "f", "__map_poner");
            cg = _cg_emit_call(cg, __map_obtener(aux2, "f"), 3);
            fi = fi + 1;
        }
        retornar cg;
    }
    
    si a_texto(tp) == "EnumInit" {
        // EnumCtor triplet: args (en orden), EnumCtor(43, nombre),
        // EnumVar(44, variante), EnumArgc(45, argc) — consecutivas
        numero eargs = __map_obtener(node, "args");
        numero ec = __map_obtener(eargs, "cnt");
        numero ei = 0;
        mientras ei < ec {
            cg = _gen_expr(cg, __map_obtener(eargs, a_texto(ei)));
            ei = ei + 1;
        }
        cg = _cg_add_str(cg, __map_obtener(node, "nombre"));
        cg = _cg_emit(cg, _instr(OP_ENUM_CTOR, __map_obtener(cg, "str_tmp")));
        cg = _cg_add_str(cg, __map_obtener(node, "variante"));
        cg = _cg_emit(cg, _instr(OP_ENUM_VAR, __map_obtener(cg, "str_tmp")));
        cg = _cg_add_int(cg, ec);
        cg = _cg_emit(cg, _instr(OP_ENUM_ARGC, __map_obtener(cg, "int_tmp")));
        retornar cg;
    }
    
    si a_texto(tp) == "Binary" {
        numero op = __map_obtener(node, "op");
        numero izq = __map_obtener(node, "izq");
        numero der = __map_obtener(node, "der");
        si a_texto(op) == "&&" { retornar _cg_and_or(cg, izq, der, 1); }
        si a_texto(op) == "||" { retornar _cg_and_or(cg, izq, der, 0); }
        cg = _gen_expr(cg, izq);
        cg = _gen_expr(cg, der);
        
        si a_texto(op) == "+" { cg = _cg_emit(cg, _instr(OP_ADD, 0)); }
        si a_texto(op) == "-" { cg = _cg_emit(cg, _instr(OP_SUB, 0)); }
        si a_texto(op) == "*" { cg = _cg_emit(cg, _instr(OP_MUL, 0)); }
        si a_texto(op) == "/" { cg = _cg_emit(cg, _instr(OP_DIV, 0)); }
        si a_texto(op) == "%" { cg = _cg_emit(cg, _instr(OP_MOD, 0)); }
        si a_texto(op) == "<" { cg = _cg_emit(cg, _instr(OP_LT, 0)); }
        si a_texto(op) == ">" { cg = _cg_emit(cg, _instr(OP_GT, 0)); }
        si a_texto(op) == "==" { cg = _cg_emit(cg, _instr(OP_EQ, 0)); }
        si a_texto(op) == "!=" { cg = _cg_emit(cg, _instr(OP_NEQ, 0)); }
        si a_texto(op) == ">=" { cg = _cg_emit(cg, _instr(OP_GE, 0)); }
        si a_texto(op) == "<=" { cg = _cg_emit(cg, _instr(OP_LE, 0)); }
        retornar cg;
    }
    
    si a_texto(tp) == "Intenta" {
        numero expr_n = __map_obtener(node, "expr");
        cg = _gen_expr(cg, expr_n);
        cg = _cg_emit(cg, _instr(40, 0)); // TryUnwrap
        retornar cg;
    }

    si a_texto(tp) == "Lista" {
        numero elems = __map_obtener(node, "elementos");
        numero ec = __map_obtener(elems, "cnt");
        numero ei = 0;
        mientras ei < ec {
            cg = _gen_expr(cg, __map_obtener(elems, a_texto(ei)));
            ei = ei + 1;
        }
        cg = _cg_add_int(cg, ec);
        cg = _cg_emit(cg, _instr(OP_ARRAY_NEW, __map_obtener(cg, "int_tmp")));
        retornar cg;
    }
    
    si a_texto(tp) == "Index" {
        numero obj = __map_obtener(node, "obj");
        numero idx = __map_obtener(node, "idx");
        cg = _gen_expr(cg, obj);
        cg = _gen_expr(cg, idx);
        cg = _cg_emit(cg, _instr(OP_ARRAY_GET, 0));
        retornar cg;
    }
    
    si a_texto(tp) == "Exito" {
        numero expr_n = __map_obtener(node, "expr");
        cg = _gen_expr(cg, expr_n);
        cg = _cg_emit(cg, _instr(38, 0)); // ResultOk
        retornar cg;
    }
    
    si a_texto(tp) == "Error" {
        numero expr_n = __map_obtener(node, "expr");
        cg = _gen_expr(cg, expr_n);
        cg = _cg_emit(cg, _instr(39, 0)); // ResultErr
        retornar cg;
    }
    
    si a_texto(tp) == "Ninguno" {
        cg = _cg_emit(cg, _instr(42, 0)); // OptionNone
        retornar cg;
    }
    
    si a_texto(tp) == "Unary" {
        numero op = __map_obtener(node, "op");
        numero expr_n = __map_obtener(node, "expr");
        cg = _gen_expr(cg, expr_n);
        si a_texto(op) == "-" { cg = _cg_emit(cg, _instr(OP_NEG, 0)); }
        si a_texto(op) == "!" { cg = _cg_emit(cg, _instr(OP_NOT, 0)); }
        retornar cg;
    }
    
    si a_texto(tp) == "Ternario" {
        numero cnd = __map_obtener(node, "cond");
        numero sv = __map_obtener(node, "si");
        numero nv = __map_obtener(node, "no");
        cg = _gen_expr(cg, cnd);
        numero jif_p = __map_obtener(cg, "pos");
        cg = _cg_emit(cg, _instr(OP_JMP_IF, 0));
        cg = _gen_expr(cg, sv);
        numero jmp_p = __map_obtener(cg, "pos");
        cg = _cg_emit(cg, _instr(OP_JMP, 0));
        numero fin = __map_obtener(cg, "pos");
        cg = _cg_patch(cg, jif_p, fin);
        cg = _gen_expr(cg, nv);
        numero fin2 = __map_obtener(cg, "pos");
        cg = _cg_patch(cg, jmp_p, fin2);
        retornar cg;
    }
    
    retornar cg;
}

// ── Gen: Statement ────────────────────────────────────────────
funcion numero _gen_stmts(numero cg, numero stmts) {
    numero i = 0;
    mientras __map_contiene(stmts, a_texto(i)) {
        cg = _gen_stmt(cg, __map_obtener(stmts, a_texto(i)));
        i = i + 1;
    }
    retornar cg;
}

funcion numero _gen_stmt(numero cg, numero stmt) {
    numero tp = __map_obtener(stmt, "tipo");
    
    si a_texto(tp) == "VarDecl" {
        numero nombre = __map_obtener(stmt, "nombre");
        numero valor = __map_obtener(stmt, "valor");
        numero tv = __map_obtener(valor, "tipo");
        si tv != 0 && a_texto(tv) == "Vacio" {
            // Declaración sin inicializador: empujar 0 por defecto
            cg = _cg_add_int(cg, 0);
            cg = _cg_emit(cg, _instr(OP_PUSH_INT, __map_obtener(cg, "int_tmp")));
        } sino {
            cg = _gen_expr(cg, valor);
        }
        cg = _cg_add_str(cg, nombre);
        cg = _cg_emit(cg, _instr(OP_STORE, __map_obtener(cg, "str_tmp")));
        retornar cg;
    }
    
    si a_texto(tp) == "Assign" {
        numero nombre = __map_obtener(stmt, "nombre");
        numero valor = __map_obtener(stmt, "valor");
        si __map_contiene(stmt, "target") {
            numero target = __map_obtener(stmt, "target");
            numero obj = __map_obtener(target, "obj");
            numero idx = __map_obtener(target, "idx");
            cg = _gen_expr(cg, obj);
            cg = _gen_expr(cg, idx);
            cg = _gen_expr(cg, valor);
            cg = _cg_emit(cg, _instr(OP_ARRAY_SET, 0));
            cg = _cg_add_str(cg, nombre);
            cg = _cg_emit(cg, _instr(OP_STORE, __map_obtener(cg, "str_tmp")));
        } sino {
            cg = _gen_expr(cg, valor);
            cg = _cg_add_str(cg, nombre);
            cg = _cg_emit(cg, _instr(OP_STORE, __map_obtener(cg, "str_tmp")));
        }
        retornar cg;
    }
    
    si a_texto(tp) == "Break" {
        numero lst = __map_obtener(cg, "loop_stack");
        numero lc = __map_obtener(cg, "loop_cnt");
        si lc > 0 {
            numero ctx = __map_obtener(lst, a_texto(lc - 1));
            numero brks = __map_obtener(ctx, "breaks");
            numero bcnt = __map_obtener(ctx, "brk_cnt");
            numero jmp_p = __map_obtener(cg, "pos");
            cg = _cg_emit(cg, _instr(OP_JMP, 0));
            brks = __map_poner(brks, a_texto(bcnt), jmp_p);
            ctx = __map_poner(ctx, "breaks", brks);
            ctx = __map_poner(ctx, "brk_cnt", bcnt + 1);
            cg = __map_poner(cg, "loop_stack", __map_poner(lst, a_texto(lc - 1), ctx));
        }
        retornar cg;
    }
    
    si a_texto(tp) == "Continue" {
        numero lst = __map_obtener(cg, "loop_stack");
        numero lc = __map_obtener(cg, "loop_cnt");
        si lc > 0 {
            numero ctx = __map_obtener(lst, a_texto(lc - 1));
            numero cnts = __map_obtener(ctx, "conts");
            numero ccnt = __map_obtener(ctx, "con_cnt");
            numero jmp_p = __map_obtener(cg, "pos");
            cg = _cg_emit(cg, _instr(OP_JMP, 0));
            cnts = __map_poner(cnts, a_texto(ccnt), jmp_p);
            ctx = __map_poner(ctx, "conts", cnts);
            ctx = __map_poner(ctx, "con_cnt", ccnt + 1);
            cg = __map_poner(cg, "loop_stack", __map_poner(lst, a_texto(lc - 1), ctx));
        }
        retornar cg;
    }
    
    si a_texto(tp) == "Return" {
        numero valor = __map_obtener(stmt, "valor");
        numero tv = __map_obtener(valor, "tipo");
        si tv != 0 && a_texto(tv) != "Vacio" {
            cg = _gen_expr(cg, valor);
        }
        cg = _cg_emit(cg, _instr(OP_RET, 0));
        retornar cg;
    }
    
    si a_texto(tp) == "If" {
        numero cond = __map_obtener(stmt, "cond");
        numero cuerpo = __map_obtener(stmt, "cuerpo");
        numero rama_else = __map_obtener(stmt, "sino");
        // Emit condition, then placeholder for JMP_IF
        cg = _gen_expr(cg, cond);
        numero jmp_if_p = __map_obtener(cg, "pos");
        cg = _cg_emit(cg, _instr(OP_JMP_IF, 0));
        // Then body
        cg = _gen_stmt(cg, cuerpo);
        // Check else branch
        numero e_tp = __map_obtener(rama_else, "tipo");
        numero hay_else = 0;
        si e_tp != 0 && a_texto(e_tp) != "Vacio" { hay_else = 1; }
        si hay_else == 1 {
            // Emit JMP past else, then patch JMP_IF to else start
            numero jmp_end_p = __map_obtener(cg, "pos");
            cg = _cg_emit(cg, _instr(OP_JMP, 0));
            numero else_start = __map_obtener(cg, "pos");
            cg = _cg_patch(cg, jmp_if_p, else_start);
            // Emit else branch
            cg = _gen_stmt(cg, rama_else);
            // Patch JMP to past else
            numero end_pos = __map_obtener(cg, "pos");
            cg = _cg_patch(cg, jmp_end_p, end_pos);
        } sino {
            // No else: patch JMP_IF to jump past body
            numero patch_pos = __map_obtener(cg, "pos");
            cg = _cg_patch(cg, jmp_if_p, patch_pos);
        }
        retornar cg;
    }
    
    si a_texto(tp) == "While" {
        // Loop header
        numero loop_start = __map_obtener(cg, "pos");
        numero cond = __map_obtener(stmt, "cond");
        numero cuerpo = __map_obtener(stmt, "cuerpo");
        // Push loop context
        numero lst = __map_obtener(cg, "loop_stack");
        numero lc = __map_obtener(cg, "loop_cnt");
        numero ctx = __map_nuevo();
        ctx = __map_poner(ctx, "start", loop_start);
        ctx = __map_poner(ctx, "breaks", __map_nuevo());
        ctx = __map_poner(ctx, "brk_cnt", 0);
        ctx = __map_poner(ctx, "conts", __map_nuevo());
        ctx = __map_poner(ctx, "con_cnt", 0);
        lst = __map_poner(lst, a_texto(lc), ctx);
        cg = __map_poner(cg, "loop_stack", lst);
        cg = __map_poner(cg, "loop_cnt", lc + 1);
        // Condition
        cg = _gen_expr(cg, cond);
        numero jmp_if_p = __map_obtener(cg, "pos");
        cg = _cg_emit(cg, _instr(OP_JMP_IF, 0));
        // Body
        cg = _gen_stmt(cg, cuerpo);
        // JMP back to loop start
        cg = _cg_add_int(cg, loop_start);
        cg = _cg_emit(cg, _instr(OP_JMP, __map_obtener(cg, "int_tmp")));
        // Patch JMP_IF to jump past body
        numero patch_pos = __map_obtener(cg, "pos");
        cg = _cg_patch(cg, jmp_if_p, patch_pos);
        // Pop loop context + patch breaks → patch_pos, conts → loop_start
        numero lst2 = __map_obtener(cg, "loop_stack");
        numero ctx2 = __map_obtener(lst2, a_texto(lc));
        cg = __map_poner(cg, "loop_cnt", lc);
        numero brks = __map_obtener(ctx2, "breaks");
        numero bcnt = __map_obtener(ctx2, "brk_cnt");
        entero bi = 0;
        mientras bi < bcnt {
            cg = _cg_patch(cg, __map_obtener(brks, a_texto(bi)), patch_pos);
            bi = bi + 1;
        }
        numero cnts = __map_obtener(ctx2, "conts");
        numero ccnt = __map_obtener(ctx2, "con_cnt");
        entero ci = 0;
        mientras ci < ccnt {
            cg = _cg_patch(cg, __map_obtener(cnts, a_texto(ci)), loop_start);
            ci = ci + 1;
        }
        retornar cg;
    }
    
    si a_texto(tp) == "Block" {
        numero cuerpo = __map_obtener(stmt, "cuerpo");
        cg = _gen_stmts(cg, cuerpo);
        retornar cg;
    }
    
    si a_texto(tp) == "ExprStmt" {
        numero expr = __map_obtener(stmt, "expr");
        cg = _gen_expr(cg, expr);
        retornar cg;
    }
    
    si a_texto(tp) == "Func" {
        numero nombre = __map_obtener(stmt, "nombre");
        numero params = __map_obtener(stmt, "params");
        numero cuerpo = __map_obtener(stmt, "cuerpo");
        numero start = __map_obtener(cg, "pos");
        // Register function: {nombre, params: {0:"a",1:"b",cnt}, start}
        numero pn = __map_obtener(params, "cnt");
        numero pm = __map_nuevo();
        entero pi = 0;
        mientras pi < pn {
            numero p = __map_obtener(params, a_texto(pi));
            pm = __map_poner(pm, a_texto(pi), __map_obtener(p, "nombre"));
            pi = pi + 1;
        }
        pm = __map_poner(pm, "cnt", pn);
        numero pd = __map_nuevo();
        entero pj = 0;
        mientras pj < pn {
            numero p = __map_obtener(params, a_texto(pj));
            pd = __map_poner(pd, a_texto(pj), __map_obtener(p, "defecto"));
            pj = pj + 1;
        }
        pd = __map_poner(pd, "cnt", pn);
        numero funcs = __map_obtener(cg, "funcs");
        numero fc = __map_obtener(cg, "func_cnt");
        numero f = __map_nuevo();
        f = __map_poner(f, "nombre", nombre);
        f = __map_poner(f, "params", pm);
        f = __map_poner(f, "defectos", pd);
        f = __map_poner(f, "start", start);
        funcs = __map_poner(funcs, a_texto(fc), f);
        cg = __map_poner(cg, "funcs", funcs);
        cg = __map_poner(cg, "func_cnt", fc + 1);
        // Emit body
        cg = _gen_stmt(cg, cuerpo);
        // Emit RET at end of function
        cg = _cg_emit(cg, _instr(OP_RET, 0));
        retornar cg;
    }
    
    retornar cg;
}

// ── Main Codegen ──────────────────────────────────────────────
// Separa el AST en funciones (registradas en la tabla funcs) y
// código top-level (registrado como __main__), para que la VM
// encuentre el entry point y las funciones llamables.
funcion numero codegen_generar(numero ast) {
    numero cg = _codegen_nuevo();
    
    numero tp = __map_obtener(ast, "tipo");
    numero cuerpo = __map_nuevo();
    numero cnt = 0;
    si a_texto(tp) == "Programa" {
        cuerpo = __map_obtener(ast, "cuerpo");
        cnt = __map_obtener(cuerpo, "cnt");
    } sino {
        cuerpo = __map_poner(cuerpo, "0", ast);
        cuerpo = __map_poner(cuerpo, "cnt", 1);
        cnt = 1;
    }
    
    // Pass 1: emit functions (register + body + RET)
    entero i = 0;
    mientras i < cnt {
        numero stmt = __map_obtener(cuerpo, a_texto(i));
        numero stp = __map_obtener(stmt, "tipo");
        si a_texto(stp) == "Func" {
            cg = _gen_stmt(cg, stmt);
        }
        i = i + 1;
    }
    
    // Register __main__ (top-level code) starting at current pos
    numero main_start = __map_obtener(cg, "pos");
    numero funcs = __map_obtener(cg, "funcs");
    numero fc = __map_obtener(cg, "func_cnt");
    numero pm = __map_nuevo();
    pm = __map_poner(pm, "cnt", 0);
    numero f = __map_nuevo();
    f = __map_poner(f, "nombre", "__main__");
    f = __map_poner(f, "params", pm);
    f = __map_poner(f, "start", main_start);
    funcs = __map_poner(funcs, a_texto(fc), f);
    cg = __map_poner(cg, "funcs", funcs);
    cg = __map_poner(cg, "func_cnt", fc + 1);
    
    // Pass 2: emit top-level (non-Func) statements
    i = 0;
    mientras i < cnt {
        numero stmt = __map_obtener(cuerpo, a_texto(i));
        numero stp = __map_obtener(stmt, "tipo");
        si a_texto(stp) != "Func" {
            cg = _gen_stmt(cg, stmt);
        }
        i = i + 1;
    }
    
    cg = _cg_emit(cg, _instr(OP_HALT, 0));
    retornar cg;
}

funcion numero codegen_generate(numero ast) { retornar codegen_generar(ast); }

// ── Bytecode to string ──────────────────────────────────────
funcion numero _op_name(numero op) {
    si op == 1 { retornar "PUSH_NUM"; }
    si op == 2 { retornar "PUSH_STR"; }
    si op == 3 { retornar "PUSH_INT"; }
    si op == 4 { retornar "PUSH_BOOL"; }
    si op == 5 { retornar "ADD"; }
    si op == 6 { retornar "SUB"; }
    si op == 7 { retornar "MUL"; }
    si op == 8 { retornar "DIV"; }
    si op == 9 { retornar "MOD"; }
    si op == 10 { retornar "EQ"; }
    si op == 11 { retornar "NEQ"; }
    si op == 12 { retornar "LT"; }
    si op == 13 { retornar "LE"; }
    si op == 14 { retornar "GT"; }
    si op == 15 { retornar "GE"; }
    si op == 16 { retornar "AND"; }
    si op == 17 { retornar "OR"; }
    si op == 18 { retornar "NOT"; }
    si op == 19 { retornar "NEG"; }
    si op == 20 { retornar "STORE"; }
    si op == 21 { retornar "LOAD"; }
    si op == 22 { retornar "JMP"; }
    si op == 23 { retornar "JMP_IF"; }
    si op == 24 { retornar "CALL"; }
    si op == 25 { retornar "RET"; }
    si op == 26 { retornar "PRINT"; }
    si op == 27 { retornar "HALT"; }
    retornar a_texto(op);
}

funcion void codegen_imprimir(numero cg) {
    numero instrs = __map_obtener(cg, "instrs");
    numero pos = __map_obtener(cg, "pos");
    numero i = 0;
    mientras i < pos {
        numero instr = __map_obtener(instrs, a_texto(i));
        numero op = __map_obtener(instr, "op");
        numero arg = __map_obtener(instr, "arg");
        imprimir(i, ": ", _op_name(op), " ", arg);
        i = i + 1;
    }
}

funcion void codegen_print(numero cg) { codegen_imprimir(cg); }

// ── Main: compila el target indicado en target.txt ──
// target.txt contiene dos líneas: ruta_entrada .nv / ruta_salida .nvc
funcion numero ejecutar_pipeline() {
    texto tgt = intentar __leer_archivo("stdlib/compiler/target.txt");
    lista<texto> cs = __str_a_caracteres(tgt);
    entero tn = largo(cs);
    entero ti = 0;
    mientras ti < tn && cs[ti] != "\n" && cs[ti] != "\r" { ti = ti + 1; }
    texto entrada = __str_subcadena(tgt, 0, ti);
    entero t2 = ti + 1;
    entero te = t2;
    mientras te < tn && cs[te] != "\n" && cs[te] != "\r" { te = te + 1; }
    texto salida = __str_subcadena(tgt, t2, te);
    imprimir("ENTRADA: ", entrada);
    imprimir("SALIDA: ", salida);

    texto codigo = intentar __leer_archivo(entrada);
    imprimir("Source: ", largo(codigo), " bytes");

    numero tk = lexer_tokenizar(codigo);
    imprimir("Tokens: ", __map_obtener(tk, "cnt"));

    // base = directorio del archivo de entrada (para imports relativos)
    texto base = "";
    entero ib = largo(entrada);
    mientras ib > 0 {
        texto c = __str_subcadena(entrada, ib - 1, ib);
        si (c == "/" || c == "\\") { romper; }
        ib = ib - 1;
    }
    base = __str_subcadena(entrada, 0, ib);

    numero ast = parser_parsear_con_base(tk, base);
    imprimir("AST: ", __map_obtener(ast, "tipo"));

    numero cg = codegen_generar(ast);
    imprimir("Instrs: ", __map_obtener(cg, "pos"));

    lista<entero> bytes = __codegen_a_nvc(cg);
    intentar __escribir_archivo_bin(salida, bytes);
    imprimir("OK: ", salida, " (", largo(bytes), " bytes)");
    retornar 0;
}
numero fin = ejecutar_pipeline();
si (__tipo_de(fin) == "Error") { imprimir("FALLO: ", fin); }