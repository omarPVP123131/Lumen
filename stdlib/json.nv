// Módulo json — parseo y serialización JSON
// JSON module — dual ES/EN API
// Uso: importar "json.nv"

funcion cualquiera parsear(texto s) {
    retornar __json_parsear(s);
}
funcion cualquiera parse(texto s) { retornar parsear(s); }

funcion texto serializar(cualquiera valor) {
    retornar __json_texto(valor);
}
funcion texto stringify(cualquiera value) { retornar serializar(value); }
