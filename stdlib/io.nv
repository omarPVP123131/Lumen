/// Módulo io — operaciones de entrada/salida
/// IO module — file reading, writing, streaming, serial ports
/// Uso: importar "io.nv"
/// Todas las funciones tienen alias en inglés / All functions have English aliases

// ============================================================
// LECTURA / READ
// ============================================================

/// Lee un archivo completo y retorna un buffer de líneas
/// Read entire file and return a line buffer
funcion numero leer_lineas(texto ruta) {
    retornar __lector_buffer(ruta);
}
/// Read entire file (English alias)
funcion numero read_lines(texto path) { retornar leer_lineas(path); }

// ============================================================
// ESCRITURA / WRITE
// ============================================================

/// Escribe contenido a un archivo (retorna Resultado<booleano, texto>)
/// Write content to a file (returns Result<boolean, string>)
funcion resultado<booleano, texto> escribir_buffer(texto ruta, texto contenido) {
    retornar __escritor_buffer(ruta, contenido);
}
/// Write content to a file (English alias)
funcion resultado<booleano, texto> write_buffer(texto path, texto content) { retornar escribir_buffer(path, content); }

// ============================================================
// STREAM / TROZOS
// ============================================================

/// Lee un archivo en trozos de tamaño fijo (retorna un stream)
/// Read a file in fixed-size chunks (returns a stream)
funcion numero leer_trozos(texto ruta, entero tamano) {
    retornar __stream_trozos(ruta, tamano);
}
/// Read file in fixed-size chunks (English alias)
funcion numero read_chunks(texto path, entero size) { retornar leer_trozos(path, size); }

// ============================================================
// SERIAL
// ============================================================

/// Abre un puerto serial para comunicación
/// Open a serial port for communication
funcion booleano abrir_puerto_serial(texto puerto) {
    retornar __serial_abrir(puerto);
}
/// Open a serial port (English alias)
funcion booleano open_serial_port(texto port) { retornar abrir_puerto_serial(port); }
