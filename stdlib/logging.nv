/// Módulo de logging para LÚMEN
/// Uso: importar "logging.nv";
///       logging_info("mensaje");
///       logging_error("error");

/// Niveles de logging
const NIVEL_ERROR = 1;
const NIVEL_WARN = 2;
const NIVEL_INFO = 3;
const NIVEL_DEBUG = 4;

/// Nivel global de logging (cambiar según necesidad)
entero nivel_log = NIVEL_INFO;

/// Registra un mensaje de error
funcion void error(texto msg) {
    si nivel_log >= NIVEL_ERROR {
        imprimir("[ERROR] ", msg);
    }
}
funcion void error(string msg) { error(msg); }

/// Registra una advertencia
funcion void advertencia(texto msg) {
    si nivel_log >= NIVEL_WARN {
        imprimir("[WARN]  ", msg);
    }
}
funcion void warn(string msg) { advertencia(msg); }

/// Registra un mensaje informativo
funcion void info(texto msg) {
    si nivel_log >= NIVEL_INFO {
        imprimir("[INFO]  ", msg);
    }
}
funcion void info(string msg) { info(msg); }

/// Registra un mensaje de debug
funcion void debug(texto msg) {
    si nivel_log >= NIVEL_DEBUG {
        imprimir("[DEBUG] ", msg);
    }
}
funcion void debug(string msg) { debug(msg); }

/// Establece el nivel de logging
funcion void establecer_nivel(entero n) {
    nivel_log = n;
}
funcion void set_level(integer n) { establecer_nivel(n); }

/// Formatea y registra un mensaje con formato
funcion void formato(texto fmt, texto a1) {
    info(fmt + a1);
}
funcion void format(string fmt, string a1) { formato(fmt, a1); }
