// Modulo de logging para LUMEN
// Logging module for LUMEN - dual ES/EN API
// Uso: importar "logging.nv"

// Niveles de logging / Logging levels
entero LOG_ERROR = 1;
entero LOG_WARN = 2;
entero LOG_INFO = 3;
entero LOG_DEBUG = 4;

// Nivel global de logging / Global logging level
entero nivel_log = LOG_INFO;

// Registra un mensaje de error / Log an error message
funcion void log_error(texto msg) {
    si nivel_log >= LOG_ERROR {
        imprimir("[ERROR] ", msg);
    }
}

// Registra una advertencia / Log a warning
funcion void log_warn(texto msg) {
    si nivel_log >= LOG_WARN {
        imprimir("[WARN]  ", msg);
    }
}

// Registra un mensaje informativo / Log an info message
funcion void info(texto msg) {
    si nivel_log >= LOG_INFO {
        imprimir("[INFO]  ", msg);
    }
}

// Registra un mensaje de debug / Log a debug message
funcion void debug(texto msg) {
    si nivel_log >= LOG_DEBUG {
        imprimir("[DEBUG] ", msg);
    }
}

// Establece el nivel de logging / Set the logging level
funcion void establecer_nivel(entero n) {
    nivel_log = n;
}

// Obtiene el nivel actual / Get current level
funcion entero obtener_nivel() {
    retornar nivel_log;
}
