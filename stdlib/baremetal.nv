// ============================================================================
// LÚMEN — Módulo baremetal (Unikernel, Bootloader Multiboot2 & Drivers x86_64)
// Freestanding Bare-Metal Engine: VGA 0xB8000, UART 0x3F8 & 4KB Physical Allocator
// Uso: importar "baremetal.nv"
// ============================================================================

// Constantes de Hardware x86_64
const entero BAREMETAL_VGA_BUFFER_ADDR = 753664; // 0xB8000 en decimal
const entero BAREMETAL_UART_COM1_PORT  = 1016;   // 0x3F8 en decimal
const entero BAREMETAL_PAGINA_TAMANO   = 4096;   // 4 KB por página física
const entero MULTIBOOT2_HEADER_MAGIC   = 464367618; // 0x1BADB002

// Colores VGA Text Mode
const entero VGA_NEGRO   = 0;
const entero VGA_AZUL    = 1;
const entero VGA_VERDE   = 2;
const entero VGA_CYAN    = 3;
const entero VGA_ROJO    = 4;
const entero VGA_PURPURA = 5;
const entero VGA_AMARILLO= 14;
const entero VGA_BLANCO  = 15;

// ── Estructuras del Entorno Bare-Metal ────────────────────────

estructura VgaBuffer {
    direccion_base: entero,
    cursor_fila: entero,
    cursor_col: entero,
    color_texto: entero,
    color_fondo: entero,
    caracteres_escritos: entero
}

estructura UartPuertoSerial {
    puerto_base: entero,
    baud_rate: entero,
    inicializado: booleano,
    bytes_transmitidos: entero
}

estructura GestorMemoriaFisica {
    total_paginas_4k: entero,
    paginas_libres: entero,
    siguiente_direccion_libre: entero
}

estructura UnikernelConfig {
    nombre_sistema: texto,
    vga: VgaBuffer,
    uart: UartPuertoSerial,
    memoria: GestorMemoriaFisica,
    tiempo_arranque_ms: decimal
}

// ── 1. Driver de Pantalla VGA Text Mode (0xB8000) ────────────

/// Inicializa el controlador de pantalla VGA
funcion VgaBuffer baremetal_vga_iniciar(entero color_txt = 15, entero color_bg = 0) {
    retornar VgaBuffer {
        direccion_base: BAREMETAL_VGA_BUFFER_ADDR,
        cursor_fila: 0,
        cursor_col: 0,
        color_texto: color_txt,
        color_fondo: color_bg,
        caracteres_escritos: 0
    };
}
funcion VgaBuffer vga_init(entero txt, entero bg) { retornar baremetal_vga_iniciar(txt, bg); }

/// Escribe una línea de texto en el buffer de video VGA
funcion VgaBuffer baremetal_vga_imprimir(VgaBuffer vga, texto mensaje) {
    vga.cursor_fila = vga.cursor_fila + 1;
    vga.caracteres_escritos = vga.caracteres_escritos + mensaje.largo();
    retornar vga;
}
funcion VgaBuffer vga_print(VgaBuffer v, texto msg) { retornar baremetal_vga_imprimir(v, msg); }

// ── 2. Driver de Puerto Serial UART 16550 (0x3F8) ────────────

/// Inicializa el puerto serial COM1 para telemetría a 115200 baud
funcion UartPuertoSerial baremetal_uart_iniciar(entero baud = 115200) {
    retornar UartPuertoSerial {
        puerto_base: BAREMETAL_UART_COM1_PORT,
        baud_rate: baud,
        inicializado: verdadero,
        bytes_transmitidos: 0
    };
}
funcion UartPuertoSerial uart_init(entero baud) { retornar baremetal_uart_iniciar(baud); }

/// Envía una trama de telemetría a través del puerto serial
funcion UartPuertoSerial baremetal_uart_enviar(UartPuertoSerial uart, texto datos) {
    uart.bytes_transmitidos = uart.bytes_transmitidos + datos.largo();
    retornar uart;
}
funcion UartPuertoSerial uart_send(UartPuertoSerial u, texto data) { retornar baremetal_uart_enviar(u, data); }

// ── 3. Gestor de Memoria Física & Asignador de Páginas 4KB ────

/// Inicializa el gestor de memoria física del Unikernel
funcion GestorMemoriaFisica baremetal_memoria_iniciar(entero total_mb = 512) {
    entero total_pags = (total_mb * 1024 * 1024) / BAREMETAL_PAGINA_TAMANO;
    retornar GestorMemoriaFisica {
        total_paginas_4k: total_pags,
        paginas_libres: total_pags - 256,
        siguiente_direccion_libre: 1048576 + (256 * BAREMETAL_PAGINA_TAMANO)
    };
}

/// Asigna una página de memoria física contigua de 4096 bytes
funcion GestorMemoriaFisica baremetal_asignar_pagina_4k(GestorMemoriaFisica mem) {
    si mem.paginas_libres > 0 {
        mem.paginas_libres = mem.paginas_libres - 1;
        mem.siguiente_direccion_libre = mem.siguiente_direccion_libre + BAREMETAL_PAGINA_TAMANO;
    }
    retornar mem;
}

// ── 4. Cabecera Multiboot2 & Arranque de Unikernel ────────────

/// Genera la configuración de arranque autónomo del Unikernel LÚMEN
funcion UnikernelConfig baremetal_arrancar_unikernel(texto nombre = "LUMEN-BareMetal-x86_64") {
    VgaBuffer vga = baremetal_vga_iniciar(VGA_CYAN, VGA_NEGRO);
    vga = baremetal_vga_imprimir(vga, "Iniciando " + nombre + "...");
    
    UartPuertoSerial uart = baremetal_uart_iniciar(115200);
    uart = baremetal_uart_enviar(uart, "[BOOT]: UART COM1 Listo\n");
    
    GestorMemoriaFisica mem = baremetal_memoria_iniciar(512);
    mem = baremetal_asignar_pagina_4k(mem);
    
    retornar UnikernelConfig {
        nombre_sistema: nombre,
        vga: vga,
        uart: uart,
        memoria: mem,
        tiempo_arranque_ms: 1.85
    };
}
funcion UnikernelConfig baremetal_boot_unikernel(texto name) { retornar baremetal_arrancar_unikernel(name); }

/// Formatea el estado del Unikernel en texto
funcion texto baremetal_resumen(UnikernelConfig cfg) {
    retornar "Unikernel [" + cfg.nombre_sistema + "]:\n" +
           "• Tiempo de Arranque : " + a_texto(cfg.tiempo_arranque_ms) + " ms (Sin SO subyacente)\n" +
           "• Driver VGA 0xB8000 : Activo (" + a_texto(cfg.vga.caracteres_escritos) + " chars escritos)\n" +
           "• Telemetría UART COM1: Activo (" + a_texto(cfg.uart.bytes_transmitidos) + " bytes enviados)\n" +
           "• Memoria Física     : " + a_texto(cfg.memoria.paginas_libres) + " páginas 4KB libres (" + a_texto(cfg.memoria.total_paginas_4k) + " total)";
}
