// Módulo tui_temas — Sistema de temas para Terminal UI
// TUI Themes module — Theming system for Terminal UI
// Uso: importar "tui_temas.nv"
// Requiere: tui_core.nv para aplicar colores ANSI

importar "tui_core.nv";
importar "texto.nv";

// ============================================================
// ESTRUCTURA DE TEMA / THEME STRUCTURE
// ============================================================

/// Tema de colores para la interfaz TUI
/// Colores basados en paleta ANSI 0-255
estructura TemaTUI {
    nombre: texto,
    fondo: entero,
    texto: entero,
    borde: entero,
    titulo: entero,
    seleccion: entero,
    seleccion_texto: entero,
    boton: entero,
    boton_texto: entero,
    error: entero,
    exito: entero,
    advertencia: entero,
    informacion: entero,
    borde_estilo: entero,    // 0=simple 1=redondeado 2=doble 3=grueso
    padding: entero,
    separacion: entero,
}
/// Theme structure for TUI (English alias)
estructura ThemeTUI {
    name: string,
    bg: integer,
    text: integer,
    border: integer,
    title: integer,
    selection: integer,
    selection_text: integer,
    button: integer,
    button_text: integer,
    error: integer,
    success: integer,
    warning: integer,
    info: integer,
    border_style: integer,   // 0=simple 1=rounded 2=double 3=thick
    padding: integer,
    spacing: integer,
}

// ============================================================
// REGISTRO GLOBAL DE TEMAS / GLOBAL THEME REGISTRY
// ============================================================

lista<TemaTUI> __temas = [];
entero __tema_activo = 0;

// ============================================================
// PRESETS / PRESET THEMES
// ============================================================

/// Tema predeterminado (Catppuccin Mocha-inspired, dark blue/cyan)
funcion TemaTUI tema_predeterminado() {
    retornar TemaTUI {
        nombre: "Predeterminado",
        fondo: 17,              // dark blue
        texto: 255,             // white
        borde: 33,              // cyan
        titulo: 214,            // yellow
        seleccion: 27,          // blue
        seleccion_texto: 231,   // white bright
        boton: 240,             // gray
        boton_texto: 255,       // white
        error: 196,             // red
        exito: 46,              // green
        advertencia: 214,       // yellow
        informacion: 33,        // cyan
        borde_estilo: 1,        // rounded
        padding: 1,
        separacion: 1,
    };
}
/// Default theme (Catppuccin Mocha-inspired, dark blue/cyan)
funcion ThemeTUI default_theme() {
    TemaTUI t = tema_predeterminado();
    retornar ThemeTUI {
        name: t.nombre, bg: t.fondo, text: t.texto,
        border: t.borde, title: t.titulo,
        selection: t.seleccion, selection_text: t.seleccion_texto,
        button: t.boton, button_text: t.boton_texto,
        error: t.error, success: t.exito,
        warning: t.advertencia, info: t.informacion,
        border_style: t.borde_estilo, padding: t.padding, spacing: t.separacion,
    };
}

/// Tema claro (light theme)
funcion TemaTUI tema_claro() {
    retornar TemaTUI {
        nombre: "Claro",
        fondo: 231,             // white
        texto: 16,              // black
        borde: 33,              // cyan
        titulo: 20,             // dark blue
        seleccion: 75,          // light blue
        seleccion_texto: 16,    // black
        boton: 250,             // light gray
        boton_texto: 16,        // black
        error: 196,             // red
        exito: 34,              // green
        advertencia: 214,       // yellow
        informacion: 33,        // cyan
        borde_estilo: 0,        // simple
        padding: 1,
        separacion: 1,
    };
}
/// Light theme
funcion ThemeTUI light_theme() {
    TemaTUI t = tema_claro();
    retornar ThemeTUI {
        name: t.nombre, bg: t.fondo, text: t.texto,
        border: t.borde, title: t.titulo,
        selection: t.seleccion, selection_text: t.seleccion_texto,
        button: t.boton, button_text: t.boton_texto,
        error: t.error, success: t.exito,
        warning: t.advertencia, info: t.informacion,
        border_style: t.borde_estilo, padding: t.padding, spacing: t.separacion,
    };
}

/// Tema oscuro (Catppuccin-like dark)
funcion TemaTUI tema_oscuro() {
    retornar TemaTUI {
        nombre: "Oscuro",
        fondo: 0,               // black
        texto: 255,             // white
        borde: 27,              // blue
        titulo: 214,            // yellow
        seleccion: 99,          // purple-blue
        seleccion_texto: 231,   // white bright
        boton: 235,             // dark gray
        boton_texto: 255,       // white
        error: 196,             // red
        exito: 46,              // green
        advertencia: 214,       // yellow
        informacion: 51,        // bright cyan
        borde_estilo: 2,        // double
        padding: 2,
        separacion: 1,
    };
}
/// Dark theme (Catppuccin-like)
funcion ThemeTUI dark_theme() {
    TemaTUI t = tema_oscuro();
    retornar ThemeTUI {
        name: t.nombre, bg: t.fondo, text: t.texto,
        border: t.borde, title: t.titulo,
        selection: t.seleccion, selection_text: t.seleccion_texto,
        button: t.boton, button_text: t.boton_texto,
        error: t.error, success: t.exito,
        warning: t.advertencia, info: t.informacion,
        border_style: t.borde_estilo, padding: t.padding, spacing: t.separacion,
    };
}

/// Tema de alto contraste (accesibilidad)
funcion TemaTUI tema_alto_contraste() {
    retornar TemaTUI {
        nombre: "Alto Contraste",
        fondo: 0,               // black
        texto: 255,             // white
        borde: 255,             // white
        titulo: 226,            // bright yellow
        seleccion: 51,          // bright cyan
        seleccion_texto: 0,     // black
        boton: 255,             // white
        boton_texto: 0,         // black
        error: 196,             // bright red
        exito: 46,              // bright green
        advertencia: 226,       // bright yellow
        informacion: 51,        // bright cyan
        borde_estilo: 0,        // simple
        padding: 2,
        separacion: 2,
    };
}
/// High contrast theme (accessibility)
funcion ThemeTUI high_contrast_theme() {
    TemaTUI t = tema_alto_contraste();
    retornar ThemeTUI {
        name: t.nombre, bg: t.fondo, text: t.texto,
        border: t.borde, title: t.titulo,
        selection: t.seleccion, selection_text: t.seleccion_texto,
        button: t.boton, button_text: t.boton_texto,
        error: t.error, success: t.exito,
        warning: t.advertencia, info: t.informacion,
        border_style: t.borde_estilo, padding: t.padding, spacing: t.separacion,
    };
}

// ============================================================
// REGISTRO Y SELECCIÓN / REGISTRATION AND SELECTION
// ============================================================

/// Inicializa el sistema de temas con los 4 temas predefinidos
funcion void temas_iniciar() {
    __temas = [
        tema_predeterminado(),
        tema_claro(),
        tema_oscuro(),
        tema_alto_contraste(),
    ];
    __tema_activo = 0;
}
/// Initialize the theme system with 4 preset themes
funcion void themes_init() { temas_iniciar(); }

/// Registra un tema personalizado y retorna su ID
/// Si ya hay temas, agrega al final; si no, inicializa lista
funcion entero tema_registrar(TemaTUI tema) {
    si largo(__temas) == 0 { temas_iniciar(); }
    __temas = __temas ++ [tema];
    entero id = largo(__temas) - 1;
    retornar id;
}
/// Register a custom theme and return its ID
funcion integer theme_register(ThemeTUI theme) {
    TemaTUI t = TemaTUI{
        nombre: theme.name, fondo: theme.bg, texto: theme.text,
        borde: theme.border, titulo: theme.title,
        seleccion: theme.selection, seleccion_texto: theme.selection_text,
        boton: theme.button, boton_texto: theme.button_text,
        error: theme.error, exito: theme.success,
        advertencia: theme.warning, informacion: theme.info,
        borde_estilo: theme.border_style, padding: theme.padding,
        separacion: theme.spacing,
    };
    retornar tema_registrar(t);
}

/// Retorna el tema activo actual
funcion TemaTUI tema_actual() {
    si largo(__temas) == 0 { temas_iniciar(); }
    si __tema_activo >= largo(__temas) { __tema_activo = 0; }
    retornar __temas[__tema_activo];
}
/// Return the currently active theme
funcion ThemeTUI current_theme() {
    TemaTUI t = tema_actual();
    retornar ThemeTUI{
        name: t.nombre, bg: t.fondo, text: t.texto,
        border: t.borde, title: t.titulo,
        selection: t.seleccion, selection_text: t.seleccion_texto,
        button: t.boton, button_text: t.boton_texto,
        error: t.error, success: t.exito,
        warning: t.advertencia, info: t.informacion,
        border_style: t.borde_estilo, padding: t.padding, spacing: t.separacion,
    };
}

/// Obtiene un tema por su ID
funcion TemaTUI tema_obtener(entero id) {
    si largo(__temas) == 0 { temas_iniciar(); }
    si id < 0 { id = 0; }
    si id >= largo(__temas) { id = 0; }
    retornar __temas[id];
}
/// Get a theme by its ID
funcion ThemeTUI theme_get(integer id) {
    TemaTUI t = tema_obtener(id);
    retornar ThemeTUI{
        name: t.nombre, bg: t.fondo, text: t.texto,
        border: t.borde, title: t.titulo,
        selection: t.seleccion, selection_text: t.seleccion_texto,
        button: t.boton, button_text: t.boton_texto,
        error: t.error, success: t.exito,
        warning: t.advertencia, info: t.informacion,
        border_style: t.borde_estilo, padding: t.padding, spacing: t.separacion,
    };
}

/// Activa un tema por su ID
funcion void tema_asignar(entero id) {
    si largo(__temas) == 0 { temas_iniciar(); }
    si id < 0 { id = 0; }
    si id >= largo(__temas) { id = largo(__temas) - 1; }
    __tema_activo = id;
}
/// Set active theme by ID
funcion void theme_set(integer id) { tema_asignar(id); }

/// Retorna la cantidad de temas registrados
funcion entero temas_cantidad() {
    retornar largo(__temas);
}
/// Return the number of registered themes
funcion integer theme_count() { retornar temas_cantidad(); }

// ============================================================
// APLICAR TEMA / APPLY THEME
// ============================================================

/// Limpia la terminal y aplica el tema activo (colores de fondo/texto base)
funcion void tema_aplicar() {
    TemaTUI t = tema_actual();
    texto fg_ansi = "\033[38;5;" + t.texto + "m";
    texto bg_ansi = "\033[48;5;" + t.fondo + "m";
    texto reset = "\033[0m";
    texto limpiar = "\033[2J\033[H";
    tui_core__tc_write(limpiar + bg_ansi + fg_ansi);
}
/// Clear terminal and apply the active theme (base bg/fg colors)
funcion void theme_apply() { tema_aplicar(); }

// ============================================================
// COLORES ANSI / ANSI COLORS
// ============================================================

/// Convierte color ANSI 0-255 a texto con código de escape
funcion texto color_ansi(entero color) {
    retornar "\033[38;5;" + a_texto(color) + "m";
}
/// Convert ANSI color 0-255 to escape code string
funcion string ansi_color(integer color) {
    retornar color_ansi(color);
}

/// Convierte color ANSI 0-255 a texto con código de escape de fondo
funcion texto color_ansi_fondo(entero color) {
    retornar "\033[48;5;" + a_texto(color) + "m";
}
/// Convert ANSI color 0-255 to background escape code string
funcion string ansi_bg_color(integer color) {
    retornar color_ansi_fondo(color);
}

/// Genera código ANSI 24-bit (true color) desde RGB
funcion texto color_ansi_rgb(entero r, entero g, entero b) {
    retornar "\033[38;2;" + a_texto(r) + ";" + a_texto(g) + ";" + a_texto(b) + "m";
}
/// Generate 24-bit ANSI true color escape from RGB
funcion string ansi_rgb_color(integer r, integer g, integer b) {
    retornar color_ansi_rgb(r, g, b);
}

/// Convierte un color hex (#RRGGBB) a lista (r, g, b)
/// Retorna lista de 3 enteros: [r, g, b]
funcion lista<entero> hex_a_rgb(texto hex) {
    texto h = texto_recortar(hex);
    // Remover '#' si está presente
    si h.largo() >= 1 && h[0] == "#" {
        texto tmp = "";
        entero j = 1;
        mientras j < h.largo() {
            tmp = tmp + h[j];
            j = j + 1;
        }
        h = tmp;
    }
    si h.largo() < 6 { h = "000000"; }
    entero r = 0; entero g = 0; entero b = 0;
    // Parsear cada par de caracteres hexadecimales manualmente
    texto chars = "0123456789ABCDEF";
    texto uc = texto_mayusculas(h);
    entero i = 0;
    mientras i < 6 && i < uc.largo() {
        entero val = 0;
        entero c = 0;
        mientras c < 16 {
            si uc[i] == chars[c] { val = c; romper; }
            c = c + 1;
        }
        si i == 0 { r = val * 16; }
        sino si i == 1 { r = r + val; }
        sino si i == 2 { g = val * 16; }
        sino si i == 3 { g = g + val; }
        sino si i == 4 { b = val * 16; }
        sino si i == 5 { b = b + val; }
        i = i + 1;
    }
    retornar [r, g, b];
}
/// Convert hex color (#RRGGBB) to RGB tuple
funcion lista<entero> hex_to_rgb(string hex) {
    retornar hex_a_rgb(hex);
}

// ============================================================
// UTILIDADES DE TEMA / THEME UTILITIES
// ============================================================

/// Retorna el nombre del tema activo
funcion texto tema_nombre() {
    retornar tema_actual().nombre;
}
/// Return the active theme name
funcion string theme_name() { retornar tema_nombre(); }

/// Retorna lista con nombres de todos los temas registrados
funcion lista<texto> temas_lista() {
    lista<texto> nombres = [];
    entero i = 0;
    mientras i < largo(__temas) {
        nombres = nombres ++ [__temas[i].nombre];
        i = i + 1;
    }
    retornar nombres;
}
/// Return list of all registered theme names
funcion list<string> theme_list() { retornar temas_lista(); }
