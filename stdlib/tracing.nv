// Modulo tracing — Trazado distribuido / Distributed tracing
// Implementa spans tipo OpenTelemetry simplificado
// Implements simplified OpenTelemetry-style spans
// Uso: importar "tracing.nv"
// Todas las funciones tienen alias en ingles / All functions have English aliases

// ── Span ──────────────────────────────────────────────────
estructura Span {
    id: texto,
    padre_id: texto,
    nombre: texto,
    inicio: entero,
    fin: entero,
    atributos: cualquiera,
    estado: texto, // "activo", "completado", "error"
}

// ── Almacenamiento interno ───────────────────────────────
cualquiera __spans = __map_nuevo();
entero __span_counter = 0;

/// Genera un ID unico para span
/// Generate a unique span ID
funcion texto __span_id() {
    __span_counter = __span_counter + 1;
    texto ts = a_texto(__tiempo_ahora());
    retornar ts + "-" + a_texto(__span_counter);
}

/// Inicia un nuevo span de trazado
/// Start a new tracing span
funcion texto span_iniciar(texto nombre, texto padre_id) {
    texto sid = __span_id();
    Span s = Span {
        id: sid,
        padre_id: padre_id,
        nombre: nombre,
        inicio: __tiempo_ahora(),
        fin: 0,
        atributos: __map_nuevo(),
        estado: "activo",
    };
    __spans = __map_poner(__spans, sid, s);
    retornar sid;
}
/// Start a new tracing span (English alias)
funcion texto span_start(texto name, texto parent_id) { retornar span_iniciar(name, parent_id); }

/// Inicia un span raiz (sin padre)
/// Start a root span (no parent)
funcion texto span_iniciar_raiz(texto nombre) {
    retornar span_iniciar(nombre, "");
}
/// Start a root span (English alias)
funcion texto span_start_root(texto name) { retornar span_iniciar_raiz(name); }

/// Finaliza un span existente
/// Finish an existing span
funcion booleano span_finalizar(texto span_id) {
    Span s = __map_obtener(__spans, span_id);
    si __tipo_de(s) == "estructura" {
        s.fin = __tiempo_ahora();
        s.estado = "completado";
        __spans = __map_poner(__spans, span_id, s);
        retornar verdadero;
    }
    retornar falso;
}
/// Finish an existing span (English alias)
funcion booleano span_finish(texto span_id) { retornar span_finalizar(span_id); }

/// Marca un span con error
/// Mark a span as errored
funcion booleano span_error(texto span_id, texto mensaje) {
    Span s = __map_obtener(__spans, span_id);
    si __tipo_de(s) == "estructura" {
        s.estado = "error";
        s.atributos = __map_poner(s.atributos, "error", mensaje);
        s.fin = __tiempo_ahora();
        __spans = __map_poner(__spans, span_id, s);
        retornar verdadero;
    }
    retornar falso;
}
/// Mark a span as errored (English alias)
funcion booleano span_error_set(texto span_id, texto message) { retornar span_error(span_id, message); }

/// Agrega un atributo a un span
/// Add an attribute to a span
funcion void span_atributo(texto span_id, texto clave, texto valor) {
    Span s = __map_obtener(__spans, span_id);
    si __tipo_de(s) == "estructura" {
        cualquiera attrs = s.atributos;
        s.atributos = __map_poner(attrs, clave, valor);
        __spans = __map_poner(__spans, span_id, s);
    }
}
/// Add an attribute to a span (English alias)
funcion void span_attribute(texto span_id, texto key, texto value) { span_atributo(span_id, key, value); }

/// Obtiene la duracion de un span en microsegundos
/// Get span duration in microseconds
funcion entero span_duracion(texto span_id) {
    Span s = __map_obtener(__spans, span_id);
    si __tipo_de(s) == "estructura" {
        si s.fin - 0 > 0 {
            retornar s.fin - s.inicio;
        }
        retornar __tiempo_ahora() - s.inicio;
    }
    retornar 0 - 1;
}
/// Get span duration (English alias)
funcion entero span_duration(texto span_id) { retornar span_duracion(span_id); }

/// Obtiene informacion de un span como texto
/// Get span info as text
funcion texto span_info(texto span_id) {
    Span s = __map_obtener(__spans, span_id);
    si __tipo_de(s) == "estructura" {
        entero dur = 0;
        si s.fin - 0 > 0 {
            dur = s.fin - s.inicio;
        }
        retornar "Span[" + s.nombre + "] id=" + s.id + " estado=" + s.estado + " duracion=" + a_texto(dur) + "us";
    }
    retornar "Span no encontrado: " + span_id;
}
/// Get span info (English alias)
funcion texto span_info_en(texto span_id) { retornar span_info(span_id); }

/// Obtiene el numero total de spans registrados
/// Get total number of registered spans
funcion entero spans_total() {
    retornar __map_longitud(__spans);
}
/// Get total spans (English alias)
funcion entero spans_count() { retornar spans_total(); }

/// Exporta todos los spans como texto JSON
/// Export all spans as JSON text
funcion texto spans_exportar() {
    texto salida = "[\n";
    cualquiera claves = __map_claves(__spans);
    entero total = largo(claves);
    entero i = 0;
    mientras total - i > 0 {
        texto key = claves[i];
        Span s = __map_obtener(__spans, key);
        si __tipo_de(s) == "estructura" {
            entero dur = 0;
            si s.fin - 0 > 0 {
                dur = s.fin - s.inicio;
            }
            salida = salida + "  { \"id\": \"" + s.id + "\", \"nombre\": \"" + s.nombre + "\"";
            salida = salida + ", \"padre_id\": \"" + s.padre_id + "\"";
            salida = salida + ", \"estado\": \"" + s.estado + "\"";
            salida = salida + ", \"inicio\": " + a_texto(s.inicio);
            salida = salida + ", \"fin\": " + a_texto(s.fin);
            salida = salida + ", \"duracion\": " + a_texto(dur);
            salida = salida + " }";
            si total - i - 1 > 0 {
                salida = salida + ",";
            }
            salida = salida + "\n";
        }
        i = i + 1;
    }
    salida = salida + "]";
    retornar salida;
}
/// Export all spans (English alias)
funcion texto spans_export() { retornar spans_exportar(); }

/// Exporta spans en formato de arbol (legible)
/// Export spans in tree format (human readable)
funcion texto spans_arbol() {
    texto salida = "=== TRACING TREE ===\n";
    cualquiera claves = __map_claves(__spans);
    entero total = largo(claves);
    entero i = 0;
    mientras total - i > 0 {
        texto key = claves[i];
        Span s = __map_obtener(__spans, key);
        si __tipo_de(s) == "estructura" {
            texto prefijo = "";
            si __str_longitud(s.padre_id) - 0 > 0 {
                prefijo = "  ";
            }
            entero dur = 0;
            si s.fin - 0 > 0 {
                dur = s.fin - s.inicio;
            }
            salida = salida + prefijo + "[" + s.estado + "] " + s.nombre + " (" + a_texto(dur) + "us)\n";
        }
        i = i + 1;
    }
    retornar salida;
}
/// Export spans as tree (English alias)
funcion texto spans_tree() { retornar spans_arbol(); }

/// Limpia todos los spans registrados
/// Clear all registered spans
funcion void spans_limpiar() {
    __spans = __map_nuevo();
    __span_counter = 0;
}
/// Clear all spans (English alias)
funcion void spans_clear() { spans_limpiar(); }
