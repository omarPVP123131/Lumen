// Rasgos: definir un comportamiento y aplicarlo a varios tipos.
// El receptor del método se llama `este`.

rasgo Describible {
    funcion texto describir(este);
}

estructura Perro { nombre: texto }
estructura Coche { marca: texto, anio: entero }

impl Describible para Perro {
    funcion texto describir(este) {
        retornar "Perro llamado " + este.nombre;
    }
}

impl Describible para Coche {
    funcion texto describir(este) {
        retornar "Coche " + este.marca + " del " + a_texto(este.anio);
    }
}

Perro p = Perro { nombre: "Toby" };
Coche c = Coche { marca: "Seat", anio: 1998 };

imprimir(p.describir());
imprimir(c.describir());
