// `posponer` (defer): ejecuta un bloque al SALIR de la función,
// pase lo que pase. Sirve para liberar recursos sin repetir la
// limpieza en cada punto de retorno.

funcion vacio usar_recurso() {
    imprimir("1. abrir el recurso");
    posponer { imprimir("4. cerrar el recurso (siempre al final)"); }
    imprimir("2. trabajar con el recurso");
    imprimir("3. terminar el trabajo");
}

// Varios `posponer` se ejecutan en orden inverso al de declaracion (LIFO),
// igual que al deshacer una pila de recursos abiertos.
funcion vacio pila_de_recursos() {
    posponer { imprimir("   cierra A (declarado primero, corre ultimo)"); }
    posponer { imprimir("   cierra B (declarado ultimo, corre primero)"); }
    imprimir("   cuerpo con A y B abiertos");
}

// Tambien corre cuando la funcion sale por un `retornar` temprano:
// ese es justamente el caso que hace util a `posponer`.
funcion entero validar(entero n) {
    posponer { imprimir("   validacion terminada"); }
    si (n < 0) {
        imprimir("   valor invalido");
        retornar 0;
    }
    imprimir("   valor aceptado");
    retornar n;
}

imprimir("=== Orden basico ===");
usar_recurso();

imprimir("");
imprimir("=== Varios posponer (LIFO) ===");
pila_de_recursos();

imprimir("");
imprimir("=== Con retorno temprano ===");
imprimir("resultado: ", validar(-5));
imprimir("resultado: ", validar(7));
