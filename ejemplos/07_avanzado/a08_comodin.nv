// a08_comodin.nv — el patrón comodín `_` en `elegir`
//
// `elegir` admite dos formas de "caso por defecto":
//   · `defecto:`  — la palabra clave clásica
//   · `caso _:`   — el patrón comodín, que casa con cualquier valor
//
// Ambas son equivalentes para valores sueltos. Los casos se prueban en
// orden, así que el comodín debe ir al final: lo que esté después de él
// nunca se alcanza.

funcion texto clasificar(entero n) {
    elegir (n) {
        caso 0: retornar "cero";
        caso 1: retornar "uno";
        caso _: retornar "muchos";
    }
    retornar "?";
}

// También casa sobre texto.
funcion texto saludar(texto idioma) {
    elegir (idioma) {
        caso "es": retornar "Hola";
        caso "en": retornar "Hello";
        caso _:    retornar "???";
    }
    retornar "?";
}

// Y como subpatrón dentro de un destructuring: aquí `_` ignora la `y`.
estructura Punto { x: entero, y: entero }

funcion texto ubicar(Punto p) {
    elegir (p) {
        caso Punto{x: 0, y: _}: retornar "sobre el eje Y";
        caso _:                 retornar "en algun otro sitio";
    }
    retornar "?";
}

imprimir("clasificar(0)  -> ", clasificar(0));
imprimir("clasificar(1)  -> ", clasificar(1));
imprimir("clasificar(42) -> ", clasificar(42));

imprimir("saludar(es) -> ", saludar("es"));
imprimir("saludar(fr) -> ", saludar("fr"));

imprimir("ubicar(0,5) -> ", ubicar(Punto{x: 0, y: 5}));
imprimir("ubicar(3,5) -> ", ubicar(Punto{x: 3, y: 5}));

// Nota: en un `elegir` sobre un enum, `caso _:` NO cuenta para el chequeo
// de exhaustividad (E080). Ahí hay que listar todas las variantes o usar
// `defecto:`.
