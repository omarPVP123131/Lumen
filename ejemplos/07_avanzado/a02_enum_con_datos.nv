// Enums que transportan datos y se desmontan con `elegir`/`caso`.

enum Figura {
    Circulo(decimal),
    Rectangulo(decimal, decimal),
    Punto
}

funcion decimal area(Figura f) {
    elegir (f) {
        caso Figura::Circulo(r):      retornar 3.14159 * r * r;
        caso Figura::Rectangulo(a,b): retornar a * b;
        caso Figura::Punto:           retornar 0.0;
    }
    retornar 0.0;
}

funcion texto nombrar(Figura f) {
    elegir (f) {
        caso Figura::Circulo(r):      retornar "circulo de radio " + a_texto(r);
        caso Figura::Rectangulo(a,b): retornar "rectangulo " + a_texto(a) + "x" + a_texto(b);
        caso Figura::Punto:           retornar "un punto";
    }
    retornar "?";
}

lista<Figura> fs = [Figura::Circulo(2.0), Figura::Rectangulo(3.0, 4.0), Figura::Punto];
para f en fs {
    imprimir(nombrar(f), " -> area ", area(f));
}
