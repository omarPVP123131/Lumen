// Ordenación por burbuja sobre una lista de enteros.

funcion lista<entero> ordenar(lista<entero> datos) {
    lista<entero> l = datos;
    entero n = largo(l);
    entero i = 0;
    mientras (i < n) {
        entero j = 0;
        mientras (j < n - i - 1) {
            si (l[j] > l[j+1]) {
                entero tmp = l[j];
                l[j] = l[j+1];
                l[j+1] = tmp;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    retornar l;
}

lista<entero> nums = [5, 3, 9, 1, 7, 2, 8];
imprimir("antes   : ", nums);
imprimir("ordenado: ", ordenar(nums));
imprimir("original intacta: ", nums);
