// Manipulación de texto con los builtins de cadena.

texto frase = "  El veloz murcielago hindu  ";

imprimir("original    :[", frase, "]");
imprimir("sin espacios:[", __str_recortar(frase), "]");

texto limpia = __str_recortar(frase);
imprimir("mayusculas  : ", __str_mayusculas(limpia));
imprimir("minusculas  : ", __str_minusculas(limpia));
imprimir("longitud    : ", largo(limpia));
imprimir("contiene 'veloz'? ", __str_contiene(limpia, "veloz"));
imprimir("reemplazado : ", __str_reemplazar(limpia, "veloz", "lento"));

lista<texto> palabras = __str_dividir(limpia, " ");
imprimir("palabras    : ", largo(palabras));
para p en palabras {
    imprimir("  - ", p, " (", largo(p), " letras)");
}
