#!/usr/bin/env pwsh
# post-commit hook — Auto-creates release tag v{version} from Cargo.toml
# Installed via: git config core.hooksPath scripts/git-hooks

$CargoToml = Join-Path (git rev-parse --show-toplevel) "Cargo.toml"
if (-not (Test-Path $CargoToml)) { exit 0 }

# Extract version from workspace Cargo.toml
$line = Select-String -Path $CargoToml -Pattern '^version\s*=\s*"([^"]+)"' | Select-Object -First 1
if (-not $line) { exit 0 }
$version = $line.Matches.Groups[1].Value
$tag = "v$version"

# Check if tag already exists
$existing = git tag --list "$tag"
if ($existing) { exit 0 }

# Create annotated tag
$commit = git rev-parse HEAD
$date = Get-Date -Format "yyyy-MM-dd"
git tag -a "$tag" -m "Release $tag ($date)" HEAD 2>$null
if ($LASTEXITCODE -eq 0) {
    Write-Host "[auto-tag] Created tag '$tag' on commit $($commit.Substring(0,7))"
}
