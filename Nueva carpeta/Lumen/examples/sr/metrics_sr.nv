// ==========================================
// metrics_sr.nv — Metrics Module (intermediate)
// Tests: counters, gauges, timers, metrics query
// Uso: lumen run -L stdlib/ examples/sr/metrics_sr.nv
// ==========================================

imprimir("=== Metrics SR: Sistema de Metricas ===");

// ── Ej 1: Contadores ──
// Ej 1: Counter operations
imprimir("");
imprimir("--- Ej 1: Contadores ---");

entero req_counter = 0;
entero err_counter = 0;

req_counter = req_counter + 1;
req_counter = req_counter + 1;
req_counter = req_counter + 1;
err_counter = err_counter + 1;
req_counter = req_counter + 1;
req_counter = req_counter + 1;

imprimir("Contador requests: " + a_texto(req_counter));
imprimir("Contador errors:   " + a_texto(err_counter));
imprimir("Total eventos:     " + a_texto(req_counter + err_counter));

// ── Ej 2: Medidores ──
// Ej 2: Gauge operations
imprimir("");
imprimir("--- Ej 2: Medidores (Gauges) ---");

decimal memoria = 256.5;
decimal cpu = 45.3;
decimal conexiones = 12.0;

imprimir("Memoria usada:      " + a_texto(memoria) + " MB");
imprimir("CPU porcentaje:     " + a_texto(cpu) + "%");
imprimir("Conexiones activas: " + a_texto(conexiones));

memoria = 320.8;
cpu = 62.1;
conexiones = 15.0;

imprimir("--- Despues de actualizar ---");
imprimir("Memoria usada:      " + a_texto(memoria) + " MB");
imprimir("CPU porcentaje:     " + a_texto(cpu) + "%");
imprimir("Conexiones activas: " + a_texto(conexiones));

// ── Ej 3: Temporizadores ──
// Ej 3: Timer operations
imprimir("");
imprimir("--- Ej 3: Temporizadores ---");

// DB query times
entero d1 = 45;
entero d2 = 120;
entero d3 = 89;
entero d4 = 200;
entero d5 = 55;
entero d6 = 78;
entero d7 = 150;
entero d8 = 33;

entero total_db = d1 + d2 + d3 + d4 + d5 + d6 + d7 + d8;
entero prom_db = total_db / 8;

// Find min
entero min_db = d1;
si (d2 < min_db) { min_db = d2; }
si (d3 < min_db) { min_db = d3; }
si (d4 < min_db) { min_db = d4; }
si (d5 < min_db) { min_db = d5; }
si (d6 < min_db) { min_db = d6; }
si (d7 < min_db) { min_db = d7; }
si (d8 < min_db) { min_db = d8; }

// Find max
entero max_db = d1;
si (d2 > max_db) { max_db = d2; }
si (d3 > max_db) { max_db = d3; }
si (d4 > max_db) { max_db = d4; }
si (d5 > max_db) { max_db = d5; }
si (d6 > max_db) { max_db = d6; }
si (d7 > max_db) { max_db = d7; }
si (d8 > max_db) { max_db = d8; }

imprimir("--- Temporizador: db_query ---");
imprimir("  Muestras:  8");
imprimir("  Promedio:  " + a_texto(prom_db) + "ms");
imprimir("  Min:       " + a_texto(min_db) + "ms");
imprimir("  Max:       " + a_texto(max_db) + "ms");

// HTTP request times
entero h1 = 12;
entero h2 = 8;
entero h3 = 15;
entero h4 = 9;
entero h5 = 22;
entero h6 = 7;

entero total_http = h1 + h2 + h3 + h4 + h5 + h6;
entero prom_http = total_http / 6;

entero min_http = h1;
si (h2 < min_http) { min_http = h2; }
si (h3 < min_http) { min_http = h3; }
si (h4 < min_http) { min_http = h4; }
si (h5 < min_http) { min_http = h5; }
si (h6 < min_http) { min_http = h6; }

entero max_http = h1;
si (h2 > max_http) { max_http = h2; }
si (h3 > max_http) { max_http = h3; }
si (h4 > max_http) { max_http = h4; }
si (h5 > max_http) { max_http = h5; }
si (h6 > max_http) { max_http = h6; }

imprimir("--- Temporizador: http_request ---");
imprimir("  Muestras:  6");
imprimir("  Promedio:  " + a_texto(prom_http) + "ms");
imprimir("  Min:       " + a_texto(min_http) + "ms");
imprimir("  Max:       " + a_texto(max_http) + "ms");

// ── Ej 4: Metricas combinadas ──
// Ej 4: Combined metrics demo
imprimir("");
imprimir("--- Ej 4: Metricas Combinadas ---");

entero total_req = 0;
total_req = total_req + 1;
imprimir("  Request 0: 10ms");
total_req = total_req + 1;
imprimir("  Request 1: 35ms");
total_req = total_req + 1;
imprimir("  Request 2: 60ms");
total_req = total_req + 1;
imprimir("  Request 3: 85ms");
total_req = total_req + 1;
imprimir("  Request 4: 110ms");

decimal uptime_seg = 3600.0;

imprimir("");
imprimir("=== Resumen de Metricas ===");
imprimir("Total requests procesados: " + a_texto(total_req));
imprimir("Uptime: " + a_texto(uptime_seg) + " segundos");

// ── Ej 5: Reset ──
// Ej 5: Reset metrics
imprimir("");
imprimir("--- Ej 5: Reset de Metricas ---");
total_req = 0;
imprimir("Metricas reiniciadas.");
imprimir("Requests despues de reset: " + a_texto(total_req));
total_req = total_req + 2;
imprimir("Nueva metrica despues de reset: " + a_texto(total_req));

imprimir("");
imprimir("--- FIN METRICS SR ---");
