// ==========================================
// json_sr.nv — JSON parsing (senior)
// Uso: lumen run -L stdlib/ examples/sr/json_sr.nv
// ==========================================
importar "json.nv";

imprimir("=== JSON SR: Intermediate JSON Operations ===");

// ── Example 1: Nested Objects ──
imprimir("--- Ej 1: Objetos Anidados ---");
sea usuario_json = "{";
usuario_json = usuario_json + "\"id\": 1, ";
usuario_json = usuario_json + "\"nombre\": \"Carlos\", ";
usuario_json = usuario_json + "\"direccion\": {";
usuario_json = usuario_json + "\"calle\": \"Mayor 10\", ";
usuario_json = usuario_json + "\"ciudad\": \"Barcelona\", ";
usuario_json = usuario_json + "\"cp\": \"08001\"";
usuario_json = usuario_json + "}, ";
usuario_json = usuario_json + "\"telefonos\": [\"+34600111222\", \"+34931234567\"]";
usuario_json = usuario_json + "}";

sea usuario = json_parsear(usuario_json);
imprimir("Usuario parseado: ", usuario);
sea usuario_str = json_serializar(usuario);
imprimir("Usuario stringificado: ", usuario_str);

// ── Example 2: Arrays of Objects ──
imprimir("--- Ej 2: Arrays de Objetos ---");
sea productos_json = "[";
productos_json = productos_json + "{\"id\": 1, \"nombre\": \"Laptop\", \"precio\": 999.99},";
productos_json = productos_json + "{\"id\": 2, \"nombre\": \"Mouse\", \"precio\": 29.99},";
productos_json = productos_json + "{\"id\": 3, \"nombre\": \"Teclado\", \"precio\": 79.99}";
productos_json = productos_json + "]";

sea productos = json_parsear(productos_json);
imprimir("Array de productos: ", productos);
imprimir("Serializado:        ", json_serializar(productos));

// English alias
sea en_arr = json_parse("[{\"key\": \"a\"}, {\"key\": \"b\"}]");
imprimir("English parse: ", en_arr);

// ── Example 3: Special Values ──
imprimir("--- Ej 3: Valores Especiales ---");
// Boolean, null, numbers
sea especiales = json_parsear("{\"bool_true\": true, \"bool_false\": false, \"nulo\": null, \"entero\": 42, \"decimal\": 3.1416}");
imprimir("Valores especiales: ", especiales);
imprimir("Serializado:        ", json_serializar(especiales));

// Array with mixed types
sea mixto = json_parsear("[1, \"texto\", true, null, 3.14]");
imprimir("Array mixto:    ", mixto);
imprimir("Serializado:    ", json_serializar(mixto));

// ── Example 4: Error Handling ──
imprimir("--- Ej 4: Manejo de Errores ---");
// Invalid JSON
sea invalido1 = json_parsear("esto no es json");
imprimir("JSON inválido 1: ", invalido1);

sea invalido2 = json_parsear("{nombre: sin comillas}");
imprimir("JSON inválido 2: ", invalido2);

// Valid JSON after error
sea valido = json_parsear("{\"ok\": true}");
imprimir("JSON válido:     ", valido);

// English alias
sea en_invalid = json_parse("{bad json}");
imprimir("Invalid EN:      ", en_invalid);

imprimir("--- FIN JSON SR ---");
