// ==========================================
// texto_sr.nv — String operations (senior)
// Uso: lumen run -L stdlib/ examples/sr/texto_sr.nv
// ==========================================
importar "texto.nv";

imprimir("=== Texto SR: Advanced String Operations ===");

// ── Example 1: Split string into parts ──
imprimir("--- Ej 1: Dividir (Split) ---");
sea csv = "manzana,pera,uva,naranja";
lista<texto> partes = texto_dividir(csv, ",");
imprimir("original:    ", csv);
imprimir("partes[0]:   ", partes[0]);
imprimir("partes[1]:   ", partes[1]);
imprimir("partes[2]:   ", partes[2]);
imprimir("partes[3]:   ", partes[3]);

// Split by space (English alias)
lista<texto> palabras = texto_split("one two three", " ");
imprimir("words[0]:    ", palabras[0]);
imprimir("words[2]:    ", palabras[2]);

// ── Example 2: Regex match & replace ──
imprimir("--- Ej 2: Regex ---");
// Check if string contains digits
imprimir("'abc123' has digits: ", texto_regex_coincide("\\d+", "abc123"));
imprimir("'abcdef' has digits: ", texto_regex_coincide("\\d+", "abcdef"));

// English alias
imprimir("'hello42' matches \\w+: ", texto_regex_match("\\w+", "hello42"));

// Replace using regex
imprimir("replace 'mundo' -> 'Lumen': ", texto_regex_reemplazar("mundo", "Hola mundo", "Lumen"));
imprimir("replace digits -> 'X':       ", texto_regex_replace("\\d+", "abc123xyz456", "X"));

// ── Example 3: Unicode normalization ──
imprimir("--- Ej 3: Unicode ---");
// Normalize combined characters (café with combining accent vs precomposed)
sea nfc = texto_unicode_normalizar("cafe\u0301", "NFC");
sea nfd = texto_unicode_normalizar("café", "NFD");
imprimir("NFC: ", nfc, " (longitud: ", texto_longitud(nfc), ")");
imprimir("NFD: ", nfd, " (longitud: ", texto_longitud(nfd), ")");

// English alias
imprimir("unicode_normalize: ", texto_unicode_normalize("café", "NFC"));

// ── Example 4: UTF-8 Encoding / Decoding ──
imprimir("--- Ej 4: UTF-8 Encode/Decode ---");
sea mensaje = "Hola Lúmen! 🌟";
// Encode to UTF-8 bytes (returns a handle)
sea bytes = texto_codificar_utf8(mensaje);
imprimir("encoded bytes handle: ", bytes);

// Decode back
sea decodificado = texto_decodificar_utf8(bytes);
imprimir("decoded: ", decodificado);

// English aliases
sea bytes_en = texto_encode_utf8("Hello");
imprimir("encode 'Hello': ", bytes_en);
sea decoded = texto_decode_utf8(bytes_en);
imprimir("decode: ", decoded);

imprimir("--- FIN TEXTO SR ---");
