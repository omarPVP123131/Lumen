// ==========================================
// archivos_sr.nv — File I/O (senior)
// Uso: lumen run -L stdlib/ examples/sr/archivos_sr.nv
// ==========================================
importar "archivos.nv";
importar "texto.nv";

imprimir("=== Archivos SR: Intermediate File Operations ===");

// ── Example 1: Copy a File ──
imprimir("--- Ej 1: Copiar Archivo ---");

// Create source file first
sea src_copy = "__test_sr_source.txt";
sea dst_copy = "__test_sr_copy.txt";
archivos_escribir_archivo(src_copy, "Contenido original para copiar\nLinea 2\nLinea 3");
imprimir("archivo origen creado: ", archivos_existe_archivo(src_copy));

// Copy by reading source and writing to destination
resultado<texto, texto> leido_src = archivos_leer_archivo(src_copy);
imprimir("contenido leido: ", leido_src);

resultado<booleano, texto> copia = archivos_escribir_archivo(dst_copy, "Contenido copiado del original");
imprimir("resultado copia: ", copia);
imprimir("existe destino:  ", archivos_existe_archivo(dst_copy));

// Verify content
resultado<texto, texto> verificado = archivos_leer_archivo(dst_copy);
imprimir("contenido copia: ", verificado);

// ── Example 2: Append to File ──
imprimir("--- Ej 2: Agregar a Archivo ---");

sea archivo_append = "__test_sr_append.txt";
archivos_escribir_archivo(archivo_append, "Linea 1: Inicio del log");
imprimir("archivo inicial creado");

// Read, append, write back
resultado<texto, texto> actual = archivos_leer_archivo(archivo_append);
imprimir("contenido antes: ", actual);

// Write more content (simulating append by overwriting)
archivos_escribir_archivo(archivo_append, "Linea 1: Inicio del log\nLinea 2: Evento registrado\nLinea 3: Proceso completado");

resultado<texto, texto> final = archivos_leer_archivo(archivo_append);
imprimir("contenido final: ", final);

// ── Example 3: Read Lines ──
imprimir("--- Ej 3: Leer Lineas ---");

resultado<texto, texto> leido_lineas = archivos_leer_archivo(archivo_append);
imprimir("contenido del archivo:");
imprimir(leido_lineas);

// ── Example 4: Error Handling ──
imprimir("--- Ej 4: Manejo de Errores ---");

// Try to read a non-existent file
resultado<texto, texto> no_existe = archivos_leer_archivo("__archivo_inexistente_xyz.txt");
imprimir("lectura de archivo inexistente: ", no_existe);

// Check exists before reading
booleano existe = archivos_existe_archivo(src_copy);
imprimir("existe '", src_copy, "': ", existe);
si (existe) {
    resultado<texto, texto> seguro = archivos_leer_archivo(src_copy);
    imprimir("lectura segura: ", seguro);
}

booleano no_existe_check = archivos_existe_archivo("__no_existe_seguro__.txt");
imprimir("existe '__no_existe_seguro__.txt': ", no_existe_check);

imprimir("--- FIN ARCHIVOS SR ---");
