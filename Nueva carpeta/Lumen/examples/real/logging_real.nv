// ==========================================
// logging_real.nv — Advanced Logging (real-world)
// Tests: file logging, rotation, structured logging, batch logging
// Uso: lumen run -L stdlib/ examples/real/logging_real.nv
// ==========================================

imprimir("=== Logging REAL: Advanced File Logging ===");

// ── Ej 1: Logging a Archivo con Append ──
// Ej 1: Write logs to a file with append
imprimir("");
imprimir("--- Ej 1: Logging a Archivo ---");

texto log_path = "temp_log_real.txt";
__escribir_archivo(log_path, "");

// Append: usar intentar para leer y obtener el contenido textual
sea c1 = intentar __leer_archivo(log_path);
entero ts = __tiempo_ahora();
__escribir_archivo(log_path, c1 + a_texto(ts) + " [ERROR] DB connection failed\n");

sea c2 = intentar __leer_archivo(log_path);
ts = __tiempo_ahora();
__escribir_archivo(log_path, c2 + a_texto(ts) + " [WARN] Retry attempt 1/3\n");

sea c3 = intentar __leer_archivo(log_path);
ts = __tiempo_ahora();
__escribir_archivo(log_path, c3 + a_texto(ts) + " [INFO] Reconnected successfully\n");

sea c4 = intentar __leer_archivo(log_path);
ts = __tiempo_ahora();
__escribir_archivo(log_path, c4 + a_texto(ts) + " [INFO] Processing 150 records\n");

sea c5 = intentar __leer_archivo(log_path);
ts = __tiempo_ahora();
__escribir_archivo(log_path, c5 + a_texto(ts) + " [DEBUG] Variable x=42 y=7\n");

// Leer y mostrar
sea contenido = intentar __leer_archivo(log_path);
imprimir("Contenido del archivo (" + a_texto(largo(contenido)) + " chars):");
imprimir(contenido);

// Cleanup
__escribir_archivo(log_path, "");

// ── Ej 2: Rotacion de Archivos ──
// Ej 2: File rotation with backup
imprimir("--- Ej 2: Rotacion de Archivos ---");

texto rot_path = "temp_rot_real.txt";
__escribir_archivo(rot_path, "");

// Escribir entradas de log
entero ri = 0;
mientras ri < 10 {
    sea cur = intentar __leer_archivo(rot_path);
    ts = __tiempo_ahora();
    __escribir_archivo(rot_path, cur + "Linea " + a_texto(ri) + ": datos de rotacion\n");
    ri = ri + 1;
}

// Leer y examinar tamano
sea contenido_rot = intentar __leer_archivo(rot_path);
entero tam = largo(contenido_rot);
imprimir("Tamano antes de rotacion: " + a_texto(tam) + " caracteres");

// Rotar: backup a .1, vaciar original
__escribir_archivo(rot_path + ".1", contenido_rot);
__escribir_archivo(rot_path, "");

imprimir("Rotacion completada: backup en " + rot_path + ".1");

// Verificar backup
sea backup = intentar __leer_archivo(rot_path + ".1");
imprimir("Backup tamano: " + a_texto(largo(backup)) + " caracteres");

// Verificar que el original esta vacio
sea vacio = intentar __leer_archivo(rot_path);
imprimir("Original despues de rotacion: '" + vacio + "' (largo=" + a_texto(largo(vacio)) + ")");

// Cleanup
__escribir_archivo(rot_path, "");
__escribir_archivo(rot_path + ".1", "");

// ── Ej 3: Formatos de Log ──
// Ej 3: Custom log formatting
imprimir("--- Ej 3: Formatos de Log ---");

funcion texto ts_corto(entero t) {
    entero h = (t / 3600) % 24;
    entero m = (t / 60) % 60;
    entero s = t % 60;
    retornar a_texto(h) + ":" + a_texto(m) + ":" + a_texto(s);
}

entero ahora = __tiempo_ahora();
imprimir("Timestamp ISO:     " + a_texto(ahora));
imprimir("Timestamp formato:  " + ts_corto(ahora));

imprimir("Ejemplos formateados:");
imprimir(ts_corto(ahora) + " [ERROR] Conexion a DB fallida");
imprimir(ts_corto(ahora) + " [WARN]  Disco al 85% de capacidad");
imprimir(ts_corto(ahora) + " [INFO]  Servidor iniciado en puerto 3000");
imprimir(ts_corto(ahora) + " [DEBUG] Variable: x=42 y=7 z=3.14");

// ── Ej 4: Batch Logging ──
// Ej 4: Buffer and flush to console
imprimir("--- Ej 4: Buffer de Logs por Lotes ---");

lista<texto> buf1 = [];
buf1.agregar("Sesion iniciada: admin@192.168.1.1");
buf1.agregar("SQL: SELECT * FROM usuarios (42ms)");
buf1.agregar("HTTP 200 GET /api/status (45ms)");
buf1.agregar("Cache MISS: key=session_abc123");

imprimir("Vaciando buffer de " + a_texto(largo(buf1)) + " mensajes:");
entero bi = 0;
mientras bi < largo(buf1) {
    imprimir("  >> " + buf1[bi]);
    bi = bi + 1;
}

lista<texto> buf2 = [];
buf2.agregar("WebSocket conectado: client=ws-42");
buf2.agregar("Broadcast enviado a 15 clientes");
buf2.agregar("Conexion cerrada: motivo=timeout");

imprimir("Vaciando buffer de " + a_texto(largo(buf2)) + " mensajes:");
bi = 0;
mientras bi < largo(buf2) {
    imprimir("  >> " + buf2[bi]);
    bi = bi + 1;
}

// ── Ej 5: Logging Estructurado ──
// Ej 5: Structured logging with key=value
imprimir("--- Ej 5: Logging Estructurado ---");

texto ts_s = ts_corto(__tiempo_ahora());
imprimir(ts_s + " level=INFO  module=http  code=200 msg=\"Request exitosa\"");
imprimir(ts_s + " level=WARN  module=http  code=429 msg=\"Rate limit\"");
imprimir(ts_s + " level=ERROR module=db    code=500 msg=\"Timeout\"");
imprimir(ts_s + " level=INFO  module=cache code=0   msg=\"Invalidacion OK\"");
imprimir(ts_s + " level=DEBUG module=auth  code=0   msg=\"Token validado\"");

// ── Resumen ──
imprimir("");
imprimir("=== Resumen de Logging ===");
imprimir("Funcionalidades demostradas:");
imprimir("  1. Append de logs a archivo (read+concat+write)");
imprimir("  2. Rotacion de archivos (backup .1, vaciar original)");
imprimir("  3. Formatos de timestamp personalizables");
imprimir("  4. Buffer de mensajes con vaciado por lotes");
imprimir("  5. Logging estructurado con campos clave=valor");

imprimir("");
imprimir("--- FIN LOGGING REAL ---");
