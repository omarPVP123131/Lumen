// ==========================================
// sistema_real.nv — System operations (real-world)
// Uso: lumen run -L stdlib/ examples/real/sistema_real.nv
// ==========================================
importar "sistema.nv";

imprimir("=== Sistema REAL: Config, File Finder & Process Manager ===");

// ── Example 1: Configuration from Environment ──
imprimir("--- Ej 1: Config from Environment ---");
funcion texto leer_config(texto clave, texto default_val) {
    sea val = sistema_env_obtener(clave);
    si val == "" {
        retornar default_val;
    }
    retornar val;
}

sistema_env_asignar("APP_MODE", "produccion");
sistema_env_asignar("APP_PORT", "8080");
sistema_env_asignar("APP_DEBUG", "falso");

sea mode = leer_config("APP_MODE", "desarrollo");
sea port = leer_config("APP_PORT", "3000");
sea debug = leer_config("APP_DEBUG", "verdadero");

imprimir("App mode:  ", mode);
imprimir("App port:  ", port);
imprimir("App debug: ", debug);

sea db_url = leer_config("DATABASE_URL", "localhost:5432");
sea log_level = leer_config("LOG_LEVEL", "info");
imprimir("DB URL:    ", db_url);
imprimir("Log level: ", log_level);

// ── Example 2: File Finder (directory scanner) ──
imprimir("--- Ej 2: File Finder ---");
funcion texto encontrar_por_extension(texto directorio, texto ext) {
    sea search_path = sistema_path_unir(directorio, "*." + ext);
    retornar "Buscando en: " + search_path;
}

imprimir(encontrar_por_extension("docs", "nv"));
imprimir(encontrar_por_extension("logs", "txt"));

// Path analysis
funcion texto analizar_archivo(texto ruta) {
    sea nombre = sistema_path_nombre_archivo(ruta);
    sea extension = sistema_path_extension(ruta);
    sea directorio = sistema_path_padre(ruta);
    retornar nombre + " (." + extension + ") en " + directorio;
}

imprimir("Analisis: ", analizar_archivo("C:\\proyectos\\lumen\\src\\main.nv"));
imprimir("Analisis: ", analizar_archivo("/var/log/app/error.log"));

// ── Example 3: Process Manager ──
imprimir("--- Ej 3: Process Manager ---");
funcion texto ejecutar_proceso(texto nombre, texto comando) {
    sea exit_code = sistema_ejecutar(comando);
    retornar nombre + ": exit code " + exit_code;
}

sea p1 = ejecutar_proceso("Verificar", "echo OK");
imprimir(p1);

sea p2 = sistema_run("echo LUMEN v1.6.0");
imprimir("Lumen version: exit ", p2);

// Detect OS from env
sea os_var = sistema_env_obtener("OS");
si os_var != "" {
    imprimir("Sistema detectado: Windows");
} sino {
    imprimir("Sistema: Unix/Linux");
}

// Build temp workspace path
funcion texto crear_workspace() {
    sea base = sistema_temp_directorio();
    sea ws = sistema_path_unir(base, "lumen_workspace");
    retornar "Workspace: " + ws;
}
imprimir(crear_workspace());

imprimir("--- FIN SISTEMA REAL ---");
