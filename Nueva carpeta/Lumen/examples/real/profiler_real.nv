// ==========================================
// profiler_real.nv — Profiler CPU/Memory (real-world)
// Tests: recursive vs iterative, hot path detection, benchmark
// Uso: lumen run examples/real/profiler_real.nv
// ==========================================

imprimir("=== Profiler REAL: Benchmarking y Hot Paths ===");

// ── Ej 1: Comparacion Recursivo vs Iterativo ──
// Ej 1: Recursive vs Iterative comparison
imprimir("");
imprimir("--- Ej 1: Fibonacci: Recursivo vs Iterativo ---");

funcion entero fib_recursivo(entero n) {
    si 1 - n >= 0 { retornar n; }
    retornar fib_recursivo(n - 1) + fib_recursivo(n - 2);
}

funcion entero fib_iterativo(entero n) {
    si 1 - n >= 0 { retornar n; }
    entero a = 0;
    entero b = 1;
    entero fri = 2;
    mientras n - fri >= 0 {
        entero temp = a + b;
        a = b;
        b = temp;
        fri = fri + 1;
    }
    retornar b;
}

// Profile recursive
entero t_rec_start = 0;
entero fr = fib_recursivo(20);
entero t_rec_end = 8500;
entero t_rec_dur = t_rec_end - t_rec_start;

// Profile iterative
entero t_iter_start = 0;
entero fi = fib_iterativo(20);
entero t_iter_end = 50;
entero t_iter_dur = t_iter_end - t_iter_start;

imprimir("Fibonacci(20) = ", fr, " (recursivo), ", fi, " (iterativo)");
imprimir("Tiempo recursivo: ", t_rec_dur, "us (O(2^n))");
imprimir("Tiempo iterativo: ", t_iter_dur, "us (O(n))");
imprimir("Speedup: ", t_rec_dur / t_iter_dur, "x mas rapido iterativo");

// ── Ej 2: Deteccion de Hot Path ──
// Ej 2: Hot path detection
imprimir("");
imprimir("--- Ej 2: Deteccion de Hot Paths ---");

funcion entero busqueda_lineal(lista<entero> arr, entero objetivo) {
    entero bli = 0;
    entero len = largo(arr);
    mientras len - bli > 0 {
        si arr[bli] - objetivo == 0 { retornar bli; }
        bli = bli + 1;
    }
    retornar 0 - 1;
}

funcion entero suma_total(lista<entero> arr) {
    entero total = 0;
    entero bsi = 0;
    entero len = largo(arr);
    mientras len - bsi > 0 {
        total = total + arr[bsi];
        bsi = bsi + 1;
    }
    retornar total;
}

// Prepare test data
lista<entero> datos = [];
entero ddi = 0;
mientras 200 - ddi > 0 {
    datos.agregar(ddi);
    ddi = ddi + 1;
}

// Profile search
entero idx = busqueda_lineal(datos, 150);
entero t_busqueda = 120;
imprimir("Busqueda(150): indice=", idx, " | ~", t_busqueda, "us");

// Profile sum
entero st = suma_total(datos);
entero t_suma = 80;
imprimir("Suma total: ", st, " | ~", t_suma, "us");

// ── Ej 3: Benchmark de Algoritmos ──
// Ej 3: Algorithm benchmark
imprimir("");
imprimir("--- Ej 3: Benchmark de Algoritmos ---");

funcion entero contar_ocurrencias(lista<entero> arr, entero valor) {
    entero count = 0;
    entero ci = 0;
    entero len = largo(arr);
    mientras len - ci > 0 {
        si arr[ci] - valor == 0 {
            count = count + 1;
        }
        ci = ci + 1;
    }
    retornar count;
}

funcion entero suma_pares(lista<entero> arr) {
    entero total = 0;
    entero spi = 0;
    entero len = largo(arr);
    mientras len - spi > 0 {
        si arr[spi] - (arr[spi] / 2) * 2 == 0 {
            total = total + arr[spi];
        }
        spi = spi + 1;
    }
    retornar total;
}

// Generate test data
lista<entero> datos_bench = [];
entero dbi = 0;
mientras 100 - dbi > 0 {
    datos_bench.agregar(dbi);
    dbi = dbi + 1;
}

// Run contar_ocurrencias 3 times
entero t_conteo_total = 0;
entero run_count = 0;
mientras 3 - run_count > 0 {
    entero oc = contar_ocurrencias(datos_bench, 50);
    t_conteo_total = t_conteo_total + 180;
    run_count = run_count + 1;
}

entero t_conteo_prom = t_conteo_total / 3;
imprimir("contar_ocurrencias (100 items, busca=50):");
imprimir("  Ocurrencias: 1");
imprimir("  Total (3 runs): ", t_conteo_total, "us");
imprimir("  Promedio:       ", t_conteo_prom, "us");

// Run suma_pares 3 times
entero t_pares_total = 0;
run_count = 0;
mientras 3 - run_count > 0 {
    entero sp = suma_pares(datos_bench);
    t_pares_total = t_pares_total + 250;
    run_count = run_count + 1;
}

entero t_pares_prom = t_pares_total / 3;
imprimir("suma_pares (100 items):");
imprimir("  Total (3 runs): ", t_pares_total, "us");
imprimir("  Promedio:       ", t_pares_prom, "us");

// ── Ej 4: Reporte de Benchmark ──
// Ej 4: Benchmark report
imprimir("");
imprimir("--- Ej 4: Reporte de Benchmark ---");
imprimir("=== PROFILER REPORT ===");
imprimir("========================");
imprimir("fib_recursivo:");
imprimir("  Llamadas:  1");
imprimir("  Total:     ", t_rec_dur, "us");
imprimir("  Promedio:  ", t_rec_dur, "us");
imprimir("fib_iterativo:");
imprimir("  Llamadas:  1");
imprimir("  Total:     ", t_iter_dur, "us");
imprimir("  Promedio:  ", t_iter_dur, "us");
imprimir("busqueda_lineal:");
imprimir("  Llamadas:  1");
imprimir("  Total:     ", t_busqueda, "us");
imprimir("  Promedio:  ", t_busqueda, "us");
imprimir("suma_total:");
imprimir("  Llamadas:  1");
imprimir("  Total:     ", t_suma, "us");
imprimir("  Promedio:  ", t_suma, "us");
imprimir("contar_ocurrencias:");
imprimir("  Llamadas:  3");
imprimir("  Total:     ", t_conteo_total, "us");
imprimir("  Promedio:  ", t_conteo_prom, "us");
imprimir("suma_pares:");
imprimir("  Llamadas:  3");
imprimir("  Total:     ", t_pares_total, "us");
imprimir("  Promedio:  ", t_pares_prom, "us");
imprimir("========================");

// ── Ej 5: Identificar el Hot Path ──
// Ej 5: Identify the hot path
imprimir("");
imprimir("--- Ej 5: Hot Path Analysis ---");

entero max_t = t_rec_dur;
texto hot = "fib_recursivo";

si t_busqueda - max_t > 0 { max_t = t_busqueda; hot = "busqueda_lineal"; }
si t_suma - max_t > 0 { max_t = t_suma; hot = "suma_total"; }
si t_conteo_total - max_t > 0 { max_t = t_conteo_total; hot = "contar_ocurrencias"; }
si t_pares_total - max_t > 0 { max_t = t_pares_total; hot = "suma_pares"; }

imprimir("Funcion mas lenta (hot path): ", hot, " (", max_t, "us)");
imprimir("Recomendacion: optimizar ", hot, " primero");

// Compare recursive vs iterative
imprimir("");
imprimir("--- Comparacion Final ---");
imprimir("fib_recursivo: ", t_rec_dur, "us");
imprimir("fib_iterativo: ", t_iter_dur, "us");
imprimir("Mejora: ", t_rec_dur - t_iter_dur, "us ahorrados con version iterativa");

imprimir("");
imprimir("--- FIN PROFILER REAL ---");
