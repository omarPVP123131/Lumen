// EJEMPLO TUI PRO — Componentes interactivos
// Uso: lumen run examples/tui_pro_completo.nv
// NOTA: Necesita terminal interactiva (raw mode)

importar "tui.nv";

funcion texto lorem() {
    retornar "LÍNEA 1: Hola Lumen\nLÍNEA 2: Pager test\nLÍNEA 3: Tercera\nLÍNEA 4: Cuarta\nLÍNEA 5: Quinta\nLÍNEA 6: Sexta\nLÍNEA 7: Séptima\nLÍNEA 8: Octava\nLÍNEA 9: Novena\nLÍNEA 10: Décima\nLÍNEA 11: Once\nLÍNEA 12: Doce\nLÍNEA 13: Trece\nLÍNEA 14: Catorce\nLÍNEA 15: Quince\nLÍNEA 16: Diesciseis\nLÍNEA 17: Diescisiete\nLÍNEA 18: Dieciocho\nLÍNEA 19: Diecinueve\nLÍNEA 20: Veinte";
}

funcion texto md_ejemplo() {
    retornar "# LÚMEN\n\nLenguaje de programación.\n\n## Características\n\n- Tipado estático\n- Sintaxis en español\n- FFI a C\n\n## TUI\n\nTerminal UI en LÚMEN puro.\n\n### Componentes\n\n- Ventanas\n- Pager\n- Markdown\n- Menús\n- Diálogos\n\n## FIN";
}

imprimir("=== TUI PRO Demo ===");
imprimir("Componentes disponibles:");
imprimir("  tui_ventana(\"Título\", \"Contenido\")");
imprimir("  tui_pager(contenido, ancho, alto)");
imprimir("  tui_markdown_viewer(md, ancho, alto)");
imprimir("  tui_progress_bar(actual, total, ancho)");
imprimir("  tui_menu(opciones, título)");
imprimir("  tui_dialogo_confirmar(\"Mensaje\")");
imprimir("  tui_dialogo_input(\"Nombre:\")");
imprimir("");
imprimir("NOTA: Los componentes interactivos (pager, menu, dialogos)");
imprimir("requieren ejecutarse en terminal real con raw mode.");
imprimir("Usa: lumen run examples/tui_pro_completo.nv");
imprimir("");
imprimir("--- Demo de progress_bar ---");
entero i = 0;
mientras i <= 10 {
    imprimir(tui_progress_bar(i, 10, 20));
    i = i + 1;
}
imprimir("--- FIN DEMO ---");
