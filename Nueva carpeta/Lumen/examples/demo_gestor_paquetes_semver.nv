// 2. Generación determinista del archivo lumen.lock
imprimir("");
imprimir("2. Generando archivo de bloqueo reproducible (lumen.lock)...");
texto checksum_sha256 = "sha256:7f83b1657ff1fc53b92dc18148a1d65dfc2d4b1fa3d677284addd200126d9069";
imprimir("   [[paquete]]");
imprimir("   nombre   = \"ai_tensor\"");
