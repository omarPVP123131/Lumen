// @expected_failure: Gt requires numbers - FFI type mismatch
imprimir("=== FFI Simple Test ===");

// Cargar msvcrt.dll
sea lib = __ffi_cargar("msvcrt.dll");
imprimir("lib: ", lib);

// Llamar _getpid() - no args, retorna entero (el valor real varía por proceso)
sea pid = __ffi_llamar(lib, "_getpid", "", [], "entero");
imprimir("pid>0: ", pid > 0);

imprimir("--- FIN ---");
