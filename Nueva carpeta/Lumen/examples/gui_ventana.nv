// @interactive: interactive - requires window
// EJEMPLO GUI — Ventana nativa con bucle de eventos
// Uso: lumen run examples/gui_ventana.nv
// NOTA: Solo Windows. Abre una ventana Win32 nativa.

importar "gui.nv";
// Headless/CI guard — demo requiere display/SDL2/consola interactiva
importar "sistema.nv";
texto _ci_guard = sistema_env_obtener("CI");
texto _hl_guard = sistema_env_obtener("LUMEN_HEADLESS");
si _ci_guard != "" || _hl_guard == "1" {
    imprimir("Headless/CI detectado — demo omitida (requiere display)");
    retornar;
}

imprimir("=== GUI Nativa ===");
imprimir("Creando ventana...");

texto id = gui_ventana("Hola LÚMEN", 640, 480);
imprimir("ID: ", id);

imprimir("Iniciando bucle de eventos...");
imprimir("Cierra la ventana para continuar.");

gui_bucle(id);

imprimir("Ventana cerrada. OK.");
