// test_simple_lexer.nv — Lexer minimo sin sino
funcion numero lx(texto s) {
    lista<entero> codes = __str_ord(s);
    entero n = largo(codes);
    entero idx = 0;
    numero tk = __map_nuevo();
    entero cnt = 0;
    
    mientras idx < n {
        entero cp = codes[idx];
        si cp == 32 { idx = idx + 1; continuar; }
        si cp == 10 { idx = idx + 1; continuar; }
        si cp >= 65 {
            texto id = "";
            mientras idx < n {
                entero c2 = codes[idx];
                si c2 >= 65 {
                    id = id + a_texto(c2); idx = idx + 1;
                } sino {
                    romper;
                }
            }
            numero t = __map_nuevo();
            t = __map_poner(t, "v", id);
            tk = __map_poner(tk, a_texto(cnt), t);
            cnt = cnt + 1;
        } sino {
            idx = idx + 1;
        }
    }
    numero t = __map_nuevo();
    t = __map_poner(t, "v", "");
    tk = __map_poner(tk, a_texto(cnt), t);
    tk = __map_poner(tk, "cnt", cnt + 1);
    retornar tk;
}

numero r = lx("ABC DEF");
imprimir("tokens: ", __map_obtener(r, "cnt"));

funcion numero _codegen_mini(texto src) {
    numero tk = lx(src);
    imprimir("Tokens: ", __map_obtener(tk, "cnt"));
    
    entero total = __map_obtener(tk, "cnt");
    entero pos = 0;
    mientras pos < total {
        numero t = __map_obtener(tk, a_texto(pos));
        texto tv = __map_obtener(t, "v");
        entero tt = __map_obtener(t, "t");
        si tt == 1 { imprimir("  ID: ", tv); }
        si tt == 2 { imprimir("  NUM: ", tv); }
        si tt == 3 { imprimir("  STR: ", tv); }
        pos = pos + 1;
    }
    retornar tk;
}

imprimir("");
imprimir("=== CODEGEN ===");
r = _codegen_mini("entero x = 42;");
imprimir("=== DONE ===");
