funcion numero probe(texto s) {
    lista<entero> codes = __str_ord(s);
    entero n = largo(codes);
    entero idx = 0;
    numero tm = __map_nuevo();
    entero ct = 0;
    
    mientras idx < n {
        entero cp = codes[idx];
        numero tk = __map_nuevo();
        tk = __map_poner(tk, "v", a_texto(cp));
        tm = __map_poner(tm, a_texto(ct), tk);
        ct = ct + 1;
        idx = idx + 1;
    }
    
    tm = __map_poner(tm, "cnt", ct);
    retornar tm;
}

numero r = probe("AB");
imprimir("cnt: ", __map_obtener(r, "cnt"));
