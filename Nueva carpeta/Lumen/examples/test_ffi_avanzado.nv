imprimir("=== FFI Test ===");

sea lib = __ffi_cargar("msvcrt.dll");
imprimir("lib cargada: ", lib);

// strlen("Hola Mundo") debe ser 10
sea len = __ffi_llamar(lib, "strlen", "texto", ["Hola Mundo"], "entero");
imprimir("strlen: ", len);

// _stricmp("Hola", "hola") debe ser 0 (case insensitive igual)
sea cmp = __ffi_llamar(lib, "_stricmp", "texto,texto", ["Hola", "hola"], "entero");
imprimir("stricmp: ", cmp);

// sqrt(100.0) debe ser 10 (desde msvcrt.dll)
sea raiz = __ffi_llamar(lib, "sqrt", "decimal", [100.0], "decimal");
imprimir("sqrt: ", raiz);

imprimir("--- FIN ---");
