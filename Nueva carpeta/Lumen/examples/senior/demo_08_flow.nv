importar ingles;

funcion entero buscar(lista<entero> arr, entero objetivo) {
    entero i = 0;
    mientras (i < largo(arr)) {
        si (arr[i] == objetivo) { romper; }
        i = i + 1;
    }
    retornar i < largo(arr) ? i : -1;
}

lista<entero> datos = [5, 12, 8, 3, 9];
imprimir("Buscar 8: " + buscar(datos, 8));
imprimir("Buscar 99: " + buscar(datos, 99));
imprimir("42 texto: " + a_texto(42));
