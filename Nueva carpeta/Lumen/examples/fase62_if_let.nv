// Fase 62 — If-let: desestructuración condicional de opciones
// `si sea algun(n) = opt { }` vincula el payload solo si el patrón matchea
funcion texto clasificar(opcion<entero> opt) {
    si sea algun(n) = opt {
        retornar "tiene: " + a_texto(n);
    }
    retornar "vacio";
}

funcion entero principal() {
    opcion<entero> a = algun(10);
    opcion<entero> b = ninguno;
    imprimir(clasificar(a));
    imprimir(clasificar(b));
    retornar 0;
}
