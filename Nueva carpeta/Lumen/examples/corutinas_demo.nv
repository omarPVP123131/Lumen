// EJEMPLO CORRUTINAS — Cooperativas (yield/resume)
// Uso: lumen run examples/corutinas_demo.nv

funcion texto tarea_a() {
    imprimir("A: inicio");
    __coro_ceder();
    imprimir("A: después del primer yield");
    __coro_ceder();
    imprimir("A: después del segundo yield");
    retornar "A: fin";
}

funcion texto tarea_b() {
    imprimir("B: inicio");
    __coro_ceder();
    imprimir("B: después del yield");
    retornar "B: fin";
}

imprimir("=== Demo de Corrutinas ===");
imprimir("Creando corrutinas...");

texto a = __coro_crear("tarea_a");
imprimir("Creada: ", a);
texto b = __coro_crear("tarea_b");
imprimir("Creada: ", b);

imprimir("--- Resumen A ---");
__coro_reanudar(a);
imprimir("--- Resumen B ---");
__coro_reanudar(b);
imprimir("--- Resumen A (2) ---");
__coro_reanudar(a);
imprimir("--- Resumen A (3) ---");
__coro_reanudar(a);
imprimir("--- FIN ---");
