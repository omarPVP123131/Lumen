importar "testing.nv";

imprimir("=== Crypto + JWT + Assert Test ===");

// AES
imprimir("--- AES ---");
sea encrypted = __aes_encriptar("mi-clave-secreta", "Hola Lumen AES");
imprimir("encrypted: ", encrypted);
sea decrypted = __aes_desencriptar("mi-clave-secreta", encrypted);
imprimir("decrypted: ", decrypted);

// JWT
imprimir("--- JWT ---");
sea token = __jwt_codificar("{\"sub\":\"123\",\"name\":\"Ana\"}", "secreto");
imprimir("token: ", token);
sea decoded = __jwt_decodificar(token, "secreto");
imprimir("decoded: ", decoded);

// Assert via testing.nv
imprimir("--- Assert ---");
testing_afirmar_verdadero(verdadero);
testing_afirmar_igual(42, 42);
imprimir("assertions OK");

imprimir("--- FIN ---");
