// EJEMPLO AUDIO — Inicialización SDL2_mixer vía FFI
// Uso: lumen run examples/audio_demo.nv
// Requiere: SDL2.dll + SDL2_mixer.dll en el PATH
// Opcional: un archivo .wav en el directorio actual

importar "graficos.nv";
importar "graficos_avanzado.nv";

// ============================================================
// CONSTANTES / CONSTANTS
// ============================================================

const entero SDL_INIT_AUDIO = 16;
const entero SDL_INIT_VIDEO = 32;

imprimir("=== Audio Demo SDL2_mixer ===");

// ============================================================
// INICIALIZAR SDL2 / INIT SDL2
// ============================================================

imprimir("1. Inicializando SDL2 (audio)...");
si !graficos_iniciar(SDL_INIT_AUDIO) {
    imprimir("ERROR: No se pudo iniciar SDL2");
    retornar;
}
imprimir("   SDL2 iniciado correctamente");

// ============================================================
// INICIALIZAR AUDIO / INIT AUDIO
// ============================================================

imprimir("2. Inicializando SDL2_mixer...");
entero audio_rc = graficos_avanzado_audio_iniciar(44100, 2);
imprimir("   Mix_OpenAudio retorna: ", audio_rc);

si audio_rc == 0 {
    imprimir("   ✅ Audio iniciado: 44100 Hz, estéreo");
} sino {
    imprimir("   ❌ No se pudo iniciar audio (SDL2_mixer.dll no encontrada?)");
    imprimir("      Continúa sin audio...");
    graficos_salir();
    retornar;
}

// ============================================================
// INTENTAR CARGAR WAV / TRY LOAD WAV
// ============================================================

imprimir("");
imprimir("3. Buscando archivos .wav...");

// Lista de posibles archivos WAV a cargar
lista<texto> wav_candidates = [
    "sonido.wav",
    "beep.wav",
    "explosion.wav",
    "laser.wav",
    "musica.wav",
    "test.wav",
    "sample.wav",
];

entero wav_cargado = 0;
texto wav_archivo = "";
entero i = 0;
mientras i < largo(wav_candidates) {
    entero chunk_id = graficos_avanzado_audio_cargar_wav(wav_candidates[i]);
    si chunk_id > 0 {
        wav_cargado = chunk_id;
        wav_archivo = wav_candidates[i];
        imprimir("   ✅ Cargado: ", wav_archivo, " (ID: ", chunk_id, ")");
        romper;
    }
    i = i + 1;
}

si wav_cargado == 0 {
    imprimir("   ℹ️  No se encontraron archivos WAV");
    imprimir("      Coloca un archivo .wav en el directorio actual");
    imprimir("      y vuelve a ejecutar para escucharlo");
}

// ============================================================
// REPRODUCIR / PLAY
// ============================================================

si wav_cargado > 0 {
    imprimir("");
    imprimir("4. Reproduciendo ", wav_archivo, "...");
    graficos_avanzado_audio_reproducir(wav_cargado, 0);  // 0 = una vez
    imprimir("   Sonido lanzado, esperando 2 segundos...");
    graficos_dormir(2000);

    // Reproducir de nuevo con bucle
    imprimir("   Reproduciendo de nuevo (3 veces)...");
    graficos_avanzado_audio_reproducir(wav_cargado, 2);  // 2 = repetir 3 veces
    graficos_dormir(500);

    // Descargar chunk
    imprimir("   Liberando chunk de audio...");
    graficos_avanzado_audio_descargar(wav_cargado);
    imprimir("   Chunk liberado");
}

// ============================================================
// LIMPIEZA / CLEANUP
// ============================================================

imprimir("");
imprimir("5. Cerrando audio...");
graficos_avanzado_audio_cerrar();
imprimir("   Audio cerrado");

graficos_salir();
imprimir("");
imprimir("=== Audio Demo Finalizada ===");
imprimir("Comandos útiles:");
imprimir("  graficos_avanzado_audio_iniciar(freq, canales)");
imprimir("  graficos_avanzado_audio_cargar_wav(\"archivo.wav\")");
imprimir("  graficos_avanzado_audio_reproducir(id, veces)");
imprimir("");
imprimir("Alias en inglés:");
imprimir("  graficos_avanzado_audio_init(freq, channels)");
imprimir("  graficos_avanzado_audio_load_wav(\"file.wav\")");
imprimir("  graficos_avanzado_audio_play(id, times)");
imprimir("  graficos_avanzado_audio_close()");
