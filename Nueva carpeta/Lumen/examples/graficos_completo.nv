// EJEMPLO GRÁFICOS COMPLETO — Ventana SDL2 con animación y teclado
// Uso: lumen run examples/graficos_completo.nv
// Requiere: SDL2.dll (Windows), libSDL2.so (Linux), libSDL2.dylib (macOS)

importar "graficos.nv";
// Headless/CI guard — demo requiere display/SDL2/consola interactiva
importar "sistema.nv";
texto _ci_guard = sistema_env_obtener("CI");
texto _hl_guard = sistema_env_obtener("LUMEN_HEADLESS");
si _ci_guard != "" || _hl_guard == "1" {
    imprimir("Headless/CI detectado — demo omitida (requiere display)");
    retornar;
}

entero SDL_INIT_VIDEO = 32;
entero SDL_SCANCODE_UP = 82;
entero SDL_SCANCODE_DOWN = 81;
entero SDL_SCANCODE_LEFT = 80;
entero SDL_SCANCODE_RIGHT = 79;
entero SDL_SCANCODE_SPACE = 44;
entero SDL_SCANCODE_ESC = 41;

imprimir("=== Gráficos SDL2 - Demo Completo ===");

si !graficos_iniciar(SDL_INIT_VIDEO) {
    imprimir("Error: No se pudo iniciar SDL2");
    retornar;
}

entero win = graficos_ventana("LÚMEN Gráficos", 100, 100, 800, 600, 0);
entero ren = graficos_renderizador(win, -1, 0);

entero cx = 400;
entero cy = 300;
entero evt_buf = __ffi_asignar(64);

mientras verdadero {
    // Leer todos los eventos
    texto evt = graficos_leer_evento(evt_buf);
    si evt == "QUIT" { romper; }

    // Teclado en tiempo real
    entero kb = graficos_teclado();
    si kb != 0 {
        si graficos_tecla_presionada(kb, SDL_SCANCODE_LEFT) { cx = cx - 5; }
        si graficos_tecla_presionada(kb, SDL_SCANCODE_RIGHT) { cx = cx + 5; }
        si graficos_tecla_presionada(kb, SDL_SCANCODE_UP) { cy = cy - 5; }
        si graficos_tecla_presionada(kb, SDL_SCANCODE_DOWN) { cy = cy + 5; }
        si graficos_tecla_presionada(kb, SDL_SCANCODE_ESC) { romper; }
    }

    // Dibujar
    graficos_color_render(ren, 20, 20, 40, 255);
    graficos_limpiar_render(ren);

    // Cuadrado animado
    graficos_color_render(ren, 255, 100, 100, 255);
    graficos_rectangulo(ren, cx - 25, cy - 25, 50, 50);

    // Barra de info
    graficos_color_render(ren, 255, 255, 255, 255);
    graficos_rectangulo(ren, cx - 25, cy + 30, 50, 5);

    graficos_presentar(ren);
    graficos_dormir(16);
}

__ffi_liberar(evt_buf, 64);
graficos_cerrar_ventana(win);
graficos_salir();
imprimir("Demo finalizada.");
