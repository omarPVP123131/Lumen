// Fase 66 — Operator Overloading: métodos añadidos a `texto`
rasgo Exclamable {
    funcion texto gritar(este);
}

impl Exclamable para texto {
    funcion texto gritar(este) {
        retornar este + "!!!";
    }
}

funcion entero principal() {
    texto s = "LUMEN";
    imprimir(s.gritar());
    retornar 0;
}
