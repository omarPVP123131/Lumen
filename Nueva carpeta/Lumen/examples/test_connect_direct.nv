// @expected_failure: Mod requires numbers - Windows ws2_32 only
// Headless/CI guard — demo requiere red/GPU intensiva, omitida en CI
importar "sistema.nv";
texto _ci_guard = sistema_env_obtener("CI");
texto _hl_guard = sistema_env_obtener("LUMEN_HEADLESS");
si _ci_guard != "" || _hl_guard == "1" {
    imprimir("Headless/CI detectado — demo omitida");
    retornar;
}
// Connect test with proper buffer handling
imprimir("=== Connect Test ===");

sea w = __ffi_cargar("ws2_32.dll");
sea wsa = __ffi_asignar(400);
__ffi_llamar(w, "WSAStartup", "entero,entero", [514, wsa], "entero");
__ffi_liberar(wsa, 400);

sea fd = __ffi_llamar(w, "socket", "entero,entero,entero", [2, 1, 0], "entero");
imprimir("socket: ", fd);

// Build sockaddr_in
sea addr = __ffi_asignar(16);
__ffi_poke(addr, 0, 2); __ffi_poke(addr, 1, 0);  // AF_INET
__ffi_poke(addr, 2, 0); __ffi_poke(addr, 3, 80); // port 80
sea ip = __ffi_llamar(w, "inet_addr", "texto", ["93.184.216.34"], "entero");
imprimir("inet_addr: ", ip);
__ffi_poke(addr, 4, ip % 256);
__ffi_poke(addr, 5, (ip / 256) % 256);
__ffi_poke(addr, 6, (ip / 65536) % 256);
__ffi_poke(addr, 7, (ip / 16777216) % 256);
// Debug: read back the bytes
entero db = 0;
mientras db < 16 {
    sea b = __ffi_peek(addr, db);
    si db < 4 { imprimir("byte ", db, ": ", b); }
    db = db + 1;
}
entero i = 8; mientras i < 16 { __ffi_poke(addr, i, 0); i = i + 1; }

// Connect
sea cr = __ffi_llamar(w, "connect", "entero,entero,entero", [fd, addr, 16], "entero");
imprimir("connect: ", cr);
sea err2 = __ffi_llamar(w, "WSAGetLastError", "", [], "entero");
imprimir("WSAGetLastError: ", err2);
__ffi_liberar(addr, 16);

si cr == 0 {
    // Send HTTP request
    texto req = "GET / HTTP/1.0\r\nHost: example.com\r\n\r\n";
    sea buf = __ffi_asignar(req.largo() + 1);
    __ffi_escribir(buf, 0, req);
    sea s = __ffi_llamar(w, "send", "entero,entero,entero,entero", [fd, buf, req.largo(), 0], "entero");
    imprimir("send: ", s);
    __ffi_liberar(buf, req.largo() + 1);
    
    // Receive response
    sea rbuf = __ffi_asignar(4096);
    sea r = __ffi_llamar(w, "recv", "entero,entero,entero,entero", [fd, rbuf, 4096, 0], "entero");
    imprimir("recv: ", r);
    si r > 0 {
        texto data = __ffi_leer(rbuf, 0, r);
        imprimir("response: ", data);
    }
    __ffi_liberar(rbuf, 4096);
    __ffi_llamar(w, "closesocket", "entero", [fd], "entero");
}

imprimir("--- FIN ---");
