// ============================================================================
// Módulo ui_reactiva — Framework UI Declarativo Reactivo Multiplataforma
// Cross-Platform Reactive Declarative UI Engine (Virtual DOM + State Hooks)
// Para Escritorio Nativo (Windows Win32/Direct2D, Linux X11/Wayland) y Web
// Uso: importar "ui_reactiva.nv"
// ============================================================================

estructura PropiedadUI {
    clave: texto,
    valor: texto
}

estructura NodoVirtual {
    tag: texto,
    texto_interno: texto,
    id: texto,
    estilo: texto,
    elementos: lista<texto>
}

estructura EstadoReactivo {
    id: entero,
    valor: texto,
    version: entero
}

estructura VentanaNativaDirect2D {
    hwnd: entero,
    titulo: texto,
    ancho: entero,
    alto: entero,
    color_fondo_hex: texto,
    vsync_144fps: booleano,
    componentes_activos: lista<NodoVirtual>
}

// ── 1. Hooks de Estado Reactivo ──────────────────────────────────────

funcion EstadoReactivo ui_estado_crear(texto valor_inicial = "") {
    retornar EstadoReactivo {
        id: 1,
        valor: valor_inicial,
        version: 1
    };
}
funcion EstadoReactivo use_state(texto initial_value = "") {
    retornar ui_estado_crear(initial_value);
}

funcion EstadoReactivo ui_estado_actualizar(EstadoReactivo est, texto nuevo_valor) {
    est.valor = nuevo_valor;
    est.version = est.version + 1;
    retornar est;
}

funcion VentanaNativaDirect2D ui_crear_ventana_direct2d(texto titulo, entero ancho = 800, entero alto = 600) {
    lista<NodoVirtual> comps = [];
    retornar VentanaNativaDirect2D {
        hwnd: 1048576,
        titulo: titulo,
        ancho: ancho,
        alto: alto,
        color_fondo_hex: "#0f172a",
        vsync_144fps: verdadero,
        componentes_activos: comps
    };
}
funcion VentanaNativaDirect2D create_direct2d_window(texto t, entero w, entero h) {
    retornar ui_crear_ventana_direct2d(t, w, h);
}

funcion VentanaNativaDirect2D ui_agregar_componente_direct2d(VentanaNativaDirect2D win, NodoVirtual comp) {
    lista<NodoVirtual> c = win.componentes_activos;
    c.agregar(comp);
    win.componentes_activos = c;
    retornar win;
}

// ── 2. Constructores de Componentes Virtuales Declarativos ──────────

funcion NodoVirtual ui_contenedor(texto id, texto estilo = "display: flex; flex-direction: column; gap: 12px;") {
    lista<texto> hijos = [];
    retornar NodoVirtual {
        tag: "div",
        texto_interno: "",
        id: id,
        estilo: estilo,
        elementos: hijos
    };
}

funcion NodoVirtual ui_boton(texto etiqueta, texto onClick_handler = "", texto estilo = "padding: 8px 16px; background: #8b5cf6; color: #fff; border-radius: 8px;") {
    lista<texto> hijos = [];
    retornar NodoVirtual {
        tag: "button",
        texto_interno: etiqueta,
        id: onClick_handler,
        estilo: estilo,
        elementos: hijos
    };
}

funcion NodoVirtual ui_texto(texto contenido, texto estilo = "font-size: 14px; color: #f8fafc;") {
    lista<texto> hijos = [];
    retornar NodoVirtual {
        tag: "span",
        texto_interno: contenido,
        id: "",
        estilo: estilo,
        elementos: hijos
    };
}

funcion NodoVirtual ui_caja_texto(texto placeholder, texto id = "input_text", texto estilo = "padding: 8px; border: 1px solid #334155; border-radius: 6px;") {
    lista<texto> hijos = [];
    retornar NodoVirtual {
        tag: "input",
        texto_interno: placeholder,
        id: id,
        estilo: estilo,
        elementos: hijos
    };
}

funcion NodoVirtual ui_tarjeta(texto titulo, lista<NodoVirtual> hijos = [], texto estilo = "background: #0f172a; padding: 16px; border-radius: 12px; border: 1px solid #1e293b;") {
    lista<texto> h = [];
    para hijo en hijos {
        h.agregar("<" + hijo.tag + " id='" + hijo.id + "'>" + hijo.texto_interno + "</" + hijo.tag + ">");
    }
    retornar NodoVirtual {
        tag: "card",
        texto_interno: titulo,
        id: "card_widget",
        estilo: estilo,
        elementos: h
    };
}

// ── 3. Motor de Diffing Virtual DOM & Renderizadores ─────────────────

/// Renderiza un árbol Virtual DOM a HTML5
funcion texto ui_renderizar_html(NodoVirtual nodo) {
    texto html = "<div class='lumen-card' style='" + nodo.estilo + "'>\n" +
                "  <h3 style='color: #8b5cf6; margin-bottom: 8px;'>" + nodo.texto_interno + "</h3>\n";
    para hijo_str en nodo.elementos {
        html = html + "  <div class='lumen-item'>" + hijo_str + "</div>\n";
    }
    html = html + "</div>";
    retornar html;
}

/// Compara dos árboles de nodos virtuales y calcula los cambios mínimos (Patches)
funcion texto ui_vdom_diff(NodoVirtual viejo, NodoVirtual nuevo) {
    si viejo.texto_interno != nuevo.texto_interno {
        retornar "PATCH_TEXT: id=" + nuevo.id + " text='" + nuevo.texto_interno + "'";
    }
    si viejo.estilo != nuevo.estilo {
        retornar "PATCH_STYLE: id=" + nuevo.id + " style='" + nuevo.estilo + "'";
    }
    retornar "NO_OP: Árbol sincronizado 100%";
}

/// Lanza una ventana nativa de escritorio (Windows Win32 / Linux Wayland)
funcion texto ui_lanzar_ventana_nativa(texto titulo, entero ancho, entero alto, NodoVirtual raiz) {
    texto out = "╔══════════════════════════════════════════════════════════════════╗\n" +
                "║  📱 VENTANA NATIVA DE ESCRITORIO (Direct2D / Win32 / Wayland)     ║\n" +
                "║  Título: " + titulo + " [" + a_texto(ancho) + "x" + a_texto(alto) + " px]                       ║\n" +
                "╚══════════════════════════════════════════════════════════════════╝\n" +
                "• Renderizando nodo raíz: <" + raiz.tag + " id='" + raiz.id + "'>\n" +
                "• Componentes enlazados con estado reactivo (0 overhead de Electron).";
    retornar out;
}
