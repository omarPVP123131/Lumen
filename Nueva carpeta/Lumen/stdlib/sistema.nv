// Módulo sistema — procesos, entorno, rutas y temp vía FFI
// System module — pure LÚMEN via FFI, dual ES/EN API
// Uso: importar "sistema.nv"

cualquiera __libc = ninguno;

funcion booleano __cargar_libc() {
    si __tipo_de(__libc) == "texto" { retornar verdadero; }
    __libc = __ffi_cargar("msvcrt.dll");
    si __tipo_de(__libc) == "texto" { retornar verdadero; }
    __libc = __ffi_cargar("libc.so.6");
    si __tipo_de(__libc) == "texto" { retornar verdadero; }
    __libc = __ffi_cargar("libSystem.dylib");
    retornar __tipo_de(__libc) == "texto";
}

// ============================================================
// PROCESOS / PROCESS
// ============================================================

funcion texto ejecutar(texto cmd) {
    si !__cargar_libc() { retornar ""; }
    texto res = "";
    // system() ejecuta y retorna código de salida
    entero r = __ffi_llamar(__libc, "system", "texto", [cmd], "entero");
    si __tipo_de(r) != "entero" { retornar ""; }
    retornar a_texto(r);
}
funcion texto run(texto cmd) { retornar ejecutar(cmd); }

// ============================================================
// ENTORNO / ENVIRONMENT
// ============================================================

funcion texto env_obtener(texto clave) {
    si !__cargar_libc() { retornar ""; }
    cualquiera ptr_val = __ffi_llamar(__libc, "getenv", "texto", [clave], "entero");
    si __tipo_de(ptr_val) != "entero" { retornar ""; }
    entero ptr = ptr_val como entero;
    si ptr == 0 { retornar ""; }
    entero len = 0;
    mientras __ffi_peek(ptr, len) != 0 { len = len + 1; }
    retornar __ffi_leer(ptr, 0, len);
}
funcion texto env_get(texto key) { retornar env_obtener(key); }

funcion booleano env_asignar(texto clave, texto valor) {
    si !__cargar_libc() { retornar falso; }
    texto entrada = clave + "=" + valor;
    cualquiera r = __ffi_llamar(__libc, "_putenv", "texto", [entrada], "entero");
    si __tipo_de(r) == "entero" && r como entero == 0 { retornar verdadero; }
    r = __ffi_llamar(__libc, "putenv", "texto", [entrada], "entero");
    si __tipo_de(r) == "entero" && r como entero == 0 { retornar verdadero; }
    r = __ffi_llamar(__libc, "setenv", "texto,texto,entero", [clave, valor, 1], "entero");
    si __tipo_de(r) == "entero" && r como entero == 0 { retornar verdadero; }
    retornar falso;
}
funcion booleano env_set(texto key, texto value) { retornar env_asignar(key, value); }

funcion cualquiera env_listar() {
    retornar __env_listar();
}
funcion cualquiera env_list() { retornar env_listar(); }

// ============================================================
// RUTAS / PATH (manipulación de strings pura)
// ============================================================

funcion texto path_unir(texto a, texto b) {
    retornar a + "\\" + b;
}
funcion texto path_join(texto a, texto b) { retornar path_unir(a, b); }

funcion texto path_absoluto(texto ruta) {
    si !__cargar_libc() { retornar ruta; }
    entero buf = __ffi_asignar(260);
    // Windows _fullpath
    cualquiera r = __ffi_llamar(__libc, "_fullpath", "entero,texto,entero", [buf, ruta, 260], "entero");
    si __tipo_de(r) == "entero" && r como entero != 0 {
        texto res = "";
        entero i = 0;
        mientras verdadero {
            entero b = __ffi_peek(buf, i);
            si b == 0 { romper; }
            res = res + __str_from(b);
            i = i + 1;
        }
        __ffi_liberar(buf, 260);
        retornar res;
    }
    // POSIX realpath
    r = __ffi_llamar(__libc, "realpath", "texto,entero", [ruta, buf], "entero");
    si __tipo_de(r) == "entero" && r como entero != 0 {
        texto res = "";
        entero i = 0;
        mientras verdadero {
            entero b = __ffi_peek(buf, i);
            si b == 0 { romper; }
            res = res + __str_from(b);
            i = i + 1;
        }
        __ffi_liberar(buf, 260);
        retornar res;
    }
    __ffi_liberar(buf, 260);
    retornar ruta;
}
funcion texto path_absolute(texto path) { retornar path_absoluto(path); }

funcion texto path_extension(texto ruta) {
    entero pos = ruta.largo() - 1;
    mientras pos >= 0 {
        si ruta[pos] == "." {
            texto ext = "";
            entero len = ruta.largo();
            entero k = pos + 1;
            mientras (k < len) {
                ext = ext + ruta[k];
                k = k + 1;
            }
            retornar ext;
        }
        pos = pos - 1;
    }
    retornar "";
}

funcion texto path_nombre_archivo(texto ruta) {
    entero i = ruta.largo() - 1;
    mientras i >= 0 {
        si ruta[i] == "\\" || ruta[i] == "/" {
            texto nom = "";
            entero j = i + 1;
            entero rlen = ruta.largo();
            mientras (j < rlen) {
                nom = nom + ruta[j];
                j = j + 1;
            }
            retornar nom;
        }
        i = i - 1;
    }
    retornar ruta;
}
funcion texto path_filename(texto path) { retornar path_nombre_archivo(path); }

funcion texto path_padre(texto ruta) {
    entero i = ruta.largo() - 1;
    mientras i >= 0 {
        si ruta[i] == "\\" || ruta[i] == "/" {
            texto padre = "";
            entero j = 0;
            entero limite = i;
            mientras (j < limite) {
                padre = padre + ruta[j];
                j = j + 1;
            }
            retornar padre;
        }
        i = i - 1;
    }
    retornar "";
}
funcion texto path_parent(texto path) { retornar path_padre(path); }

// ============================================================
// TEMP
// ============================================================

funcion texto temp_directorio() {
    texto res = env_obtener("TEMP");
    si res == "" { res = env_obtener("TMP"); }
    si res == "" { res = env_obtener("TMPDIR"); }
    si res == "" { res = env_obtener("XDG_RUNTIME_DIR"); }
    si res == "" {
        // Fallback por SO
        texto os = env_obtener("OS");
        si os.largo() > 0 && os[0] == "W" { res = "C:\\Windows\\Temp"; } sino { res = "/tmp"; }
    }
    retornar res;
}
funcion texto temp_dir() { retornar temp_directorio(); }

funcion texto temp_archivo() {
    texto dir = temp_directorio();
    si !__cargar_libc() {
        retornar path_unir(dir, "lumen_" + a_texto(__tiempo_ahora()) + "_0");
    }
    cualquiera pid_val = __ffi_llamar(__libc, "_getpid", "", [], "entero");
    si __tipo_de(pid_val) != "entero" {
        pid_val = __ffi_llamar(__libc, "getpid", "", [], "entero");
    }
    entero pid = 0;
    si __tipo_de(pid_val) == "entero" { pid = pid_val como entero; }
    entero ts = __tiempo_ahora();
    retornar path_unir(dir, "lumen_" + a_texto(ts) + "_" + a_texto(pid));
}
funcion texto temp_file() { retornar temp_archivo(); }
