// Módulo gráficos — ventanas gráficas vía SDL2 FFI
// Graphics module — pure LÚMEN via FFI to SDL2, dual ES/EN API
// Uso: importar "graficos.nv"
// Requiere: SDL2.dll/libSDL2.so/libSDL2.dylib

cualquiera __sdl = ninguno;
cualquiera __libc_hl = ninguno;

funcion booleano es_headless() {
    si __tipo_de(__libc_hl) != "texto" {
        __libc_hl = __ffi_cargar("msvcrt.dll");
        si __tipo_de(__libc_hl) != "texto" {
            __libc_hl = __ffi_cargar("libc.so.6");
        }
        si __tipo_de(__libc_hl) != "texto" {
            __libc_hl = __ffi_cargar("libSystem.dylib");
        }
    }
    si __tipo_de(__libc_hl) == "texto" {
        entero p = __ffi_llamar(__libc_hl, "getenv", "texto", ["CI"], "entero");
        si p != 0 && __ffi_peek(p, 0) != 0 { retornar verdadero; }
        p = __ffi_llamar(__libc_hl, "getenv", "texto", ["LUMEN_HEADLESS"], "entero");
        si p != 0 && __ffi_peek(p, 0) != 0 { retornar verdadero; }
    }
    retornar falso;
}
funcion booleano is_headless() { retornar es_headless(); }

funcion booleano __cargar() {
    si __tipo_de(__sdl) == "texto" { retornar verdadero; }
    __sdl = __ffi_cargar("SDL2.dll");
    si __tipo_de(__sdl) != "texto" {
        __sdl = __ffi_cargar("libSDL2.so");
    }
    si __tipo_de(__sdl) != "texto" {
        __sdl = __ffi_cargar("libSDL2.dylib");
    }
    retornar __tipo_de(__sdl) == "texto";
}

funcion texto __err() {
    retornar __ffi_llamar(__sdl, "SDL_GetError", "", [], "texto");
}

// ============================================================
// INICIALIZACIÓN / INIT
// ============================================================

funcion booleano iniciar(entero flags) {
    si es_headless() { retornar falso; }
    si !__cargar() { retornar falso; }
    entero rc = __ffi_llamar(__sdl, "SDL_Init", "entero", [flags], "entero");
    retornar rc == 0;
}
funcion booleano init(entero flags) { retornar iniciar(flags); }

funcion texto salir() {
    __ffi_llamar(__sdl, "SDL_Quit", "", [], "void");
    retornar "ok";
}
funcion texto quit() { retornar salir(); }

funcion texto dormir(entero ms) {
    __ffi_llamar(__sdl, "SDL_Delay", "entero", [ms], "void");
    retornar "ok";
}
funcion texto delay(entero ms) { retornar dormir(ms); }

// ============================================================
// VENTANA / WINDOW
// ============================================================

funcion entero ventana(texto titulo, entero x, entero y, entero w, entero h, entero flags) {
    si es_headless() { retornar 0; }
    si !__cargar() { retornar 0; }
    entero buf = __ffi_asignar(titulo.largo() + 1);
    __ffi_escribir(buf, 0, titulo);
    __ffi_poke(buf, titulo.largo(), 0);
    entero win = __ffi_llamar(__sdl, "SDL_CreateWindow", "entero,entero,entero,entero,entero,entero",
        [buf, x, y, w, h, flags], "entero");
    __ffi_liberar(buf, titulo.largo() + 1);
    retornar win;
}
funcion entero window(texto title, entero x, entero y, entero w, entero h, entero flags) { retornar ventana(title, x, y, w, h, flags); }

funcion void cerrar_ventana(entero win) {
    __ffi_llamar(__sdl, "SDL_DestroyWindow", "entero", [win], "void");
}
funcion void destroy_window(entero win) { retornar cerrar_ventana(win); }

// ============================================================
// RENDERIZADO / RENDER
// ============================================================

funcion entero renderizador(entero win, entero index, entero flags) {
    retornar __ffi_llamar(__sdl, "SDL_CreateRenderer", "entero,entero,entero", [win, index, flags], "entero");
}
funcion entero renderer(entero win, entero index, entero flags) { retornar renderizador(win, index, flags); }

funcion booleano color_render(entero ren, entero r, entero g, entero b, entero a) {
    retornar __ffi_llamar(__sdl, "SDL_SetRenderDrawColor", "entero,entero,entero,entero,entero", [ren, r, g, b, a], "entero") == 0;
}
funcion booleano set_color(entero ren, entero r, entero g, entero b, entero a) { retornar color_render(ren, r, g, b, a); }

funcion booleano limpiar_render(entero ren) {
    retornar __ffi_llamar(__sdl, "SDL_RenderClear", "entero", [ren], "entero") == 0;
}
funcion booleano clear(entero ren) { retornar limpiar_render(ren); }

funcion texto presentar(entero ren) {
    __ffi_llamar(__sdl, "SDL_RenderPresent", "entero", [ren], "void");
    retornar "ok";
}
funcion texto present(entero ren) { retornar presentar(ren); }

// ============================================================
// DIBUJADO / DRAWING
// ============================================================

funcion entero __i32_le(entero val, entero buf, entero off) {
    entero o0 = off;
    entero o1 = off + 1;
    entero o2 = off + 2;
    entero o3 = off + 3;
    __ffi_poke(buf, o0, val & 255);
    __ffi_poke(buf, o1, (val >> 8) & 255);
    __ffi_poke(buf, o2, (val >> 16) & 255);
    __ffi_poke(buf, o3, (val >> 24) & 255);
    retornar 0;
}

funcion booleano rectangulo(entero ren, entero x, entero y, entero w, entero h) {
    entero buf = __ffi_asignar(16);
    __i32_le(x, buf, 0);
    __i32_le(y, buf, 4);
    __i32_le(w, buf, 8);
    __i32_le(h, buf, 12);
    entero rc = __ffi_llamar(__sdl, "SDL_RenderFillRect", "entero,entero", [ren, buf], "entero");
    __ffi_liberar(buf, 16);
    retornar rc == 0;
}
funcion booleano fill_rect(entero ren, entero x, entero y, entero w, entero h) { retornar rectangulo(ren, x, y, w, h); }

// ============================================================
// EVENTOS / EVENTS
// ============================================================

funcion entero __read_u32(entero buf, entero off) {
    entero b0 = __ffi_peek(buf, off);
    entero b1 = __ffi_peek(buf, off + 1);
    entero b2 = __ffi_peek(buf, off + 2);
    entero b3 = __ffi_peek(buf, off + 3);
    retornar b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
}

funcion entero __read_u16(entero buf, entero off) {
    entero b0 = __ffi_peek(buf, off);
    entero b1 = __ffi_peek(buf, off + 1);
    retornar b0 | (b1 << 8);
}

funcion texto leer_evento(entero buf) {
    entero rc = __ffi_llamar(__sdl, "SDL_PollEvent", "entero", [buf], "entero");
    si rc == 0 { retornar ""; }
    entero evt_type = __read_u32(buf, 0);
    si evt_type == 256 { retornar "QUIT"; }
    si evt_type == 768 {
        entero sym = __read_u32(buf, 20);
        retornar "KEY:" + sym;
    }
    si evt_type == 769 { retornar "KEYUP"; }
    si evt_type == 1024 {
        entero mx = __read_u16(buf, 24);
        entero my = __read_u16(buf, 26);
        retornar "MOVE:" + mx + "," + my;
    }
    si evt_type == 1025 || evt_type == 1026 {
        entero btn = __ffi_peek(buf, 28);
        retornar "MOUSE:" + btn;
    }
    retornar "EVT:" + evt_type;
}
funcion texto poll_event(entero buf) { retornar leer_evento(buf); }

// ============================================================
// BUCLE PRINCIPAL / MAIN LOOP
// ============================================================

funcion texto bucle_principal(entero win, entero ren, entero r, entero g, entero b) {
    entero evt_buf = __ffi_asignar(64);
    mientras verdadero {
        color_render(ren, r, g, b, 255);
        limpiar_render(ren);
        presentar(ren);
        texto evt = leer_evento(evt_buf);
        si evt == "QUIT" { romper; }
        dormir(16);
    }
    __ffi_liberar(evt_buf, 64);
    salir();
    retornar "ok";
}
funcion texto main_loop(entero win, entero ren, entero r, entero g, entero b) { retornar bucle_principal(win, ren, r, g, b); }

// ============================================================
// IMAGENES / IMAGES (SDL_LoadBMP + SDL_CreateTextureFromSurface)
// ============================================================

funcion entero cargar_textura(entero ren, texto archivo) {
    entero buf = __ffi_asignar(archivo.largo() + 1);
    __ffi_escribir(buf, 0, archivo);
    __ffi_poke(buf, archivo.largo(), 0);
    entero surf = __ffi_llamar(__sdl, "SDL_LoadBMP_RW", "entero,entero", [buf, 0], "entero");
    __ffi_liberar(buf, archivo.largo() + 1);
    si surf == 0 { retornar 0; }
    entero tex = __ffi_llamar(__sdl, "SDL_CreateTextureFromSurface", "entero,entero", [ren, surf], "entero");
    __ffi_llamar(__sdl, "SDL_FreeSurface", "entero", [surf], "void");
    retornar tex;
}
funcion entero load_texture(entero ren, texto file) { retornar cargar_textura(ren, file); }

funcion booleano dibujar_textura(entero ren, entero tex, entero x, entero y) {
    entero buf = __ffi_asignar(16);
    __i32_le(x, buf, 0); __i32_le(y, buf, 4);
    // src rect = NULL, dst rect = {x, y, -1, -1} no funciona, usar SDL_RenderCopy sin rect
    entero rc = __ffi_llamar(__sdl, "SDL_RenderCopy", "entero,entero,entero,entero", [ren, tex, 0, buf], "entero");
    __ffi_liberar(buf, 16);
    retornar rc == 0;
}
funcion booleano draw_texture(entero ren, entero tex, entero x, entero y) { retornar dibujar_textura(ren, tex, x, y); }

funcion void destruir_textura(entero tex) {
    __ffi_llamar(__sdl, "SDL_DestroyTexture", "entero", [tex], "void");
}
funcion void destroy_texture(entero tex) { destruir_textura(tex); }

// ============================================================
// TECLADO / KEYBOARD
// ============================================================

funcion entero teclado() {
    entero buf = __ffi_asignar(8);
    entero ptr = __ffi_llamar(__sdl, "SDL_GetKeyboardState", "entero", [buf], "entero");
    __ffi_liberar(buf, 8);
    retornar ptr;
}
funcion entero keyboard() { retornar teclado(); }

funcion booleano tecla_presionada(entero kb_ptr, entero scancode) {
    entero b = __ffi_peek(kb_ptr, scancode);
    retornar b != 0;
}
funcion booleano key_down(entero kb_ptr, entero scancode) { retornar tecla_presionada(kb_ptr, scancode); }
