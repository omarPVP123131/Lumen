importar "texto.nv";

imprimir("=== Texto Test ===");

// Basic
imprimir("largo: ", texto_largo("Hola"));
imprimir("mayus: ", texto_mayusculas("hola"));
imprimir("minus: ", texto_minusculas("HOLA"));
imprimir("trim: '", texto_recortar("  hola  "), "'");
imprimir("trim_start: '", texto_recortar_inicio("  hola  "), "'");
imprimir("trim_end: '", texto_recortar_fin("  hola  "), "'");

// Search
imprimir("contiene: ", texto_contiene("Hola Mundo", "Mundo"));
imprimir("buscar: ", texto_buscar("Hola Mundo", "Mundo"));
imprimir("empieza_con: ", texto_empieza_con("Hola", "Ho"));
imprimir("termina_con: ", texto_termina_con("Hola", "la"));

// Transform
imprimir("invertir: ", texto_invertir("Hola"));
imprimir("reemplazar: ", texto_reemplazar("Hola Mundo", "Mundo", "Lumen"));
imprimir("repetir: ", texto_repetir("X", 5));

// Validation
imprimir("es_vacio: ", texto_es_vacio(""));
imprimir("es_digito: ", texto_es_digito("5"));
imprimir("es_letra: ", texto_es_letra("a"));

// Split
lista<texto> partes = texto_dividir("a,b,c", ",");
imprimir("split count: ", partes.largo());
imprimir("split[0]: ", partes[0]);

// English aliases
imprimir("upper: ", texto_upper("hola"));
imprimir("trim: '", texto_trim("  hi  "), "'");
imprimir("starts_with: ", texto_starts_with("Hello", "He"));

imprimir("--- FIN ---");
