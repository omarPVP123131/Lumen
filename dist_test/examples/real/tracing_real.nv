// ==========================================
// tracing_real.nv — Distributed Tracing (real-world)
// Tests: microservice tracing, waterfall, error propagation
// Uso: lumen run examples/real/tracing_real.nv
// ==========================================

imprimir("=== Tracing REAL: Microservicio con Trazado ===");

// ── Ej 1: Simulacion de request HTTP completo ──
// Ej 1: Full HTTP request simulation
imprimir("");
imprimir("--- Ej 1: Trazado de Peticion HTTP ---");

entero req_inicio = 1000;
entero req_fin = 1350;
entero req_duracion = req_fin - req_inicio;

entero auth_duracion = 45;
entero db_duracion = 120;
entero cache_duracion = 15;
entero ser_duracion = 30;
entero env_duracion = 25;

imprimir("[ACTIVO] GET /api/usuarios/42 (", req_duracion, "us)");
imprimir("  [OK] auth.verificar_token (", auth_duracion, "us)");
imprimir("  [OK] db.consulta_usuario (", db_duracion, "us)");
imprimir("  [OK] cache.verificar (", cache_duracion, "us)");
imprimir("  [OK] serializar_respuesta (", ser_duracion, "us)");
imprimir("  [OK] enviar_respuesta (", env_duracion, "us)");

// Verify total
entero suma_tiempos = auth_duracion + db_duracion + cache_duracion + ser_duracion + env_duracion;
imprimir("Suma de tiempos: ", suma_tiempos, "us (request total: ", req_duracion, "us)");

// ── Ej 2: Propagacion de errores entre servicios ──
// Ej 2: Error propagation across services
imprimir("");
imprimir("--- Ej 2: Propagacion de Errores ---");

imprimir("[ERROR] servicio.pedidos.crear: Fallo en verificacion de inventario");
imprimir("  [ERROR] inventario.verificar_stock: Producto sin stock disponible");
imprimir("    producto.id = PROD-999");
imprimir("    stock.actual = 0");
imprimir("    stock.minimo = 5");
imprimir("  [CANCELADO] pago.procesar: Cancelado por error upstream");
imprimir("  [CANCELADO] notificacion.enviar: No ejecutado");

entero errores_detectados = 2;
entero cancelados = 2;
imprimir("Resumen: ", errores_detectados, " errores, ", cancelados, " cancelados");

// ── Ej 3: Waterfall de latencias ──
// Ej 3: Latency waterfall
imprimir("");
imprimir("--- Ej 3: Waterfall de Latencias ---");

texto servicio = "procesar_lote";
entero t_validar = 100;
entero t_transformar = 250;
entero t_enviar_cola = 80;
entero t_guardar_log = 50;
entero t_notificar = 20;
entero t_total = t_validar + t_transformar + t_enviar_cola + t_guardar_log + t_notificar;

imprimir("[COMPLETADO] ", servicio, " (", t_total, "us)");
imprimir("  validar_datos:    ", t_validar, "us (", t_validar * 100 / t_total, "%)");
imprimir("  transformar:      ", t_transformar, "us (", t_transformar * 100 / t_total, "%)");
imprimir("  enviar_cola:      ", t_enviar_cola, "us (", t_enviar_cola * 100 / t_total, "%)");
imprimir("  guardar_log:      ", t_guardar_log, "us (", t_guardar_log * 100 / t_total, "%)");
imprimir("  notificar:         ", t_notificar, "us (", t_notificar * 100 / t_total, "%)");

// Find bottleneck
entero max_etapa = t_validar;
texto cuello_botella = "validar_datos";
si t_transformar - max_etapa > 0 { max_etapa = t_transformar; cuello_botella = "transformar"; }
si t_enviar_cola - max_etapa > 0 { max_etapa = t_enviar_cola; cuello_botella = "enviar_cola"; }
si t_guardar_log - max_etapa > 0 { max_etapa = t_guardar_log; cuello_botella = "guardar_log"; }
si t_notificar - max_etapa > 0 { max_etapa = t_notificar; cuello_botella = "notificar"; }
imprimir("Cuello de botella: ", cuello_botella, " (", max_etapa, "us, ", max_etapa * 100 / t_total, "%)");

// ── Ej 4: Export JSON ──
// Ej 4: JSON export format
imprimir("");
imprimir("--- Ej 4: Export JSON ---");
texto json = "[\n";
json = json + "  {\"trace_id\":\"abc123\",\"spans\":[\n";
json = json + "    {\"nombre\":\"procesar_lote\",\"duracion\":" + a_texto(t_total) + "},\n";
json = json + "    {\"nombre\":\"validar_datos\",\"duracion\":" + a_texto(t_validar) + "},\n";
json = json + "    {\"nombre\":\"transformar\",\"duracion\":" + a_texto(t_transformar) + "}\n";
json = json + "  ]}\n";
json = json + "]";
imprimir(json);

// ── Ej 5: Metricas de tracing ──
// Ej 5: Tracing metrics
imprimir("");
imprimir("--- Ej 5: Metricas de Trazado ---");
entero total_spans = 9;
entero spans_ok = 5;
entero spans_error = 2;
entero spans_cancel = 2;

imprimir("Total spans: ", total_spans);
imprimir("  Completados: ", spans_ok);
imprimir("  Errores:     ", spans_error);
imprimir("  Cancelados:  ", spans_cancel);

si spans_error == 0 {
    imprimir("Estado: TODO OK - sin errores");
} sino {
    entero tasa_pct = spans_error * 100 / total_spans;
    imprimir("Tasa de error: ", tasa_pct, "%");
    imprimir("Trazado completado con ", spans_error, " errores");
}

imprimir("");
imprimir("--- FIN TRACING REAL ---");
