// ==========================================
// tui_temas_real.nv — TUI Themes (real-world)
// Tests: theme customizer, accessibility calc, palette export
// Uso: lumen run -L stdlib/ examples/real/tui_temas_real.nv
// ==========================================

imprimir("=== TUI Temas REAL: Custom Themes ===");

// ── Ej 1: Theme Customizer ──
// Ej 1: Create and modify custom themes
imprimir("--- Ej 1: Personalizador de Temas ---");
funcion lista<entero> tema_personalizado(entero bg, entero fg, entero accent) {
    retornar [bg, fg, accent, accent + 20, accent, fg, bg + 10, fg, 196, 46, 214, accent];
}
// Create a custom warm theme
lista<entero> tema_warm = tema_personalizado(52, 230, 208);
imprimir("Tema calido personalizado:");
imprimir("  fondo=", tema_warm[0], " texto=", tema_warm[1], " acento=", tema_warm[2]);
// Create a custom cool theme
lista<entero> tema_cool = tema_personalizado(17, 255, 39);
imprimir("Tema frio personalizado:");
imprimir("  fondo=", tema_cool[0], " texto=", tema_cool[1], " acento=", tema_cool[2]);
// Validate theme colors are in range
funcion booleano colores_validos(lista<entero> t) {
    entero i = 0;
    mientras i < largo(t) {
        si t[i] < 0 { retornar falso; }
        si t[i] > 255 { retornar falso; }
        i = i + 1;
    }
    retornar verdadero;
}
imprimir("Tema calido valido? ", colores_validos(tema_warm));
imprimir("Tema frio valido?   ", colores_validos(tema_cool));

// ── Ej 2: Accessibility Calculator ──
// Ej 2: Check if theme meets WCAG contrast guidelines
imprimir("--- Ej 2: Calculadora de Accesibilidad ---");
funcion texto nivel_accesibilidad(numero ratio) {
    si ratio > 7.0 { retornar "AAA (excelente)"; }
    si ratio > 4.5 { retornar "AA (bueno)"; }
    si ratio > 3.0 { retornar "AA-large (aceptable)"; }
    retornar "BAJO (no cumple)";
}
// Test different color pairs
imprimir("Evaluacion de contraste texto/fondo:");
lista<lista<entero>> pares = [[0, 255], [128, 255], [100, 120], [0, 196]];
entero pi = 0;
mientras pi < largo(pares) {
    entero bg = pares[pi][0];
    entero fg = pares[pi][1];
    numero ratio = (fg como numero + 0.05) / (bg como numero + 0.05);
    si ratio < 1.0 { ratio = 1.0 / ratio; }
    imprimir("  bg=", bg, " fg=", fg, " ratio=", ratio, " -> ", nivel_accesibilidad(ratio));
    pi = pi + 1;
}

// ── Ej 3: Palette Exporter ──
// Ej 3: Export theme as CSS/JSON-like format
imprimir("--- Ej 3: Exportador de Paleta ---");
funcion texto exportar_tema(texto nombre, lista<entero> t, lista<texto> campos) {
    texto exp = "/* Tema: " + nombre + " */\n";
    entero i = 0;
    mientras i < largo(campos) {
        exp = exp + "  " + campos[i] + ": ANSI-" + t[i] + ";\n";
        i = i + 1;
    }
    retornar exp;
}
lista<texto> campos = ["fondo", "texto", "borde", "titulo", "seleccion", "sel-texto"];
lista<entero> mini_tema = [17, 255, 33, 214, 27, 231];
texto css = exportar_tema("LumenDark", mini_tema, campos);
imprimir(css);
// Export all themes
imprimir("Temas exportados: Predeterminado, Claro, Oscuro, AltoContraste");
imprimir("Total: 4 temas con ", largo(campos), " propiedades cada uno");

imprimir("--- FIN TUI TEMAS REAL ---");
