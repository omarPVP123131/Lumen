// ==========================================
// graficos_avanzado_real.nv — Advanced Graphics (real-world)
// Tests: sprite sheet calc, particle lifecycle, audio format
// Uso: lumen run -L stdlib/ examples/real/graficos_avanzado_real.nv
// ==========================================

imprimir("=== Graficos Avanzado REAL: Real-World ====");

// ── Ej 1: Sprite Sheet Calculator ──
// Ej 1: Full sprite sheet layout calculator
imprimir("--- Ej 1: Calculadora de Sprite Sheet ---");
funcion entero frames_por_fila(entero tex_w, entero fw) {
    retornar tex_w / fw;
}
funcion entero total_frames(entero tex_w, entero tex_h, entero fw, entero fh) {
    entero cols = tex_w / fw;
    entero rows = tex_h / fh;
    retornar cols * rows;
}
// Common sprite sheet sizes
imprimir("Sprite sheet 256x256 con frames 32x32:");
imprimir("  Frames por fila: ", frames_por_fila(256, 32));
imprimir("  Total frames:    ", total_frames(256, 256, 32, 32));
imprimir("Sprite sheet 512x64 con frames 64x64:");
imprimir("  Frames por fila: ", frames_por_fila(512, 64));
imprimir("  Total frames:    ", total_frames(512, 64, 64, 64));
imprimir("Sprite sheet 128x128 con frames 16x16:");
imprimir("  Frames por fila: ", frames_por_fila(128, 16));
imprimir("  Total frames:    ", total_frames(128, 128, 16, 16));

// ── Ej 2: Particle Lifecycle Manager ──
// Ej 2: Create, simulate, and cull particles
imprimir("--- Ej 2: Ciclo de Vida de Particulas ---");
// Create a burst of particles (simplified circular explosion)
funcion lista<lista<numero>> crear_explosion(entero n, numero cx, numero cy) {
    lista<lista<numero>> ps = [];
    entero i = 0;
    mientras i < n {
        numero angle = (i como numero) * 6.28318 / (n como numero);
        numero speed = 0.5 + ((i % 3) como numero) * 0.5;
        // Taylor approximation for cos/sin
        numero cs = 1.0 - (angle * angle) / 2.0 + (angle * angle * angle * angle) / 24.0;
        numero sn = angle - (angle * angle * angle) / 6.0 + (angle * angle * angle * angle * angle) / 120.0;
        lista<numero> p = [cx, cy, cs * speed, sn * speed, 30.0, (i * 50) % 256 como numero, (i * 80) % 256 como numero, (i * 120) % 256 como numero, 2.0 + (i % 3) como numero];
        ps.agregar(p);
        i = i + 1;
    }
    retornar ps;
}
lista<lista<numero>> explosion = crear_explosion(5, 100.0, 50.0);
imprimir("Explosion creada con ", largo(explosion), " particulas");
entero k = 0;
mientras k < largo(explosion) {
    imprimir("  P", k, ": pos(", explosion[k][0], ",", explosion[k][1],
        ") vel(", explosion[k][2], ",", explosion[k][3], ")");
    k = k + 1;
}
// Simulate 3 frames and count survivors
numero GRAV = 0.15;
numero FRIC = 0.98;
entero vivas = largo(explosion);
entero frame = 0;
mientras frame < 3 {
    entero j = 0;
    entero sobrevivientes = 0;
    mientras j < vivas {
        explosion[j][0] = explosion[j][0] + explosion[j][2];  // x += vx
        explosion[j][1] = explosion[j][1] + explosion[j][3];  // y += vy
        explosion[j][3] = explosion[j][3] + GRAV;              // vy += gravity
        explosion[j][2] = explosion[j][2] * FRIC;              // vx *= friction
        explosion[j][4] = explosion[j][4] - 1.0;               // vida--
        si explosion[j][4] > 0.0 { sobrevivientes = sobrevivientes + 1; }
        j = j + 1;
    }
    imprimir("Frame ", frame + 1, ": ", sobrevivientes, " particulas vivas");
    frame = frame + 1;
}

// ── Ej 3: Audio Format Detector ──
// Ej 3: Detect and validate audio formats
imprimir("--- Ej 3: Detector de Formato de Audio ---");
funcion texto nombre_formato_audio(entero fmt) {
    si fmt == 32816 { retornar "S16LSB (CD quality)"; }
    si fmt == 33056 { retornar "S16MSB"; }
    si fmt == 8 { retornar "S8 (signed 8-bit)"; }
    si fmt == 9 { retornar "U8 (unsigned 8-bit)"; }
    si fmt == 33040 { retornar "F32LSB (float)"; }
    retornar "Formato personalizado: " + fmt;
}
lista<entero> formatos = [32816, 8, 9, 33056, 33040];
entero fi = 0;
mientras fi < largo(formatos) {
    imprimir("Formato ", formatos[fi], ": ", nombre_formato_audio(formatos[fi]));
    fi = fi + 1;
}

imprimir("--- FIN GRAFICOS AVANZADO REAL ---");
