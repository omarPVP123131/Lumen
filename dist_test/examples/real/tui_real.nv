// ==========================================
// tui_real.nv — TUI Module (real-world)
// Tests: layout calculator, component tree, theme apply
// Uso: lumen run -L stdlib/ examples/real/tui_real.nv
// ==========================================

imprimir("=== TUI REAL: Layout & Components ===");

// ── Ej 1: Layout Calculator ──
// Ej 1: Split panel, status bar, content area
imprimir("--- Ej 1: Calculadora de Layout TUI ---");
funcion lista<entero> calc_layout(entero term_w, entero term_h) {
    entero status_h = 1;
    entero menu_h = 1;
    entero content_h = term_h - status_h - menu_h;
    si content_h < 1 { content_h = 1; }
    retornar [term_w, term_h, menu_h, content_h, status_h];
}
lista<entero> ly = calc_layout(80, 24);
imprimir("Terminal 80x24:");
imprimir("  Ancho total:    ", ly[0]);
imprimir("  Alto total:     ", ly[1]);
imprimir("  Alto menu:      ", ly[2]);
imprimir("  Alto contenido: ", ly[3]);
imprimir("  Alto status:    ", ly[4]);
// Test with smaller terminal
lista<entero> ly2 = calc_layout(40, 10);
imprimir("Terminal 40x10 -> contenido: ", ly2[3], " lineas");

// ── Ej 2: Component Tree Builder ──
// Ej 2: Build a component hierarchy
imprimir("--- Ej 2: Arbol de Componentes ---");
funcion lista<texto> arbol_componentes() {
    retornar [
        "App",
        "  ├── MenuBar",
        "  │   ├── Archivo",
        "  │   ├── Editar",
        "  │   └── Ayuda",
        "  ├── ContentArea",
        "  │   ├── Sidebar",
        "  │   └── MainView",
        "  └── StatusBar"
    ];
}
lista<texto> arbol = arbol_componentes();
entero ai = 0;
mientras ai < largo(arbol) {
    imprimir(arbol[ai]);
    ai = ai + 1;
}
// Count leaf components
entero hojas = 5;  // MenuBar items (3) + Sidebar + MainView
imprimir("Componentes hoja: ", hojas);

// ── Ej 3: ANSI Theme Application ──
// Ej 3: Apply theme colors to components
imprimir("--- Ej 3: Aplicacion de Tema ANSI ---");
funcion texto color_bg(entero code) {
    retornar "\\033[48;5;" + code + "m";
}
funcion texto color_fg(entero code) {
    retornar "\\033[38;5;" + code + "m";
}
// Theme color constants
imprimir("Paleta de colores ANSI 0-255:");
entero c = 0;
mientras c < 5 {
    texto swatch = color_bg(c * 40 + 20) + "  " + "\\033[0m";
    imprimir("  ANSI ", c * 40 + 20, ": ", swatch);
    c = c + 1;
}
// Component color assignment
funcion lista<entero> colores_componente(texto comp) {
    si comp == "App" { retornar [17, 255]; }       // dark bg, white fg
    si comp == "MenuBar" { retornar [27, 231]; }   // blue bg, bright fg
    si comp == "StatusBar" { retornar [240, 255]; } // gray bg, white fg
    si comp == "MainView" { retornar [0, 255]; }    // black bg, white fg
    retornar [0, 255];
}
lista<texto> comps = ["App", "MenuBar", "StatusBar", "MainView"];
entero ci = 0;
mientras ci < largo(comps) {
    lista<entero> cols = colores_componente(comps[ci]);
    imprimir("  ", comps[ci], ": bg=", cols[0], " fg=", cols[1]);
    ci = ci + 1;
}

imprimir("--- FIN TUI REAL ---");
