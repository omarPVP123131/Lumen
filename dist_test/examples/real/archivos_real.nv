// ==========================================
// archivos_real.nv — File I/O (real-world)
// Uso: lumen run -L stdlib/ examples/real/archivos_real.nv
// ==========================================
importar "archivos.nv";
importar "texto.nv";

imprimir("=== Archivos REAL: Real-World File Applications ===");

// ── Example 1: Config File Parser ──
imprimir("--- Ej 1: Parser de Archivo de Configuración ---");

// Create a sample config file
sea ruta_config = "__test_real_config.cfg";
texto config_content = "host=localhost\npuerto=8080\nusuario=admin\ndebug=verdadero\nnombre=LumenApp\n";
archivos_escribir_archivo(ruta_config, config_content);
imprimir("archivo de config creado: ", archivos_existe_archivo(ruta_config));

// Read and display config
resultado<texto, texto> leido_config = archivos_leer_archivo(ruta_config);
imprimir("Configuración cargada:");
imprimir(leido_config);

// ── Example 2: Log Reader & Analyzer ──
imprimir("--- Ej 2: Lector de Logs ---");

// Create a sample log file
sea ruta_log = "__test_real_log.txt";
texto log_content = "[2026-01-15 10:30:00] INFO Inicio del sistema\n";
log_content = log_content + "[2026-01-15 10:30:05] DEBUG Configuración cargada\n";
log_content = log_content + "[2026-01-15 10:30:10] INFO Servidor iniciado en puerto 8080\n";
log_content = log_content + "[2026-01-15 10:35:22] WARN Conexion lenta detectada\n";
log_content = log_content + "[2026-01-15 10:40:00] ERROR Timeout en base de datos\n";
log_content = log_content + "[2026-01-15 10:40:05] INFO Reintentando conexion\n";
log_content = log_content + "[2026-01-15 10:40:10] INFO Conexion restablecida\n";
log_content = log_content + "[2026-01-15 10:45:00] INFO Proceso completado\n";
archivos_escribir_archivo(ruta_log, log_content);

resultado<texto, texto> leido_log = archivos_leer_archivo(ruta_log);
imprimir("Log cargado:");
imprimir(leido_log);

// Count log levels using texto functions
lista<texto> lineas_log = texto_dividir(log_content, "\n");
entero total = 0;
entero errores = 0;
entero warns = 0;
entero infos = 0;

entero i = 0;
mientras i < lineas_log.largo() {
    sea linea = texto_recortar(lineas_log[i]);
    si linea != "" {
        total = total + 1;
        si (texto_contiene(linea, "ERROR")) {
            errores = errores + 1;
        }
        si (texto_contiene(linea, "WARN")) {
            warns = warns + 1;
        }
        si (texto_contiene(linea, "INFO")) {
            infos = infos + 1;
        }
    }
    i = i + 1;
}

imprimir("Analisis de log:");
imprimir("  Total lineas:  ", total);
imprimir("  INFO:          ", infos);
imprimir("  WARN:          ", warns);
imprimir("  ERROR:         ", errores);

// ── Example 3: CSV Writer ──
imprimir("--- Ej 3: Escritor CSV ---");

sea contenido_csv = "Nombre,Edad,Ciudad,Profesion\n";
contenido_csv = contenido_csv + "Ana Garcia,28,Madrid,Ingeniera\n";
contenido_csv = contenido_csv + "Luis Perez,35,Barcelona,Disenador\n";
contenido_csv = contenido_csv + "Maria Lopez,42,Sevilla,Doctora\n";
contenido_csv = contenido_csv + "Juan Ruiz,31,Valencia,Profesor\n";

sea ruta_csv = "__test_real_datos.csv";
resultado<booleano, texto> escrito_csv = archivos_escribir_archivo(ruta_csv, contenido_csv);
imprimir("resultado escritura CSV: ", escrito_csv);

// Read back and display
resultado<texto, texto> csv_leido = archivos_leer_archivo(ruta_csv);
imprimir("Contenido del CSV:");
imprimir(csv_leido);

imprimir("--- FIN ARCHIVOS REAL ---");
