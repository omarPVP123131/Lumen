// ==========================================
// fecha_real.nv — Date/Time operations (real-world)
// Uso: lumen run -L stdlib/ examples/real/fecha_real.nv
// ==========================================
importar "fecha.nv";

imprimir("=== Fecha REAL: Real-World Date Applications ===");

// ── Example 1: Logger with Timestamps ──
imprimir("--- Ej 1: Logger con Timestamps ---");

sea ts1 = fecha_ahora();
sea t1 = fecha_formatear(ts1, "%Y-%m-%d %H:%M:%S");
imprimir("[", t1, "] [INFO] Aplicación iniciada");
imprimir("[", t1, "] [DEBUG] Cargando configuración...");
imprimir("[", t1, "] [INFO] Conexión a base de datos establecida");
imprimir("[", t1, "] [WARN] Uso de memoria al 80%");
imprimir("[", t1, "] [ERROR] No se pudo conectar al servidor externo");
imprimir("[", t1, "] [INFO] Reintentando en 5 segundos...");
imprimir("[", t1, "] [INFO] Aplicación finalizada correctamente");

// ── Example 2: Deadline Tracker ──
imprimir("--- Ej 2: Rastreador de Plazos ---");

sea ahora_ts = fecha_ahora();

// Check project deadline
sea limite1 = fecha_parsear("2026-12-01T00:00:00Z", "%Y-%m-%d %H:%M:%S");
sea diff1 = fecha_diferencia(limite1, ahora_ts);
sea dias1 = diff1 / 86400;
imprimir("Entrega proyecto (2026-12-01): FALTAN ", dias1, " días");

// Check tax deadline
sea limite2 = fecha_parsear("2026-09-15T00:00:00Z", "%Y-%m-%d %H:%M:%S");
sea diff2 = fecha_diferencia(limite2, ahora_ts);
sea dias2 = diff2 / 86400;
imprimir("Pagar impuestos (2026-09-15): FALTAN ", dias2, " días");

// Check past deadline
sea limite3 = fecha_parsear("2026-06-01T00:00:00Z", "%Y-%m-%d %H:%M:%S");
sea diff3 = fecha_diferencia(ahora_ts, limite3);
sea dias3 = diff3 / 86400;
imprimir("Informe mensual (2026-06-01): VENCIDO hace ", dias3, " días");

// Check upcoming deadline
sea limite4 = fecha_parsear("2026-08-10T00:00:00Z", "%Y-%m-%d %H:%M:%S");
sea diff4 = fecha_diferencia(limite4, ahora_ts);
sea dias4 = diff4 / 86400;
imprimir("Renovar licencia (2026-08-10): FALTAN ", dias4, " días");

// ── Example 3: Schedule Checker ──
imprimir("--- Ej 3: Verificador de Horario ---");

sea ts_sched = fecha_ahora();
sea dia_semana = fecha_formatear(ts_sched, "%A");
sea hora_str = fecha_formatear(ts_sched, "%H");
sea min_str = fecha_formatear(ts_sched, "%M");

imprimir("Día actual: ", dia_semana);
imprimir("Hora actual: ", hora_str, ":", min_str);

// Determine if weekend
booleano es_finde = falso;
si (dia_semana == "Saturday") {
    es_finde = verdadero;
}
si (dia_semana == "Sunday") {
    es_finde = verdadero;
}

si (es_finde) {
    imprimir("Es fin de semana. Horario: 10:00 - 14:00");
} sino {
    imprimir("Es día laboral. Horario: 09:00 - 18:00");
}

imprimir("--- FIN FECHA REAL ---");
