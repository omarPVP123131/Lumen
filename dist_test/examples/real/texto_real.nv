// ==========================================
// texto_real.nv — String operations (real-world)
// Uso: lumen run -L stdlib/ examples/real/texto_real.nv
// ==========================================
importar "texto.nv";

imprimir("=== Texto REAL: Real-World String Applications ===");

// ── Example 1: Email Validator ──
imprimir("--- Ej 1: Validador de Email ---");

funcion booleano es_email_valido(texto email) {
    sea tiene_arroba = texto_contiene(email, "@");
    sea tiene_punto = texto_contiene(email, ".");
    sea patron = "^[\\w.+-]+@[\\w-]+\\.[\\w.]+$";
    si (tiene_arroba) {
        si (tiene_punto) {
            retornar texto_regex_coincide(patron, email);
        }
    }
    retornar falso;
}

imprimir("test@example.com  -> ", es_email_valido("test@example.com"));
imprimir("user@domain.co    -> ", es_email_valido("user@domain.co"));
imprimir("invalid-email     -> ", es_email_valido("invalid-email"));
imprimir("no@dot            -> ", es_email_valido("no@dot"));
imprimir("name+tag@host.com -> ", es_email_valido("name+tag@host.com"));

// ── Example 2: Password Strength Checker ──
imprimir("--- Ej 2: Validador de Contraseñas ---");

funcion texto chequear_fortaleza(texto password) {
    sea largo = texto_longitud(password);
    si largo < 8 {
        retornar "DÉBIL: muy corta (mínimo 8 caracteres)";
    }
    
    sea tiene_mayus = texto_regex_coincide("[A-Z]", password);
    sea tiene_minus = texto_regex_coincide("[a-z]", password);
    sea tiene_digito = texto_regex_coincide("\\d", password);
    sea tiene_especial = texto_regex_coincide("[!@#$%^&*(),.?\":{}|<>]", password);
    
    entero puntaje = 0;
    si (tiene_mayus) { puntaje = puntaje + 1; }
    si (tiene_minus) { puntaje = puntaje + 1; }
    si (tiene_digito) { puntaje = puntaje + 1; }
    si (tiene_especial) { puntaje = puntaje + 1; }
    si largo >= 12 { puntaje = puntaje + 1; }
    
    si puntaje >= 4 {
        retornar "FUERTE (puntaje: " + puntaje + "/5)";
    } sino si puntaje >= 2 {
        retornar "MEDIA (puntaje: " + puntaje + "/5)";
    }
    retornar "DÉBIL (puntaje: " + puntaje + "/5)";
}

imprimir("'abc'           -> ", chequear_fortaleza("abc"));
imprimir("'abcdefgh'      -> ", chequear_fortaleza("abcdefgh"));
imprimir("'Abcdefgh'      -> ", chequear_fortaleza("Abcdefgh"));
imprimir("'Abc12345'      -> ", chequear_fortaleza("Abc12345"));
imprimir("'Abc123!@#'     -> ", chequear_fortaleza("Abc123!@#"));
imprimir("'Lumen2026!Seg' -> ", chequear_fortaleza("Lumen2026!Seg"));

// ── Example 3: CSV Parser ──
imprimir("--- Ej 3: Parser CSV Simple ---");

funcion texto parsear_linea_csv(texto linea) {
    lista<texto> columnas = texto_dividir(texto_recortar(linea), ",");
    sea res = "";
    entero i = 0;
    mientras i < columnas.largo() {
        sea valor = texto_recortar(columnas[i]);
        si i > 0 {
            res = res + " | ";
        }
        res = res + valor;
        i = i + 1;
    }
    retornar res;
}

sea header = "  Nombre ,  Edad , Ciudad  ";
sea fila1 = "  Ana ,  25 , Madrid  ";
sea fila2 = " Luis,30,Barcelona  ";
sea fila3 = "Maria,28,Sevilla";

imprimir("Header: ", parsear_linea_csv(header));
imprimir("Fila 1: ", parsear_linea_csv(fila1));
imprimir("Fila 2: ", parsear_linea_csv(fila2));
imprimir("Fila 3: ", parsear_linea_csv(fila3));

imprimir("--- FIN TEXTO REAL ---");
