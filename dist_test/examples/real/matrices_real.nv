// ==========================================
// matrices_real.nv — Matrices Module (real-world)
// Tests: matrix chain, rotation matrix, determinant
// Uso: lumen run -L stdlib/ examples/real/matrices_real.nv
// ==========================================

imprimir("=== Matrices REAL: Real-World Matrix Ops ===");

funcion lista<lista<entero>> crear_matriz(entero filas, entero cols, entero valor) {
    lista<lista<entero>> m = [];
    entero i = 0;
    mientras i < filas {
        lista<entero> fila = [];
        entero j = 0;
        mientras j < cols { fila.agregar(valor); j = j + 1; }
        m.agregar(fila);
        i = i + 1;
    }
    retornar m;
}
funcion lista<lista<entero>> multiplicar(lista<lista<entero>> a, lista<lista<entero>> b) {
    entero fa = largo(a);
    entero ca = largo(a[0]);
    entero cb = largo(b[0]);
    lista<lista<entero>> r = crear_matriz(fa, cb, 0);
    entero i = 0;
    mientras i < fa {
        entero j = 0;
        mientras j < cb {
            entero k = 0;
            mientras k < ca { r[i][j] = r[i][j] + a[i][k] * b[k][j]; k = k + 1; }
            j = j + 1;
        }
        i = i + 1;
    }
    retornar r;
}
funcion void imprimir_matriz(lista<lista<entero>> m) {
    entero i = 0;
    mientras i < largo(m) {
        texto fila = "";
        entero j = 0;
        mientras j < largo(m[i]) {
            fila = fila + m[i][j];
            si j < largo(m[i]) - 1 { fila = fila + " "; }
            j = j + 1;
        }
        imprimir(fila);
        i = i + 1;
    }
}

// ── Ej 1: Matrix Chain Multiplication ──
// Ej 1: Multiply three matrices in sequence
imprimir("--- Ej 1: Multiplicacion en Cadena ---");
funcion lista<lista<entero>> cadena(lista<lista<lista<entero>> > matrices) {
    lista<lista<entero>> r = matrices[0];
    entero i = 1;
    mientras i < largo(matrices) {
        r = multiplicar(r, matrices[i]);
        i = i + 1;
    }
    retornar r;
}
lista<lista<entero>> m1 = [[2, 0], [0, 2]];  // scale by 2
lista<lista<entero>> m2 = [[0, -1], [1, 0]];  // rotate 90 degrees
lista<lista<entero>> m3 = [[1, 1], [0, 1]];   // shear
imprimir("Matrices: Escala(2) * Rotacion(90) * Shear");
lista<lista<lista<entero>> > cadena_ms = [m1, m2, m3];
lista<lista<entero>> resultado = cadena(cadena_ms);
imprimir("Resultado combinado:");
imprimir_matriz(resultado);

// ── Ej 2: 2D Rotation Matrix ──
// Ej 2: Create rotation matrix for integer angles
imprimir("--- Ej 2: Matriz de Rotacion 2D ---");
// For 90 degrees: [[0, -1], [1, 0]]
// For 180 degrees: [[-1, 0], [0, -1]]
// For 270 degrees: [[0, 1], [-1, 0]]
lista<lista<entero>> rot90 = [[0, -1], [1, 0]];
lista<lista<entero>> rot180 = [[-1, 0], [0, -1]];
lista<lista<entero>> rot270 = [[0, 1], [-1, 0]];
// Rotate point (3, 1) by 90 degrees
lista<lista<entero>> punto = [[3], [1]];
lista<lista<entero>> rotado = multiplicar(rot90, punto);
imprimir("Punto (3,1) rotado 90 grados: (", rotado[0][0], ",", rotado[1][0], ")");
// Rotate by 180
lista<lista<entero>> rot180p = multiplicar(rot180, punto);
imprimir("Punto (3,1) rotado 180 grados: (", rot180p[0][0], ",", rot180p[1][0], ")");
// Two 90-degree rotations = 180
lista<lista<entero>> dos_rot90 = multiplicar(rot90, rot90);
imprimir("Rot90 * Rot90 = Rot180?");
imprimir_matriz(dos_rot90);

// ── Ej 3: Determinant for 2x2 and 3x3 ──
// Ej 3: Calculate matrix determinant
imprimir("--- Ej 3: Calculo de Determinante ---");
funcion entero determinante_2x2(lista<lista<entero>> m) {
    retornar m[0][0] * m[1][1] - m[0][1] * m[1][0];
}
funcion entero determinante_3x3(lista<lista<entero>> m) {
    entero a = m[0][0] * (m[1][1] * m[2][2] - m[1][2] * m[2][1]);
    entero b = m[0][1] * (m[1][0] * m[2][2] - m[1][2] * m[2][0]);
    entero c = m[0][2] * (m[1][0] * m[2][1] - m[1][1] * m[2][0]);
    retornar a - b + c;
}
lista<lista<entero>> d2 = [[3, 8], [4, 6]];
imprimir("det([[3,8],[4,6]]) = ", determinante_2x2(d2), " (3*6 - 8*4 = -14)");
lista<lista<entero>> d3 = [[6, 1, 1], [4, -2, 5], [2, 8, 7]];
imprimir("det(3x3) = ", determinante_3x3(d3));
// Identity has det=1
lista<lista<entero>> id2 = [[1, 0], [0, 1]];
imprimir("det(identidad 2x2) = ", determinante_2x2(id2), " (debe ser 1)");
// Singular matrix test: det=0
lista<lista<entero>> sing = [[2, 4], [1, 2]];
entero det_sing = determinante_2x2(sing);
imprimir("det(singular) = ", det_sing, " (debe ser 0 => no invertible)");

imprimir("--- FIN MATRICES REAL ---");
