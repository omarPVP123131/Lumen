// Fase 65 — Guard Let con Result (let-else): desenrolla resultado o diverge
// `sea exito(v) = res sino { ... }` extrae el valor de Exito/Ok o ejecuta
// el cuerpo `sino` cuando el resultado es Error/Err
funcion numero raiz(numero x) {
    resultado<numero, texto> res = raiz_cuadrada(x);
    sea exito(v) = res sino {
        imprimir("error: no soportado");
        retornar 0.0;
    }
    retornar v;
}

funcion resultado<numero, texto> raiz_cuadrada(numero x) {
    si x < 0 { retornar error("negativo"); }
    retornar exito(x);
}

funcion entero principal() {
    imprimir(raiz(25.0));
    imprimir(raiz(-1.0));
    retornar 0;
}