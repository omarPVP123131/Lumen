// Associated Types (Fase 68)
// Demostracion de tipos asociados en rasgos con sustitucion correcta

rasgo Contenedor {
    tipo Item;
    funcion Item obtener(yo);
}

estructura Caja {
    valor: entero,
}

impl Contenedor para Caja {
    tipo Item = entero;
    funcion entero obtener(yo) {
        retornar yo.valor;
    }
}

estructura Bolsa {
    mensaje: texto,
}

impl Contenedor para Bolsa {
    tipo Item = texto;
    funcion texto obtener(yo) {
        retornar yo.mensaje;
    }
}

sea c = Caja { valor: 42 };
imprimir(c.obtener());

sea b = Bolsa { mensaje: "hola mundo" };
imprimir(b.obtener());
