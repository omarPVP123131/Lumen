// ==========================================
// gui_sr.nv — GUI Module (intermediate)
// Tests: controls layout, text get/set, checkbox state
// Uso: lumen run -L stdlib/ examples/sr/gui_sr.nv
// ==========================================

imprimir("=== GUI SR: Controls & State ===");

// ── Ej 1: Complex Layout Calculator ──
// Ej 1: Form layout with labels and inputs
imprimir("--- Ej 1: Layout de Formulario ---");
funcion lista<lista<entero>> layout_formulario(entero x0, entero y0, entero num_campos) {
    lista<lista<entero>> controles = [];
    entero label_w = 80;
    entero input_w = 200;
    entero h = 24;
    entero gap = 6;
    entero i = 0;
    mientras i < num_campos {
        entero ly = y0 + i * (h + gap);
        // Label position
        controles.agregar([x0, ly, label_w, h)];
        // Input position
        controles.agregar([x0 + label_w + gap, ly, input_w, h)];
        i = i + 1;
    }
    retornar controles;
}
lista<lista<entero>> form = layout_formulario(10, 10, 3);
imprimir("Formulario de 3 campos:");
imprimir("  Campo 1 - Label: x=", form[0][0], " y=", form[0][1], " w=", form[0][2]);
imprimir("  Campo 1 - Input: x=", form[1][0], " y=", form[1][1], " w=", form[1][2]);
imprimir("  Campo 2 - Label: x=", form[2][0], " y=", form[2][1]);
imprimir("  Campo 3 - Input: x=", form[5][0], " y=", form[5][1]);
// Total window height needed
entero alto_total = form[5][1] + form[5][3] + 10 + 30 + 10;  // last input + button + padding
imprimir("Alto de ventana necesario: ", alto_total, "px");

// ── Ej 2: Text Buffer Manager ──
// Ej 2: Get/Set text on controls
imprimir("--- Ej 2: Gestor de Buffer de Texto ---");
funcion texto truncar_texto(texto s, entero max_len) {
    si s.largo() < max_len + 1 { retornar s; }
    texto res = "";
    entero i = 0;
    mientras i < max_len - 3 { res = res + s[i]; i = i + 1; }
    retornar res + "...";
}
imprimir("Truncar a 10 chars:");
imprimir("  'Hola Mundo'   -> '", truncar_texto("Hola Mundo", 10), "'");
imprimir("  'Texto muy largo que no cabe' -> '", truncar_texto("Texto muy largo que no cabe", 10), "'");
imprimir("  'Corto'        -> '", truncar_texto("Corto", 10), "'");
// Text buffer allocation
funcion entero buffer_size(texto s) {
    retornar s.largo() + 1;
}
imprimir("Tamanos de buffer (incluye null terminator):");
imprimir("  'Hola': ", buffer_size("Hola"), " bytes");
imprimir("  '':     ", buffer_size(""), " byte");

// ── Ej 3: Checkbox State Machine ──
// Ej 3: Track checkbox states
imprimir("--- Ej 3: Maquina de Estados de Checkbox ---");
funcion texto estado_check(entero state) {
    si state == 0 { retornar "UNCHECKED"; }
    si state == 1 { retornar "CHECKED"; }
    si state == 2 { retornar "INDETERMINATE"; }
    retornar "DESCONOCIDO";
}
// Win32 button states: BST_UNCHECKED=0, BST_CHECKED=1, BST_INDETERMINATE=2
imprimir("Estados de checkbox Win32:");
imprimir("  0 = ", estado_check(0));
imprimir("  1 = ", estado_check(1));
imprimir("  2 = ", estado_check(2));
// Toggle logic
funcion entero toggle(entero actual) {
    si actual == 0 { retornar 1; }
    retornar 0;
}
entero chk = 0;
imprimir("Toggle: ", estado_check(chk), " -> ", estado_check(toggle(chk)), 
    " -> ", estado_check(toggle(toggle(chk))));

imprimir("--- FIN GUI SR ---");
