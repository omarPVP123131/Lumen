// ==========================================
// matrices_sr.nv — Matrices Module (intermediate)
// Tests: multiply, sum, identity
// Uso: lumen run -L stdlib/ examples/sr/matrices_sr.nv
// ==========================================

imprimir("=== Matrices SR: Matrix Algebra ===");

funcion lista<lista<entero>> crear_matriz(entero filas, entero cols, entero valor) {
    lista<lista<entero>> m = [];
    entero i = 0;
    mientras i < filas {
        lista<entero> fila = [];
        entero j = 0;
        mientras j < cols { fila.agregar(valor); j = j + 1; }
        m.agregar(fila);
        i = i + 1;
    }
    retornar m;
}
funcion void imprimir_matriz(lista<lista<entero>> m) {
    entero i = 0;
    mientras i < largo(m) {
        texto fila = "";
        entero j = 0;
        mientras j < largo(m[i]) {
            fila = fila + m[i][j];
            si j < largo(m[i]) - 1 { fila = fila + " "; }
            j = j + 1;
        }
        imprimir(fila);
        i = i + 1;
    }
}

// ── Ej 1: Matrix Addition ──
// Ej 1: Add two matrices element-wise
imprimir("--- Ej 1: Suma de Matrices ---");
funcion lista<lista<entero>> sumar(lista<lista<entero>> a, lista<lista<entero>> b) {
    entero filas = largo(a);
    entero cols = largo(a[0]);
    lista<lista<entero>> r = crear_matriz(filas, cols, 0);
    entero i = 0;
    mientras i < filas {
        entero j = 0;
        mientras j < cols {
            r[i][j] = a[i][j] + b[i][j];
            j = j + 1;
        }
        i = i + 1;
    }
    retornar r;
}
lista<lista<entero>> a1 = [[1, 2], [3, 4]];
lista<lista<entero>> b1 = [[5, 6], [7, 8]];
imprimir("A:");
imprimir_matriz(a1);
imprimir("B:");
imprimir_matriz(b1);
imprimir("A + B:");
imprimir_matriz(sumar(a1, b1));

// ── Ej 2: Matrix Multiplication ──
// Ej 2: Multiply two matrices
imprimir("--- Ej 2: Multiplicacion de Matrices ---");
funcion lista<lista<entero>> multiplicar(lista<lista<entero>> a, lista<lista<entero>> b) {
    entero fa = largo(a);
    entero ca = largo(a[0]);
    entero cb = largo(b[0]);
    lista<lista<entero>> r = crear_matriz(fa, cb, 0);
    entero i = 0;
    mientras i < fa {
        entero j = 0;
        mientras j < cb {
            entero k = 0;
            mientras k < ca {
                r[i][j] = r[i][j] + a[i][k] * b[k][j];
                k = k + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    retornar r;
}
lista<lista<entero>> a2 = [[1, 2, 3], [4, 5, 6]];
lista<lista<entero>> b2 = [[7, 8], [9, 10], [11, 12]];
imprimir("A (2x3):");
imprimir_matriz(a2);
imprimir("B (3x2):");
imprimir_matriz(b2);
imprimir("A * B (2x2):");
imprimir_matriz(multiplicar(a2, b2));

// ── Ej 3: Identity Matrix ──
// Ej 3: Create and verify identity matrix
imprimir("--- Ej 3: Matriz Identidad ---");
funcion lista<lista<entero>> identidad(entero n) {
    lista<lista<entero>> m = crear_matriz(n, n, 0);
    entero i = 0;
    mientras i < n {
        m[i][i] = 1;
        i = i + 1;
    }
    retornar m;
}
lista<lista<entero>> i3 = identidad(3);
imprimir("Identidad 3x3:");
imprimir_matriz(i3);
// Verify I * A = A
lista<lista<entero>> test_a = [[5, 3], [2, 7]];
lista<lista<entero>> i2 = identidad(2);
lista<lista<entero>> result = multiplicar(i2, test_a);
imprimir("I * A = A? (debe ser [[5,3],[2,7]]):");
imprimir_matriz(result);
si result[0][0] - 5 == 0 { imprimir("  PASS: I*A = A"); } sino { imprimir("  FAIL"); }

imprimir("--- FIN MATRICES SR ---");
