// Test HTTP - GET y POST via red.nv
importar "red.nv";

imprimir("=== HTTP Test ===");

resultado<texto, texto> body = red_http_obtener("http://example.com/");
imprimir("GET status: ", body);

resultado<texto, texto> body2 = red_http_enviar("http://example.com/", "{\"test\":42}");
imprimir("POST status: ", body2);

imprimir("--- FIN ---");
