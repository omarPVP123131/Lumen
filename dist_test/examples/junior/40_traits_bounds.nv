importar ingles;

trait Valor {
    function integer obtener(yo);
}

struct Numero {
    val: integer
}

impl Valor para Numero {
    function integer obtener(yo) {
        return yo.val;
    }
}

function integer duplicar<T: Valor>(T item) {
    return item.obtener() * 2;
}

Numero n = Numero { val: 21 };
print(duplicar<Numero>(n));
