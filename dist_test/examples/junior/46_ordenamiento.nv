importar ingles;

function array<integer> crear_ordenada(array<integer> arr) {
    array<integer> copia = [];
    integer i = 0;
    while (i < arr.largo()) {
        copia.agregar(arr[i]);
        i = i + 1;
    }
    integer n = copia.largo();
    i = 0;
    while (i < n - 1) {
        integer j = 0;
        while (j < n - i - 1) {
            if (copia[j] > copia[j + 1]) {
                array<integer> nueva = [];
                integer k = 0;
                while (k < n) {
                    if (k == j) {
                        nueva.agregar(copia[j + 1]);
                    } else {
                        if (k == j + 1) {
                            nueva.agregar(copia[j]);
                        } else {
                            nueva.agregar(copia[k]);
                        }
                    }
                    k = k + 1;
                }
                copia = nueva;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return copia;
}

array<integer> nums = [5, 2, 9, 1, 7];
array<integer> ordenados = crear_ordenada(nums);
integer k = 0;
while (k < ordenados.largo()) {
    print(ordenados[k]);
    k = k + 1;
}
