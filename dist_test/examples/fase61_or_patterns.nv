importar ingles;

enum Color { Rojo, Verde, Azul, Amarillo }

funcion texto temperatura(Color col) {
    elegir (col) {
        caso Color::Rojo | Color::Amarillo: retornar "calido";
        caso Color::Verde | Color::Azul: retornar "frio";
        defecto: retornar "desconocido";
    }
}

funcion texto tamano(entero n) {
    elegir (n) {
        caso 1 | 2 | 3: retornar "pequeno";
        caso 4 | 5: retornar "mediano";
        defecto: retornar "grande";
    }
}

funcion entero principal() {
    imprimir(temperatura(Color::Rojo));
    imprimir(temperatura(Color::Verde));
    imprimir(temperatura(Color::Azul));
    imprimir(temperatura(Color::Amarillo));
    imprimir(tamano(2));
    imprimir(tamano(5));
    imprimir(tamano(99));
    retornar 0;
}
