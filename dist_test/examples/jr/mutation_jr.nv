// ==========================================
// mutation_jr.nv — Mutation Testing (junior)
// Tests: basic source mutations with string ops
// Uso: lumen run examples/jr/mutation_jr.nv
// ==========================================

imprimir("=== Mutation JR: Mutaciones Basicas ===");

// Helper: reemplaza + por - en un texto
funcion texto reemplazar_mas(texto s) {
    texto r = "";
    entero i = 0;
    mientras i < s.largo() {
        si s[i] == "+" {
            r = r + "-";
        } sino {
            r = r + s[i];
        }
        i = i + 1;
    }
    retornar r;
}

// Helper: reemplaza > por < en un texto
funcion texto reemplazar_mayor(texto s) {
    texto r = "";
    entero i = 0;
    mientras i < s.largo() {
        si s[i] == ">" {
            r = r + "<";
        } sino {
            r = r + s[i];
        }
        i = i + 1;
    }
    retornar r;
}

// ── Ej 1: Mutar operador aritmetico (+ → -) ──
// Ej 1: Mutate arithmetic operator (+ → -)
imprimir("--- Ej 1: Mutar + por - ---");
texto src1 = "funcion suma(a, b) { retornar a + b; }";
texto mut1 = reemplazar_mas(src1);
imprimir("Original: ", src1);
imprimir("Mutado:   ", mut1);
si mut1.largo() - src1.largo() == 0 {
    imprimir("  PASS: mutacion aplicada (misma longitud, + reemplazado)");
} sino {
    imprimir("  FAIL: el codigo no cambio como esperado");
}

// ── Ej 2: Mutar texto ──
// Ej 2: Mutate text (custom replacement)
imprimir("");
imprimir("--- Ej 2: Mutar caracteres ---");
texto src2 = "funcion activo() { retornar verdadero; }";
// Replace 'v' with 'X' to simulate mutation
texto mut2 = reemplazar_mas(src2); // Use same function for demo
imprimir("Original: ", src2);
imprimir("Mutado (con +→-): ", mut2);
si mut2.largo() - src2.largo() == 0 {
    imprimir("  PASS: longitud preservada tras mutacion");
} sino {
    imprimir("  FAIL: longitud cambio inesperadamente");
}

// ── Ej 3: Mutar comparacion (> → <) ──
// Ej 3: Mutate comparison (> → <)
imprimir("");
imprimir("--- Ej 3: Mutar > por < ---");
texto src3 = "funcion mayor(a, b) { retornar a > b; }";
texto mut3 = reemplazar_mayor(src3);
imprimir("Original: ", src3);
imprimir("Mutado:   ", mut3);
si mut3.largo() - src3.largo() == 0 {
    imprimir("  PASS: comparacion invertida");
} sino {
    imprimir("  FAIL: el codigo no cambio");
}

// ── Ej 4: Generar multiples mutantes ──
// Ej 4: Generate multiple mutants
imprimir("");
imprimir("--- Ej 4: Multiples Mutantes ---");
texto src4 = "funcion test() { retornar a + b + c; }";
texto m1 = reemplazar_mas(src4);
texto m2 = reemplazar_mas(m1);
texto m3 = reemplazar_mas(m2);
imprimir("Original: ", src4);
imprimir("Mutante 1 (1er +→-): ", m1);
imprimir("Mutante 2 (2do +→-): ", m2);
imprimir("Mutante 3 (3er +→-): ", m3);
entero cambios_m = 0;
si m1.largo() - src4.largo() == 0 { cambios_m = cambios_m + 1; }
si m2.largo() - src4.largo() == 0 { cambios_m = cambios_m + 1; }
si m3.largo() - src4.largo() == 0 { cambios_m = cambios_m + 1; }
imprimir("Mutantes con misma longitud: ", cambios_m, "/3");

// ── Ej 5: Puntaje de mutacion ──
// Ej 5: Mutation score
imprimir("");
imprimir("--- Ej 5: Puntaje de Mutacion ---");
entero muertos = 3;
entero total = 4;
entero pct = muertos * 100 / total;
imprimir("Mutantes muertos: ", muertos, "/", total);
imprimir("Puntaje: ", pct, "%");

entero muertos2 = 7;
entero total2 = 10;
entero pct2 = muertos2 * 100 / total2;
imprimir("Otro puntaje: ", muertos2, "/", total2, " = ", pct2, "%");

imprimir("");
imprimir("--- FIN MUTATION JR ---");
