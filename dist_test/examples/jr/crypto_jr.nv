// ==========================================
// crypto_jr.nv — Crypto operations (junior)
// Uso: lumen run -L stdlib/ examples/jr/crypto_jr.nv
// ==========================================
importar "crypto.nv";

imprimir("=== Crypto JR: Basic Hashing & JWT ===");

// ── Example 1: SHA256 Hash ──
imprimir("--- Ej 1: SHA256 ---");
sea h1 = crypto_sha256("Hola Lumen");
imprimir("sha256('Hola Lumen') = ", h1);

sea h2 = crypto_sha256("mensaje secreto");
imprimir("sha256('mensaje secreto') = ", h2);

sea h3 = crypto_sha256("");
imprimir("sha256('') = (empty string hash length:", h3.largo(), ")");

sea h4 = crypto_sha256_string("Hello World");
imprimir("sha256_string (EN) = ", h4);

// ── Example 2: SHA512 Hash ──
imprimir("--- Ej 2: SHA512 ---");
sea h5 = crypto_sha512("Hola Lumen");
imprimir("sha512('Hola Lumen') = ", h5);

sea h6 = crypto_sha512_string("data");
imprimir("sha512('data') = ", h6);

imprimir("sha512 length: ", h5.largo());
imprimir("sha256 length: ", h1.largo());

// ── Example 3: JWT Simple ──
imprimir("--- Ej 3: JWT Simple ---");
sea token = crypto_jwt_codificar("{\"usuario\":\"ana\"}", "mi-secreto");
imprimir("JWT creado: ", token);

sea payload = crypto_jwt_decodificar(token, "mi-secreto");
imprimir("JWT payload: ", payload);

// English aliases
sea en_token = crypto_jwt_encode("{\"role\":\"admin\"}", "key123");
imprimir("JWT EN create: OK (len:", en_token.largo(), ")");
sea en_payload = crypto_jwt_decode(en_token, "key123");
imprimir("JWT EN decode: ", en_payload);

imprimir("--- FIN CRYPTO JR ---");
