// ==========================================
// archivos_jr.nv — File I/O (junior)
// Uso: lumen run -L stdlib/ examples/jr/archivos_jr.nv
// ==========================================
importar "archivos.nv";

imprimir("=== Archivos JR: Basic File Operations ===");

// ── Example 1: Write a File ──
imprimir("--- Ej 1: Escribir Archivo ---");
sea ruta_test = "__test_jr_escritura.txt";
sea contenido_escribir = "Hola Lúmen!\nEste es un archivo de prueba.\n¡Funciona!";

resultado<booleano, texto> escrito = archivos_escribir_archivo(ruta_test, contenido_escribir);
imprimir("escrito a '", ruta_test, "': ", escrito);

// ── Example 2: Read a File ──
imprimir("--- Ej 2: Leer Archivo ---");
resultado<texto, texto> leido = archivos_leer_archivo(ruta_test);
imprimir("leído de '", ruta_test, "':");
imprimir("  ", leido);

// ── Example 3: Check if File Exists ──
imprimir("--- Ej 3: Verificar Existencia ---");
imprimir("existe '", ruta_test, "':           ", archivos_existe_archivo(ruta_test));
imprimir("existe 'archivo_que_no_existe.txt': ", archivos_existe_archivo("archivo_que_no_existe.txt"));

imprimir("--- FIN ARCHIVOS JR ---");
