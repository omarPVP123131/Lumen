// ==========================================
// concurrencia_jr.nv — Concurrency basics (junior)
// Uso: lumen run -L stdlib/ examples/jr/concurrencia_jr.nv
// Note: Uses __ builtins directly for full type safety.
// The stdlib wrappers (concurrencia_*) use 'cualquiera' types.
// ==========================================

imprimir("=== Concurrencia JR: Threads, Channels & Sleep ===");

// ── Example 1: Spawn and Join Threads ──
imprimir("--- Ej 1: Threads (Spawn + Join) ---");
funcion texto tarea_costosa(texto nombre) {
    retornar "Resultado de " + nombre;
}

sea h1 = __hilo_lanzar("tarea_costosa", "Tarea A");
sea h2 = __hilo_lanzar("tarea_costosa", "Tarea B");

imprimir("Hilos lanzados, esperando...");
sea r1 = __hilo_esperar(h1);
sea r2 = __hilo_esperar(h2);

imprimir("Hilo 1: ", r1);
imprimir("Hilo 2: ", r2);

// ── Example 2: Channel Communication ──
imprimir("--- Ej 2: Channels ---");
sea canal = __canal_nuevo();

// Producer-consumer pattern
funcion texto producir() {
    sea c = __canal_nuevo();
    __canal_enviar(c, "mensaje-1");
    __canal_enviar(c, "mensaje-2");
    __canal_enviar(c, "FIN");
    retornar c;
}

sea ch = producir();
sea v1 = __canal_recibir(ch);
sea v2 = __canal_recibir(ch);
sea v3 = __canal_recibir(ch);

imprimir("Recibido: ", v1, ", ", v2, ", ", v3);

// ── Example 3: Sleep (Delay) ──
imprimir("--- Ej 3: Sleep ---");
sea antes = __tiempo_ahora();
__dormir(50);
sea despues = __tiempo_ahora();
sea diff = __tiempo_diferencia(despues, antes);
imprimir("Durmiendo ~50ms, elapsed: ", diff, "ms");

imprimir("--- FIN CONCURRENCIA JR ---");
