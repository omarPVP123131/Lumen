// ==========================================
// graficos_avanzado_jr.nv — Advanced Graphics (junior)
// Tests: sprite create, audio init, particle create
// Uso: lumen run -L stdlib/ examples/jr/graficos_avanzado_jr.nv
// ==========================================

imprimir("=== Graficos Avanzado JR: Sprites, Audio, Particulas ===");

// Ej 1: Sprite ID Validation
imprimir("--- Ej 1: ID de Sprite ---");
imprimir("Sprite ID 0 = error/invalido (no se pudo cargar)");
imprimir("Sprite ID 1 = primer sprite cargado correctamente");
imprimir("Sprite ID > 0 = sprite valido");
imprimir("Los sprites tienen: textura SDL, ancho, alto (cache)");

// Ej 2: Audio Parameters
imprimir("--- Ej 2: Parametros de Audio ---");
entero CD_QUALITY = 44100;
entero VOICE_QUALITY = 22050;
entero DVD_QUALITY = 48000;
entero MONO = 1;
entero STEREO = 2;
imprimir("Frecuencias (Hz): CD=", CD_QUALITY, " Voz=", VOICE_QUALITY, " DVD=", DVD_QUALITY);
imprimir("Canales: MONO=", MONO, " STEREO=", STEREO);
imprimir("MIX_DEFAULT_FORMAT = AUDIO_S16LSB = 32816");
imprimir("Chunk size tipico: 2048 bytes");

// Ej 3: Particle Simulation
imprimir("--- Ej 3: Fisica de Particula ---");
numero px = 100.0;
numero py = 50.0;
numero vx = 2.5;
numero vy = -1.3;
numero vida = 40.0;
imprimir("Particula inicial: pos(", px, ",", py, ") vel(", vx, ",", vy, ") vida=", vida);
// Simulate 3 frames
numero GRAV = 0.15;
numero FRIC = 0.98;
entero f = 0;
mientras f < 3 {
    px = px + vx;
    py = py + vy;
    vy = vy + GRAV;
    vx = vx * FRIC;
    vida = vida - 1.0;
    imprimir("Frame ", f+1, ": pos(", px, ",", py, ") vel(", vx, ",", vy, ") vida=", vida);
    f = f + 1;
}
si vida > 0.0 { imprimir("Particula VIVA"); } sino { imprimir("Particula MUERTA"); }

imprimir("--- FIN GRAFICOS AVANZADO JR ---");
