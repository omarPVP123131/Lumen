// compiler_v3.nv — Self-hosting compiler v3
// Pipeline: lexer.nv → parser.nv → codegen.nv → __codegen_a_nvc
// Leer archivo con intentar (TryUnwrap), compilar, escribir .nvc
importar "lexer.nv";
importar "parser.nv";
importar "codegen.nv";

texto entrada = "stdlib/compiler/mini_fn.nv";
texto salida = "stdlib/compiler/mini_fn_out.nvc";

texto codigo = intentar __leer_archivo(entrada);
imprimir("Source: ", largo(codigo), " bytes");

numero tk = lexer_lexer_tokenizar(codigo);
imprimir("Tokens: ", __map_obtener(tk, "cnt"));

numero ast = parser_parser_parsear(tk);
imprimir("AST: ", __map_obtener(ast, "tipo"));

numero cg = codegen_codegen_generar(ast);
imprimir("Instrs: ", __map_obtener(cg, "pos"));

lista<entero> bytes = __codegen_a_nvc(cg);
intentar __escribir_archivo_bin(salida, bytes);
imprimir("OK: -> ", salida, " (", largo(bytes), " bytes)");









