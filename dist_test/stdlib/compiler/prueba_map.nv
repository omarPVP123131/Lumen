funcion numero pp(numero m, entero i, numero v) {
    retornar __map_poner(__map_obtener(m, "pila"), a_texto(i), v);
}

funcion numero gg(numero m, entero i) {
    retornar __map_obtener(__map_obtener(m, "pila"), a_texto(i));
}

funcion entero main() {
    numero st = __map_nuevo();
    st = __map_poner(st, "pila", __map_nuevo());
    st = pp(st, 1, 42.0);
    imprimir(gg(st, 1));
    retornar 0;
}
