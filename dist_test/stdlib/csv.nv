// Módulo csv — parseo y serialización CSV en LÚMEN puro
// CSV module — pure LÚMEN, dual ES/EN API
// Uso: importar "csv.nv"

funcion cualquiera parsear(texto datos) {
    lista<texto> lineas = __str_dividir(datos, "\n");
    cualquiera res = __map_nuevo();
    entero i = 0;
    entero idx = 0;
    mientras i < lineas.largo() {
        si lineas[i] != "" {
            lista<texto> campos = __str_dividir(lineas[i], ",");
            res = __map_poner(res, i, campos);
            idx = idx + 1;
        }
        i = i + 1;
    }
    retornar res;
}
funcion cualquiera parse(texto data) { retornar parsear(data); }

funcion texto serializar(cualquiera filas) {
    lista<numero> claves = __map_claves(filas);
    entero n = claves.largo();
    entero a = 0;
    mientras a < n {
        entero b = a + 1;
        mientras b < n {
            si claves[b] < claves[a] {
                cualquiera tmp = claves[a];
                claves[a] = claves[b];
                claves[b] = tmp;
            }
            b = b + 1;
        }
        a = a + 1;
    }
    texto res = "";
    entero i = 0;
    mientras i < claves.largo() {
        cualquiera fila = __map_obtener(filas, claves[i]);
        texto linea = "";
        entero j = 0;
        mientras j < fila.largo() {
            linea = linea + fila[j];
            si j < fila.largo() - 1 { linea = linea + ","; }
            j = j + 1;
        }
        res = res + linea;
        si i < claves.largo() - 1 { res = res + "\n"; }
        i = i + 1;
    }
    retornar res;
}
funcion texto stringify(cualquiera rows) { retornar serializar(rows); }
