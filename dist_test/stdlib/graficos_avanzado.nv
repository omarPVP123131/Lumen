// Módulo gráficos avanzado — Sprites, Audio, Partículas vía SDL2 FFI
// Advanced Graphics module — Sprites, Audio, Particles via SDL2 FFI
// Uso: importar "graficos_avanzado.nv"
// Requiere: SDL2.dll para sprites, SDL2_mixer.dll para audio
// Partículas son 100% LÚMEN (no requieren FFI extra)

// ============================================================
// ESTADO INTERNO / INTERNAL STATE
// ============================================================

cualquiera __sdl = ninguno;
cualquiera __mixer = ninguno;
entero __ren = 0;
lista<entero> __textures = [];     // texture pointers
lista<entero> __tex_w = [];        // cached texture widths
lista<entero> __tex_h = [];        // cached texture heights
lista<entero> __chunks = [];       // Mix_Chunk pointers

// ============================================================
// CARGA DE DLLs / DLL LOADING
// ============================================================

/// Carga SDL2.dll bajo demanda
funcion booleano __cargar_sdl() {
    si __tipo_de(__sdl) == "texto" { retornar verdadero; }
    __sdl = __ffi_cargar("SDL2.dll");
    si __tipo_de(__sdl) != "texto" {
        __sdl = __ffi_cargar("libSDL2.so");
    }
    si __tipo_de(__sdl) != "texto" {
        __sdl = __ffi_cargar("libSDL2.dylib");
    }
    retornar __tipo_de(__sdl) == "texto";
}

/// Carga SDL2_mixer.dll bajo demanda
funcion booleano __cargar_mixer() {
    si __tipo_de(__mixer) == "texto" { retornar verdadero; }
    __mixer = __ffi_cargar("SDL2_mixer.dll");
    si __tipo_de(__mixer) != "texto" {
        __mixer = __ffi_cargar("libSDL2_mixer.so");
    }
    si __tipo_de(__mixer) != "texto" {
        __mixer = __ffi_cargar("libSDL2_mixer.dylib");
    }
    retornar __tipo_de(__mixer) == "texto";
}

// ============================================================
// FUNCIONES AUXILIARES / HELPER FUNCTIONS
// ============================================================

/// Escribe un entero 32-bit little-endian en un buffer
funcion entero __i32_le(entero val, entero buf, entero off) {
    __ffi_poke(buf, off, val & 255);
    __ffi_poke(buf, off + 1, (val >> 8) & 255);
    __ffi_poke(buf, off + 2, (val >> 16) & 255);
    __ffi_poke(buf, off + 3, (val >> 24) & 255);
    retornar 0;
}

/// Lee un entero 32-bit little-endian de un buffer
funcion entero __read_u32(entero buf, entero off) {
    entero b0 = __ffi_peek(buf, off);
    entero b1 = __ffi_peek(buf, off + 1);
    entero b2 = __ffi_peek(buf, off + 2);
    entero b3 = __ffi_peek(buf, off + 3);
    retornar b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
}

/// Asigna un buffer y llena un SDL_Rect{x,y,w,h} (16 bytes)
funcion entero __rect_alloc(entero x, entero y, entero w, entero h) {
    entero buf = __ffi_asignar(16);
    __i32_le(x, buf, 0);
    __i32_le(y, buf, 4);
    __i32_le(w, buf, 8);
    __i32_le(h, buf, 12);
    retornar buf;
}

// ============================================================
// INICIALIZACIÓN / INIT
// ============================================================

/// Establece el renderer para usar en sprites y partículas
/// Debe llamarse después de crear el renderer
funcion void iniciar(entero renderer) {
    __ren = renderer;
    __textures = [];
    __tex_w = [];
    __tex_h = [];
    __chunks = [];
}
/// Set the renderer to use for sprites and particles
funcion void init(entero renderer) { iniciar(renderer); }

/// Retorna el renderer actual / Returns current renderer
funcion entero obtener_renderer() { retornar __ren; }
funcion entero get_renderer() { retornar obtener_renderer(); }

// ============================================================
// SPRITES — CARGA / SPRITES — LOAD
// ============================================================

/// Carga un archivo BMP como textura vía SDL2
/// Retorna un ID de sprite (1-based) o 0 si falla
funcion entero cargar_sprite(texto archivo) {
    si __ren == 0 { retornar 0; }
    si !__cargar_sdl() { retornar 0; }

    // SDL_RWFromFile(filename, "rb")
    entero rwops = __ffi_llamar(__sdl, "SDL_RWFromFile", "texto,texto",
        [archivo, "rb"], "entero");
    si rwops == 0 { retornar 0; }

    // SDL_LoadBMP_RW(rwops, freesrc=1)
    entero surf = __ffi_llamar(__sdl, "SDL_LoadBMP_RW", "entero,entero",
        [rwops, 1], "entero");
    si surf == 0 { retornar 0; }

    // SDL_CreateTextureFromSurface(renderer, surface)
    entero tex = __ffi_llamar(__sdl, "SDL_CreateTextureFromSurface",
        "entero,entero", [__ren, surf], "entero");

    // SDL_FreeSurface(surface)
    __ffi_llamar(__sdl, "SDL_FreeSurface", "entero", [surf], "void");

    si tex == 0 { retornar 0; }

    // Query texture dimensions for cached size
    entero w_buf = __ffi_asignar(4);
    entero h_buf = __ffi_asignar(4);
    // SDL_QueryTexture(texture, format=NULL, access=NULL, &w, &h)
    __ffi_llamar(__sdl, "SDL_QueryTexture", "entero,entero,entero,entero,entero",
        [tex, 0, 0, w_buf, h_buf], "entero");

    entero tw = __read_u32(w_buf, 0);
    entero th = __read_u32(h_buf, 0);
    __ffi_liberar(w_buf, 4);
    __ffi_liberar(h_buf, 4);

    __textures = __textures ++ [tex];
    __tex_w = __tex_w ++ [tw];
    __tex_h = __tex_h ++ [th];

    retornar largo(__textures);  // 1-based ID
}
/// Load a BMP file as a texture via SDL2
funcion entero load_sprite(texto file) { retornar cargar_sprite(file); }

/// Descarga y libera un sprite (libera la textura SDL)
/// sprite_id: ID devuelto por cargar_sprite()
funcion booleano descargar_sprite(entero id) {
    si id < 1 || id > largo(__textures) { retornar falso; }
    si !__cargar_sdl() { retornar falso; }
    entero tex = __textures[id - 1];
    __ffi_llamar(__sdl, "SDL_DestroyTexture", "entero", [tex], "void");
    __textures[id - 1] = 0;
    __tex_w[id - 1] = 0;
    __tex_h[id - 1] = 0;
    retornar verdadero;
}
/// Unload and free a sprite texture
funcion booleano unload_sprite(entero id) { retornar descargar_sprite(id); }

// ============================================================
// SPRITES — DIBUJO / SPRITES — DRAW
// ============================================================

/// Dibuja un sprite en posición (x, y) con su tamaño nativo
/// sprite_id: ID devuelto por cargar_sprite()
funcion booleano dibujar_sprite(entero id, entero x, entero y) {
    si id < 1 || id > largo(__textures) { retornar falso; }
    si __ren == 0 { retornar falso; }
    si !__cargar_sdl() { retornar falso; }
    entero tex = __textures[id - 1];
    si tex == 0 { retornar falso; }

    entero w = __tex_w[id - 1];
    entero h = __tex_h[id - 1];

    // dst rect = {x, y, w, h}
    entero dst = __rect_alloc(x, y, w, h);
    entero rc = __ffi_llamar(__sdl, "SDL_RenderCopy", "entero,entero,entero,entero",
        [__ren, tex, 0, dst], "entero");
    __ffi_liberar(dst, 16);
    retornar rc == 0;
}
/// Draw a sprite at position (x, y) with native size
funcion booleano draw_sprite(entero id, entero x, entero y) {
    retornar dibujar_sprite(id, x, y);
}

/// Dibuja un sprite escalado a (w, h) en posición (x, y)
funcion booleano dibujar_sprite_escala(entero id, entero x, entero y, entero w, entero h) {
    si id < 1 || id > largo(__textures) { retornar falso; }
    si __ren == 0 { retornar falso; }
    si !__cargar_sdl() { retornar falso; }
    entero tex = __textures[id - 1];
    si tex == 0 { retornar falso; }

    entero dst = __rect_alloc(x, y, w, h);
    entero rc = __ffi_llamar(__sdl, "SDL_RenderCopy", "entero,entero,entero,entero",
        [__ren, tex, 0, dst], "entero");
    __ffi_liberar(dst, 16);
    retornar rc == 0;
}
/// Draw a sprite scaled to (w, h) at position (x, y)
funcion booleano draw_sprite_scaled(entero id, entero x, entero y, entero w, entero h) {
    retornar dibujar_sprite_escala(id, x, y, w, h);
}

/// Dibuja un frame de una hoja de sprites (sprite sheet horizontal)
/// sprite_id: ID de textura, frame: índice (0-based), fw/fh: ancho/alto del frame
funcion booleano animar_sprite(entero id, entero frame, entero fw, entero fh,
        entero x, entero y) {
    si id < 1 || id > largo(__textures) { retornar falso; }
    si __ren == 0 { retornar falso; }
    si !__cargar_sdl() { retornar falso; }
    entero tex = __textures[id - 1];
    si tex == 0 { retornar falso; }

    // src rect = {frame * fw, 0, fw, fh}
    entero src = __rect_alloc(frame * fw, 0, fw, fh);
    // dst rect = {x, y, fw, fh}
    entero dst = __rect_alloc(x, y, fw, fh);

    entero rc = __ffi_llamar(__sdl, "SDL_RenderCopy", "entero,entero,entero,entero",
        [__ren, tex, src, dst], "entero");

    __ffi_liberar(src, 16);
    __ffi_liberar(dst, 16);
    retornar rc == 0;
}
/// Draw a frame from a sprite sheet (horizontal strip)
funcion booleano animate_sprite(entero id, entero frame, entero fw, entero fh,
        entero x, entero y) {
    retornar animar_sprite(id, frame, fw, fh, x, y);
}

// ============================================================
// AUDIO — INICIALIZACIÓN / AUDIO — INIT
// ============================================================

/// Inicializa audio con SDL2_mixer
/// frecuencia: ej. 44100, canales: 1=mono 2=estéreo
/// Retorna 0 si éxito, -1 si error
funcion entero audio_iniciar(entero frecuencia, entero canales) {
    si !__cargar_mixer() { retornar -1; }
    // MIX_DEFAULT_FORMAT = AUDIO_S16LSB = 0x8010 = 32816
    entero MIX_DEFAULT_FORMAT = 32816;
    // Mix_OpenAudio(frequency, format, channels, chunksize)
    entero rc = __ffi_llamar(__mixer, "Mix_OpenAudio", "entero,entero,entero,entero",
        [frecuencia, MIX_DEFAULT_FORMAT, canales, 2048], "entero");
    retornar rc;
}
/// Initialize audio with SDL2_mixer
funcion entero audio_init(entero freq, entero channels) {
    retornar audio_iniciar(freq, channels);
}

/// Cierra el subsistema de audio
funcion void audio_cerrar() {
    si !__cargar_mixer() { retornar; }
    __ffi_llamar(__mixer, "Mix_CloseAudio", "", [], "void");
}
/// Close the audio subsystem
funcion void audio_close() { audio_cerrar(); }

// ============================================================
// AUDIO — CARGA / AUDIO — LOAD
// ============================================================

/// Carga un archivo WAV como chunk de audio
/// Retorna un ID de sonido (1-based) o 0 si falla
funcion entero audio_cargar_wav(texto archivo) {
    si !__cargar_mixer() { retornar 0; }
    // Mix_LoadWAV(file) returns Mix_Chunk*
    entero chunk = __ffi_llamar(__mixer, "Mix_LoadWAV", "texto", [archivo], "entero");
    si chunk == 0 { retornar 0; }
    __chunks = __chunks ++ [chunk];
    retornar largo(__chunks);
}
/// Load a WAV file as an audio chunk
funcion entero audio_load_wav(texto file) { retornar audio_cargar_wav(file); }

/// Libera un chunk de audio
funcion void audio_descargar(entero id) {
    si id < 1 || id > largo(__chunks) { retornar; }
    si !__cargar_mixer() { retornar; }
    entero chunk = __chunks[id - 1];
    __ffi_llamar(__mixer, "Mix_FreeChunk", "entero", [chunk], "void");
    __chunks[id - 1] = 0;
}
/// Free an audio chunk
funcion void audio_unload(entero id) { audio_descargar(id); }

// ============================================================
// AUDIO — REPRODUCCIÓN / AUDIO — PLAYBACK
// ============================================================

/// Reproduce un sonido en el primer canal disponible
/// chunk_id: ID devuelto por audio_cargar_wav()
/// veces: 0 = una vez, -1 = bucle infinito
funcion void audio_reproducir(entero id, entero veces) {
    si id < 1 || id > largo(__chunks) { retornar; }
    si !__cargar_mixer() { retornar; }
    entero chunk = __chunks[id - 1];
    si chunk == 0 { retornar; }
    // Mix_PlayChannel(channel=-1, chunk, loops)
    __ffi_llamar(__mixer, "Mix_PlayChannel", "entero,entero,entero",
        [-1, chunk, veces], "entero");
}
/// Play a sound on the first available channel
funcion void audio_play(entero id, entero times) {
    audio_reproducir(id, times);
}

/// Detiene todos los canales de audio
funcion void audio_detener_todo() {
    si !__cargar_mixer() { retornar; }
    __ffi_llamar(__mixer, "Mix_HaltChannel", "entero", [-1], "void");
}
/// Stop all audio channels
funcion void audio_stop_all() { audio_detener_todo(); }

// ============================================================
// PARTÍCULAS — ESTRUCTURA / PARTICLES — STRUCT
// ============================================================

/// Estructura que representa una partícula individual
estructura Particula {
    x: decimal,
    y: decimal,
    vx: decimal,
    vy: decimal,
    vida: entero,
    vida_max: entero,
    color_r: entero,
    color_g: entero,
    color_b: entero,
    tamano: entero,
}

estructura Particle {
    x: decimal,
    y: decimal,
    vx: decimal,
    vy: decimal,
    vida: entero,
    vida_max: entero,
    color_r: entero,
    color_g: entero,
    color_b: entero,
    tamano: entero,
}

// ============================================================
// PARTÍCULAS — CREACIÓN / PARTICLES — CREATE
// ============================================================

/// Crea un sistema de partículas con forma de explosión circular
/// cantidad: número de partículas, cx/cy: centro de la explosión
funcion lista<Particula> particulas_crear(entero cantidad, decimal cx, decimal cy) {
    lista<Particula> ps = [];
    entero i = 0;
    mientras i < cantidad {
        // Distribución pseudo-circular usando módulo para direcciones
        decimal angle = (i como decimal) * 6.28318 / (cantidad como decimal);
        decimal speed = 0.5 + ((i % 5) como decimal) * 0.4;
        // Aproximación de seno/coseno sin usar matematicas.nv
        decimal sn = 0.0;
        decimal cs = 0.0;
        // seno(angle) usando primer término de Taylor
        decimal a2 = angle * angle;
        decimal a3 = a2 * angle;
        decimal a5 = a3 * a2;
        sn = angle - a3 / 6.0 + a5 / 120.0;
        // coseno(angle) usando primer término de Taylor
        decimal a4 = a2 * a2;
        cs = 1.0 - a2 / 2.0 + a4 / 24.0;

        decimal vx = cs * speed;
        decimal vy = sn * speed;

        Particula p = Particula {
            x: cx,
            y: cy,
            vx: vx,
            vy: vy,
            vida: 40 + (i % 20) * 2,
            vida_max: 40 + (i % 20) * 2,
            color_r: (i * 50) % 256,
            color_g: (i * 80) % 256,
            color_b: (i * 120) % 256,
            tamano: 2 + (i % 4),
        };
        ps = ps ++ [p];
        i = i + 1;
    }
    retornar ps;
}
/// Create a particle system with circular burst pattern
funcion lista<Particle> particles_create(entero count, decimal cx, decimal cy) {
    lista<Particula> ps = particulas_crear(count, cx, cy);
    lista<Particle> res = [];
    entero i = 0;
    mientras i < largo(ps) {
        Particle p = Particle {
            x: ps[i].x, y: ps[i].y,
            vx: ps[i].vx, vy: ps[i].vy,
            vida: ps[i].vida, vida_max: ps[i].vida_max,
            color_r: ps[i].color_r, color_g: ps[i].color_g,
            color_b: ps[i].color_b, tamano: ps[i].tamano,
        };
        res = res ++ [p];
        i = i + 1;
    }
    retornar res;
}

// ============================================================
// PARTÍCULAS — ACTUALIZACIÓN / PARTICLES — UPDATE
// ============================================================

/// Actualiza todas las partículas (movimiento, gravedad, desvanecimiento)
/// Retorna solo las partículas vivas
funcion lista<Particula> particulas_actualizar(lista<Particula> ps) {
    lista<Particula> vivas = [];
    entero i = 0;
    mientras i < largo(ps) {
        ps[i].x = ps[i].x + ps[i].vx;
        ps[i].y = ps[i].y + ps[i].vy;
        ps[i].vy = ps[i].vy + 0.15;  // gravedad
        ps[i].vx = ps[i].vx * 0.98;  // fricción
        ps[i].vida = ps[i].vida - 1;
        si ps[i].vida > 0 {
            vivas = vivas ++ [ps[i]];
        }
        i = i + 1;
    }
    retornar vivas;
}
/// Update all particles (movement, gravity, fade)
funcion lista<Particle> particles_update(lista<Particle> ps) {
    // Convert to Particula list, update, convert back
    lista<Particula> internas = [];
    entero i = 0;
    mientras i < largo(ps) {
        Particula p = Particula {
            x: ps[i].x, y: ps[i].y,
            vx: ps[i].vx, vy: ps[i].vy,
            vida: ps[i].vida, vida_max: ps[i].vida_max,
            color_r: ps[i].color_r, color_g: ps[i].color_g,
            color_b: ps[i].color_b, tamano: ps[i].tamano,
        };
        internas = internas ++ [p];
        i = i + 1;
    }
    lista<Particula> actualizadas = particulas_actualizar(internas);
    lista<Particle> res = [];
    i = 0;
    mientras i < largo(actualizadas) {
        Particle p = Particle {
            x: actualizadas[i].x, y: actualizadas[i].y,
            vx: actualizadas[i].vx, vy: actualizadas[i].vy,
            vida: actualizadas[i].vida, vida_max: actualizadas[i].vida_max,
            color_r: actualizadas[i].color_r, color_g: actualizadas[i].color_g,
            color_b: actualizadas[i].color_b, tamano: actualizadas[i].tamano,
        };
        res = res ++ [p];
        i = i + 1;
    }
    retornar res;
}

// ============================================================
// PARTÍCULAS — DIBUJO / PARTICLES — DRAW
// ============================================================

/// Dibuja todas las partículas como rectángulos coloreados
/// Requiere: __ren inicializado via graficos_avanzado_iniciar()
funcion void particulas_dibujar(lista<Particula> ps) {
    si __ren == 0 { retornar; }
    si !__cargar_sdl() { retornar; }

    entero i = 0;
    mientras i < largo(ps) {
        // Calcular alfa de desvanecimiento
        decimal alpha = 1.0;
        si ps[i].vida_max > 0 {
            alpha = ps[i].vida como decimal / ps[i].vida_max como decimal;
        }
        entero r = (ps[i].color_r como decimal * alpha) como entero;
        entero g = (ps[i].color_g como decimal * alpha) como entero;
        entero b = (ps[i].color_b como decimal * alpha) como entero;

        // SDL_SetRenderDrawColor(renderer, r, g, b, 255)
        __ffi_llamar(__sdl, "SDL_SetRenderDrawColor", "entero,entero,entero,entero,entero",
            [__ren, r, g, b, 255], "entero");

        // SDL_RenderFillRect(renderer, &rect)
        entero dst = __rect_alloc(ps[i].x como entero, ps[i].y como entero,
            ps[i].tamano, ps[i].tamano);
        __ffi_llamar(__sdl, "SDL_RenderFillRect", "entero,entero",
            [__ren, dst], "entero");
        __ffi_liberar(dst, 16);

        i = i + 1;
    }
}
/// Draw all particles as colored rectangles
funcion void particles_draw(lista<Particle> ps) {
    // Convert to Particula list and draw
    lista<Particula> internas = [];
    entero i = 0;
    mientras i < largo(ps) {
        Particula p = Particula {
            x: ps[i].x, y: ps[i].y,
            vx: ps[i].vx, vy: ps[i].vy,
            vida: ps[i].vida, vida_max: ps[i].vida_max,
            color_r: ps[i].color_r, color_g: ps[i].color_g,
            color_b: ps[i].color_b, tamano: ps[i].tamano,
        };
        internas = internas ++ [p];
        i = i + 1;
    }
    particulas_dibujar(internas);
}

// ============================================================
// PARTÍCULAS — EXPLOSIÓN (ATALJO) / PARTICLES — EXPLOSION (SHORTCUT)
// ============================================================

/// Crea y actualiza un sistema completo de explosión en un solo paso
/// Retorna las partículas vivas después de 1 frame
funcion lista<Particula> particulas_explosion(entero cantidad, decimal cx, decimal cy) {
    lista<Particula> ps = particulas_crear(cantidad, cx, cy);
    retornar particulas_actualizar(ps);
}
/// Create and update a complete explosion in one step
funcion lista<Particle> particles_explosion(entero count, decimal cx, decimal cy) {
    retornar particles_update(particles_create(count, cx, cy));
}
