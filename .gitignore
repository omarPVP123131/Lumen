# ── 5. BENCHMARKS — BINARIOS Y ARTEFACTOS GENERADOS ───────────────────────
# Binarios compilados (AOT-C / Cranelift / LLVM) — nunca versionar
benchmarks/results/exe_*
benchmarks/results/exe_*.exe
benchmarks/results/bench_*
benchmarks/results/bench_*.exe
# IR / runtime C generado por --llvm (se puede regenerar)
# Nota: actualmente trackeados en git; si se quieren des-trackear, hacer git rm --cached
# benchmarks/lumen/*.ll
# benchmarks/lumen/*.llvm_rt.c
# Binarios temporales de stdlib/compiler y ejemplos
benchmarks/lumen/*.nvc
stdlib/compiler/bench_fib
stdlib/compiler/bench_out.nvc
benchmarks_output/
bench_fib

