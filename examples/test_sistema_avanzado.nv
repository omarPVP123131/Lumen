importar "sistema.nv";

imprimir("=== Sistema Test ===");

// --- Procesos ---
imprimir("--- Procesos ---");
sea res = sistema_ejecutar("echo Hola Mundo");
imprimir("echo: ", res);

// --- Env ---
imprimir("--- Env ---");
sea path = sistema_env_obtener("PATH");
imprimir("PATH existe: ", path != "");
sistema_env_asignar("LUMEN_TEST", "funciona");
sea test_val = sistema_env_obtener("LUMEN_TEST");
imprimir("LUMEN_TEST: ", test_val);
sea vars = sistema_env_listar();
imprimir("vars count: ", vars.largo());

// --- Path ---
imprimir("--- Path ---");
sea unido = sistema_path_unir("carpeta", "archivo.txt");
imprimir("unido: ", unido);
sea ext = sistema_path_extension("documento.pdf");
imprimir("extension: ", ext);
sea nombre = sistema_path_nombre_archivo("carpeta/archivo.txt");
imprimir("nombre: ", nombre);
sea padre = sistema_path_padre("carpeta/sub/archivo.txt");
imprimir("padre: ", padre);

// --- Temp ---
imprimir("--- Temp ---");
sea dir = sistema_temp_directorio();
imprimir("temp dir: ", dir);
sea tmp = sistema_temp_archivo();
imprimir("temp archivo: ", tmp);

imprimir("--- FIN ---");
