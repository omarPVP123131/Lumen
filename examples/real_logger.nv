// EJEMPLO REAL: Logger con timestamps del sistema
// Uso: lumen run examples/real_logger.nv

importar "fecha.nv";
importar "sistema.nv";

funcion texto nivel_str(entero nivel) {
    elegir (nivel) {
        caso 0: retornar "DEBUG";
        caso 1: retornar "INFO";
        caso 2: retornar "WARN";
        caso 3: retornar "ERROR";
        defecto: retornar "UNKNOWN";
    }
}

funcion texto log(entero nivel, texto msg) {
    sea ts = fecha_ahora();
    sea time_str = fecha_formatear(ts, "%Y-%m-%d %H:%M:%S");
    sea host = sistema_env_obtener("COMPUTERNAME");
    si host != "" {
        retornar time_str + " [" + nivel_str(nivel) + "] [" + host + "] " + msg;
    } sino {
        retornar time_str + " [" + nivel_str(nivel) + "] [localhost] " + msg;
    }
}

imprimir("=== Logger REAL ===");

sea inicio = fecha_ahora();
imprimir(log(0, "Iniciando logger"));
imprimir(log(1, "Cargando configuración"));
imprimir(log(1, "Conectando a base de datos"));
imprimir(log(2, "Timeout en conexión, reintentando"));
imprimir(log(1, "Conexión establecida"));
imprimir(log(3, "Error: archivo de configuración no encontrado"));
imprimir(log(1, "Usando valores por defecto"));

// Simular operaciones
sea iter = 0;
mientras iter < 5 {
    sea iter_inicio = fecha_ahora();
    sea res_proc = sistema_ejecutar("echo operacion_" + iter);
    sea iter_fin = fecha_ahora();
    sea duracion = fecha_diferencia(iter_fin, iter_inicio);
    imprimir(log(1, "Operacion " + iter + " completada en " + duracion + "ms"));
    iter = iter + 1;
}

sea fin = fecha_ahora();
sea total = fecha_diferencia(fin, inicio);
imprimir(log(1, "Proceso completado en " + total + "ms"));

imprimir("--- FIN REAL ---");
