// v3.0 — `opcion<T>` y `resultado<T, E>` con cualquier tipo
//
// Hasta v2.4.x el dato capturado en un patrón se ligaba siempre como `numero`,
// así que estos tipos sólo servían con enteros. Desde v3.0 conservan el tipo
// real: structs, listas, texto... (BUG-065)

estructura Usuario {
    nombre: texto,
    edad: entero,
}

// Búsqueda que puede no encontrar nada: `opcion<Usuario>`.
funcion opcion<Usuario> buscar(lista<Usuario> us, texto nombre) {
    para u en us {
        si (u.nombre == nombre) {
            retornar algun(u);
        }
    }
    retornar ninguno;
}

// Operación que puede fallar con un motivo: `resultado<Usuario, texto>`.
funcion resultado<Usuario, texto> registrar(texto nombre, entero edad) {
    si (largo(nombre) == 0) {
        retornar error("el nombre no puede estar vacío");
    }
    si (edad < 18) {
        retornar error("debe ser mayor de edad");
    }
    retornar exito(Usuario { nombre: nombre, edad: edad });
}

lista<Usuario> usuarios = [
    Usuario { nombre: "Ana", edad: 34 },
    Usuario { nombre: "Beto", edad: 28 },
];

// El struct capturado conserva sus campos.
elegir (buscar(usuarios, "Ana")) {
    caso algun(u): imprimir("encontrado: ", u.nombre, " (", u.edad, " años)");
    caso ninguno: imprimir("no encontrado");
}

elegir (buscar(usuarios, "Zoe")) {
    caso algun(u): imprimir("encontrado: ", u.nombre);
    caso ninguno: imprimir("Zoe no está registrada");
}

// `resultado` con struct en el caso correcto y texto en el error.
elegir (registrar("Carmen", 45)) {
    caso exito(u): imprimir("alta OK: ", u.nombre);
    caso error(e): imprimir("alta rechazada: ", e);
}

elegir (registrar("Dani", 15)) {
    caso exito(u): imprimir("alta OK: ", u.nombre);
    caso error(e): imprimir("alta rechazada: ", e);
}

elegir (registrar("", 30)) {
    caso exito(u): imprimir("alta OK: ", u.nombre);
    caso error(e): imprimir("alta rechazada: ", e);
}

// También funciona con listas y con texto.
funcion opcion<lista<entero>> primeros(entero n) {
    si (n <= 0) {
        retornar ninguno;
    }
    lista<entero> l = [];
    para i en 1..=n {
        agregar(l, i);
    }
    retornar algun(l);
}

elegir (primeros(4)) {
    caso algun(l): imprimir("lista de ", largo(l), " elementos (1..=4)");
    caso ninguno: imprimir("sin lista");
}

funcion opcion<texto> saludo(booleano formal) {
    si (formal) {
        retornar algun("Buenos días");
    }
    retornar algun("¡Hola!");
}

elegir (saludo(verdadero)) {
    caso algun(s): imprimir(s, " (", largo(s), " caracteres)");
    caso ninguno: imprimir("sin saludo");
}
