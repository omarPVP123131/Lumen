estructura Tarea {
    descripcion: texto,
    completa: booleano
}

lista<Tarea> tareas = [];
tareas.agregar(Tarea { descripcion: "Comprar leche", completa: falso });
tareas.agregar(Tarea { descripcion: "Estudiar", completa: falso });

Tarea primera = tareas[0];
primera.completa = verdadero;

entero i = 0;
mientras (i < tareas.largo()) {
    texto estado = tareas[i].completa ? "hecho" : "pendiente";
    imprimir(tareas[i].descripcion + " - " + estado);
    i = i + 1;
}
