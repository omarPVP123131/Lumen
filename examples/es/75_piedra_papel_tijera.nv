funcion texto jugar(entero j1, entero j2) {
    si (j1 == j2) {
        retornar "Empate";
    }
    si (j1 == 1 && j2 == 3) {
        retornar "Gana Jugador 2";
    }
    si (j1 == 2 && j2 == 1) {
        retornar "Gana Jugador 2";
    }
    si (j1 == 3 && j2 == 2) {
        retornar "Gana Jugador 2";
    }
    retornar "Gana Jugador 1";
}

imprimir(jugar(1, 2));
imprimir(jugar(3, 1));
imprimir(jugar(2, 2));
