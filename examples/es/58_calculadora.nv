funcion entero sumar(entero a, entero b) {
    retornar a + b;
}

funcion entero restar(entero a, entero b) {
    retornar a - b;
}

funcion entero multiplicar(entero a, entero b) {
    retornar a * b;
}

funcion entero dividir(entero a, entero b) {
    si (b == 0) {
        retornar 0;
    }
    retornar a / b;
}

imprimir(sumar(10, 5));
imprimir(restar(10, 5));
imprimir(multiplicar(10, 5));
imprimir(dividir(10, 5));
