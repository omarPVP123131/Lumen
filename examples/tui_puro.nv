importar "tui.nv";
// Headless/CI guard — demo requiere display/SDL2/consola interactiva
importar "sistema.nv";
texto _ci_guard = sistema_env_obtener("CI");
texto _hl_guard = sistema_env_obtener("LUMEN_HEADLESS");
si _ci_guard != "" || _hl_guard == "1" {
    imprimir("Headless/CI detectado — demo omitida (requiere display)");
    retornar;
}

imprimir("=== TUI en LÚMEN puro ===");
tui_iniciar();
tui_limpiar();
tui_ventana("Hola Lumen", "Esto es TUI en LUMEN puro!");
tui_escribir("Presiona ESC para salir", 0, 8);

texto k = "";
mientras k != "esc" {
    k = tui_tecla();
}

tui_cerrar();
imprimir("--- FIN ---");
