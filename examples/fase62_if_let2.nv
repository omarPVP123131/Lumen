// Fase 62 — If-let con Resultado: extracción segura de `exito`
funcion entero principal() {
    resultado<entero, texto> r = exito(7);
    si sea exito(v) = r {
        imprimir("ok: ", v);
    }
    resultado<entero, texto> e = error("boom");
    si sea exito(w) = e {
        imprimir("nunca se imprime");
    }
    retornar 0;
}
