importar ingles;

struct ParClave {
    clave: string,
    valor: integer
}

function integer buscar_clave(array<ParClave> dict, string clave) {
    integer i = 0;
    while (i < dict.largo()) {
        if (dict[i].clave == clave) {
            return dict[i].valor;
        }
        i = i + 1;
    }
    return -1;
}

array<ParClave> dict = [];
dict.agregar(ParClave { clave: "a", valor: 1 });
dict.agregar(ParClave { clave: "b", valor: 2 });
dict.agregar(ParClave { clave: "c", valor: 3 });

print(buscar_clave(dict, "b"));
print(buscar_clave(dict, "z"));
