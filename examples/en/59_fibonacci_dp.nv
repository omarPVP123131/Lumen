importar ingles;

function integer fib(integer n) {
    if (n <= 1) {
        return n;
    }
    integer a = 0;
    integer b = 1;
    integer i = 2;
    while (i <= n) {
        integer c = a + b;
        a = b;
        b = c;
        i = i + 1;
    }
    return b;
}

print(fib(0));
print(fib(1));
print(fib(10));
print(fib(20));
