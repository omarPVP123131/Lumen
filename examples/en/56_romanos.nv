importar ingles;

function string romano(integer n) {
    array<integer> vals = [1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1];
    array<string> syms = ["M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"];
    string r = "";
    integer i = 0;
    while (i < vals.largo()) {
        while (n >= vals[i]) {
            r = r + syms[i];
            n = n - vals[i];
        }
        i = i + 1;
    }
    return r;
}

print(romano(42));
print(romano(1994));
