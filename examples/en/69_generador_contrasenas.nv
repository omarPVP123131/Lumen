importar ingles;

function string generar_clave(integer largo) {
    string chars = "abcdefghijklmnopqrstuvwxyz";
    string r = "";
    integer i = 0;
    while (i < largo) {
        integer idx = i % __str_longitud(chars);
        r = r + chars[idx];
        i = i + 1;
    }
    return r;
}

print(generar_clave(8));
print(generar_clave(12));
