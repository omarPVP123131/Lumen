importar ingles;

function boolean validar_clave(string clave) {
    if (__str_longitud(clave) < 8) {
        return false;
    }
    boolean tiene_numero = false;
    integer i = 0;
    while (i < __str_longitud(clave)) {
        if (clave[i] == "0" || clave[i] == "1" || clave[i] == "2" || clave[i] == "3" || clave[i] == "4" || clave[i] == "5" || clave[i] == "6" || clave[i] == "7" || clave[i] == "8" || clave[i] == "9") {
            tiene_numero = true;
        }
        i = i + 1;
    }
    return tiene_numero && __str_longitud(clave) >= 8;
}

print(validar_clave("abc12345"));
print(validar_clave("abcdefghi"));
print(validar_clave("corta1"));
