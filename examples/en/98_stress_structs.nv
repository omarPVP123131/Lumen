importar ingles;

struct Vec2 {
    x: integer,
    y: integer
}

Vec2 a = Vec2 { x: 1, y: 2 };
Vec2 b = Vec2 { x: a.x, y: a.y };
b.x = 10;
print(a.x);
print(b.x);

struct Rect {
    esquina: Vec2,
    ancho: integer,
    alto: integer
}

Rect r = Rect { esquina: Vec2 { x: 0, y: 0 }, ancho: 5, alto: 3 };
print(r.esquina.x);
print(r.ancho);
r.alto = 7;
print(r.alto);
