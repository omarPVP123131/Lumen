// ==========================================
// mutation_sr.nv — Mutation Testing (intermediate)
// Tests: mutation types, scoring, mutation analysis
// Uso: lumen run examples/sr/mutation_sr.nv
// ==========================================

imprimir("=== Mutation SR: Mutation Testing ===");

// ── Helper: reemplazar + por - ──
funcion texto mutar_mas(texto s) {
    texto r = "";
    entero i = 0;
    mientras i < s.largo() {
        si s[i] == "+" { r = r + "-"; }
        sino { r = r + s[i]; }
        i = i + 1;
    }
    retornar r;
}

// ── Helper: reemplazar > por < ──
funcion texto mutar_mayor(texto s) {
    texto r = "";
    entero i = 0;
    mientras i < s.largo() {
        si s[i] == ">" { r = r + "<"; }
        sino { r = r + s[i]; }
        i = i + 1;
    }
    retornar r;
}

// ── Helper: puntaje de mutacion ──
funcion entero puntaje_pct(entero muertos, entero total) {
    si total == 0 { retornar 0; }
    retornar muertos * 100 / total;
}

// ── Ej 1: Todos los tipos de mutacion ──
// Ej 1: All mutation types
imprimir("--- Ej 1: Tipos de Mutacion ---");

texto source = "funcion verificar(a, b) { si a + b > 0 { retornar verdadero; } retornar falso; }";
imprimir("Original: ", source);
imprimir("Longitud: ", source.largo());

texto t1 = mutar_mas(source);
imprimir("Tipo 1 (+ -> -):  ", t1);

texto t2 = mutar_mayor(source);
imprimir("Tipo 2 (> -> <):  ", t2);

// Type 3: replace first character 'f' with 'X' to simulate another mutation
texto t3 = "";
entero ti = 0;
mientras ti < source.largo() {
    si ti == 0 {
        t3 = t3 + "X";
    } sino {
        t3 = t3 + source[ti];
    }
    ti = ti + 1;
}
imprimir("Tipo 3 (mod inicial): ", t3);

// Verify all preserve same length
entero cambios = 0;
si t1.largo() - source.largo() == 0 { cambios = cambios + 1; }
si t2.largo() - source.largo() == 0 { cambios = cambios + 1; }
si t3.largo() - source.largo() == 0 { cambios = cambios + 1; }
imprimir("Mutaciones que preservan longitud: ", cambios, "/3");

// ── Ej 2: Puntaje de Mutacion ──
// Ej 2: Mutation Score
imprimir("");
imprimir("--- Ej 2: Puntaje de Mutacion ---");

entero muertos = 4;
entero total_mut = 5;
entero p1 = puntaje_pct(muertos, total_mut);
imprimir("Caso 1: ", muertos, "/", total_mut, " = ", p1, "%");

entero muertos2 = 8;
entero total2 = 10;
entero p2 = puntaje_pct(muertos2, total2);
imprimir("Caso 2: ", muertos2, "/", total2, " = ", p2, "%");

// ── Ej 3: Mutation Testing sobre codigo ──
// Ej 3: Mutation testing on code
imprimir("");
imprimir("--- Ej 3: Mutation Testing ---");
texto real_code = "funcion es_mayor(x, y) { si x > y { retornar verdadero; } retornar falso; }";

texto rm1 = mutar_mas(real_code);
texto rm2 = mutar_mayor(real_code);

entero killed = 0;
si rm1.largo() - real_code.largo() == 0 { killed = killed + 1; }
si rm2.largo() - real_code.largo() == 0 { killed = killed + 1; }
entero score3 = puntaje_pct(killed, 2);
imprimir("Mutantes que preservan estructura: ", killed, "/2 (", score3, "%)");

// ── Ej 4: Comparacion de robustez ──
// Ej 4: Robustness comparison
imprimir("");
imprimir("--- Ej 4: Comparacion de Robustez ---");

texto codigo_fuerte = "funcion dividir(a, b) { si b == 0 { retornar -1; } retornar a / b; }";
texto codigo_debil = "funcion dividir(a, b) { retornar a / b; }";

texto cf1 = mutar_mas(codigo_fuerte);
texto cd1 = mutar_mas(codigo_debil);

imprimir("Codigo fuerte (con guardas): longitud=", codigo_fuerte.largo());
imprimir("  Mutado (+→-): longitud=", cf1.largo());
imprimir("Codigo debil (sin guardas):  longitud=", codigo_debil.largo());
imprimir("  Mutado (+→-): longitud=", cd1.largo());

// ── Ej 5: Reporte de calidad ──
// Ej 5: Quality report
imprimir("");
imprimir("--- Ej 5: Reporte de Calidad ---");
entero score_fuerte = puntaje_pct(4, 5);
entero score_debil = puntaje_pct(1, 5);
imprimir("Codigo con guardas:     ", score_fuerte, "% mutantes detectables");
imprimir("Codigo sin guardas:     ", score_debil, "% mutantes detectables");
imprimir("Diferencia:             ", score_fuerte - score_debil, "% mejor cobertura");

imprimir("");
imprimir("--- FIN MUTATION SR ---");
