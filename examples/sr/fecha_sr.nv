// ==========================================
// fecha_sr.nv — Date/Time operations (senior)
// Uso: lumen run -L stdlib/ examples/sr/fecha_sr.nv
// ==========================================
importar "fecha.nv";

imprimir("=== Fecha SR: Intermediate Date Operations ===");

// ── Example 1: Date Parsing & Difference ──
imprimir("--- Ej 1: Parsear y Diferencias ---");
sea ahora = fecha_ahora();

sea inicio = fecha_parsear("2026-06-01T00:00:00Z", "%Y-%m-%d %H:%M:%S");
sea final = fecha_parsear("2026-08-15T00:00:00Z", "%Y-%m-%d %H:%M:%S");
sea total_segs = fecha_diferencia(final, inicio);
sea total_dias = total_segs / 86400;
imprimir("días entre 2026-06-01 y 2026-08-15: ", total_dias);

// Days between specific events
sea evento1 = fecha_parsear("2026-01-01T00:00:00Z", "%Y-%m-%d %H:%M:%S");
sea evento2 = fecha_parsear("2026-12-31T23:59:59Z", "%Y-%m-%d %H:%M:%S");
sea dias_anio = fecha_diferencia(evento2, evento1) / 86400;
imprimir("días en 2026: ", dias_anio);

// ── Example 2: Countdown ──
imprimir("--- Ej 2: Cuenta Regresiva ---");
sea target = fecha_parsear("2027-01-01T00:00:00Z", "%Y-%m-%d %H:%M:%S");
sea faltan_segs = fecha_diferencia(target, ahora);
sea faltan_dias = faltan_segs / 86400;
sea faltan_horas = (faltan_segs % 86400) / 3600;

imprimir("Cuenta regresiva a 2027-01-01:");
imprimir("  días restantes:  ", faltan_dias);
imprimir("  horas restantes: ", faltan_horas);

// ── Example 3: Age Calculator ──
imprimir("--- Ej 3: Calculadora de Edad ---");

// Calculate age for first person
sea nac1 = fecha_parsear("1990-03-20T00:00:00Z", "%Y-%m-%d %H:%M:%S");
sea segs1 = fecha_diferencia(ahora, nac1);
sea anios1 = segs1 / (365 * 86400);
sea meses1 = (segs1 % (365 * 86400)) / (30 * 86400);
sea dias1 = (segs1 % (30 * 86400)) / 86400;
imprimir("  Nacimiento: 1990-03-20");
imprimir("  Edad: ", anios1, " años, ", meses1, " meses, ", dias1, " días");

// Calculate age for second person
sea nac2 = fecha_parsear("2005-11-05T00:00:00Z", "%Y-%m-%d %H:%M:%S");
sea segs2 = fecha_diferencia(ahora, nac2);
sea anios2 = segs2 / (365 * 86400);
imprimir("  Nacimiento: 2005-11-05");
imprimir("  Edad: ", anios2, " años");

// Calculate age for third person
sea nac3 = fecha_parsear("1985-07-15T00:00:00Z", "%Y-%m-%d %H:%M:%S");
sea segs3 = fecha_diferencia(ahora, nac3);
sea anios3 = segs3 / (365 * 86400);
imprimir("  Nacimiento: 1985-07-15");
imprimir("  Edad: ", anios3, " años");

// ── Example 4: Format Variants ──
imprimir("--- Ej 4: Variantes de Formato ---");
sea ts = fecha_ahora();

imprimir("ISO 8601:       ", fecha_formatear(ts, "%Y-%m-%dT%H:%M:%S"));
imprimir("fecha corta:    ", fecha_formatear(ts, "%d/%m/%Y"));
imprimir("hora 24h:       ", fecha_formatear(ts, "%H:%M:%S"));

// English aliases
sea mes_en = fecha_format(ts, "%B");
sea dia_en = fecha_format(ts, "%A");
imprimir("month name:     ", mes_en);
imprimir("day of week:    ", dia_en);

imprimir("--- FIN FECHA SR ---");
