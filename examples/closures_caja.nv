// Caja registradora: una closure acumula el total de la venta.
funcion cualquiera crear_caja() {
    decimal total = 0.0;
    sea cobrar = funcion(decimal importe) {
        total = total + importe;
        retornar total;
    };
    retornar cobrar;
}

funcion vacio main() {
    sea caja1 = crear_caja();
    sea caja2 = crear_caja();

    imprimir("Caja 1 tras tres cobros:");
    imprimir(caja1(10.5));
    imprimir(caja1(4.25));
    imprimir(caja1(5.25));

    imprimir("Caja 2 es independiente:");
    imprimir(caja2(100.0));
}
