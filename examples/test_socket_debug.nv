imprimir("=== Socket Debug ===");

sea wsa = __ffi_asignar(400);
sea r1 = __ffi_llamar(__ffi_cargar("ws2_32.dll"), "WSAStartup", "entero,entero", [514, wsa], "entero");
imprimir("WSAStartup: ", r1);
__ffi_liberar(wsa, 400);

sea w = __ffi_cargar("ws2_32.dll");
imprimir("ws2_32: ", w);

sea fd2 = __ffi_llamar(w, "socket", "entero,entero,entero", [2, 1, 0], "entero");
imprimir("socket: ", fd2);

sea err2 = __ffi_llamar(w, "WSAGetLastError", "", [], "entero");
imprimir("error: ", err2);

imprimir("--- FIN ---");
