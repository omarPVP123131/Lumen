// step1d.nv — add strings
funcion numero lx(texto s) {
    lista<entero> codes = __str_ord(s);
    entero n = largo(codes);
    entero idx = 0;
    numero tk = __map_nuevo();
    entero cnt = 0;
    
    mientras idx < n {
        entero cp = codes[idx];
        si cp == 32 || cp == 9 { idx = idx + 1; continuar; }
        si cp == 10 { idx = idx + 1; continuar; }
        si cp == 47 {
            si idx + 1 < n && codes[idx + 1] == 47 {
                mientras idx < n && codes[idx] != 10 { idx = idx + 1; }
                continuar;
            }
        }
        si cp == 34 {
            idx = idx + 1;
            mientras idx < n && codes[idx] != 34 { idx = idx + 1; }
            si idx < n { idx = idx + 1; }
            numero t = __map_nuevo();
            t = __map_poner(t, "v", "str");
            tk = __map_poner(tk, a_texto(cnt), t);
            cnt = cnt + 1;
            continuar;
        }
        si cp >= 65 {
            texto id = "";
            mientras idx < n {
                entero c2 = codes[idx];
                si c2 >= 65 { id = id + a_texto(c2); idx = idx + 1; }
                sino { romper; }
            }
            numero t = __map_nuevo();
            t = __map_poner(t, "v", id);
            tk = __map_poner(tk, a_texto(cnt), t);
            cnt = cnt + 1;
        } sino {
            idx = idx + 1;
        }
    }
    numero t = __map_nuevo();
    t = __map_poner(t, "v", "");
    tk = __map_poner(tk, a_texto(cnt), t);
    tk = __map_poner(tk, "cnt", cnt + 1);
    retornar tk;
}

numero r = lx("// test\nABC \"hello\" DEF");
imprimir("tokens: ", __map_obtener(r, "cnt"));
