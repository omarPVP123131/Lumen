// examples/compiler/test_parser.nv — Recursive Descent Parser + Lexer + Tests
// Self-contained, no imports. Run: lumen run examples/compiler/test_parser.nv

// ═══════════════════════════════════════════════════════════════
// ── Lexer ──────────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════

funcion numero tokenizar(texto src) {
    numero kw = __map_nuevo();
    kw = __map_poner(kw, "si", 1); kw = __map_poner(kw, "if", 1);
    kw = __map_poner(kw, "sino", 1); kw = __map_poner(kw, "else", 1);
    kw = __map_poner(kw, "mientras", 1); kw = __map_poner(kw, "while", 1);
    kw = __map_poner(kw, "para", 1); kw = __map_poner(kw, "for", 1);
    kw = __map_poner(kw, "funcion", 1); kw = __map_poner(kw, "function", 1);
    kw = __map_poner(kw, "retornar", 1); kw = __map_poner(kw, "return", 1);
    kw = __map_poner(kw, "entero", 1); kw = __map_poner(kw, "texto", 1);
    kw = __map_poner(kw, "booleano", 1); kw = __map_poner(kw, "decimal", 1);
    kw = __map_poner(kw, "numero", 1); kw = __map_poner(kw, "void", 1);
    kw = __map_poner(kw, "verdadero", 1); kw = __map_poner(kw, "true", 1);
    kw = __map_poner(kw, "falso", 1); kw = __map_poner(kw, "false", 1);
    kw = __map_poner(kw, "imprimir", 1); kw = __map_poner(kw, "estructura", 1);
    kw = __map_poner(kw, "importar", 1); kw = __map_poner(kw, "romper", 1);
    kw = __map_poner(kw, "continuar", 1);

    entero n = largo(src);
    entero i = 0;
    numero toks = __map_nuevo();
    entero c = 0;

    mientras (i < n) {
        texto ch = src[i];
        entero cp = __str_ord(ch)[0];

        // Whitespace
        si (cp == 32 || cp == 9 || cp == 10 || cp == 13) {
            i = i + 1; continuar;
        }
        // Comment //
        si (cp == 47 && i + 1 < n) {
            texto nxt = src[i + 1];
            si (nxt == "/") {
                i = i + 2;
                mientras (i < n) {
                    si (src[i] == "\n") { romper; }
                    i = i + 1;
                }
                continuar;
            }
        }
        // String ""
        si (cp == 34) {
            texto s = ""; i = i + 1;
            mientras (i < n) {
                si (src[i] == "\"") { romper; }
                s = s + src[i]; i = i + 1;
            }
            si (i < n) { i = i + 1; }
            numero t = __map_nuevo();
            t = __map_poner(t, "t", 3);
            t = __map_poner(t, "v", s);
            toks = __map_poner(toks, a_texto(c), t);
            c = c + 1; continuar;
        }
        // Number
        si (cp >= 48 && cp <= 57) {
            texto num = "";
            mientras (i < n) {
                si (i < n) {
                    entero dcp = __str_ord(src[i])[0];
                    si (dcp >= 48 && dcp <= 57) {
                        num = num + src[i]; i = i + 1;
                    } sino { romper; }
                }
            }
            si (i < n && src[i] == ".") {
                num = num + "."; i = i + 1;
                mientras (i < n) {
                    entero dcp = __str_ord(src[i])[0];
                    si (dcp >= 48 && dcp <= 57) {
                        num = num + src[i]; i = i + 1;
                    } sino { romper; }
                }
            }
            numero t = __map_nuevo();
            t = __map_poner(t, "t", 2);
            t = __map_poner(t, "v", num);
            toks = __map_poner(toks, a_texto(c), t);
            c = c + 1; continuar;
        }
        // Identifier / Keyword
        si ((cp >= 65 && cp <= 90) || (cp >= 97 && cp <= 122) || cp == 95) {
            texto id = "";
            mientras (i < n) {
                texto cc = src[i];
                entero ccp = __str_ord(cc)[0];
                si ((ccp >= 65 && ccp <= 90) || (ccp >= 97 && ccp <= 122)
                    || (ccp >= 48 && ccp <= 57) || ccp == 95) {
                    id = id + cc; i = i + 1;
                } sino { romper; }
            }
            entero tp = 1;
            numero kwv = __map_obtener(kw, id);
            si (kwv == 1) { tp = 6; }
            numero t = __map_nuevo();
            t = __map_poner(t, "t", tp);
            t = __map_poner(t, "v", id);
            toks = __map_poner(toks, a_texto(c), t);
            c = c + 1; continuar;
        }
        // Operators
        texto op = ch;
        si (i + 1 < n) {
            texto nxt = src[i + 1];
            si (ch == "&" && nxt == "&") { op = "&&"; i = i + 1; }
            si (ch == "|" && nxt == "|") { op = "||"; i = i + 1; }
            si (ch == ">" && nxt == "=") { op = ">="; i = i + 1; }
            si (ch == "<" && nxt == "=") { op = "<="; i = i + 1; }
            si (ch == "!" && nxt == "=") { op = "!="; i = i + 1; }
            si (ch == "=" && nxt == "=") { op = "=="; i = i + 1; }
        }
        numero t = __map_nuevo();
        t = __map_poner(t, "t", 4);
        t = __map_poner(t, "v", op);
        toks = __map_poner(toks, a_texto(c), t);
        c = c + 1; i = i + 1;
    }

    numero t = __map_nuevo();
    t = __map_poner(t, "t", 99);
    t = __map_poner(t, "v", "");
    toks = __map_poner(toks, a_texto(c), t);
    toks = __map_poner(toks, "cnt", c);
    retornar toks;
}

// ═══════════════════════════════════════════════════════════════
// ── Parser State Helpers ───────────────────────────────────────
// ═══════════════════════════════════════════════════════════════

funcion numero _st_tk(numero st) {
    numero pos = __map_obtener(st, "pos");
    numero cnt = __map_obtener(st, "cnt");
    si (pos > cnt) {
        numero t = __map_nuevo();
        t = __map_poner(t, "t", 99);
        t = __map_poner(t, "v", "");
        retornar t;
    }
    retornar __map_obtener(__map_obtener(st, "tokens"), a_texto(pos));
}

funcion numero _st_tt(numero st) {
    numero t = _st_tk(st);
    retornar __map_obtener(t, "t");
}

funcion numero _st_tv(numero st) {
    numero t = _st_tk(st);
    retornar __map_obtener(t, "v");
}

funcion booleano _st_eof(numero st) {
    retornar __map_obtener(st, "pos") > __map_obtener(st, "cnt");
}

funcion numero _st_adv(numero st) {
    numero p = __map_obtener(st, "pos");
    st = __map_poner(st, "pos", p + 1);
    retornar st;
}

funcion booleano _st_ch(numero st, numero tt, texto vv) {
    si (_st_eof(st)) { retornar falso; }
    numero tk = _st_tk(st);
    numero a = __map_obtener(tk, "t");
    numero b = __map_obtener(tk, "v");
    retornar a == tt && a_texto(b) == vv;
}

funcion booleano _st_kw(numero st, texto w) {
    retornar _st_tt(st) == 6 && a_texto(_st_tv(st)) == w;
}

funcion booleano _st_tp(numero st) {
    texto v = a_texto(_st_tv(st));
    retornar _st_tt(st) == 6 && (v == "entero" || v == "texto" ||
           v == "decimal" || v == "booleano" || v == "numero" || v == "void");
}

funcion numero _res(numero st, numero nodo) {
    numero r = __map_nuevo();
    r = __map_poner(r, "st", st);
    r = __map_poner(r, "node", nodo);
    retornar r;
}

// ── Forward ────────────────────────────────────────────────────
funcion numero _parse_expr(numero st);
funcion numero _parse_stmt(numero st);
funcion numero _parse_blk(numero st);

// ═══════════════════════════════════════════════════════════════
// ── Expression ─────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════

funcion numero _parse_pr(numero st) {
    numero tt = _st_tt(st);
    texto tvs = a_texto(_st_tv(st));

    // String literal
    si (tt == 3) {
        st = _st_adv(st);
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "Texto");
        n = __map_poner(n, "v", tvs);
        retornar _res(st, n);
    }
    // Number literal
    si (tt == 2) {
        st = _st_adv(st);
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "Literal");
        n = __map_poner(n, "v", tvs);
        retornar _res(st, n);
    }
    // Bool
    si (tt == 6 && (tvs == "verdadero" || tvs == "true" ||
                     tvs == "falso" || tvs == "false")) {
        st = _st_adv(st);
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "Bool");
        n = __map_poner(n, "v", tvs);
        retornar _res(st, n);
    }
    // Identifier or function call
    si (tt == 1 || (tt == 6 && !_st_tp(st) &&
         tvs != "verdadero" && tvs != "true" &&
         tvs != "falso" && tvs != "false")) {
        texto nm = tvs;
        st = _st_adv(st);
        // function call
        si (_st_ch(st, 5, "(")) {
            st = _st_adv(st);
            numero args = __map_nuevo();
            numero ac = 0;
            mientras (!_st_eof(st)) {
                si (_st_ch(st, 5, ")")) { romper; }
                si (ac > 0) {
                    si (_st_ch(st, 5, ",")) { st = _st_adv(st); }
                }
                numero re = _parse_expr(st);
                numero _en = __map_obtener(re, "node");
                st = __map_obtener(re, "st");
                args = __map_poner(args, a_texto(ac), _en);
                ac = ac + 1;
            }
            st = _st_adv(st);
            args = __map_poner(args, "cnt", ac);
            numero n = __map_nuevo();
            n = __map_poner(n, "tipo", "Call");
            n = __map_poner(n, "callee", nm);
            n = __map_poner(n, "args", args);
            retornar _res(st, n);
        }
        // plain identifier
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "Ident");
        n = __map_poner(n, "nombre", nm);
        retornar _res(st, n);
    }
    // Parenthesized expression
    si (_st_ch(st, 5, "(")) {
        st = _st_adv(st);
        numero re = _parse_expr(st);
        numero _en = __map_obtener(re, "node");
        st = __map_obtener(re, "st");
        st = _st_adv(st);
        retornar _res(st, _en);
    }
    // Unary: - or !
    si (tt == 4 && (tvs == "-" || tvs == "!")) {
        st = _st_adv(st);
        numero re = _parse_pr(st);
        numero _en = __map_obtener(re, "node");
        st = __map_obtener(re, "st");
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "Unary");
        n = __map_poner(n, "op", tvs);
        n = __map_poner(n, "expr", _en);
        retornar _res(st, n);
    }
    // Error recovery
    st = _st_adv(st);
    numero n = __map_nuevo();
    n = __map_poner(n, "tipo", "Literal");
    n = __map_poner(n, "v", "0");
    retornar _res(st, n);
}

funcion entero _prec(texto op) {
    si (op == "||") { retornar 1; }
    si (op == "&&") { retornar 2; }
    si (op == "==" || op == "!=" || op == "<" || op == ">"
        || op == "<=" || op == ">=") { retornar 3; }
    si (op == "+" || op == "-") { retornar 4; }
    si (op == "*" || op == "/" || op == "%") { retornar 5; }
    retornar 0;
}

funcion numero _parse_bin(numero st, entero mp) {
    numero re = _parse_pr(st);
    numero izq = __map_obtener(re, "node");
    st = __map_obtener(re, "st");
    mientras (_st_tt(st) == 4) {
        texto op = a_texto(_st_tv(st));
        entero p = _prec(op);
        si (p < mp) { romper; }
        st = _st_adv(st);
        numero rr = _parse_bin(st, p + 1);
        numero der = __map_obtener(rr, "node");
        st = __map_obtener(rr, "st");
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "Binary");
        n = __map_poner(n, "op", op);
        n = __map_poner(n, "izq", izq);
        n = __map_poner(n, "der", der);
        izq = n;
    }
    retornar _res(st, izq);
}

funcion numero _parse_expr(numero st) {
    retornar _parse_bin(st, 0);
}

// ═══════════════════════════════════════════════════════════════
// ── Block ──────────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════

funcion numero _parse_blk(numero st) {
    st = _st_adv(st); // consume {
    numero stmts = __map_nuevo();
    numero sc = 0;
    mientras (!_st_eof(st)) {
        si (_st_ch(st, 5, "}")) { romper; }
        numero rs = _parse_stmt(st);
        numero sn = __map_obtener(rs, "node");
        st = __map_obtener(rs, "st");
        stmts = __map_poner(stmts, a_texto(sc), sn);
        sc = sc + 1;
    }
    st = _st_adv(st); // consume }
    stmts = __map_poner(stmts, "cnt", sc);
    numero n = __map_nuevo();
    n = __map_poner(n, "tipo", "Block");
    n = __map_poner(n, "cuerpo", stmts);
    retornar _res(st, n);
}

// ═══════════════════════════════════════════════════════════════
// ── Statement ──────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════

funcion numero _parse_stmt(numero st) {
    si (_st_eof(st)) {
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "Vacio");
        retornar _res(st, n);
    }
    numero tt = _st_tt(st);
    texto tvs = a_texto(_st_tv(st));

    // Var decl: tipo nombre [= expr];
    si (tt == 6 && _st_tp(st)) {
        texto tvar = tvs;
        st = _st_adv(st);
        texto nm = a_texto(_st_tv(st));
        st = _st_adv(st);
        numero vl = __map_nuevo();
        vl = __map_poner(vl, "tipo", "Vacio");
        si (_st_ch(st, 4, "=")) {
            st = _st_adv(st);
            numero re = _parse_expr(st);
            vl = __map_obtener(re, "node");
            st = __map_obtener(re, "st");
        }
        si (_st_ch(st, 5, ";")) { st = _st_adv(st); }
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "VarDecl");
        n = __map_poner(n, "nombre", nm);
        n = __map_poner(n, "tipo_var", tvar);
        n = __map_poner(n, "valor", vl);
        retornar _res(st, n);
    }

    // If
    si (tt == 6 && (tvs == "si" || tvs == "if")) {
        st = _st_adv(st);
        numero rc = _parse_expr(st);
        numero cond = __map_obtener(rc, "node");
        st = __map_obtener(rc, "st");
        numero rb = _parse_blk(st);
        numero cuerpo = __map_obtener(rb, "node");
        st = __map_obtener(rb, "st");
        numero _else = __map_nuevo();
        _else = __map_poner(_else, "tipo", "Vacio");
        si (_st_kw(st, "sino") || _st_kw(st, "else")) {
            st = _st_adv(st);
            si (_st_kw(st, "si") || _st_kw(st, "if")) {
                numero rs = _parse_stmt(st);
                _else = __map_obtener(rs, "node");
                st = __map_obtener(rs, "st");
            } sino {
                numero rb2 = _parse_blk(st);
                _else = __map_obtener(rb2, "node");
                st = __map_obtener(rb2, "st");
            }
        }
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "If");
        n = __map_poner(n, "cond", cond);
        n = __map_poner(n, "cuerpo", cuerpo);
        n = __map_poner(n, "sino", _else);
        retornar _res(st, n);
    }

    // While
    si (tt == 6 && (tvs == "mientras" || tvs == "while")) {
        st = _st_adv(st);
        numero rc = _parse_expr(st);
        numero cond = __map_obtener(rc, "node");
        st = __map_obtener(rc, "st");
        numero rb = _parse_blk(st);
        numero cuerpo = __map_obtener(rb, "node");
        st = __map_obtener(rb, "st");
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "While");
        n = __map_poner(n, "cond", cond);
        n = __map_poner(n, "cuerpo", cuerpo);
        retornar _res(st, n);
    }

    // Return
    si (tt == 6 && (tvs == "retornar" || tvs == "return")) {
        st = _st_adv(st);
        numero vl = __map_nuevo();
        vl = __map_poner(vl, "tipo", "Vacio");
        si (!_st_ch(st, 5, ";") && !_st_ch(st, 5, "}") && !_st_eof(st)) {
            numero re = _parse_expr(st);
            vl = __map_obtener(re, "node");
            st = __map_obtener(re, "st");
        }
        si (_st_ch(st, 5, ";")) { st = _st_adv(st); }
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "Return");
        n = __map_poner(n, "valor", vl);
        retornar _res(st, n);
    }

    // Break / Continue
    si (tt == 6 && (tvs == "romper" || tvs == "break")) {
        st = _st_adv(st);
        si (_st_ch(st, 5, ";")) { st = _st_adv(st); }
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "Break");
        retornar _res(st, n);
    }
    si (tt == 6 && tvs == "continuar") {
        st = _st_adv(st);
        si (_st_ch(st, 5, ";")) { st = _st_adv(st); }
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "Continue");
        retornar _res(st, n);
    }

    // Import
    si (tt == 6 && (tvs == "importar" || tvs == "import")) {
        st = _st_adv(st);
        texto rt = a_texto(_st_tv(st));
        st = _st_adv(st);
        si (_st_ch(st, 5, ";")) { st = _st_adv(st); }
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "Import");
        n = __map_poner(n, "ruta", rt);
        retornar _res(st, n);
    }

    // Assignment or expression
    si (tt == 1 || tt == 6) {
        texto nm = a_texto(_st_tv(st));
        numero tokns = __map_obtener(st, "tokens");
        numero pos = __map_obtener(st, "pos");
        numero nxt = __map_obtener(tokns, a_texto(pos + 1));
        numero nt = __map_obtener(nxt, "t");
        texto nv = a_texto(__map_obtener(nxt, "v"));
        si (nt == 4 && nv == "=") {
            st = _st_adv(st);
            st = _st_adv(st);
            numero re = _parse_expr(st);
            numero vl = __map_obtener(re, "node");
            st = __map_obtener(re, "st");
            si (_st_ch(st, 5, ";")) { st = _st_adv(st); }
            numero n = __map_nuevo();
            n = __map_poner(n, "tipo", "Assign");
            n = __map_poner(n, "nombre", nm);
            n = __map_poner(n, "valor", vl);
            retornar _res(st, n);
        }
        numero re = _parse_expr(st);
        numero ex = __map_obtener(re, "node");
        st = __map_obtener(re, "st");
        si (_st_ch(st, 5, ";")) { st = _st_adv(st); }
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "ExprStmt");
        n = __map_poner(n, "expr", ex);
        retornar _res(st, n);
    }

    // Fallback expression
    si (!_st_eof(st)) {
        numero re = _parse_expr(st);
        numero ex = __map_obtener(re, "node");
        st = __map_obtener(re, "st");
        si (_st_ch(st, 5, ";")) { st = _st_adv(st); }
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "ExprStmt");
        n = __map_poner(n, "expr", ex);
        retornar _res(st, n);
    }
    numero n = __map_nuevo();
    n = __map_poner(n, "tipo", "Vacio");
    retornar _res(st, n);
}

// ═══════════════════════════════════════════════════════════════
// ── Declaration ────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════

funcion numero _parse_decl(numero st) {
    si (_st_eof(st)) {
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "Vacio");
        retornar _res(st, n);
    }
    numero tt = _st_tt(st);
    texto tvs = a_texto(_st_tv(st));

    si (tt == 6 && (tvs == "funcion" || tvs == "function")) {
        st = _st_adv(st);
        texto tr = "void";
        si (_st_tp(st)) {
            tr = a_texto(_st_tv(st));
            st = _st_adv(st);
        }
        texto nm = a_texto(_st_tv(st));
        st = _st_adv(st);
        st = _st_adv(st); // consume (
        numero prms = __map_nuevo();
        numero pc = 0;
        mientras (!_st_eof(st)) {
            si (_st_ch(st, 5, ")")) { romper; }
            si (pc > 0) {
                si (_st_ch(st, 5, ",")) { st = _st_adv(st); }
            }
            texto pt = a_texto(_st_tv(st));
            st = _st_adv(st);
            texto pn = a_texto(_st_tv(st));
            st = _st_adv(st);
            numero pm = __map_nuevo();
            pm = __map_poner(pm, "nombre", pn);
            pm = __map_poner(pm, "tipo", pt);
            prms = __map_poner(prms, a_texto(pc), pm);
            pc = pc + 1;
        }
        st = _st_adv(st); // consume )
        prms = __map_poner(prms, "cnt", pc);
        numero rb = _parse_blk(st);
        numero bd = __map_obtener(rb, "node");
        st = __map_obtener(rb, "st");
        numero n = __map_nuevo();
        n = __map_poner(n, "tipo", "Func");
        n = __map_poner(n, "nombre", nm);
        n = __map_poner(n, "tipo_ret", tr);
        n = __map_poner(n, "params", prms);
        n = __map_poner(n, "cuerpo", bd);
        retornar _res(st, n);
    }
    retornar _parse_stmt(st);
}

// ═══════════════════════════════════════════════════════════════
// ── Program ────────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════

funcion numero _parse_prog(numero st) {
    numero prog = __map_nuevo();
    prog = __map_poner(prog, "tipo", "Programa");
    numero stmts = __map_nuevo();
    numero sc = 0;
    mientras (!_st_eof(st)) {
        si (_st_ch(st, 5, ";") || _st_ch(st, 5, "}")) {
            st = _st_adv(st);
            continuar;
        }
        numero tt = _st_tt(st);
        texto tvs = a_texto(_st_tv(st));
        numero r;
        si (tt == 6 && (tvs == "funcion" || tvs == "function" ||
                         tvs == "estructura" || tvs == "importar" ||
                         tvs == "import")) {
            r = _parse_decl(st);
        } sino {
            r = _parse_stmt(st);
        }
        st = __map_obtener(r, "st");
        stmts = __map_poner(stmts, a_texto(sc), __map_obtener(r, "node"));
        sc = sc + 1;
    }
    stmts = __map_poner(stmts, "cnt", sc);
    prog = __map_poner(prog, "cuerpo", stmts);
    retornar _res(st, prog);
}

funcion numero parser_parse(numero tokens) {
    numero st = __map_nuevo();
    st = __map_poner(st, "tokens", tokens);
    st = __map_poner(st, "pos", 0);
    st = __map_poner(st, "cnt", __map_obtener(tokens, "cnt"));
    numero r = _parse_prog(st);
    retornar __map_obtener(r, "node");
}

// ═══════════════════════════════════════════════════════════════
// ── AST Printer ─────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════

funcion texto ast_prn(numero nodo, entero prof) {
    texto tp = a_texto(__map_obtener(nodo, "tipo"));
    texto pad = "";
    entero i = 0;
    mientras (i < prof) { pad = pad + "  "; i = i + 1; }

    si (tp == "Programa") {
        texto r = pad + "Programa\n";
        numero stmts = __map_obtener(nodo, "cuerpo");
        numero sc = __map_obtener(stmts, "cnt");
        numero j = 0;
        mientras (j < sc) {
            r = r + ast_prn(__map_obtener(stmts, a_texto(j)), prof + 1);
            j = j + 1;
        }
        retornar r;
    }
    si (tp == "VarDecl") {
        texto r = pad + "VarDecl(";
        r = r + a_texto(__map_obtener(nodo, "tipo_var"));
        r = r + " " + a_texto(__map_obtener(nodo, "nombre"));
        numero vl = __map_obtener(nodo, "valor");
        si (a_texto(__map_obtener(vl, "tipo")) != "Vacio") {
            r = r + " = " + ast_prn(vl, 0);
        }
        retornar r + ")\n";
    }
    si (tp == "Assign") {
        texto r = pad + "Assign(";
        r = r + a_texto(__map_obtener(nodo, "nombre"));
        r = r + " = " + ast_prn(__map_obtener(nodo, "valor"), 0);
        retornar r + ")\n";
    }
    si (tp == "If") {
        texto r = pad + "If\n";
        r = r + pad + "  cond: ";
        r = r + ast_prn(__map_obtener(nodo, "cond"), 0);
        r = r + pad + "  cuerpo:\n";
        r = r + ast_prn(__map_obtener(nodo, "cuerpo"), prof + 2);
        numero _else = __map_obtener(nodo, "sino");
        si (a_texto(__map_obtener(_else, "tipo")) != "Vacio") {
            r = r + pad + "  sino:\n";
            r = r + ast_prn(_else, prof + 2);
        }
        retornar r;
    }
    si (tp == "While") {
        texto r = pad + "While\n";
        r = r + pad + "  cond: ";
        r = r + ast_prn(__map_obtener(nodo, "cond"), 0);
        r = r + pad + "  cuerpo:\n";
        r = r + ast_prn(__map_obtener(nodo, "cuerpo"), prof + 2);
        retornar r;
    }
    si (tp == "Return") {
        numero vl = __map_obtener(nodo, "valor");
        si (a_texto(__map_obtener(vl, "tipo")) == "Vacio") {
            retornar pad + "Return\n";
        }
        retornar pad + "Return(" + ast_prn(vl, 0) + ")\n";
    }
    si (tp == "Func") {
        texto r = pad + "Func(";
        r = r + a_texto(__map_obtener(nodo, "nombre"));
        r = r + " -> " + a_texto(__map_obtener(nodo, "tipo_ret"));
        r = r + ")\n";
        numero prms = __map_obtener(nodo, "params");
        numero pc = __map_obtener(prms, "cnt");
        numero j = 0;
        mientras (j < pc) {
            numero p = __map_obtener(prms, a_texto(j));
            r = r + pad + "  param: ";
            r = r + a_texto(__map_obtener(p, "tipo"));
            r = r + " " + a_texto(__map_obtener(p, "nombre"));
            r = r + "\n";
            j = j + 1;
        }
        r = r + ast_prn(__map_obtener(nodo, "cuerpo"), prof + 1);
        retornar r;
    }
    si (tp == "Block") {
        texto r = pad + "Block\n";
        numero stmts = __map_obtener(nodo, "cuerpo");
        numero sc = __map_obtener(stmts, "cnt");
        numero j = 0;
        mientras (j < sc) {
            r = r + ast_prn(__map_obtener(stmts, a_texto(j)), prof + 1);
            j = j + 1;
        }
        retornar r;
    }
    si (tp == "Call") {
        texto cl = a_texto(__map_obtener(nodo, "callee"));
        numero args = __map_obtener(nodo, "args");
        numero ac = __map_obtener(args, "cnt");
        texto r = pad + "Call(" + cl;
        numero j = 0;
        mientras (j < ac) {
            r = r + " " + ast_prn(__map_obtener(args, a_texto(j)), 0);
            j = j + 1;
        }
        retornar r + ")\n";
    }
    si (tp == "Binary") {
        texto r = pad + "Binary(";
        r = r + ast_prn(__map_obtener(nodo, "izq"), 0);
        r = r + " " + a_texto(__map_obtener(nodo, "op")) + " ";
        r = r + ast_prn(__map_obtener(nodo, "der"), 0);
        retornar r + ")\n";
    }
    si (tp == "Unary") {
        texto r = pad + "Unary(";
        r = r + a_texto(__map_obtener(nodo, "op"));
        r = r + ast_prn(__map_obtener(nodo, "expr"), 0);
        retornar r + ")\n";
    }
    si (tp == "Ident") { retornar a_texto(__map_obtener(nodo, "nombre")); }
    si (tp == "Literal") { retornar a_texto(__map_obtener(nodo, "v")); }
    si (tp == "Texto") {
        retornar "\"" + a_texto(__map_obtener(nodo, "v")) + "\"";
    }
    si (tp == "Bool") { retornar a_texto(__map_obtener(nodo, "v")); }
    si (tp == "ExprStmt") {
        retornar pad + ast_prn(__map_obtener(nodo, "expr"), prof);
    }
    si (tp == "Import") {
        retornar pad + "Import(" + a_texto(__map_obtener(nodo, "ruta")) + ")\n";
    }
    si (tp == "Break") { retornar pad + "Break\n"; }
    si (tp == "Continue") { retornar pad + "Continue\n"; }
    si (tp == "Vacio") { retornar ""; }
    retornar pad + tp + "(?)\n";
}

// ═══════════════════════════════════════════════════════════════
// ── Tests ───────────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════

funcion void probar(texto nm, texto src) {
    imprimir("");
    imprimir("=== ", nm, " ===");
    imprimir("Source: ", src);
    numero toks = tokenizar(src);
    numero ast = parser_parse(toks);
    texto sal = ast_prn(ast, 0);
    imprimir(sal);
}

probar("Test 1: VarDecl", "entero x = 42;");
probar("Test 2: Call", "imprimir(\"hola\");");
probar("Test 3: Assign", "x = 10;");
probar("Test 4: Return", "retornar x;");
probar("Test 5: If", "si x > 5 { imprimir(x); }");
probar("Test 6: Func",
    "funcion entero suma(entero a, entero b) { retornar a + b; }");
probar("Test 7: If-Else",
    "si x > 0 { imprimir(x); } sino { imprimir(0); }");
probar("Test 8: While", "mientras x > 0 { x = x - 1; }");
probar("Test 9: Multi", "entero x = 42; texto y = \"ok\";");

imprimir("");
imprimir("=== TODAS LAS PRUEBAS COMPLETADAS ===");
