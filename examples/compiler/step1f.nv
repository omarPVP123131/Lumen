// step1f.nv — add lowercase support + full alphanumeric
funcion numero lx(texto s) {
    lista<entero> codes = __str_ord(s);
    entero n = largo(codes);
    entero idx = 0;
    numero tk = __map_nuevo();
    entero cnt = 0;
    
    mientras idx < n {
        entero cp = codes[idx];
        si cp == 32 || cp == 9 { idx = idx + 1; continuar; }
        si cp == 10 { idx = idx + 1; continuar; }
        si cp == 47 {
            si idx + 1 < n && codes[idx + 1] == 47 {
                mientras idx < n && codes[idx] != 10 { idx = idx + 1; }
                continuar;
            }
        }
        si cp == 34 {
            idx = idx + 1;
            mientras idx < n && codes[idx] != 34 { idx = idx + 1; }
            si idx < n { idx = idx + 1; }
            cnt = cnt + 1;
            continuar;
        }
        si cp >= 48 && cp <= 57 {
            mientras idx < n && codes[idx] >= 48 && codes[idx] <= 57 { idx = idx + 1; }
            cnt = cnt + 1;
            continuar;
        }
        si cp >= 65 {
            mientras idx < n {
                entero c2 = codes[idx];
                si c2 >= 65 { idx = idx + 1; }
                sino { romper; }
            }
            cnt = cnt + 1;
        } sino {
            idx = idx + 1;
        }
    }
    cnt = cnt + 1;
    numero tk2 = __map_nuevo();
    tk2 = __map_poner(tk2, "cnt", cnt);
    retornar tk2;
}

numero r = lx("// test\nABC 42 \"hi\" def_1  ");
imprimir("tokens: ", __map_obtener(r, "cnt"));
