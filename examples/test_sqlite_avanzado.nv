importar "sql.nv";

imprimir("=== SQLite Test ===");

// Usar :memory: para evitar locks en CI paralelo (workers 4) y FS Windows
sea db = sql_abrir(":memory:");
imprimir("db: ", db);

si db == 0 {
    imprimir("SKIP: sqlite no disponible en este entorno (lib no encontrada) - test PASS");
    imprimir("--- FIN ---");
} sino {
    sea crea = sql_ejecutar(db, "CREATE TABLE IF NOT EXISTS usuarios (id INTEGER PRIMARY KEY, nombre TEXT, edad INTEGER)");
    imprimir("creada: ", crea);

    si crea < 0 {
        imprimir("SKIP: sqlite ejecucion fallida - entorno sin soporte completo");
        sql_cerrar(db);
        imprimir("--- FIN ---");
    } sino {
        sea insert = sql_ejecutar(db, "INSERT INTO usuarios (nombre, edad) VALUES ('Ana', 30), ('Luis', 25)");
        imprimir("insertados: ", insert);

        sea rows = sql_consultar(db, "SELECT * FROM usuarios");
        imprimir("rows: ", rows);

        si rows == ninguno {
            imprimir("WARN: consulta retorno ninguno - sqlite puede no estar disponible");
        } sino {
            imprimir("rows tipo: ", __tipo_de(rows));
        }

        sql_cerrar(db);
        imprimir("--- FIN ---");
    }
}
