importar ingles;

function array<string> parsear_csv(string linea) {
    array<string> res = [];
    string actual = "";
    integer i = 0;
    while (i < __str_longitud(linea)) {
        if (linea[i] == ",") {
            res.agregar(actual);
            actual = "";
        } else {
            actual = actual + linea[i];
        }
        i = i + 1;
    }
    res.agregar(actual);
    return res;
}

array<string> campos = parsear_csv("nombre,edad,ciudad");
print(campos[0]);
print(campos[1]);
print(campos[2]);
