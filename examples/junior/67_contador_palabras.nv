importar ingles;

function integer contar_palabras(string s) {
    array<string> partes = __str_dividir(s, " ");
    integer total = 0;
    integer i = 0;
    while (i < partes.largo()) {
        if (partes[i] != "") {
            total = total + 1;
        }
        i = i + 1;
    }
    return total;
}

print(contar_palabras("Hola mundo Lumen"));
print(contar_palabras("uno dos tres cuatro"));
