importar ingles;

function integer buscar(array<integer> arr, integer obj) {
    integer izq = 0;
    integer der = arr.largo() - 1;
    while (izq <= der) {
        integer medio = (izq + der) / 2;
        if (arr[medio] == obj) {
            return medio;
        }
        if (arr[medio] < obj) {
            izq = medio + 1;
        } else {
            der = medio - 1;
        }
    }
    return -1;
}

array<integer> datos = [1, 3, 5, 7, 9];
print(buscar(datos, 5));
print(buscar(datos, 8));
