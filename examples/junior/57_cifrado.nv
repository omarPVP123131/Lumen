importar ingles;

function string cifrar(string s, integer k) {
    string r = "";
    integer i = 0;
    while (i < __str_longitud(s)) {
        string letra = s[i];
        integer codigo = 0;
        r = r + a_texto(codigo + k);
        i = i + 1;
    }
    return r;
}

string msg = "abc";
