importar ingles;

integer a = function(integer x) {
    return function(integer y) {
        return x + y;
    }(10);
}(5);
print(a);

string b = function(string s) {
    return function(string t) {
        return s + " " + t;
    }("Mundo");
}("Hola");
print(b);

integer c = function(integer n) {
    if (n <= 1) {
        return 1;
    }
    return n * function(integer m) { return m; }(n);
}(4);
print(c);
