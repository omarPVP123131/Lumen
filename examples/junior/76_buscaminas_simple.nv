importar ingles;

function integer contar_minas(array<array<integer>> campo) {
    integer total = 0;
    integer i = 0;
    while (i < campo.largo()) {
        integer j = 0;
        while (j < campo[i].largo()) {
            if (campo[i][j] == -1) {
                total = total + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return total;
}

array<array<integer>> campo = [[0, -1, 0], [0, 0, 0], [-1, 0, 0]];
print(contar_minas(campo));
