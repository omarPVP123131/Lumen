importar ingles;

function string jugar(integer j1, integer j2) {
    if (j1 == j2) {
        return "Empate";
    }
    if ((j1 == 1 && j2 == 3) || (j1 == 2 && j2 == 1) || (j1 == 3 && j2 == 2)) {
        return "Gana Jugador 1";
    }
    return "Gana Jugador 2";
}

print(jugar(1, 2));
print(jugar(3, 1));
print(jugar(2, 2));
