// ==========================================
// coleccion_real.nv — Collections (real-world)
// Uso: lumen run -L stdlib/ examples/real/coleccion_real.nv
// ==========================================
importar "coleccion.nv";
importar "texto.nv";

imprimir("=== Coleccion REAL: Real-World Collections ===");

// ── Example 1: Word Frequency Counter with Map ──
imprimir("--- Ej 1: Contador de Frecuencia de Palabras ---");

// Build word frequency for first phrase
sea freq1 = coleccion_mapa_nuevo();
sea texto1 = "Lúmen es un lenguaje de programación Lúmen es rápido y moderno";
lista<texto> palabras1 = texto_dividir(texto_recortar(texto1), " ");

entero idx1 = 0;
mientras idx1 < palabras1.largo() {
    sea palabra = texto_minusculas(texto_recortar(palabras1[idx1]));
    si palabra != "" {
        numero cuenta = 1;
        si coleccion_mapa_contiene(freq1, palabra) {
            numero actual = coleccion_mapa_obtener(freq1, palabra);
            cuenta = actual + 1;
        }
        freq1 = coleccion_mapa_poner(freq1, palabra, cuenta);
    }
    idx1 = idx1 + 1;
}

imprimir("Frase 1: \"", texto1, "\"");
imprimir("  palabras únicas: ", coleccion_mapa_longitud(freq1));
si coleccion_mapa_contiene(freq1, "lúmen") {
    imprimir("  'lúmen' aparece: ", coleccion_mapa_obtener(freq1, "lúmen"));
}
si coleccion_mapa_contiene(freq1, "es") {
    imprimir("  'es' aparece:    ", coleccion_mapa_obtener(freq1, "es"));
}
si coleccion_mapa_contiene(freq1, "y") {
    imprimir("  'y' aparece:     ", coleccion_mapa_obtener(freq1, "y"));
}

// Build word frequency for second phrase
imprimir("");
sea freq2 = coleccion_mapa_nuevo();
sea texto2 = "el sol brilla y el día es bello el sol calienta";
lista<texto> palabras2 = texto_dividir(texto_recortar(texto2), " ");

entero idx2 = 0;
mientras idx2 < palabras2.largo() {
    sea palabra = texto_minusculas(texto_recortar(palabras2[idx2]));
    si palabra != "" {
        numero cuenta = 1;
        si coleccion_mapa_contiene(freq2, palabra) {
            numero actual = coleccion_mapa_obtener(freq2, palabra);
            cuenta = actual + 1;
        }
        freq2 = coleccion_mapa_poner(freq2, palabra, cuenta);
    }
    idx2 = idx2 + 1;
}

imprimir("Frase 2: \"", texto2, "\"");
imprimir("  palabras únicas: ", coleccion_mapa_longitud(freq2));
si coleccion_mapa_contiene(freq2, "el") {
    imprimir("  'el' aparece: ", coleccion_mapa_obtener(freq2, "el"));
}
si coleccion_mapa_contiene(freq2, "sol") {
    imprimir("  'sol' aparece: ", coleccion_mapa_obtener(freq2, "sol"));
}

// ── Example 2: Task Queue with Deque ──
imprimir("--- Ej 2: Cola de Tareas (Deque) ---");

sea cola = coleccion_deque_nuevo();
// Add tasks (high priority at front, normal at back)
cola = coleccion_deque_agregar_final(cola, "Tarea normal: backup");
cola = coleccion_deque_agregar_final(cola, "Tarea normal: reporte");
cola = coleccion_deque_agregar_frente(cola, "Tarea urgente: apagar incendio");
cola = coleccion_deque_agregar_final(cola, "Tarea normal: limpieza");
cola = coleccion_deque_agregar_frente(cola, "Tarea urgente: error crítico");

imprimir("Procesando tareas:");
imprimir("  1. ", coleccion_deque_quitar_frente(cola));
imprimir("  2. ", coleccion_deque_quitar_frente(cola));
imprimir("  3. ", coleccion_deque_quitar_frente(cola));
imprimir("  4. ", coleccion_deque_quitar_frente(cola));
imprimir("  5. ", coleccion_deque_quitar_frente(cola));

// ── Example 3: Top-K Elements with Heap ──
imprimir("--- Ej 3: Top-K con Montículo ---");

lista<numero> scores = [78, 92, 45, 88, 95, 67, 83, 91, 74, 99];
imprimir("Puntajes: 78, 92, 45, 88, 95, 67, 83, 91, 74, 99");

sea heap = coleccion_monticulo_nuevo();
entero idx = 0;
mientras idx < scores.largo() {
    heap = coleccion_monticulo_agregar(heap, scores[idx]);
    idx = idx + 1;
}

imprimir("Top 3 puntajes:");
imprimir("  #1: ", coleccion_monticulo_quitar(heap));
imprimir("  #2: ", coleccion_monticulo_quitar(heap));
imprimir("  #3: ", coleccion_monticulo_quitar(heap));

imprimir("--- FIN COLECCION REAL ---");
