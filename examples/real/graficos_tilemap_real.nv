// ==========================================
// graficos_tilemap_real.nv — Tilemap (real-world)
// Tests: map generator, path checker, collision grid
// Uso: lumen run -L stdlib/ examples/real/graficos_tilemap_real.nv
// ==========================================

imprimir("=== Graficos Tilemap REAL: Map Generation ===");

// ── Ej 1: Procedural Map Generator ──
// Ej 1: Generate random terrain map
imprimir("--- Ej 1: Generador de Mapas Procedural ---");
funcion lista<entero> generar_mapa(entero w, entero h) {
    lista<entero> m = [];
    entero total = w * h;
    entero i = 0;
    mientras i < total {
        // Simple deterministic pattern: use position to decide tile
        entero x = i % w;
        entero y = i / w;
        entero tile = 0;
        // Border = stone (3)
        si x == 0 { tile = 3; }
        si y == 0 { tile = 3; }
        si x == w - 1 { tile = 3; }
        si y == h - 1 { tile = 3; }
        // Interior = grass (2)
        si tile == 0 { tile = 2; }
        // Some water patches using position math
        si (x + y) % 5 == 0 { si tile == 2 { tile = 4; } }
        // Some rock clusters
        si (x * 3 + y * 7) % 11 == 0 { tile = 3; }
        m.agregar(tile);
        i = i + 1;
    }
    retornar m;
}
lista<entero> map_gen = generar_mapa(6, 5);
imprimir("Mapa generado 6x5:");
entero y = 0;
mientras y < 5 {
    texto fila = "";
    entero x = 0;
    mientras x < 6 {
        entero t = map_gen[y * 6 + x];
        texto ch = ".";
        si t == 1 { ch = "T"; }  // tierra
        si t == 2 { ch = "C"; }  // cesped
        si t == 3 { ch = "#"; }  // piedra
        si t == 4 { ch = "~"; }  // agua
        fila = fila + ch;
        x = x + 1;
    }
    imprimir(fila);
    y = y + 1;
}

// ── Ej 2: Path Checker (A* simplified) ──
// Ej 2: Check if a straight path exists between two points
imprimir("--- Ej 2: Verificador de Camino Recto ---");
funcion booleano camino_libre(lista<entero> m, entero map_w, entero x1, entero y1, entero x2, entero y2) {
    // Check if straight line has no solid tiles (>0)
    entero dx = x2 - x1;
    si dx < 0 { dx = -dx; }
    entero dy = y2 - y1;
    si dy < 0 { dy = -dy; }
    entero steps = dx;
    si dy > dx { steps = dy; }
    si steps == 0 { steps = 1; }
    entero i = 0;
    mientras i < steps + 1 {
        entero cx = x1 + (x2 - x1) * i / steps;
        entero cy = y1 + (y2 - y1) * i / steps;
        si cx < 0 { retornar falso; }
        si cy < 0 { retornar falso; }
        si cx > map_w - 1 { retornar falso; }
        si cy > map_w - 1 { retornar falso; }
        entero t = m[cy * map_w + cx];
        si t == 3 { retornar falso; }  // stone blocks path
        i = i + 1;
    }
    retornar verdadero;
}
imprimir("Camino (0,0)->(5,4) libre? ", camino_libre(map_gen, 6, 0, 0, 5, 4));
imprimir("Camino (1,1)->(3,3) libre? ", camino_libre(map_gen, 6, 1, 1, 3, 3));
imprimir("Camino (0,2)->(5,2) libre? ", camino_libre(map_gen, 6, 0, 2, 5, 2));

// ── Ej 3: Collision Grid Optimizer ──
// Ej 3: Build collision grid for fast lookups
imprimir("--- Ej 3: Grilla de Colision Optimizada ---");
funcion lista<lista<booleano>> grilla_colision(lista<entero> m, entero w, entero h) {
    lista<lista<booleano>> g = [];
    entero i = 0;
    mientras i < h {
        lista<booleano> fila = [];
        entero j = 0;
        mientras j < w {
            fila.agregar(m[i * w + j) > 0];
            j = j + 1;
        }
        g.agregar(fila);
        i = i + 1;
    }
    retornar g;
}
lista<lista<booleano>> grilla = grilla_colision(map_gen, 6, 5);
imprimir("Grilla de colision 6x5 (S=solido, .=vacio):");
entero gy = 0;
mientras gy < 5 {
    texto fila = "";
    entero gx = 0;
    mientras gx < 6 {
        si grilla[gy][gx] { fila = fila + "S"; } sino { fila = fila + "."; }
        gx = gx + 1;
    }
    imprimir(fila);
    gy = gy + 1;
}
// Count solid cells
entero solidos = 0;
entero ci = 0;
mientras ci < largo(map_gen) {
    si map_gen[ci] > 0 { solidos = solidos + 1; }
    ci = ci + 1;
}
imprimir("Celdas solidas: ", solidos, "/", largo(map_gen));

imprimir("--- FIN GRAFICOS TILEMAP REAL ---");
