// Headless/CI guard — demo requiere display/SDL2/consola interactiva
importar "sistema.nv";
texto _ci_guard = sistema_env_obtener("CI");
texto _hl_guard = sistema_env_obtener("LUMEN_HEADLESS");
si _ci_guard != "" || _hl_guard == "1" {
    imprimir("Headless/CI detectado — demo omitida (requiere display)");
    retornar;
}
// Ejemplo interactivo: Reloj en tiempo real con JS bridges
// Muestra la hora actual actualizándose cada segundo

imprimir("=== Reloj LÚMEN ===");

// Crear elemento para el reloj
__js_eval("
  if (!document.getElementById('lumenClock')) {
    const d = document.createElement('div');
    d.id = 'lumenClock';
    d.style.fontSize = '48px';
    d.style.fontFamily = 'monospace';
    d.style.textAlign = 'center';
    d.style.padding = '20px';
    d.style.color = '#89b4fa';
    d.style.background = '#1e1e2e';
    d.style.border = '1px solid #444';
    d.style.borderRadius = '8px';
    d.style.margin = '10px auto';
    d.style.maxWidth = '300px';
    d.textContent = '--:--:--';
    document.body.appendChild(d);
  }
");

imprimir("Reloj iniciado. Actualizando cada segundo...");
imprimir("Presiona Ctrl+C en consola para detener (en servidor).");

// Bucle del reloj
booleano running = verdadero;
mientras running {
  // Obtener hora actual via JS
  texto timeStr = __js_call("eval", "
    const now = new Date();
    const h = String(now.getHours()).padStart(2,'0');
    const m = String(now.getMinutes()).padStart(2,'0');
    const s = String(now.getSeconds()).padStart(2,'0');
    h + ':' + m + ':' + s;
  ");
  
  // Actualizar display
  __js_call("eval", "document.getElementById('lumenClock').textContent = '" + timeStr + "';");
  
  // Mostrar en consola LÚMEN también
  imprimir(timeStr);
  
  // Esperar 1 segundo (1000 ms)
  __coro_ceder();
  // Nota: __coro_ceder cede control; en VM Rust usa sleep
  // Para demo, usamos loop con cedida
}

// Limpiar al salir
__js_call("eval", "document.getElementById('lumenClock').remove();");
imprimir("Reloj detenido.");
