importar "red.nv";

imprimir("=== Red Test ===");

// Inicializar Winsock manualmente primero
sea w = __ffi_cargar("ws2_32.dll");
imprimir("w: ", w);
sea wsa = __ffi_asignar(400);
sea r = __ffi_llamar(w, "WSAStartup", "entero,entero", [514, wsa], "entero");
imprimir("WSAStartup: ", r);
__ffi_liberar(wsa, 400);

// Socket
sea fd = red_socket();
imprimir("socket: ", fd);

imprimir("--- FIN ---");
