// ==========================================
// sistema_jr.nv — System operations (junior)
// Uso: lumen run -L stdlib/ examples/jr/sistema_jr.nv
// ==========================================
importar "sistema.nv";

imprimir("=== Sistema JR: Environment & Path Basics ===");

// ── Example 1: List Environment Variables ──
imprimir("--- Ej 1: List Environment Variables ---");
sea vars = __env_listar();
imprimir("Total env vars: ", vars.largo());
imprimir("Primera var:    ", vars[0]);

// ── Example 2: Path Join ──
imprimir("--- Ej 2: Path Join ---");
sea ruta1 = sistema_path_unir("C:\\Users", "Documents");
imprimir("path_unir:    ", ruta1);
sea ruta2 = sistema_path_join("carpeta", "subcarpeta");
imprimir("path_join(en):", ruta2);

sea ruta3 = sistema_path_unir(ruta1, "archivo.txt");
imprimir("ruta completa:", ruta3);

// ── Example 3: Get Environment Variable ──
imprimir("--- Ej 3: Get Env Variable ---");
sistema_env_asignar("LUMEN_JR_TEST", "funciona_jr");
sea valor = sistema_env_obtener("LUMEN_JR_TEST");
imprimir("LUMEN_JR_TEST = ", valor);

// Get common system paths
sea path_var = sistema_env_obtener("PATH");
imprimir("PATH exists:    ", path_var.largo() > 0);

sea home = sistema_env_obtener("USERPROFILE");
imprimir("USERPROFILE:    ", home);

imprimir("--- FIN SISTEMA JR ---");
