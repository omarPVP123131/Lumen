// ==========================================
// graficos_canvas_jr.nv — Canvas 2D (junior)
// Tests: circle params, line math, pixel check
// Uso: lumen run -L stdlib/ examples/jr/graficos_canvas_jr.nv
// ==========================================

imprimir("=== Graficos Canvas JR: 2D Primitives ===");

// Ej 1: Circle Midpoint Algorithm
imprimir("--- Ej 1: Algoritmo de Circulo ---");
entero radio = 5;
entero decision = 3 - 2 * radio;
imprimir("Radio=", radio, " decision_inicial=", decision);
entero cx = 0;
entero cy = radio;
imprimir("Paso 0: x=", cx, " y=", cy);
cx = 1;
decision = decision + 4 * 0 + 6;
imprimir("Paso 1: x=", cx, " y=", cy, " (horizontal, d=", decision, ")");
si decision > 0 {
    cy = cy - 1;
    decision = decision + 4 * (cx - 1 - cy) + 10;
    imprimir("Paso 2: x=", cx + 1, " y=", cy, " (diagonal)");
}
imprimir("8 puntos simetricos se dibujan por cada paso");

// Ej 2: Bresenham Line
imprimir("--- Ej 2: Linea Bresenham ---");
entero lx1 = 0; entero ly1 = 0;
entero lx2 = 6; entero ly2 = 4;
entero ldx = lx2 - lx1;
entero ldy = ly2 - ly1;
si ldx < 0 { ldx = -ldx; }
si ldy < 0 { ldy = -ldy; }
entero lerr = ldx - ldy;
imprimir("Linea (0,0)->(6,4): dx=", ldx, " dy=", ldy, " err=", lerr);
imprimir("Muestreo: (0,0) (1,1) (2,1) (3,2) (4,2) (5,3) (6,4)");

// Ej 3: Color Validation
imprimir("--- Ej 3: Colores RGB ---");
imprimir("Formato: rgba(rojo, verde, azul, alpha)");
imprimir("  Rojo:   rgba(255, 0, 0, 255)");
imprimir("  Verde:  rgba(0, 255, 0, 255)");
imprimir("  Azul:   rgba(0, 0, 255, 255)");
imprimir("  Blanco: rgba(255, 255, 255, 255)");
imprimir("  Negro:  rgba(0, 0, 0, 255)");
imprimir("Canales validos: 0 a 255");

imprimir("--- FIN GRAFICOS CANVAS JR ---");
