// Headless/CI guard — demo requiere display/SDL2/consola interactiva
importar "sistema.nv";
texto _ci_guard = sistema_env_obtener("CI");
texto _hl_guard = sistema_env_obtener("LUMEN_HEADLESS");
si _ci_guard != "" || _hl_guard == "1" {
    imprimir("Headless/CI detectado — demo omitida (requiere display)");
    retornar;
}
// ==========================================
// graficos_charts_jr.nv — Charts (junior)
// Tests: bar data, pie segments, axis calc
// Uso: lumen run -L stdlib/ examples/jr/graficos_charts_jr.nv
// ==========================================

imprimir("=== Graficos Charts JR: Chart Data ===");

// Ej 1: Bar Chart Data
imprimir("--- Ej 1: Datos de Barras ---");
lista<numero> ventas = [45.0, 78.0, 32.0, 91.0, 56.0];
numero total_v = ventas[0] + ventas[1] + ventas[2] + ventas[3] + ventas[4];
imprimir("Ventas: 45 78 32 91 56");
imprimir("Total: ", total_v);
// Find max using manual comparisons
numero max_v = ventas[0];
si ventas[1] > max_v { max_v = ventas[1]; }
si ventas[2] > max_v { max_v = ventas[2]; }
si ventas[3] > max_v { max_v = ventas[3]; }
si ventas[4] > max_v { max_v = ventas[4]; }
imprimir("Maximo: ", max_v);

// Ej 2: Pie Chart Angles
imprimir("--- Ej 2: Angulos de Pastel ---");
numero a0 = ventas[0] / total_v * 360.0;
numero a1 = ventas[1] / total_v * 360.0;
numero a2 = ventas[2] / total_v * 360.0;
numero a3 = ventas[3] / total_v * 360.0;
numero a4 = ventas[4] / total_v * 360.0;
imprimir("Segmentos (grados): ", a0, " ", a1, " ", a2, " ", a3, " ", a4);
numero total_ang = a0 + a1 + a2 + a3 + a4;
imprimir("Suma de angulos: ", total_ang, " (debe ser ~360)");

// Ej 3: Axis Scale
imprimir("--- Ej 3: Escala de Ejes ---");
entero nice = ((max_v como entero) / 10 + 1) * 10;
imprimir("Rango automatico: 0 a ", nice);
entero step = nice / 4;
imprimir("Ticks: 0, ", step, ", ", step * 2, ", ", step * 3, ", ", nice);

imprimir("--- FIN GRAFICOS CHARTS JR ---");
