// Fase 65 — Guard Let (let-else): vincula el payload y continúa, o diverge
// `sea algun(n) = opt sino { retornar; }` — si el patrón matchea, `n`
// queda en scope para el resto del bloque; si no, ejecuta el cuerpo `sino`
funcion texto procesar(opcion<entero> opt) {
    sea algun(n) = opt sino { retornar "vacio"; }
    retornar "tiene: " + a_texto(n);
}

funcion entero principal() {
    opcion<entero> a = algun(42);
    opcion<entero> b = ninguno;
    imprimir(procesar(a));
    imprimir(procesar(b));
    retornar 0;
}