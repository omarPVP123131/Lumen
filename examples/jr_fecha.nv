// EJEMPLO JR: formato de fecha simple
// Uso: lumen run examples/jr_fecha.nv

importar "fecha.nv";

imprimir("=== Fecha JR ===");

sea ts = fecha_ahora();
imprimir("timestamp: ", ts);

sea hoy = fecha_formatear(ts, "%Y-%m-%d");
imprimir("hoy: ", hoy);

sea hora = fecha_formatear(ts, "%H:%M:%S");
imprimir("hora: ", hora);

sea completo = fecha_formatear(ts, "%Y-%m-%d %H:%M:%S");
imprimir("completo: ", completo);

sea cumple = fecha_parsear("2000-01-15 00:00:00", "%Y-%m-%d %H:%M:%S");
sea edad_segs = fecha_diferencia(ts, cumple);
sea edad_anios = edad_segs / (365.25 * 86400);
imprimir("edad (años): ", edad_anios);

imprimir("--- FIN JR ---");
