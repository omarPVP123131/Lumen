// Ejemplo de Extension Methods en Lúmen
rasgo Formateable {
    funcion texto a_formato(este);
}

impl Formateable para entero {
    funcion texto a_formato(este) {
        retornar "Numero: " + a_texto(este);
    }
}

impl Formateable para texto {
    funcion texto a_formato(este) {
        retornar "Texto: '" + este + "'";
    }
}

funcion entero principal() {
    entero n = 42;
    texto s = "Hola LÚMEN";

    imprimir(n.a_formato());
    imprimir(s.a_formato());
    retornar 0;
}
