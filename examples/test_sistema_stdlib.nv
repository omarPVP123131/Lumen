importar "sistema.nv";

imprimir("=== Sistema Stdlib Test ===");

sea res = sistema_ejecutar("echo Hola Stdlib");
imprimir("echo: ", res);

sea ruta_var = sistema_env_obtener("PATH");
imprimir("PATH exists: ", ruta_var);

sistema_env_asignar("LUMEN_STDLIB", "ok");
sea val_test = sistema_env_obtener("LUMEN_STDLIB");
imprimir("LUMEN_STDLIB: ", val_test);

sea unido = sistema_path_unir("docs", "manual.txt");
imprimir("unido: ", unido);

sea ext = sistema_path_extension("imagen.png");
imprimir("extension: ", ext);

sea tmp_dir = sistema_temp_directorio();
imprimir("temp dir: ", tmp_dir);

imprimir("--- FIN ---");
