importar ingles;

enum Nivel {
    Bajo,
    Medio,
    Alto
}

funcion texto evaluar(Nivel n, entero puntaje) {
    elegir (n) {
        caso Nivel::Alto si puntaje > 80: { retornar "excelente"; }
        caso Nivel::Alto: { retornar "alto normal"; }
        caso Nivel::Medio si puntaje > 50: { retornar "bueno"; }
        caso Nivel::Medio: { retornar "regular"; }
        caso Nivel::Bajo: { retornar "insuficiente"; }
    }
}

imprimir(evaluar(Nivel::Alto, 90));
imprimir(evaluar(Nivel::Alto, 60));
imprimir(evaluar(Nivel::Medio, 70));
imprimir(evaluar(Nivel::Bajo, 0));
