importar ingles;

funcion texto categoria(entero edad) {
    elegir (edad) {
        caso 0 si edad < 13: { retornar "nino"; }
        caso 1 si edad < 18: { retornar "adolescente"; }
        defecto { retornar "adulto"; }
    }
}

imprimir(categoria(8));
imprimir(categoria(15));
imprimir(categoria(30));
