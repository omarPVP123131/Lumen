importar ingles;

funcion texto dia_texto(entero n) {
    elegir (n) {
        caso 1: { retornar "lunes"; }
        caso 2: { retornar "martes"; }
        caso 3: { retornar "miercoles"; }
        caso 4: { retornar "jueves"; }
        caso 5: { retornar "viernes"; }
        defecto { retornar "fin de semana"; }
    }
}

imprimir(dia_texto(3));
imprimir(dia_texto(7));
