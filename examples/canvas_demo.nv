// Ejemplo interactivo: Canvas drawing con JS bridges
// Requiere modo Servidor (VM Rust) o WASM con bridges JS habilitados

importar "matematicas.nv";

imprimir("=== Canvas Demo ===");
imprimir("Dibuja en el canvas con clic/arrastre");

// Crear canvas via JS
__js_eval("
  if (!document.getElementById('lumenCanvas')) {
    const c = document.createElement('canvas');
    c.id = 'lumenCanvas';
    c.width = 400;
    c.height = 300;
    c.style.border = '1px solid #444';
    c.style.background = '#1e1e2e';
    c.style.display = 'block';
    c.style.margin = '10px auto';
    document.body.appendChild(c);
    window.lumenCtx = c.getContext('2d');
    window.lumenCtx.strokeStyle = '#89b4fa';
    window.lumenCtx.lineWidth = 2;
    window.lumenCtx.lineCap = 'round';
  }
");

texto color = "#a6e3a1"; // verde catppuccin
__js_call("eval", "window.lumenCtx.strokeStyle = '" + color + "';");

entero x = 0;
entero y = 0;
entero drawing = 0;

// Manejar eventos mouse
__js_eval("
  const c = document.getElementById('lumenCanvas');
  c.onmousedown = (e) => { window.lumenDrawing = 1; window.lumenLastX = e.offsetX; window.lumenLastY = e.offsetY; };
  c.onmousemove = (e) => { if (window.lumenDrawing) { window.lumenDrawLine(e.offsetX, e.offsetY); } };
  c.onmouseup = () => { window.lumenDrawing = 0; };
  c.onmouseleave = () => { window.lumenDrawing = 0; };
  window.lumenDrawLine = (x, y) => {
    const ctx = window.lumenCtx;
    ctx.beginPath();
    ctx.moveTo(window.lumenLastX, window.lumenLastY);
    ctx.lineTo(x, y);
    ctx.stroke();
    window.lumenLastX = x; window.lumenLastY = y;
  };
");

imprimir("Canvas listo. Dibuja con el ratón.");
imprimir("Presiona 'c' en consola JS para limpiar: window.lumenCtx.clearRect(0,0,400,300);");

// Demo automático: dibujar espiral
imprimir("Dibujando espiral de demo...");
entero i = 0;
mientras i < 720 {
  decimal ang = i * 3.14159 / 180.0;
  decimal r = i * 0.2;
  decimal cx = 200.0 + (r * matematicas_coseno(ang));
  decimal cy = 150.0 + (r * matematicas_seno(ang));
  __js_call("eval", "window.lumenDrawLine(" + a_texto(cx) + ", " + a_texto(cy) + ");");
  i = i + 2;
}
imprimir("¡Espiral completada!");
