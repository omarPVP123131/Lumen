importar ingles;

// Test: traits, generics bounds, impl para
rasgo Describible {
    funcion texto mostrar(yo);
}

estructura Punto { x: entero, y: entero }

impl Describible para Punto {
    funcion texto mostrar(yo) {
        retornar "Punto(" + yo.x + "," + yo.y + ")";
    }
}

Punto p = Punto { x: 5, y: 12 };
imprimir(p.mostrar());
