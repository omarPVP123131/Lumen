// Extension Methods — Fase 67
// Implementar rasgos para tipos externos (built-in)

// Definir un rasgo
rasgo Describible {
    funcion texto descripcion(yo);
}

// Implementar para entero
impl Describible para entero {
    funcion texto descripcion(yo) {
        retornar "Entero: " + a_texto(yo);
    }
}

// Implementar para texto
impl Describible para texto {
    funcion texto descripcion(yo) {
        retornar "Texto: " + yo;
    }
}

// Implementar para booleano
impl Describible para booleano {
    funcion texto descripcion(yo) {
        si (yo) {
            retornar "Booleano: verdadero";
        } sino {
            retornar "Booleano: falso";
        }
    }
}

// Usamos declaraciones tipadas correctas en español
entero n = 42;
imprimir(n.descripcion());

texto s = "Hola";
imprimir(s.descripcion());

booleano b = verdadero;
imprimir(b.descripcion());

// Extension method con parámetros adicionales
rasgo Sumable {
    funcion entero sumar(yo, entero otro);
}

impl Sumable para entero {
    funcion entero sumar(yo, entero otro) {
        retornar yo + otro;
    }
}

entero x = 10;
imprimir(x.sumar(5));
