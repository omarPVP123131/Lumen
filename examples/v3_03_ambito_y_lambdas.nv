// v3.0 — Ámbito de bloque y lambdas recursivas
//
// Dos correcciones importantes de esta versión:
//   * cada bloque tiene su propio ámbito: declarar dentro SOMBREA, no machaca
//     la variable de fuera (BUG-063);
//   * una lambda recursiva funciona tras cualquier condicional o bucle; antes
//     las etiquetas de la lambda pisaban las del programa y la recursión no
//     terminaba nunca (BUG-062).

// --- Ámbito de bloque ---------------------------------------------------

entero x = 1;
si (1 > 0) {
    entero x = 2;          // variable NUEVA, sólo vive en este bloque
    imprimir("dentro del si : ", x);
}
imprimir("fuera del si  : ", x, "   <- intacta");

texto etiqueta = "global";
mientras (verdadero) {
    texto etiqueta = "del bucle";
    imprimir("dentro while  : ", etiqueta);
    romper;
}
imprimir("fuera del while: ", etiqueta);

// Ojo: SIN tipo delante no se declara, se ASIGNA (y eso sí muta la de fuera).
entero contador = 0;
para i en 1..5 {
    contador = contador + i;   // asignación: acumula
}
imprimir("acumulador     : ", contador, " (1+2+3+4)");

// Sombrear dentro del bucle no rompe el acumulador de fuera.
entero suma = 100;
para i en 1..3 {
    entero suma = i;           // declaración: variable distinta
}
imprimir("suma protegida : ", suma);

// --- Lambdas recursivas -------------------------------------------------

// Tras un `si`, un `mientras` o un `elegir`, la recursión funciona igual.
si (verdadero) {
    imprimir("-- antes de definir las lambdas --");
}

sea factorial = funcion(entero n) {
    si (n <= 1) {
        retornar 1;
    }
    retornar n * factorial(n - 1);
};

sea fib = funcion(entero n) {
    si (n < 2) {
        retornar n;
    }
    retornar fib(n - 1) + fib(n - 2);
};

imprimir("factorial(6)   : ", factorial(6));
imprimir("fib(10)        : ", fib(10));

elegir (2) {
    caso 2: imprimir("-- tras un elegir --");
    defecto: imprimir("otro");
}

sea suma_hasta = funcion(entero n) {
    si (n <= 0) {
        retornar 0;
    }
    retornar n + suma_hasta(n - 1);
};
imprimir("suma_hasta(10) : ", suma_hasta(10));

// Las lambdas también capturan variables del entorno.
entero base = 10;
sea escalar = funcion(entero v) {
    retornar v * base;
};
imprimir("escalar(7)     : ", escalar(7));
