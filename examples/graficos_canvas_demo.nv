// EJEMPLO CANVAS — Primitivas de dibujo 2D con teclado interactivo
// Canvas Demo — 2D drawing primitives with interactive keyboard
// Uso: lumen run examples/graficos_canvas_demo.nv
// Requiere: SDL2.dll en el PATH
//
// Controles:
//   [1]-[6]  Cambiar modo de dibujo
//   [FLECHAS] Mover origen / ajustar parámetros
//   [ESPACIO]  Pausar/Reanudar animación
//   [ESC]      Salir

importar "graficos.nv";
importar "graficos_canvas.nv";
// Headless/CI guard — demo requiere display/SDL2/consola interactiva
importar "sistema.nv";
texto _ci_guard = sistema_env_obtener("CI");
texto _hl_guard = sistema_env_obtener("LUMEN_HEADLESS");
si _ci_guard != "" || _hl_guard == "1" {
    imprimir("Headless/CI detectado — demo omitida (requiere display)");
    retornar;
}

// ============================================================
// CONSTANTES SDL2 / SDL2 CONSTANTS
// ============================================================

const entero SDL_INIT_VIDEO = 32;
const entero SDL_SCANCODE_ESC = 41;
const entero SDL_SCANCODE_SPACE = 44;
const entero SDL_SCANCODE_UP = 82;
const entero SDL_SCANCODE_DOWN = 81;
const entero SDL_SCANCODE_LEFT = 80;
const entero SDL_SCANCODE_RIGHT = 79;
const entero SDL_SCANCODE_1 = 30;
const entero SDL_SCANCODE_2 = 31;
const entero SDL_SCANCODE_3 = 32;
const entero SDL_SCANCODE_4 = 33;
const entero SDL_SCANCODE_5 = 34;
const entero SDL_SCANCODE_6 = 35;

// ============================================================
// CONFIGURACIÓN / SETUP
// ============================================================

const entero ANCHO = 800;
const entero ALTO = 600;

imprimir("=== Canvas 2D — Primitivas de Dibujo ===");
imprimir("Inicializando SDL2...");

si !graficos_iniciar(SDL_INIT_VIDEO) {
    imprimir("ERROR: No se pudo iniciar SDL2");
    retornar;
}

entero win = graficos_ventana("LÚMEN Canvas 2D", 100, 100, ANCHO, ALTO, 0);
si win == 0 {
    imprimir("ERROR: No se pudo crear ventana");
    graficos_salir();
    retornar;
}

entero ren = graficos_renderizador(win, -1, 0);
si ren == 0 {
    imprimir("ERROR: No se pudo crear renderer");
    graficos_cerrar_ventana(win);
    graficos_salir();
    retornar;
}

// Inicializar módulo canvas
graficos_canvas_iniciar(ren);

// ============================================================
// ESTADO DE LA DEMO / DEMO STATE
// ============================================================

entero modo = 1;      // 1=lineas, 2=circulos, 3=circulos_rellenos,
                       // 4=triangulos, 5=pincel, 6=gradiente
entero tiempo = 0;
booleano pausado = falso;
entero origen_x = ANCHO / 2;
entero origen_y = ALTO / 2;
entero radio = 80;

// Para detección de flanco en teclas de modo
entero prev_1 = 0; entero prev_2 = 0; entero prev_3 = 0;
entero prev_4 = 0; entero prev_5 = 0; entero prev_6 = 0;
entero prev_space = 0;

// Arreglo de colores HSL-like
entero paleta_r[] = [255, 100, 100, 200, 255, 180];
entero paleta_g[] = [100, 200, 255, 100, 200, 100];
entero paleta_b[] = [100, 255, 100, 100, 50,  200];

// Eventos
entero evt_buf = __ffi_asignar(64);

imprimir("=== Controles ===");
imprimir("  [1] Líneas rotativas");
imprimir("  [2] Círculos huecos");
imprimir("  [3] Círculos rellenos");
imprimir("  [4] Triángulos");
imprimir("  [5] Triángulos rellenos");
imprimir("  [6] Degradados");
imprimir("  [FLECHAS] Mover origen");
imprimir("  [ESPACIO] Pausar");
imprimir("  [ESC] Salir");

// ============================================================
// BUCLE PRINCIPAL / MAIN LOOP
// ============================================================

mientras verdadero {
    // --- Leer eventos SDL ---
    texto evt = graficos_leer_evento(evt_buf);
    si evt == "QUIT" { romper; }

    // --- Teclado en tiempo real ---
    entero kb = graficos_teclado();

    si kb != 0 {
        // ESC → salir
        si graficos_tecla_presionada(kb, SDL_SCANCODE_ESC) { romper; }

        // FLECHAS → mover origen / ajustar
        si graficos_tecla_presionada(kb, SDL_SCANCODE_LEFT) { origen_x = origen_x - 5; }
        si graficos_tecla_presionada(kb, SDL_SCANCODE_RIGHT) { origen_x = origen_x + 5; }
        si graficos_tecla_presionada(kb, SDL_SCANCODE_UP) { origen_y = origen_y - 5; }
        si graficos_tecla_presionada(kb, SDL_SCANCODE_DOWN) { origen_y = origen_y + 5; }

        // ESPACIO → pausar (flanco de subida)
        entero sp = 0;
        si graficos_tecla_presionada(kb, SDL_SCANCODE_SPACE) { sp = 1; }
        si sp == 1 && prev_space == 0 { pausado = !pausado; }
        prev_space = sp;

        // [1]-[6] → cambiar modo (flanco de subida)
        entero d1 = 0; entero d2 = 0; entero d3 = 0;
        entero d4 = 0; entero d5 = 0; entero d6 = 0;
        si graficos_tecla_presionada(kb, SDL_SCANCODE_1) { d1 = 1; }
        si graficos_tecla_presionada(kb, SDL_SCANCODE_2) { d2 = 1; }
        si graficos_tecla_presionada(kb, SDL_SCANCODE_3) { d3 = 1; }
        si graficos_tecla_presionada(kb, SDL_SCANCODE_4) { d4 = 1; }
        si graficos_tecla_presionada(kb, SDL_SCANCODE_5) { d5 = 1; }
        si graficos_tecla_presionada(kb, SDL_SCANCODE_6) { d6 = 1; }

        si d1 == 1 && prev_1 == 0 { modo = 1; imprimir("Modo: Líneas"); }
        si d2 == 1 && prev_2 == 0 { modo = 2; imprimir("Modo: Círculos"); }
        si d3 == 1 && prev_3 == 0 { modo = 3; imprimir("Modo: Círculos rellenos"); }
        si d4 == 1 && prev_4 == 0 { modo = 4; imprimir("Modo: Triángulos"); }
        si d5 == 1 && prev_5 == 0 { modo = 5; imprimir("Modo: Triángulos rellenos"); }
        si d6 == 1 && prev_6 == 0 { modo = 6; imprimir("Modo: Degradados"); }

        prev_1 = d1; prev_2 = d2; prev_3 = d3;
        prev_4 = d4; prev_5 = d5; prev_6 = d6;
    }

    // Avanzar tiempo (si no está pausado)
    si !pausado {
        tiempo = tiempo + 1;
    }

    // ============================================================
    // DIBUJADO / RENDERING
    // ============================================================

    // Limpiar pantalla con fondo azul oscuro
    graficos_canvas_limpiar_pantalla(15, 15, 30);

    // Obtener colores del modo actual
    entero ci = modo - 1;
    entero cr = paleta_r[ci];
    entero cg = paleta_g[ci];
    entero cb = paleta_b[ci];

    // Dibujar según modo
    si modo == 1 {
        // MODO 1: LÍNEAS ROTATIVAS
        // Haz de líneas que rotan alrededor del origen
        entero n = 16;
        entero i = 0;
        mientras i < n {
            decimal ang = (i como decimal) * 6.28318 / (n como decimal);
            ang = ang + (tiempo como decimal) * 0.02;
            // Aproximación seno/coseno Taylor
            decimal a2 = ang * ang;
            decimal sn = ang - a2 * ang / 6.0 + a2 * a2 * ang / 120.0;
            decimal cs = 1.0 - a2 / 2.0 + a2 * a2 / 24.0;

            entero largo = 120;
            entero ex = (cs * (largo como decimal)) como entero;
            entero ey = (sn * (largo como decimal)) como entero;

            entero rr = (i * 40) % 256;
            entero gg = (i * 80 + 100) % 256;
            entero bb = (i * 120 + 50) % 256;

            graficos_canvas_linea(origen_x, origen_y, origen_x + ex, origen_y + ey, rr, gg, bb, 255);
            i = i + 1;
        }

        // Línea de referencia horizontal
        graficos_canvas_linea(origen_x - 150, origen_y, origen_x + 150, origen_y, 60, 60, 80, 255);
        graficos_canvas_linea(origen_x, origen_y - 150, origen_x, origen_y + 150, 60, 60, 80, 255);

    } sino si modo == 2 {
        // MODO 2: CÍRCULOS HUEVOS
        // Círculos concéntricos pulsantes
        entero i = 0;
        mientras i < 5 {
            entero r = radio + i * 25 + ((tiempo * 3 + i * 50) % 40);
            entero rr = (cr + i * 30) % 256;
            entero gg = (cg + i * 50) % 256;
            entero bb = (cb + i * 70) % 256;
            graficos_canvas_circulo(origen_x, origen_y, r, rr, gg, bb, 255);
            i = i + 1;
        }

    } sino si modo == 3 {
        // MODO 3: CÍRCULOS RELLENOS
        // Círculo relleno que respira (cambia de tamaño)
        entero r_actual = radio + ((tiempo * 4) % 60);
        entero rr = (cr + tiempo * 2) % 256;
        entero gg = (cg + tiempo * 3) % 256;
        entero bb = (cb + tiempo * 5) % 256;

        // Círculo principal con destello
        graficos_canvas_circulo_relleno(origen_x, origen_y, r_actual, rr, gg, bb, 200);

        // Borde más brillante
        graficos_canvas_circulo(origen_x, origen_y, r_actual, 255, 255, 255, 120);

        // Círculo secundario orbitante
        decimal ang = (tiempo como decimal) * 0.03;
        decimal a2 = ang * ang;
        decimal sn = ang - a2 * ang / 6.0 + a2 * a2 * ang / 120.0;
        decimal cs = 1.0 - a2 / 2.0 + a2 * a2 / 24.0;
        entero ox = (cs * 160.0) como entero;
        entero oy = (sn * 160.0) como entero;
        graficos_canvas_circulo_relleno(origen_x + ox, origen_y + oy, 20, 255, 255, 100, 200);

    } sino si modo == 4 {
        // MODO 4: TRIÁNGULOS HUEVOS
        // Estrella de triángulos rotantes
        entero n = 8;
        entero i = 0;
        mientras i < n {
            decimal ang = (i como decimal) * 6.28318 / (n como decimal);
            ang = ang + (tiempo como decimal) * 0.015;
            decimal a2 = ang * ang;
            decimal sn = ang - a2 * ang / 6.0 + a2 * a2 * ang / 120.0;
            decimal cs = 1.0 - a2 / 2.0 + a2 * a2 / 24.0;

            entero dist = 100;
            entero dx = (cs * (dist como decimal)) como entero;
            entero dy = (sn * (dist como decimal)) como entero;

            ang = ang + 2.094;  // +120°
            a2 = ang * ang;
            entero sn2 = (ang - a2 * ang / 6.0 + a2 * a2 * ang / 120.0) como entero;
            entero cs2 = (1.0 - a2 / 2.0 + a2 * a2 / 24.0) como entero;
            entero dx2 = (cs2 * (dist como decimal)) como entero;
            entero dy2 = (sn2 * (dist como decimal)) como entero;

            entero rr = (i * 60) % 256;
            entero gg = (i * 90 + 50) % 256;
            entero bb = (i * 120 + 100) % 256;

            graficos_canvas_triangulo(
                origen_x + dx, origen_y + dy,
                origen_x + dx2, origen_y + dy2,
                origen_x, origen_y,
                rr, gg, bb, 200
            );
            i = i + 1;
        }

    } sino si modo == 5 {
        // MODO 5: TRIÁNGULOS RELLENOS
        // Composiciones de triángulos rellenos
        entero i = 0;
        mientras i < 6 {
            decimal ang = (i como decimal) * 1.047;  // 60°
            ang = ang + (tiempo como decimal) * 0.01;
            decimal a2 = ang * ang;
            decimal sn = ang - a2 * ang / 6.0 + a2 * a2 * ang / 120.0;
            decimal cs = 1.0 - a2 / 2.0 + a2 * a2 / 24.0;

            entero dist = 90 + ((tiempo * 2 + i * 30) % 50);
            entero dx = (cs * (dist como decimal)) como entero;
            entero dy = (sn * (dist como decimal)) como entero;

            entero rr = (i * 40 + 50) % 256;
            entero gg = (i * 70 + 100) % 256;
            entero bb = (i * 100 + 50) % 256;

            graficos_canvas_triangulo_relleno(
                origen_x, origen_y,
                origen_x + dx, origen_y + dy,
                origen_x - dy / 2, origen_y + dx / 2,
                rr, gg, bb, 180
            );
            i = i + 1;
        }

    } sino si modo == 6 {
        // MODO 6: DEGRADADOS
        // Rectángulos con degradado vertical en cascada
        entero n = 5;
        entero ancho_banda = 140;
        entero separacion = 10;
        entero total_w = n * ancho_banda + (n - 1) * separacion;
        entero x_inicio = origen_x - total_w / 2;

        entero i = 0;
        mientras i < n {
            entero bx = x_inicio + i * (ancho_banda + separacion);
            entero by = origen_y - 100;

            // Degradado de color i a color i+1
            entero r1 = (i * 50) % 256;
            entero g1 = ((i * 70 + 100) % 256);
            entero b1 = ((i * 90 + 50) % 256);
            entero r2 = ((i * 50 + 150) % 256);
            entero g2 = ((i * 70 + 50) % 256);
            entero b2 = ((i * 90 + 200) % 256);

            graficos_canvas_rectangulo_gradiente(bx, by, ancho_banda, 200,
                r1, g1, b1, r2, g2, b2);

            // Borde del degradado
            graficos_canvas_linea(bx, by, bx + ancho_banda, by, 200, 200, 200, 100);
            graficos_canvas_linea(bx, by + 200, bx + ancho_banda, by + 200, 200, 200, 200, 100);

            i = i + 1;
        }
    }

    // ============================================================
    // HUD / OVERLAY
    // ============================================================

    // Fondo del HUD semi-transparente
    graficos_color_render(ren, 0, 0, 0, 180);
    graficos_rectangulo(ren, 5, 5, 220, 70);

    // Texto del modo actual (simulado con rectángulos)
    texto modo_str = "";
    si modo == 1 { modo_str = "Líneas"; }
    sino si modo == 2 { modo_str = "Círculos"; }
    sino si modo == 3 { modo_str = "Círculos Rellenos"; }
    sino si modo == 4 { modo_str = "Triángulos"; }
    sino si modo == 5 { modo_str = "Triángulos Rellenos"; }
    sino si modo == 6 { modo_str = "Degradados"; }

    // Indicador de modo - barra coloreada
    graficos_color_render(ren, cr, cg, cb, 255);
    graficos_rectangulo(ren, 10, 10, 12, 12);

    // Texto modo
    graficos_color_render(ren, 200, 200, 220, 255);
    entero tx = 28;
    graficos_rectangulo(ren, tx, 12, 80, 4);  // "Modo: X"
    graficos_rectangulo(ren, tx, 22, 60, 3);  // "[1]-[6] cambiar"
    graficos_rectangulo(ren, tx, 35, 40, 3);  // posición

    // Posición del origen
    graficos_color_render(ren, 200, 200, 200, 150);
    graficos_rectangulo(ren, tx, 50, 100, 3);

    // Indicador de pausa
    si pausado {
        graficos_color_render(ren, 255, 220, 50, 255);
        graficos_rectangulo(ren, 10, 58, 80, 4);
    }

    // Mira en el origen
    graficos_color_render(ren, 255, 255, 255, 100);
    graficos_rectangulo(ren, origen_x - 3, origen_y - 1, 6, 3);
    graficos_rectangulo(ren, origen_x - 1, origen_y - 3, 3, 6);

    // Presentar frame
    graficos_presentar(ren);
    graficos_dormir(16);
}

// ============================================================
// LIMPIEZA / CLEANUP
// ============================================================

__ffi_liberar(evt_buf, 64);
graficos_cerrar_ventana(win);
graficos_salir();
imprimir("=== Demo de Canvas finalizada ===");
imprimir("Tiempo total: ", tiempo);
