// ============================================================================
// Suite de regresión — bugs corregidos sobre LÚMEN v2.4.6
//
// Ejecutar:  lumen run -L stdlib tests/regresiones_v2.4.7.nv
// Cada bloque imprime "ok <BUG-XXX> ..." cuando el comportamiento es correcto.
// ============================================================================

imprimir("=== Suite de regresión v2.4.6 → v2.4.7 ===");

// ── BUG-001: abs() como builtin ────────────────────────────────────────────
imprimir("BUG-001 abs(-5)        -> ", abs(-5));        // 5
imprimir("BUG-001 abs(-2.5)      -> ", abs(-2.5));      // 2.5
imprimir("BUG-001 minimo/maximo  -> ", minimo(3, 9), " / ", maximo(3, 9));
imprimir("BUG-001 raiz/potencia  -> ", raiz(16.0), " / ", potencia(2.0, 10.0));

// ── BUG-007 / BUG-002: conversiones texto → número ─────────────────────────
imprimir("BUG-007 a_entero       -> ", a_entero("42"));
imprimir("BUG-007 negativo+space -> ", a_entero("  -17 "));
imprimir("BUG-007 trunca decimal -> ", a_entero("3.9"));
imprimir("BUG-007 a_decimal      -> ", a_decimal("3.5"));
imprimir("BUG-007 a_texto (ida)  -> ", a_texto(42));
imprimir("BUG-007 es_numero      -> ", es_numero("12"), " / ", es_numero("abc"));

// Variantes seguras: permiten detectar entrada inválida sin abortar.
resultado<entero, texto> conv_ok = a_entero_seguro("100");
elegir (conv_ok) {
    caso exito(v): imprimir("BUG-007 seguro ok      -> ", v);
    caso error(e): imprimir("BUG-007 seguro ok      -> INESPERADO ", e);
}
resultado<entero, texto> conv_mal = a_entero_seguro("no-soy-numero");
elegir (conv_mal) {
    caso exito(v): imprimir("BUG-007 seguro err     -> INESPERADO ", v);
    caso error(e): imprimir("BUG-007 seguro err     -> ", e);
}

// ── BUG-003: destructuring de datos de enum en elegir/caso ─────────────────
enum Figura { Circulo(decimal), Rect(decimal, decimal), Punto }

funcion decimal area(Figura f) {
    elegir (f) {
        caso Figura::Circulo(r): retornar 3.14159 * r * r;
        caso Figura::Rect(w, h): retornar w * h;
        caso Figura::Punto: retornar 0.0;
    }
    retornar -1.0;
}

imprimir("BUG-003 Circulo(2)     -> ", area(Figura::Circulo(2.0)));
imprimir("BUG-003 Rect(3,4)      -> ", area(Figura::Rect(3.0, 4.0)));
imprimir("BUG-003 Punto          -> ", area(Figura::Punto));

// Patrón literal anidado + captura en la misma enumeración.
enum Msg { Texto(texto), Codigo(entero) }

funcion texto describir(Msg m) {
    elegir (m) {
        caso Msg::Texto(t): retornar t;
        caso Msg::Codigo(404): retornar "no encontrado";
        caso Msg::Codigo(c): retornar a_texto(c);
    }
    retornar "?";
}

imprimir("BUG-003 Texto          -> ", describir(Msg::Texto("hola")));
imprimir("BUG-003 Codigo(404)    -> ", describir(Msg::Codigo(404)));
imprimir("BUG-003 Codigo(200)    -> ", describir(Msg::Codigo(200)));

// Los patrones OR siguen funcionando junto a los patrones con datos.
enum Color { Rojo, Verde, Azul, Amarillo }

funcion texto temperatura(Color c) {
    elegir (c) {
        caso Color::Rojo | Color::Amarillo: retornar "calido";
        caso Color::Verde | Color::Azul: retornar "frio";
        defecto: retornar "desconocido";
    }
}

imprimir("BUG-003 OR-pattern     -> ", temperatura(Color::Azul), " / ", temperatura(Color::Rojo));

// ── BUG-006: 'resultado' y 'opcion' usables como nombre de variable ────────
entero resultado = 0;
resultado = resultado + 42;
imprimir("BUG-006 var resultado  -> ", resultado);

entero opcion = 7;
imprimir("BUG-006 var opcion     -> ", opcion * 2);

// El tipo genérico sigue disponible sin ambigüedad.
resultado<entero, texto> r_tipo = exito(5);
elegir (r_tipo) {
    caso exito(v): imprimir("BUG-006 tipo resultado -> ", v);
    caso error(e): imprimir("BUG-006 tipo resultado -> ", e);
}

funcion entero doblar(entero resultado) { retornar resultado * 2; }
imprimir("BUG-006 param nombrado -> ", doblar(21));

// ── BUG-008: paso por referencia explícito con 'prestado mut' ──────────────
estructura Caja { valor: entero }

funcion vacio cambiar(prestado mut Caja c) { c.valor = 999; }

Caja caja = Caja { valor: 1 };
cambiar(caja);
imprimir("BUG-008 struct mutado  -> ", caja.valor);          // 999

funcion vacio agregar_algo(prestado mut lista<texto> l) { l.agregar("hola"); }

lista<texto> lista_ref = [];
agregar_algo(lista_ref);
agregar_algo(lista_ref);
imprimir("BUG-008 lista mutada   -> ", lista_ref.largo());   // 2

funcion vacio set_primero(prestado mut lista<entero> l) { l[0] = 77; }

lista<entero> nums = [1, 2, 3];
set_primero(nums);
imprimir("BUG-008 lista[i]=v     -> ", nums[0]);             // 77

// Caso del generador de laberinto: acumular por recursión sin reasignar.
funcion vacio excavar(prestado mut lista<entero> camino, entero n) {
    si n <= 0 { retornar; }
    camino.agregar(n);
    excavar(camino, n - 1);
}

lista<entero> camino = [];
excavar(camino, 5);
imprimir("BUG-008 recursión      -> ", camino.largo());      // 5

// Mutación propagada a través de dos niveles de llamada.
funcion vacio incr(prestado mut Caja c) { c.valor = c.valor + 1; }
funcion vacio incr_dos(prestado mut Caja c) { incr(c); incr(c); }

Caja anidada = Caja { valor: 0 };
incr_dos(anidada);
imprimir("BUG-008 anidado        -> ", anidada.valor);       // 2

// Sin 'prestado' el paso sigue siendo por valor (semántica explícita).
funcion vacio no_muta(Caja c) { c.valor = 123; }
Caja copia = Caja { valor: 7 };
no_muta(copia);
imprimir("BUG-008 por valor      -> ", copia.valor);         // 7 (no muta)

// ── BUG-009: imprimir con varios argumentos = una sola línea ───────────────
imprimir("BUG-009 ", "una", " sola ", "linea");

// ── BUG-010: retorno temprano no debe truncar el programa ──────────────────
funcion vacio salida_temprana(entero n) {
    si n <= 0 { retornar; }
    imprimir("BUG-010 rama normal    -> n=", n);
}

salida_temprana(0);
salida_temprana(5);
imprimir("BUG-010 sigue vivo     -> ok");

// ── BUG-011: asignación a campo de struct dentro de una lista ──────────────
estructura Criatura { vida: entero }

lista<Criatura> equipo = [Criatura { vida: 100 }, Criatura { vida: 50 }];
equipo[0].vida = 5;
equipo[1].vida = equipo[1].vida - 10;
imprimir("BUG-011 lista[i].campo -> ", equipo[0].vida, " / ", equipo[1].vida);

// BUG-015: romper / continuar dentro de 'para ... en'
lista<entero> vistos = [];
para n en [1,2,3,4,5] {
  si (n == 3) { continuar; }
  si (n == 5) { romper; }
  vistos.agregar(n);
}
imprimir("BUG-015 continuar/romper -> ", vistos);

// BUG-015: romper solo afecta al bucle interno
para i en [1,2] {
  para j en [10,20] {
    si (j == 20) { romper; }
    imprimir("BUG-015 anidado       -> ", i, "/", j);
  }
}

// BUG-017: lambda que captura una variable del entorno
entero cap_base = 100;
cap_f = funcion() { retornar cap_base; };
imprimir("BUG-017 captura lambda -> ", cap_f());

// BUG-018: funcion del usuario llamada 'leer'
entero leer_base = 55;
funcion entero leer() { retornar leer_base; }
imprimir("BUG-018 usuario 'leer'  -> ", leer());

// BUG-020: prestado mut self en metodos de impl
estructura Cnt { valor: entero }
impl Cnt {
  funcion vacio inc(prestado mut Cnt self) { self.valor = self.valor + 1; }
  funcion entero get(prestado Cnt self) { retornar self.valor; }
}
Cnt cc = Cnt { valor: 0 };
cc.inc();
cc.inc();
imprimir("BUG-020 metodo mut self -> ", cc.get());

// BUG-021: lambda declarada dentro de otra lambda
sea b21_externa = funcion() {
  sea b21_interna = funcion() { retornar 7; };
  retornar b21_interna();
};
imprimir("BUG-021 lambda anidada -> ", b21_externa());

// BUG-023: una local no debe pisar la global homonima
entero b23_total = 100;
funcion vacio b23_f() { entero b23_total = 7; }
b23_f();
imprimir("BUG-023 local vs global -> ", b23_total);

// BUG-026: lambda que captura la variable del bucle (no debe colgarse)
entero b26_k = 0;
lista<entero> b26_r = [];
mientras (b26_k < 3) {
  sea b26_f = funcion() { retornar b26_k * 2; };
  b26_r.agregar(b26_f());
  b26_k = b26_k + 1;
}
imprimir("BUG-026 lambda en bucle -> ", b26_r);

// BUG-027: imprimir dentro de una funcion no corrompe la pila
funcion entero b27_h(entero n) { imprimir("BUG-027 dentro n=", n); retornar n; }
imprimir("BUG-027 total=", b27_h(2));

// BUG-028: posponer se ejecuta al SALIR de la funcion (defer)
funcion vacio b28_f() {
  imprimir("BUG-028 1 abrir");
  posponer { imprimir("BUG-028 3 cerrar"); }
  imprimir("BUG-028 2 usar");
}
b28_f();

// BUG-029: una lambda puede llamar a funciones y builtins
funcion entero b29_doblar(entero x) { retornar x * 2; }
sea b29_g = funcion() { retornar b29_doblar(21); };
imprimir("BUG-029 lambda llama funcion -> ", b29_g());

// BUG-030: igualdad estructural de listas y tuplas
lista<entero> b30_a = [1,2,3];
lista<entero> b30_b = [1,2,3];
imprimir("BUG-030 listas iguales -> ", b30_a == b30_b);
imprimir("BUG-030 listas distintas -> ", b30_a == [9,9]);

// BUG-031: el patrón comodín `caso _:` como patrón de nivel superior
funcion texto b31_f(entero n) {
  elegir (n) {
    caso 1: retornar "uno";
    caso _: retornar "otro";
  }
  retornar "?";
}
imprimir("BUG-031 comodin caso exacto -> ", b31_f(1));
imprimir("BUG-031 comodin cae al _ -> ", b31_f(77));

// BUG-033: mutar una lista alcanzada por campo o por índice
estructura B33Caja { items: lista<entero> }
B33Caja b33_c = B33Caja{items: [1]};
b33_c.items.agregar(2);
imprimir("BUG-033 campo de struct -> ", b33_c.items);
lista<lista<entero>> b33_m = [[1],[2]];
b33_m[0].agregar(9);
imprimir("BUG-033 elemento indexado -> ", b33_m);

// BUG-035/036/037/038: paridad VM <-> AOT (enums, prestado mut, largo, ==)
imprimir("BUG-035 largo unicode -> ", largo("áéíóú ñ"));
enum B36Color { Rojo, Verde }
B36Color b36 = B36Color::Verde;
elegir (b36) {
  caso B36Color::Rojo: imprimir("BUG-036 enum -> rojo");
  caso B36Color::Verde: imprimir("BUG-036 enum -> verde");
}
estructura B38P { x: entero }
imprimir("BUG-038 structs iguales -> ", B38P{x:1} == B38P{x:1});
imprimir("BUG-038 structs distintos -> ", B38P{x:1} == B38P{x:2});

// BUG-040: reemplazar una clave en un mapa (no duplicarla)
sea b40_m = __map_nuevo();
b40_m = __map_poner(b40_m, "a", 1);
b40_m = __map_poner(b40_m, "a", 10);
imprimir("BUG-040 clave reemplazada -> ", __map_obtener(b40_m, "a"));
imprimir("BUG-040 tamano -> ", __map_longitud(b40_m));

// BUG-041/042/046/047/048: paridad VM <-> AOT (texto, globales, pila)
imprimir("BUG-041 indexar texto -> ", "Lumen"[0]);
imprimir("BUG-042 longitud unicode -> ", __str_longitud("Lúmen"));
entero b46_g = 1;
funcion vacio b46_subir() { b46_g = b46_g + 1; }
b46_subir();
b46_subir();
imprimir("BUG-046 global modificada -> ", b46_g);
funcion texto b47_f() { retornar "X"; }
imprimir("BUG-047 pila intacta -> [", b47_f(), "]");
texto b48_s = "Hola";
imprimir("BUG-048 metodo largo -> ", b48_s.largo());

// BUG-049: la recursion legitima sigue funcionando (el limite de profundidad
// solo corta la infinita, que no se puede probar aqui sin abortar la suite)
funcion entero b49_mil(entero n) { si (n <= 0) { retornar 0; } retornar 1 + b49_mil(n - 1); }
imprimir("BUG-049 recursion profunda -> ", b49_mil(1000));

// BUG-032: closure devuelta conserva su entorno y cada instancia el suyo.
sea b32_mk = funcion(entero n) {
  sea f = funcion(entero x) { retornar x + n; };
  retornar f;
};
sea b32_s5 = b32_mk(5);
sea b32_s100 = b32_mk(100);
imprimir("b32 esperado 15  -> ", b32_s5(10));
imprimir("b32 esperado 110 -> ", b32_s100(10));
imprimir("b32 esperado 15  -> ", b32_s5(10));
sea b32_ext = funcion(entero n) {
  sea media = funcion(entero m) {
    sea interna = funcion(entero x) { retornar n + m + x; };
    retornar interna;
  };
  retornar media;
};
sea b32_g = b32_ext(100);
sea b32_h = b32_g(20);
imprimir("b32 esperado 123 -> ", b32_h(3));

// BUG-052: la closure devuelta muta su captura y conserva el estado; dos
// instancias de la misma factoria no comparten celda.
sea b52_mk = funcion(entero n) {
  sea inc = funcion() { n = n + 1; retornar n; };
  retornar inc;
};
sea b52_a = b52_mk(10);
sea b52_b = b52_mk(100);
imprimir("b52 esperado 11  -> ", b52_a());
imprimir("b52 esperado 12  -> ", b52_a());
imprimir("b52 esperado 101 -> ", b52_b());

// BUG-022: intentar/atrapar captura errores de verdad y desenrolla la pila.
funcion entero b22_explota(entero x) { retornar x / 0; }
intentar {
  imprimir("b22 esperado capturado -> ", b22_explota(5));
} atrapar (e) {
  imprimir("b22 esperado capturado -> capturado");
}
intentar {
  intentar { imprimir(1 / 0); } atrapar (a) { imprimir("b22 esperado interno -> interno"); }
} atrapar (b) {
  imprimir("b22 NO deberia verse");
}
funcion entero b22_seguro(entero a, entero b) {
  intentar { retornar a / b; } atrapar (e) { retornar -1; }
}
imprimir("b22 esperado 5  -> ", b22_seguro(10, 2));
imprimir("b22 esperado -1 -> ", b22_seguro(10, 0));

// BUG-058: los parametros de tipo se resuelven dentro de tipos compuestos.
funcion entero b58_cuantos<T>(lista<T> l) { retornar l.largo(); }
lista<entero> b58_l = [1, 2, 3];
imprimir("b58 esperado 3  -> ", b58_cuantos(b58_l));

// BUG-060/061: lambda recursiva; con dos llamadas por nivel para detectar que
// el parametro se restaura entre ellas (fallaba solo en el backend nativo).
sea b60_fact = funcion(entero n) {
  si (n <= 1) { retornar 1; }
  retornar n * b60_fact(n - 1);
};
imprimir("b60 esperado 120 -> ", b60_fact(5));
sea b61_fib = funcion(entero n) {
  si (n < 2) { retornar n; }
  retornar b61_fib(n - 1) + b61_fib(n - 2);
};
imprimir("b61 esperado 55  -> ", b61_fib(10));


// BUG-063: una variable declarada dentro de un bloque sombrea, no machaca.
entero b63 = 1;
si (1 > 0) { entero b63 = 2; imprimir("b63 esperado 2   -> ", b63); }
imprimir("b63 esperado 1   -> ", b63);
texto b63t = "fuera";
mientras (verdadero) { texto b63t = "dentro"; romper; }
imprimir("b63 esperado fuera -> ", b63t);
entero b63c = 0;
para b63i en 1..4 { b63c = b63c + b63i; }
imprimir("b63 esperado 6   -> ", b63c);


// BUG-064: `agregar(l, x)` en forma de función también muta.
lista<entero> b64 = [1, 2];
agregar(b64, 9);
imprimir("b64 esperado 3   -> ", largo(b64));
// BUG-065: el patrón conserva el tipo real del dato capturado.
estructura B65 { v: entero, }
funcion opcion<B65> b65_dame() { retornar algun(B65 { v: 7 }); }
elegir (b65_dame()) {
    caso algun(p): imprimir("b65 esperado 7   -> ", p.v);
    caso ninguno: imprimir("b65 FALLO");
}
funcion resultado<B65, texto> b65_err() { retornar error("boom"); }
elegir (b65_err()) {
    caso exito(p): imprimir("b65 FALLO");
    caso error(e): imprimir("b65 esperado 4   -> ", largo(e));
}

imprimir("=== Fin de la suite ===");
