importar ingles;

estructura Punto {
    x: entero,
    y: entero,
}

impl Punto {
    funcion entero distancia(Punto otro) {
        entero dx = self.x - otro.x;
        entero dy = self.y - otro.y;
        retornar dx * dx + dy * dy;
    }
}

funcion texto main() {
    Punto p1 = Punto { x: 3, y: 4 };
    Punto p2 = Punto { x: 0, y: 0 };
    imprimir(p1.distancia(p2));
    retornar "ok";
}