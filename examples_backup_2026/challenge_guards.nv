importar ingles;

// Pattern matching with guards (simple enums without data bindings)
enum Color { Rojo, Verde, Azul }

funcion texto describir(Color c, entero brillo) {
    elegir (c) {
        caso Color::Rojo si brillo > 50: { retornar "rojo brillante"; }
        caso Color::Rojo: { retornar "rojo"; }
        caso Color::Verde: { retornar "verde"; }
        caso Color::Azul: { retornar "azul"; }
    }
}

imprimir(describir(Color::Rojo, 80));
imprimir(describir(Color::Rojo, 30));
imprimir(describir(Color::Verde, 0));
imprimir(describir(Color::Azul, 0));
