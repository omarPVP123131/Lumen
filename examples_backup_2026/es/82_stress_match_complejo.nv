funcion texto calificar(entero nota) {
    si (nota >= 90) {
        retornar "A";
    }
    si (nota >= 80) {
        retornar "B";
    }
    si (nota >= 70) {
        retornar "C";
    }
    si (nota >= 60) {
        retornar "D";
    }
    si (nota >= 50) {
        retornar "E";
    }
    retornar "F";
}

imprimir(calificar(95));
imprimir(calificar(75));
imprimir(calificar(45));
imprimir(calificar(82));
