estructura Vec2 {
    x: entero,
    y: entero
}

Vec2 a = Vec2 { x: 1, y: 2 };
Vec2 b = Vec2 { x: a.x, y: a.y };
b.x = 10;
imprimir(a.x);
imprimir(b.x);

estructura Rect {
    esquina: Vec2,
    ancho: entero,
    alto: entero
}

Rect r = Rect { esquina: Vec2 { x: 0, y: 0 }, ancho: 5, alto: 3 };
imprimir(r.esquina.x);
imprimir(r.ancho);
r.alto = 7;
imprimir(r.alto);
