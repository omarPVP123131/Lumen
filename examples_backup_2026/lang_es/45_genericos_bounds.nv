importar ingles;

rasgo Comparable {
    funcion booleano es_igual(yo, entero otro);
}

estructura Item {
    id: entero
}

impl Comparable for Item {
    funcion booleano es_igual(yo, entero otro) {
        retornar yo.id == otro;
    }
}

Item i = Item { id: 7 };
imprimir(i.es_igual(7));
imprimir(i.es_igual(3));
