importar ingles;

funcion texto evaluar_edad(entero edad) {
    retornar edad >= 18 ? "adulto" : "menor";
}

imprimir(evaluar_edad(20));
imprimir(evaluar_edad(15));

funcion texto signo(entero n) {
    retornar n > 0 ? "positivo" : (n < 0 ? "negativo" : "cero");
}

imprimir(signo(10));
imprimir(signo(-5));
imprimir(signo(0));
