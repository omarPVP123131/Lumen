importar ingles;

texto a = "El valor es " + a_texto(42);
imprimir(a);

texto b = "PI = " + a_texto(3.14);
imprimir(b);

texto c = "Verdad: " + a_texto(verdadero);
imprimir(c);

funcion texto etiquetar(texto nombre, entero num) {
    retornar nombre + " #" + a_texto(num);
}
imprimir(etiquetar("Item", 7));
